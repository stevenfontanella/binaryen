;; Once-guarded optimizations:
;; 1. Single-use immutable struct.new / array.new_fixed chains ($inner, $outer,
;;    $arr) used inside a once-guard are inlined and deleted, while $in_loop
;;    (inside a loop in a once-guard) stays eager.
;; 2. Same-block 1-set mutable global ($same_block_mut) in a once-guard is
;;    demoted to a local and deleted.
;; 3. Redundant i32 once-flag ($flag_redundant) guarding a single non-nullable
;;    reference global assignment ($lazy_target) is replaced by ref.is_null and
;;    deleted.
;; CHECK:      (func $defer$enum (type $7) (param $0 i32) (result (ref $enum))
;; CHECK-NEXT:  (local $1 (ref $enum))
;; CHECK-NEXT:  (block $cached (result (ref $enum))
;; CHECK-NEXT:   (br_on_non_null $cached
;; CHECK-NEXT:    (array.get $2
;; CHECK-NEXT:     (global.get $defer$enum$cache)
;; CHECK-NEXT:     (local.get $0)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (if
;; CHECK-NEXT:    (ref.is_null
;; CHECK-NEXT:     (global.get $defer$enum$table$w1)
;; CHECK-NEXT:    )
;; CHECK-NEXT:    (then
;; CHECK-NEXT:     (global.set $defer$enum$table$w1
;; CHECK-NEXT:      (array.new_data $3 $defer$data
;; CHECK-NEXT:       (i32.const 0)
;; CHECK-NEXT:       (i32.const 40)
;; CHECK-NEXT:      )
;; CHECK-NEXT:     )
;; CHECK-NEXT:     (global.set $defer$enum$table$3
;; CHECK-NEXT:      (array.new_data $5 $defer$data
;; CHECK-NEXT:       (i32.const 40)
;; CHECK-NEXT:       (i32.const 20)
;; CHECK-NEXT:      )
;; CHECK-NEXT:     )
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (array.set $2
;; CHECK-NEXT:    (global.get $defer$enum$cache)
;; CHECK-NEXT:    (local.get $0)
;; CHECK-NEXT:    (local.tee $1
;; CHECK-NEXT:     (struct.new $enum
;; CHECK-NEXT:      (array.get $4
;; CHECK-NEXT:       (global.get $defer$enum$palette$0)
;; CHECK-NEXT:       (array.get_u $3
;; CHECK-NEXT:        (global.get $defer$enum$table$w1)
;; CHECK-NEXT:        (local.get $0)
;; CHECK-NEXT:       )
;; CHECK-NEXT:      )
;; CHECK-NEXT:      (i32.const 0)
;; CHECK-NEXT:      (array.get_u $3
;; CHECK-NEXT:       (global.get $defer$enum$table$w1)
;; CHECK-NEXT:       (i32.add
;; CHECK-NEXT:        (local.get $0)
;; CHECK-NEXT:        (i32.const 20)
;; CHECK-NEXT:       )
;; CHECK-NEXT:      )
;; CHECK-NEXT:      (array.get_s $5
;; CHECK-NEXT:       (global.get $defer$enum$table$3)
;; CHECK-NEXT:       (local.get $0)
;; CHECK-NEXT:      )
;; CHECK-NEXT:     )
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (local.get $1)
;; CHECK-NEXT:  )
;; CHECK-NEXT: )
(module
  ;; CHECK:      (type $leaf (struct (field i32)))
  (type $leaf (struct (field i32)))
  ;; CHECK:      (type $node (struct (field (ref $leaf)) (field i32)))
  (type $node (struct (field (ref $leaf)) (field i32)))
  ;; CHECK:      (type $arr (array (ref $node)))
  (type $arr (array (ref $node)))
  ;; CHECK:      (type $box (struct (field (ref $arr)) (field (ref null $leaf))))
  (type $box (struct (field (ref $arr)) (field (ref null $leaf))))

  (global $inner (ref $leaf) (struct.new $leaf (i32.const 42)))
  (global $outer (ref $node) (struct.new $node (global.get $inner) (i32.const 7)))
  (global $arr_glob (ref $arr) (array.new_fixed $arr 1 (global.get $outer)))
  ;; CHECK:      (type $4 (func (param i32) (result (ref null $box))))

  ;; CHECK:      (global $in_loop (ref $leaf) (struct.new $leaf
  ;; CHECK-NEXT:  (i32.const 99)
  ;; CHECK-NEXT: ))
  (global $in_loop (ref $leaf) (struct.new $leaf (i32.const 99)))

  (global $same_block_mut (mut (ref null $leaf)) (ref.null none))
  (global $flag_redundant (mut i32) (i32.const 0))
  ;; CHECK:      (global $lazy_target (mut (ref null $box)) (ref.null none))
  (global $lazy_target (mut (ref null $box)) (ref.null none))

  ;; CHECK:      (export "init_and_get" (func $init_and_get))

  ;; CHECK:      (func $init_and_get (type $4) (param $n i32) (result (ref null $box))
  ;; CHECK-NEXT:  (local $1 (ref null $leaf))
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (ref.is_null
  ;; CHECK-NEXT:    (global.get $lazy_target)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (local.set $1
  ;; CHECK-NEXT:     (struct.new $leaf
  ;; CHECK-NEXT:      (i32.const 10)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (loop $l
  ;; CHECK-NEXT:     (if
  ;; CHECK-NEXT:      (local.get $n)
  ;; CHECK-NEXT:      (then
  ;; CHECK-NEXT:       (drop
  ;; CHECK-NEXT:        (global.get $in_loop)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:       (local.set $n
  ;; CHECK-NEXT:        (i32.sub
  ;; CHECK-NEXT:         (local.get $n)
  ;; CHECK-NEXT:         (i32.const 1)
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:       (br $l)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (global.set $lazy_target
  ;; CHECK-NEXT:     (struct.new $box
  ;; CHECK-NEXT:      (array.new_fixed $arr 1
  ;; CHECK-NEXT:       (struct.new $node
  ;; CHECK-NEXT:        (struct.new $leaf
  ;; CHECK-NEXT:         (i32.const 42)
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:        (i32.const 7)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (local.get $1)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (global.get $lazy_target)
  ;; CHECK-NEXT: )
  (func $init_and_get (export "init_and_get") (param $n i32) (result (ref null $box))
    (if
      (i32.eqz (global.get $flag_redundant))
      (then
        (global.set $flag_redundant (i32.const 1))
        (global.set $same_block_mut (struct.new $leaf (i32.const 10)))
        (loop $l
          (if
            (local.get $n)
            (then
              (drop (global.get $in_loop))
              (local.set $n (i32.sub (local.get $n) (i32.const 1)))
              (br $l)
            )
          )
        )
        (global.set $lazy_target
          (struct.new $box
            (global.get $arr_glob)
            (global.get $same_block_mut)
          )
        )
      )
    )
    (global.get $lazy_target)
  )
)

;; Absorbing a single-consumer array.new_fixed global of candidate struct.new
;; globals into the factory, plus base-column delta local teeing.
(module
  ;; CHECK:      (type $msg (struct (field i32) (field i32) (field i32) (field i32) (field i32) (field i32) (field i32)))
  (type $msg (struct (field i32) (field i32) (field i32) (field i32) (field i32) (field i32) (field i32)))
  (type $msg_arr (array (ref $msg)))

  (global $m0 (ref $msg) (struct.new $msg (i32.const 300) (i32.const 301) (i32.const 302) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
  (global $m1 (ref $msg) (struct.new $msg (i32.const 310) (i32.const 312) (i32.const 315) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
  (global $m2 (ref $msg) (struct.new $msg (i32.const 320) (i32.const 321) (i32.const 323) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
  (global $m3 (ref $msg) (struct.new $msg (i32.const 330) (i32.const 333) (i32.const 334) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
  (global $m4 (ref $msg) (struct.new $msg (i32.const 340) (i32.const 341) (i32.const 342) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
  (global $m5 (ref $msg) (struct.new $msg (i32.const 350) (i32.const 352) (i32.const 355) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
  (global $m6 (ref $msg) (struct.new $msg (i32.const 360) (i32.const 361) (i32.const 363) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
  (global $m7 (ref $msg) (struct.new $msg (i32.const 370) (i32.const 373) (i32.const 374) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
  (global $m8 (ref $msg) (struct.new $msg (i32.const 380) (i32.const 381) (i32.const 382) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))
  (global $m9 (ref $msg) (struct.new $msg (i32.const 390) (i32.const 392) (i32.const 395) (i32.const 0) (i32.const 0) (i32.const 0) (i32.const 0)))

  (global $arr_table (ref $msg_arr) (array.new_fixed $msg_arr 4
    (global.get $m0)
    (global.get $m1)
    (global.get $m2)
    (global.get $m3)
  ))

  ;; CHECK:      (type $1 (array (mut (ref null $msg))))

  ;; CHECK:      (type $2 (array (mut i8)))

  ;; CHECK:      (type $3 (array (mut i16)))

  ;; CHECK:      (type $4 (func (param i32) (result (ref $msg))))

  ;; CHECK:      (type $5 (func (result (ref $msg))))

  ;; CHECK:      (global $defer$msg$cache (ref $1) (array.new_default $1
  ;; CHECK-NEXT:  (i32.const 10)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (global $defer$msg$table$w1 (mut (ref null $2)) (ref.null none))

  ;; CHECK:      (global $defer$msg$table$0 (mut (ref null $3)) (ref.null none))

  ;; CHECK:      (data $defer$data "\01\02\01\03\01\02\01\03\01\02\02\05\03\04\02\05\03\04\02\05,\016\01@\01J\01T\01^\01h\01r\01|\01\86\01")

  ;; CHECK:      (export "get_from_arr" (func $get_from_arr))

  ;; CHECK:      (export "get_direct" (func $get_direct))

  ;; CHECK:      (func $get_from_arr (type $4) (param $i i32) (result (ref $msg))
  ;; CHECK-NEXT:  (call $defer$msg
  ;; CHECK-NEXT:   (local.get $i)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $get_from_arr (export "get_from_arr") (param $i i32) (result (ref $msg))
    (array.get $msg_arr (global.get $arr_table) (local.get $i))
  )

  ;; CHECK:      (func $get_direct (type $5) (result (ref $msg))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$msg
  ;; CHECK-NEXT:    (i32.const 4)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$msg
  ;; CHECK-NEXT:    (i32.const 5)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$msg
  ;; CHECK-NEXT:    (i32.const 6)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$msg
  ;; CHECK-NEXT:    (i32.const 7)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$msg
  ;; CHECK-NEXT:    (i32.const 8)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $defer$msg
  ;; CHECK-NEXT:   (i32.const 9)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $get_direct (export "get_direct") (result (ref $msg))
    (drop (global.get $m4))
    (drop (global.get $m5))
    (drop (global.get $m6))
    (drop (global.get $m7))
    (drop (global.get $m8))
    (global.get $m9)
  )
)

;; Per-member allocOperandUses == 0 filtering, duplicate varying-column local
;; teeing, and second-pass palette absorption with cached-factory onceGets:
;; - $v0..$v9 have allocOperandUses == 0 and are deferred even though $v_hot0
;;   and $v_hot1 (same struct type $vt) have multiple struct.new operand uses.
;; - Fields 0 and 1 of $v0..$v9 are identical varying columns, so field 0 tees
;;   a local that field 1 reuses without emitting a second data column.
;; - Field 2 of $v0..$v9 references $s0..$s9 (identical sole-use $sub structs),
;;   whose palette array is absorbed in the second pass into an uncached
;;   factory $defer$sub because the read inside $defer$vt's cached factory block
;;   is recognized as a once-get.
;; CHECK:      (func $defer$msg (type $4) (param $0 i32) (result (ref $msg))
;; CHECK-NEXT:  (local $1 (ref $msg))
;; CHECK-NEXT:  (local $2 i32)
;; CHECK-NEXT:  (block $cached (result (ref $msg))
;; CHECK-NEXT:   (br_on_non_null $cached
;; CHECK-NEXT:    (array.get $1
;; CHECK-NEXT:     (global.get $defer$msg$cache)
;; CHECK-NEXT:     (local.get $0)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (if
;; CHECK-NEXT:    (ref.is_null
;; CHECK-NEXT:     (global.get $defer$msg$table$w1)
;; CHECK-NEXT:    )
;; CHECK-NEXT:    (then
;; CHECK-NEXT:     (global.set $defer$msg$table$w1
;; CHECK-NEXT:      (array.new_data $2 $defer$data
;; CHECK-NEXT:       (i32.const 0)
;; CHECK-NEXT:       (i32.const 20)
;; CHECK-NEXT:      )
;; CHECK-NEXT:     )
;; CHECK-NEXT:     (global.set $defer$msg$table$0
;; CHECK-NEXT:      (array.new_data $3 $defer$data
;; CHECK-NEXT:       (i32.const 20)
;; CHECK-NEXT:       (i32.const 10)
;; CHECK-NEXT:      )
;; CHECK-NEXT:     )
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (array.set $1
;; CHECK-NEXT:    (global.get $defer$msg$cache)
;; CHECK-NEXT:    (local.get $0)
;; CHECK-NEXT:    (local.tee $1
;; CHECK-NEXT:     (struct.new $msg
;; CHECK-NEXT:      (local.tee $2
;; CHECK-NEXT:       (array.get_u $3
;; CHECK-NEXT:        (global.get $defer$msg$table$0)
;; CHECK-NEXT:        (local.get $0)
;; CHECK-NEXT:       )
;; CHECK-NEXT:      )
;; CHECK-NEXT:      (i32.add
;; CHECK-NEXT:       (array.get_u $2
;; CHECK-NEXT:        (global.get $defer$msg$table$w1)
;; CHECK-NEXT:        (local.get $0)
;; CHECK-NEXT:       )
;; CHECK-NEXT:       (local.get $2)
;; CHECK-NEXT:      )
;; CHECK-NEXT:      (i32.add
;; CHECK-NEXT:       (array.get_u $2
;; CHECK-NEXT:        (global.get $defer$msg$table$w1)
;; CHECK-NEXT:        (i32.add
;; CHECK-NEXT:         (local.get $0)
;; CHECK-NEXT:         (i32.const 10)
;; CHECK-NEXT:        )
;; CHECK-NEXT:       )
;; CHECK-NEXT:       (local.get $2)
;; CHECK-NEXT:      )
;; CHECK-NEXT:      (i32.const 0)
;; CHECK-NEXT:      (i32.const 0)
;; CHECK-NEXT:      (i32.const 0)
;; CHECK-NEXT:      (i32.const 0)
;; CHECK-NEXT:     )
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (local.get $1)
;; CHECK-NEXT:  )
;; CHECK-NEXT: )
(module
  ;; CHECK:      (type $sub (struct (field i32) (field i32)))
  (type $sub (struct (field i32) (field i32)))
  ;; CHECK:      (type $vt (struct (field i32) (field i32) (field (ref $sub)) (field i32) (field i32) (field i32) (field i32) (field i32)))
  (type $vt (struct (field i32) (field i32) (field (ref $sub)) (field i32) (field i32) (field i32) (field i32) (field i32)))
  ;; CHECK:      (type $obj (struct (field (ref $vt))))
