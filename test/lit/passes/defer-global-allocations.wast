;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: foreach %s %t wasm-opt --defer-global-allocations -all -S -o - | filecheck %s

;; String-like wrappers with a shared vtable and varying externref operands,
;; used only from code: they get an extern table, a cache, and a factory, with
;; indexes assigned in first-use order.
;;
;; $boxed is also used from another global's initializer and stays eager, as
;; does $exported. $hot has too many uses to be worth deferring, and $unused is
;; left alone.
(module
  ;; CHECK:      (type $vt (struct (field i32)))
  (type $vt (struct (field i32)))
  ;; CHECK:      (type $str (struct (field (ref $vt)) (field (mut i32)) (field externref)))
  (type $str (struct (field (ref $vt)) (field (mut i32)) (field externref)))
  ;; CHECK:      (type $2 (array (mut (ref null $str))))

  ;; CHECK:      (type $3 (array externref))

  ;; CHECK:      (type $box (struct (field (ref $str))))
  (type $box (struct (field (ref $str))))

  ;; CHECK:      (type $5 (func (param i32) (result (ref $str))))

  ;; CHECK:      (type $6 (func (result (ref $str))))

  ;; CHECK:      (import "env" "s0" (global $import0 externref))
  (import "env" "s0" (global $import0 externref))
  ;; CHECK:      (import "env" "s1" (global $import1 externref))
  (import "env" "s1" (global $import1 externref))
  ;; CHECK:      (import "env" "s2" (global $import2 externref))
  (import "env" "s2" (global $import2 externref))
  ;; CHECK:      (import "env" "s3" (global $import3 externref))
  (import "env" "s3" (global $import3 externref))
  ;; CHECK:      (import "env" "s4" (global $import4 externref))
  (import "env" "s4" (global $import4 externref))
  ;; CHECK:      (import "env" "s5" (global $import5 externref))
  (import "env" "s5" (global $import5 externref))
  ;; CHECK:      (import "env" "s6" (global $import6 externref))
  (import "env" "s6" (global $import6 externref))
  ;; CHECK:      (import "env" "s7" (global $import7 externref))
  (import "env" "s7" (global $import7 externref))
  ;; CHECK:      (import "env" "s8" (global $import8 externref))
  (import "env" "s8" (global $import8 externref))
  ;; CHECK:      (import "env" "s9" (global $import9 externref))
  (import "env" "s9" (global $import9 externref))
  ;; CHECK:      (import "env" "s10" (global $import10 externref))
  (import "env" "s10" (global $import10 externref))
  ;; CHECK:      (import "env" "s11" (global $import11 externref))
  (import "env" "s11" (global $import11 externref))

  ;; CHECK:      (global $vt (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (i32.const 42)
  ;; CHECK-NEXT: ))
  (global $vt (ref $vt) (struct.new $vt (i32.const 42)))

  (global $s0 (ref $str) (struct.new $str (global.get $vt) (i32.const 0) (global.get $import0)))
  (global $s1 (ref $str) (struct.new $str (global.get $vt) (i32.const 0) (global.get $import1)))
  (global $s2 (ref $str) (struct.new $str (global.get $vt) (i32.const 0) (global.get $import2)))
  (global $s3 (ref $str) (struct.new $str (global.get $vt) (i32.const 0) (global.get $import3)))
  (global $s4 (ref $str) (struct.new $str (global.get $vt) (i32.const 0) (global.get $import4)))
  (global $s5 (ref $str) (struct.new $str (global.get $vt) (i32.const 0) (global.get $import5)))
  (global $s6 (ref $str) (struct.new $str (global.get $vt) (i32.const 0) (global.get $import6)))
  (global $s7 (ref $str) (struct.new $str (global.get $vt) (i32.const 0) (global.get $import7)))
  (global $s8 (ref $str) (struct.new $str (global.get $vt) (i32.const 0) (global.get $import8)))
  (global $s9 (ref $str) (struct.new $str (global.get $vt) (i32.const 0) (global.get $import9)))
  ;; CHECK:      (global $boxed (ref $str) (struct.new $str
  ;; CHECK-NEXT:  (global.get $vt)
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT:  (global.get $import10)
  ;; CHECK-NEXT: ))
  (global $boxed (ref $str) (struct.new $str (global.get $vt) (i32.const 0) (global.get $import10)))
  ;; CHECK:      (global $exported (ref $str) (struct.new $str
  ;; CHECK-NEXT:  (global.get $vt)
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT:  (global.get $import11)
  ;; CHECK-NEXT: ))
  (global $exported (ref $str) (struct.new $str (global.get $vt) (i32.const 0) (global.get $import11)))
  ;; CHECK:      (global $hot (ref $str) (struct.new $str
  ;; CHECK-NEXT:  (global.get $vt)
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT:  (global.get $import0)
  ;; CHECK-NEXT: ))
  (global $hot (ref $str) (struct.new $str (global.get $vt) (i32.const 0) (global.get $import0)))
  ;; CHECK:      (global $unused (ref $str) (struct.new $str
  ;; CHECK-NEXT:  (global.get $vt)
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT:  (global.get $import1)
  ;; CHECK-NEXT: ))
  (global $unused (ref $str) (struct.new $str (global.get $vt) (i32.const 0) (global.get $import1)))

  ;; CHECK:      (global $box (ref $box) (struct.new $box
  ;; CHECK-NEXT:  (global.get $boxed)
  ;; CHECK-NEXT: ))
  (global $box (ref $box) (struct.new $box (global.get $boxed)))

  ;; CHECK:      (global $defer$str$cache (ref $2) (array.new_default $2
  ;; CHECK-NEXT:  (i32.const 10)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (global $defer$str$table$2 (ref $3) (array.new_fixed $3 10
  ;; CHECK-NEXT:  (global.get $import9)
  ;; CHECK-NEXT:  (global.get $import8)
  ;; CHECK-NEXT:  (global.get $import7)
  ;; CHECK-NEXT:  (global.get $import6)
  ;; CHECK-NEXT:  (global.get $import5)
  ;; CHECK-NEXT:  (global.get $import4)
  ;; CHECK-NEXT:  (global.get $import3)
  ;; CHECK-NEXT:  (global.get $import2)
  ;; CHECK-NEXT:  (global.get $import1)
  ;; CHECK-NEXT:  (global.get $import0)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (export "use" (func $use))

  ;; CHECK:      (export "use-again" (func $use-again))

  ;; CHECK:      (export "exported" (global $exported))
  (export "exported" (global $exported))

  ;; CHECK:      (func $use (type $5) (param $x i32) (result (ref $str))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$str
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$str
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$str
  ;; CHECK-NEXT:    (i32.const 2)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$str
  ;; CHECK-NEXT:    (i32.const 3)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$str
  ;; CHECK-NEXT:    (i32.const 4)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$str
  ;; CHECK-NEXT:    (i32.const 5)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$str
  ;; CHECK-NEXT:    (i32.const 6)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$str
  ;; CHECK-NEXT:    (i32.const 7)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$str
  ;; CHECK-NEXT:    (i32.const 8)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$str
  ;; CHECK-NEXT:    (i32.const 9)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $boxed)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $exported)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $hot)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $hot)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $hot)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $hot)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $hot)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $hot)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $hot)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $hot)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $hot)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (global.get $hot)
  ;; CHECK-NEXT: )
  (func $use (export "use") (param $x i32) (result (ref $str))
    (drop (global.get $s9))
    (drop (global.get $s8))
    (drop (global.get $s7))
    (drop (global.get $s6))
    (drop (global.get $s5))
    (drop (global.get $s4))
    (drop (global.get $s3))
    (drop (global.get $s2))
    (drop (global.get $s1))
    (drop (global.get $s0))
    (drop (global.get $boxed))
    (drop (global.get $exported))
    (drop (global.get $hot))
    (drop (global.get $hot))
    (drop (global.get $hot))
    (drop (global.get $hot))
    (drop (global.get $hot))
    (drop (global.get $hot))
    (drop (global.get $hot))
    (drop (global.get $hot))
    (drop (global.get $hot))
    (global.get $hot)
  )

  ;; CHECK:      (func $use-again (type $6) (result (ref $str))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$str
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $defer$str
  ;; CHECK-NEXT:   (i32.const 9)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $use-again (export "use-again") (result (ref $str))
    (drop (global.get $s9))
    (global.get $s0)
  )
)

;; A group whose members all agree gets no table columns: the factory just
;; allocates the same constants.
;; CHECK:      (func $defer$str (type $5) (param $0 i32) (result (ref $str))
;; CHECK-NEXT:  (local $1 (ref $str))
;; CHECK-NEXT:  (block $cached (result (ref $str))
;; CHECK-NEXT:   (br_on_non_null $cached
;; CHECK-NEXT:    (array.get $2
;; CHECK-NEXT:     (global.get $defer$str$cache)
;; CHECK-NEXT:     (local.get $0)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (array.set $2
;; CHECK-NEXT:    (global.get $defer$str$cache)
;; CHECK-NEXT:    (local.get $0)
;; CHECK-NEXT:    (local.tee $1
;; CHECK-NEXT:     (struct.new $str
;; CHECK-NEXT:      (global.get $vt)
;; CHECK-NEXT:      (i32.const 0)
;; CHECK-NEXT:      (array.get $3
;; CHECK-NEXT:       (global.get $defer$str$table$2)
;; CHECK-NEXT:       (local.get $0)
;; CHECK-NEXT:      )
;; CHECK-NEXT:     )
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (local.get $1)
;; CHECK-NEXT:  )
;; CHECK-NEXT: )
(module
  ;; CHECK:      (type $vt (struct (field i32)))
  (type $vt (struct (field i32)))
  ;; CHECK:      (type $class (struct (field (ref $vt)) (field (mut i32)) (field (ref null $class))))
  (type $class (struct (field (ref $vt)) (field (mut i32)) (field (ref null $class))))

  ;; CHECK:      (type $2 (func (result (ref $class))))

  ;; CHECK:      (type $3 (array (mut (ref null $class))))

  ;; CHECK:      (type $4 (func (param i32) (result (ref $class))))

  ;; CHECK:      (global $vt (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT: ))
  (global $vt (ref $vt) (struct.new $vt (i32.const 1)))

  (global $c0 (ref $class) (struct.new $class (global.get $vt) (i32.const 0) (ref.null none)))
  (global $c1 (ref $class) (struct.new $class (global.get $vt) (i32.const 0) (ref.null none)))
  (global $c2 (ref $class) (struct.new $class (global.get $vt) (i32.const 0) (ref.null none)))
  (global $c3 (ref $class) (struct.new $class (global.get $vt) (i32.const 0) (ref.null none)))
  (global $c4 (ref $class) (struct.new $class (global.get $vt) (i32.const 0) (ref.null none)))
  (global $c5 (ref $class) (struct.new $class (global.get $vt) (i32.const 0) (ref.null none)))
  (global $c6 (ref $class) (struct.new $class (global.get $vt) (i32.const 0) (ref.null none)))
  (global $c7 (ref $class) (struct.new $class (global.get $vt) (i32.const 0) (ref.null none)))
  (global $c8 (ref $class) (struct.new $class (global.get $vt) (i32.const 0) (ref.null none)))
  (global $c9 (ref $class) (struct.new $class (global.get $vt) (i32.const 0) (ref.null none)))

  ;; CHECK:      (global $defer$class$cache (ref $3) (array.new_default $3
  ;; CHECK-NEXT:  (i32.const 10)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (export "c0" (func $get-c0))

  ;; CHECK:      (export "c1" (func $get-c1))

  ;; CHECK:      (export "c2" (func $get-c2))

  ;; CHECK:      (export "c3" (func $get-c3))

  ;; CHECK:      (export "c4" (func $get-c4))

  ;; CHECK:      (export "c5" (func $get-c5))

  ;; CHECK:      (export "c6" (func $get-c6))

  ;; CHECK:      (export "c7" (func $get-c7))

  ;; CHECK:      (export "c8" (func $get-c8))

  ;; CHECK:      (export "c9" (func $get-c9))

  ;; CHECK:      (func $get-c0 (type $2) (result (ref $class))
  ;; CHECK-NEXT:  (call $defer$class
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $get-c0 (export "c0") (result (ref $class)) (global.get $c0))
  ;; CHECK:      (func $get-c1 (type $2) (result (ref $class))
  ;; CHECK-NEXT:  (call $defer$class
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $get-c1 (export "c1") (result (ref $class)) (global.get $c1))
  ;; CHECK:      (func $get-c2 (type $2) (result (ref $class))
  ;; CHECK-NEXT:  (call $defer$class
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $get-c2 (export "c2") (result (ref $class)) (global.get $c2))
  ;; CHECK:      (func $get-c3 (type $2) (result (ref $class))
  ;; CHECK-NEXT:  (call $defer$class
  ;; CHECK-NEXT:   (i32.const 3)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $get-c3 (export "c3") (result (ref $class)) (global.get $c3))
  ;; CHECK:      (func $get-c4 (type $2) (result (ref $class))
  ;; CHECK-NEXT:  (call $defer$class
  ;; CHECK-NEXT:   (i32.const 4)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $get-c4 (export "c4") (result (ref $class)) (global.get $c4))
  ;; CHECK:      (func $get-c5 (type $2) (result (ref $class))
  ;; CHECK-NEXT:  (call $defer$class
  ;; CHECK-NEXT:   (i32.const 5)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $get-c5 (export "c5") (result (ref $class)) (global.get $c5))
  ;; CHECK:      (func $get-c6 (type $2) (result (ref $class))
  ;; CHECK-NEXT:  (call $defer$class
  ;; CHECK-NEXT:   (i32.const 6)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $get-c6 (export "c6") (result (ref $class)) (global.get $c6))
  ;; CHECK:      (func $get-c7 (type $2) (result (ref $class))
  ;; CHECK-NEXT:  (call $defer$class
  ;; CHECK-NEXT:   (i32.const 7)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $get-c7 (export "c7") (result (ref $class)) (global.get $c7))
  ;; CHECK:      (func $get-c8 (type $2) (result (ref $class))
  ;; CHECK-NEXT:  (call $defer$class
  ;; CHECK-NEXT:   (i32.const 8)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $get-c8 (export "c8") (result (ref $class)) (global.get $c8))
  ;; CHECK:      (func $get-c9 (type $2) (result (ref $class))
  ;; CHECK-NEXT:  (call $defer$class
  ;; CHECK-NEXT:   (i32.const 9)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $get-c9 (export "c9") (result (ref $class)) (global.get $c9))
)

;; Too few members: the fixed overhead of a factory is not worth it.
;; CHECK:      (func $defer$class (type $4) (param $0 i32) (result (ref $class))
;; CHECK-NEXT:  (local $1 (ref $class))
;; CHECK-NEXT:  (block $cached (result (ref $class))
;; CHECK-NEXT:   (br_on_non_null $cached
;; CHECK-NEXT:    (array.get $3
;; CHECK-NEXT:     (global.get $defer$class$cache)
;; CHECK-NEXT:     (local.get $0)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (array.set $3
;; CHECK-NEXT:    (global.get $defer$class$cache)
;; CHECK-NEXT:    (local.get $0)
;; CHECK-NEXT:    (local.tee $1
;; CHECK-NEXT:     (struct.new $class
;; CHECK-NEXT:      (global.get $vt)
;; CHECK-NEXT:      (i32.const 0)
;; CHECK-NEXT:      (ref.null none)
;; CHECK-NEXT:     )
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (local.get $1)
;; CHECK-NEXT:  )
;; CHECK-NEXT: )
(module
  ;; CHECK:      (type $vt (struct (field i32)))
  (type $vt (struct (field i32)))
  ;; CHECK:      (type $str (struct (field (ref $vt)) (field (mut i32)) (field externref)))
  (type $str (struct (field (ref $vt)) (field (mut i32)) (field externref)))

  ;; CHECK:      (type $2 (func (result (ref $str))))

  ;; CHECK:      (import "env" "s0" (global $import0 externref))
  (import "env" "s0" (global $import0 externref))
  ;; CHECK:      (import "env" "s1" (global $import1 externref))
  (import "env" "s1" (global $import1 externref))

  ;; CHECK:      (global $vt (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (i32.const 42)
  ;; CHECK-NEXT: ))
  (global $vt (ref $vt) (struct.new $vt (i32.const 42)))

  ;; CHECK:      (global $s0 (ref $str) (struct.new $str
  ;; CHECK-NEXT:  (global.get $vt)
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT:  (global.get $import0)
  ;; CHECK-NEXT: ))
  (global $s0 (ref $str) (struct.new $str (global.get $vt) (i32.const 0) (global.get $import0)))
  ;; CHECK:      (global $s1 (ref $str) (struct.new $str
  ;; CHECK-NEXT:  (global.get $vt)
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT:  (global.get $import1)
  ;; CHECK-NEXT: ))
  (global $s1 (ref $str) (struct.new $str (global.get $vt) (i32.const 0) (global.get $import1)))

  ;; CHECK:      (export "use" (func $use))

  ;; CHECK:      (func $use (type $2) (result (ref $str))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $s0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (global.get $s1)
  ;; CHECK-NEXT: )
  (func $use (export "use") (result (ref $str))
    (drop (global.get $s0))
    (global.get $s1)
  )
)

;; Numeric i32 columns of sufficient size are narrowed into a passive data
;; segment (lazily loaded on first cache miss), and repeated non-externref
;; reference columns use a deduplicated palette global indexed by a u8 data
;; column.
(module
  ;; CHECK:      (type $vt (struct (field i32)))
  (type $vt (struct (field i32)))
  ;; CHECK:      (type $enum (struct (field (ref $vt)) (field (mut i32)) (field i32) (field i32)))
  (type $enum (struct (field (ref $vt)) (field (mut i32)) (field i32) (field i32)))

  ;; CHECK:      (type $2 (array (mut i8)))

  ;; CHECK:      (type $3 (array (mut (ref null $enum))))

  ;; CHECK:      (type $4 (array (ref $vt)))

  ;; CHECK:      (type $5 (array (mut i16)))

  ;; CHECK:      (type $6 (func (result (ref $enum))))

  ;; CHECK:      (type $7 (func (param i32) (result (ref $enum))))

  ;; CHECK:      (global $vt0 (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT: ))
  (global $vt0 (ref $vt) (struct.new $vt (i32.const 1)))
  ;; CHECK:      (global $vt1 (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (i32.const 2)
  ;; CHECK-NEXT: ))
  (global $vt1 (ref $vt) (struct.new $vt (i32.const 2)))

  (global $e0 (ref $enum) (struct.new $enum (global.get $vt0) (i32.const 0) (i32.const 10) (i32.const 300)))
  (global $e1 (ref $enum) (struct.new $enum (global.get $vt1) (i32.const 0) (i32.const 12) (i32.const -300)))
  (global $e2 (ref $enum) (struct.new $enum (global.get $vt0) (i32.const 0) (i32.const 14) (i32.const 300)))
  (global $e3 (ref $enum) (struct.new $enum (global.get $vt1) (i32.const 0) (i32.const 16) (i32.const -300)))
  (global $e4 (ref $enum) (struct.new $enum (global.get $vt0) (i32.const 0) (i32.const 18) (i32.const 300)))
  (global $e5 (ref $enum) (struct.new $enum (global.get $vt1) (i32.const 0) (i32.const 20) (i32.const -300)))
  (global $e6 (ref $enum) (struct.new $enum (global.get $vt0) (i32.const 0) (i32.const 22) (i32.const 300)))
  (global $e7 (ref $enum) (struct.new $enum (global.get $vt1) (i32.const 0) (i32.const 24) (i32.const -300)))
  (global $e8 (ref $enum) (struct.new $enum (global.get $vt0) (i32.const 0) (i32.const 26) (i32.const 300)))
  (global $e9 (ref $enum) (struct.new $enum (global.get $vt1) (i32.const 0) (i32.const 28) (i32.const -300)))
  (global $e10 (ref $enum) (struct.new $enum (global.get $vt0) (i32.const 0) (i32.const 10) (i32.const 300)))
  (global $e11 (ref $enum) (struct.new $enum (global.get $vt1) (i32.const 0) (i32.const 12) (i32.const -300)))
  (global $e12 (ref $enum) (struct.new $enum (global.get $vt0) (i32.const 0) (i32.const 14) (i32.const 300)))
  (global $e13 (ref $enum) (struct.new $enum (global.get $vt1) (i32.const 0) (i32.const 16) (i32.const -300)))
  (global $e14 (ref $enum) (struct.new $enum (global.get $vt0) (i32.const 0) (i32.const 18) (i32.const 300)))
  (global $e15 (ref $enum) (struct.new $enum (global.get $vt1) (i32.const 0) (i32.const 20) (i32.const -300)))
  (global $e16 (ref $enum) (struct.new $enum (global.get $vt0) (i32.const 0) (i32.const 22) (i32.const 300)))
  (global $e17 (ref $enum) (struct.new $enum (global.get $vt1) (i32.const 0) (i32.const 24) (i32.const -300)))
  (global $e18 (ref $enum) (struct.new $enum (global.get $vt0) (i32.const 0) (i32.const 26) (i32.const 300)))
  (global $e19 (ref $enum) (struct.new $enum (global.get $vt1) (i32.const 0) (i32.const 28) (i32.const -300)))

  ;; CHECK:      (global $defer$enum$cache (ref $3) (array.new_default $3
  ;; CHECK-NEXT:  (i32.const 20)
