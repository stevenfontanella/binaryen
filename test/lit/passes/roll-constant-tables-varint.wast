;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.
;; RUN: foreach %s %t wasm-opt --fuzz-exec --roll-constant-tables --pass-arg=roll-constant-tables-always@1 --pass-arg=roll-constant-tables-mode@varint -all -S -o - | filecheck %s
;; (--fuzz-exec fails the run if the decoded tables differ from the originals.)

;; The varint layout: per table a ULEB stream [n, per element (lo - previous
;; hi, hi - lo, cat)], decoded by a shared reader. The tables here are sorted
;; range tables with gaps 0, 1 and 300.
(module
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $Object (sub (struct (field (ref null $Object)))))
    (type $Object (sub (struct (field (ref null $Object)))))
    ;; CHECK:       (type $Ints (array (mut i32)))
    (type $Ints (array (mut i32)))
    ;; CHECK:       (type $Range (sub $Object (struct (field (ref null $Object)) (field (mut i32)) (field (ref null $Ints)))))
    (type $Range (sub $Object (struct (field (ref null $Object)) (field (mut i32)) (field (ref null $Ints)))))
    ;; CHECK:       (type $Elems (array (mut (ref null $Object))))
    (type $Elems (array (mut (ref null $Object))))
    ;; CHECK:       (type $Table (sub $Object (struct (field (ref null $Object)) (field (mut i32)) (field (ref null $Elems)))))
    (type $Table (sub $Object (struct (field (ref null $Object)) (field (mut i32)) (field (ref null $Elems)))))
  )

  ;; CHECK:      (type $5 (func (result i32)))

  ;; CHECK:      (type $6 (array (mut i8)))

  ;; CHECK:      (type $7 (array (mut (ref null $Table))))

  ;; CHECK:      (type $8 (array (mut i16)))

  ;; CHECK:      (type $9 (func (param i32 i32 i32) (result i32)))

  ;; CHECK:      (type $10 (func (param (ref $6)) (result i32)))

  ;; CHECK:      (type $11 (func (param i32) (result (ref $Table))))

  ;; CHECK:      (global $vt (ref null $Object) (ref.null none))
  (global $vt (ref null $Object) (ref.null none))

  (global $t0 (ref $Table) (struct.new $Table
    (global.get $vt)
    (i32.const 0)
    (array.new_fixed $Elems 4
      (struct.new $Range (global.get $vt) (i32.const 0) (array.new_fixed $Ints 3 (i32.const 200) (i32.const 205) (i32.const 1)))
      (struct.new $Range (global.get $vt) (i32.const 0) (array.new_fixed $Ints 3 (i32.const 206) (i32.const 209) (i32.const 1)))
      (struct.new $Range (global.get $vt) (i32.const 0) (array.new_fixed $Ints 3 (i32.const 211) (i32.const 700) (i32.const 200)))
      (struct.new $Range (global.get $vt) (i32.const 0) (array.new_fixed $Ints 3 (i32.const 801) (i32.const 1000) (i32.const 1)))
    )
  ))

  (global $t1 (ref $Table) (struct.new $Table
    (global.get $vt)
    (i32.const 0)
    (array.new_fixed $Elems 2
      (struct.new $Range (global.get $vt) (i32.const 0) (array.new_fixed $Ints 3 (i32.const 65536) (i32.const 65600) (i32.const 300)))
      (struct.new $Range (global.get $vt) (i32.const 0) (array.new_fixed $Ints 3 (i32.const 1114100) (i32.const 1114111) (i32.const 7)))
    )
  ))

  ;; CHECK:      (global $tables$pos (mut i32) (i32.const 0))

  ;; CHECK:      (global $tables$0$cache (ref $7) (array.new_default $7
  ;; CHECK-NEXT:  (i32.const 2)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (data $tables$0 "\06\00\17\00#\00\04\c8\01\05\01\01\03\01\02\e9\03\c8\01e\c7\01\01\02\80\80\04@\ac\02\b4\ff?\0b\07")

  ;; CHECK:      (export "get" (func $get))

  ;; CHECK:      (export "t0_3_lo" (func $t0_3_lo))

  ;; CHECK:      (export "t0_2_hi" (func $t0_2_hi))

  ;; CHECK:      (export "t1_1_lo" (func $t1_1_lo))

  ;; CHECK:      (export "t1_0_cat" (func $t1_0_cat))

  ;; CHECK:      (export "t0_identity" (func $t0_identity))

  ;; CHECK:      (func $get (type $9) (param $t i32) (param $i i32) (param $j i32) (result i32)
  ;; CHECK-NEXT:  (array.get $Ints
  ;; CHECK-NEXT:   (struct.get $Range 2
  ;; CHECK-NEXT:    (ref.cast (ref $Range)
  ;; CHECK-NEXT:     (array.get $Elems
  ;; CHECK-NEXT:      (struct.get $Table 2
  ;; CHECK-NEXT:       (select (result (ref $Table))
  ;; CHECK-NEXT:        (call $tables$0
  ;; CHECK-NEXT:         (i32.const 0)
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:        (call $tables$0
  ;; CHECK-NEXT:         (i32.const 1)
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:        (local.get $t)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (local.get $i)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (local.get $j)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $get (export "get") (param $t i32) (param $i i32) (param $j i32) (result i32)
    (array.get $Ints
      (struct.get $Range 2
        (ref.cast (ref $Range)
          (array.get $Elems
            (struct.get $Table 2
              (select (result (ref $Table))
                (global.get $t0)
                (global.get $t1)
                (local.get $t)
              )
            )
            (local.get $i)
          )
        )
      )
      (local.get $j)
    )
  )

  ;; CHECK:      (func $t0_3_lo (type $5) (result i32)
  ;; CHECK-NEXT:  (call $get
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (i32.const 3)
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $t0_3_lo (export "t0_3_lo") (result i32)
    (call $get (i32.const 1) (i32.const 3) (i32.const 0))
  )
  ;; CHECK:      (func $t0_2_hi (type $5) (result i32)
  ;; CHECK-NEXT:  (call $get
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $t0_2_hi (export "t0_2_hi") (result i32)
    (call $get (i32.const 1) (i32.const 2) (i32.const 1))
  )
  ;; CHECK:      (func $t1_1_lo (type $5) (result i32)
  ;; CHECK-NEXT:  (call $get
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $t1_1_lo (export "t1_1_lo") (result i32)
    (call $get (i32.const 0) (i32.const 1) (i32.const 0))
  )
  ;; CHECK:      (func $t1_0_cat (type $5) (result i32)
  ;; CHECK-NEXT:  (call $get
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $t1_0_cat (export "t1_0_cat") (result i32)
    (call $get (i32.const 0) (i32.const 0) (i32.const 2))
  )
  ;; CHECK:      (func $t0_identity (type $5) (result i32)
  ;; CHECK-NEXT:  (ref.eq
  ;; CHECK-NEXT:   (call $tables$0
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (call $tables$0
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $t0_identity (export "t0_identity") (result i32)
    (ref.eq (global.get $t0) (global.get $t0))
  )
)

;; Bare int arrays whose values jump up and down: the same-column delta needs
;; zigzag encoding, which pays off here against raw ULEBs (the values are
;; around 1000, the deltas small).
;; CHECK:      (func $tables$read (type $10) (param $0 (ref $6)) (result i32)
;; CHECK-NEXT:  (local $1 i32)
;; CHECK-NEXT:  (local $2 i32)
;; CHECK-NEXT:  (local $3 i32)
;; CHECK-NEXT:  (loop $read
;; CHECK-NEXT:   (local.set $3
;; CHECK-NEXT:    (array.get_u $6
;; CHECK-NEXT:     (local.get $0)
;; CHECK-NEXT:     (global.get $tables$pos)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (global.set $tables$pos
;; CHECK-NEXT:    (i32.add
;; CHECK-NEXT:     (global.get $tables$pos)
;; CHECK-NEXT:     (i32.const 1)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (local.set $1
;; CHECK-NEXT:    (i32.or
;; CHECK-NEXT:     (local.get $1)
;; CHECK-NEXT:     (i32.shl
;; CHECK-NEXT:      (i32.and
;; CHECK-NEXT:       (local.get $3)
;; CHECK-NEXT:       (i32.const 127)
;; CHECK-NEXT:      )
;; CHECK-NEXT:      (local.get $2)
;; CHECK-NEXT:     )
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (local.set $2
;; CHECK-NEXT:    (i32.add
;; CHECK-NEXT:     (local.get $2)
;; CHECK-NEXT:     (i32.const 7)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (br_if $read
;; CHECK-NEXT:    (i32.and
;; CHECK-NEXT:     (local.get $3)
;; CHECK-NEXT:     (i32.const 128)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:  )
;; CHECK-NEXT:  (local.get $1)
;; CHECK-NEXT: )

;; CHECK:      (func $tables$0 (type $11) (param $0 i32) (result (ref $Table))
;; CHECK-NEXT:  (local $1 i32)
;; CHECK-NEXT:  (local $2 i32)
;; CHECK-NEXT:  (local $3 i32)
;; CHECK-NEXT:  (local $4 (ref $8))
;; CHECK-NEXT:  (local $5 (ref $6))
;; CHECK-NEXT:  (local $6 i32)
;; CHECK-NEXT:  (local $7 i32)
;; CHECK-NEXT:  (local $8 i32)
;; CHECK-NEXT:  (local $9 (ref (exact $Elems)))
;; CHECK-NEXT:  (local $10 (ref $Table))
;; CHECK-NEXT:  (block $cached (result (ref $Table))
;; CHECK-NEXT:   (br_on_non_null $cached
;; CHECK-NEXT:    (array.get $7
;; CHECK-NEXT:     (global.get $tables$0$cache)
;; CHECK-NEXT:     (local.get $0)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (local.set $4
;; CHECK-NEXT:    (array.new_data $8 $tables$0
;; CHECK-NEXT:     (i32.const 0)
;; CHECK-NEXT:     (i32.const 3)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (local.set $1
;; CHECK-NEXT:    (array.get_u $8
;; CHECK-NEXT:     (local.get $4)
;; CHECK-NEXT:     (local.get $0)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (local.set $5
;; CHECK-NEXT:    (array.new_data $6 $tables$0
;; CHECK-NEXT:     (local.get $1)
;; CHECK-NEXT:     (i32.sub
;; CHECK-NEXT:      (array.get_u $8
;; CHECK-NEXT:       (local.get $4)
;; CHECK-NEXT:       (i32.add
;; CHECK-NEXT:        (local.get $0)
;; CHECK-NEXT:        (i32.const 1)
;; CHECK-NEXT:       )
;; CHECK-NEXT:      )
;; CHECK-NEXT:      (local.get $1)
;; CHECK-NEXT:     )
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (global.set $tables$pos
;; CHECK-NEXT:    (i32.const 0)
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (local.set $2
;; CHECK-NEXT:    (call $tables$read
;; CHECK-NEXT:     (local.get $5)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (local.set $9
;; CHECK-NEXT:    (array.new_default $Elems
;; CHECK-NEXT:     (local.get $2)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (loop $fill
;; CHECK-NEXT:    (local.set $6
;; CHECK-NEXT:     (i32.add
;; CHECK-NEXT:      (call $tables$read
;; CHECK-NEXT:       (local.get $5)
;; CHECK-NEXT:      )
;; CHECK-NEXT:      (local.get $7)
;; CHECK-NEXT:     )
;; CHECK-NEXT:    )
;; CHECK-NEXT:    (local.set $7
;; CHECK-NEXT:     (i32.add
;; CHECK-NEXT:      (call $tables$read
;; CHECK-NEXT:       (local.get $5)
;; CHECK-NEXT:      )
;; CHECK-NEXT:      (local.get $6)
;; CHECK-NEXT:     )
;; CHECK-NEXT:    )
;; CHECK-NEXT:    (local.set $8
;; CHECK-NEXT:     (call $tables$read
;; CHECK-NEXT:      (local.get $5)
;; CHECK-NEXT:     )
;; CHECK-NEXT:    )
;; CHECK-NEXT:    (array.set $Elems
;; CHECK-NEXT:     (local.get $9)
;; CHECK-NEXT:     (local.get $3)
;; CHECK-NEXT:     (struct.new $Range
;; CHECK-NEXT:      (global.get $vt)
;; CHECK-NEXT:      (i32.const 0)
;; CHECK-NEXT:      (array.new_fixed $Ints 3
;; CHECK-NEXT:       (local.get $6)
;; CHECK-NEXT:       (local.get $7)
;; CHECK-NEXT:       (local.get $8)
;; CHECK-NEXT:      )
;; CHECK-NEXT:     )
;; CHECK-NEXT:    )
;; CHECK-NEXT:    (br_if $fill
;; CHECK-NEXT:     (i32.lt_u
;; CHECK-NEXT:      (local.tee $3
;; CHECK-NEXT:       (i32.add
;; CHECK-NEXT:        (local.get $3)
;; CHECK-NEXT:        (i32.const 1)
;; CHECK-NEXT:       )
;; CHECK-NEXT:      )
;; CHECK-NEXT:      (local.get $2)
;; CHECK-NEXT:     )
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (array.set $7
;; CHECK-NEXT:    (global.get $tables$0$cache)
;; CHECK-NEXT:    (local.get $0)
;; CHECK-NEXT:    (local.tee $10
;; CHECK-NEXT:     (struct.new $Table
;; CHECK-NEXT:      (global.get $vt)
;; CHECK-NEXT:      (i32.const 0)
;; CHECK-NEXT:      (local.get $9)
;; CHECK-NEXT:     )
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (local.get $10)
;; CHECK-NEXT:  )
;; CHECK-NEXT: )
(module
  ;; CHECK:      (type $Ints (array (mut i32)))
  (type $Ints (array (mut i32)))

  (global $a (ref $Ints) (array.new_fixed $Ints 24
    (i32.const 1000) (i32.const 1010) (i32.const 990) (i32.const 1005)
    (i32.const 1000) (i32.const 1010) (i32.const 990) (i32.const 1005)
    (i32.const 1000) (i32.const 1010) (i32.const 990) (i32.const 1005)
    (i32.const 1000) (i32.const 1010) (i32.const 990) (i32.const 1005)
    (i32.const 1000) (i32.const 1010) (i32.const 990) (i32.const 1005)
    (i32.const 1000) (i32.const 1010) (i32.const 990) (i32.const 1005)
  ))

  (global $b (ref $Ints) (array.new_fixed $Ints 3
    (i32.const 2000) (i32.const 1990) (i32.const 2001)
  ))

  ;; CHECK:      (type $1 (array (mut i8)))

  ;; CHECK:      (type $2 (array (mut (ref null $Ints))))

  ;; CHECK:      (type $3 (func (result i32)))

  ;; CHECK:      (type $4 (array (mut i16)))

  ;; CHECK:      (type $5 (func (param i32 i32) (result i32)))

  ;; CHECK:      (type $6 (func (param (ref $1)) (result i32)))

  ;; CHECK:      (type $7 (func (param i32) (result (ref $Ints))))

  ;; CHECK:      (global $tables$pos (mut i32) (i32.const 0))

  ;; CHECK:      (global $tables$0$cache (ref $2) (array.new_default $2
  ;; CHECK-NEXT:  (i32.const 2)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (data $tables$0 "\06\00 \00%\00\18\d0\0f\14\'\1e\t\14\'\1e\t\14\'\1e\t\14\'\1e\t\14\'\1e\t\14\'\1e\03\a0\1f\13\16")

  ;; CHECK:      (export "get" (func $get))

  ;; CHECK:      (export "a_2" (func $a_2))

  ;; CHECK:      (export "a_23" (func $a_23))

  ;; CHECK:      (export "b_1" (func $b_1))

  ;; CHECK:      (export "b_2" (func $b_2))

  ;; CHECK:      (func $get (type $5) (param $t i32) (param $i i32) (result i32)
  ;; CHECK-NEXT:  (array.get $Ints
  ;; CHECK-NEXT:   (select (result (ref $Ints))
  ;; CHECK-NEXT:    (call $tables$0
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (call $tables$0
  ;; CHECK-NEXT:     (i32.const 1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.get $t)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (local.get $i)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $get (export "get") (param $t i32) (param $i i32) (result i32)
    (array.get $Ints
      (select (result (ref $Ints))
        (global.get $a)
        (global.get $b)
        (local.get $t)
      )
      (local.get $i)
    )
  )

  ;; CHECK:      (func $a_2 (type $3) (result i32)
  ;; CHECK-NEXT:  (call $get
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $a_2 (export "a_2") (result i32)
    (call $get (i32.const 1) (i32.const 2))
  )
  ;; CHECK:      (func $a_23 (type $3) (result i32)
  ;; CHECK-NEXT:  (call $get
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (i32.const 23)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $a_23 (export "a_23") (result i32)
    (call $get (i32.const 1) (i32.const 23))
  )
  ;; CHECK:      (func $b_1 (type $3) (result i32)
  ;; CHECK-NEXT:  (call $get
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $b_1 (export "b_1") (result i32)
    (call $get (i32.const 0) (i32.const 1))
  )
  ;; CHECK:      (func $b_2 (type $3) (result i32)
  ;; CHECK-NEXT:  (call $get
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $b_2 (export "b_2") (result i32)
    (call $get (i32.const 0) (i32.const 2))
  )
)

;; A varying f64 leaf: the varint layout does not apply, the fixed layout is
;; used even though it is requested.
;; CHECK:      (func $tables$read (type $6) (param $0 (ref $1)) (result i32)
;; CHECK-NEXT:  (local $1 i32)
;; CHECK-NEXT:  (local $2 i32)
;; CHECK-NEXT:  (local $3 i32)
;; CHECK-NEXT:  (loop $read
;; CHECK-NEXT:   (local.set $3
;; CHECK-NEXT:    (array.get_u $1
;; CHECK-NEXT:     (local.get $0)
;; CHECK-NEXT:     (global.get $tables$pos)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (global.set $tables$pos
;; CHECK-NEXT:    (i32.add
;; CHECK-NEXT:     (global.get $tables$pos)
;; CHECK-NEXT:     (i32.const 1)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (local.set $1
;; CHECK-NEXT:    (i32.or
;; CHECK-NEXT:     (local.get $1)
;; CHECK-NEXT:     (i32.shl
;; CHECK-NEXT:      (i32.and
;; CHECK-NEXT:       (local.get $3)
;; CHECK-NEXT:       (i32.const 127)
;; CHECK-NEXT:      )
;; CHECK-NEXT:      (local.get $2)
;; CHECK-NEXT:     )
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (local.set $2
;; CHECK-NEXT:    (i32.add
;; CHECK-NEXT:     (local.get $2)
;; CHECK-NEXT:     (i32.const 7)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (br_if $read
;; CHECK-NEXT:    (i32.and
;; CHECK-NEXT:     (local.get $3)
;; CHECK-NEXT:     (i32.const 128)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:  )
;; CHECK-NEXT:  (local.get $1)
;; CHECK-NEXT: )

