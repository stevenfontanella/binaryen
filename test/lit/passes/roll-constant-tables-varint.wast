  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $use (export "use") (result f64)
    (struct.get $Pair 1 (array.get $Pairs (global.get $p) (i32.const 1)))
  )
)
