(module
  ;; CHECK:      (type $Pair (struct (field i32) (field f64)))
  (type $Pair (struct (field i32) (field f64)))
  ;; CHECK:      (type $Pairs (array (mut (ref null $Pair))))
  (type $Pairs (array (mut (ref null $Pair))))

  (global $p (ref $Pairs) (array.new_fixed $Pairs 2
    (struct.new $Pair (i32.const 1) (f64.const 1.5))
    (struct.new $Pair (i32.const 2) (f64.const 2.5))
  ))

  ;; CHECK:      (type $2 (array (mut (ref null $Pairs))))

  ;; CHECK:      (type $3 (array (mut i16)))

  ;; CHECK:      (type $4 (array (mut i8)))

  ;; CHECK:      (type $5 (array (mut f64)))

