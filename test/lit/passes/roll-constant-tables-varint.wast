  ;; CHECK-NEXT: ))

  ;; CHECK:      (data $tables$0 "\00\00\02\00\01\02\00\00\00\00\00\00\f8?\00\00\00\00\00\00\04@")

  ;; CHECK:      (export "use" (func $use))

