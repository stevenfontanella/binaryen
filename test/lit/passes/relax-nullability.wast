  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:   (local.get $y)
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT: )
  (func $unsub-a (param $p (ref null $UnsubA)) (param $y i32) (result i32)
    (i32.add
      (struct.get $UnsubA 0
        (local.get $p)
      )
      (local.get $y)
    )
  )

  ;; CHECK:      (func $unsub-b (type $4) (param $p anyref) (param $y i32) (result i32)
  ;; CHECK-NEXT:  (i32.add
