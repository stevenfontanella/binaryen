;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: foreach %s %t wasm-opt -all --closed-world --traps-never-happen --relax-nullability -S -o - | filecheck %s
;; RUN: foreach %s %t wasm-opt -all --closed-world --relax-nullability -S -o - | filecheck %s --check-prefix=NO_TNH

(module
  ;; CHECK:      (type $A (struct (field (mut i32))))
  ;; NO_TNH:      (type $A (struct (field (mut i32))))
  (type $A (struct (field (mut i32))))
  ;; CHECK:      (type $pub (func (param (ref $A)) (result i32)))

  ;; CHECK:      (rec
  ;; CHECK-NEXT:  (type $2 (func (param (ref null $A) i32)))

  ;; CHECK:       (type $3 (func (param (ref null $A))))

  ;; CHECK:       (type $4 (func (param (ref null $A) (ref null $sig)) (result (ref $A))))

  ;; CHECK:       (type $sig (func (param (ref null $A)) (result (ref $A))))

  ;; CHECK:       (type $B (struct (field (ref $A))))
  ;; NO_TNH:      (type $sig (func (param (ref $A)) (result (ref $A))))

  ;; NO_TNH:      (type $pub (func (param (ref $A)) (result i32)))

  ;; NO_TNH:      (type $3 (func (param (ref null $A)) (result i32)))

  ;; NO_TNH:      (type $B (struct (field (ref $A))))
  (type $B (struct (field (ref $A))))
  (type $sig (func (param (ref $A)) (result (ref $A))))
  (type $pub (func (param (ref $A)) (result i32)))

  ;; CHECK:       (type $7 (func (param (ref null $A)) (result (ref $A))))

  ;; CHECK:       (type $8 (func (param (ref null $A)) (result i32)))

  ;; CHECK:       (type $9 (func (param (ref null $A) i32) (result i32)))

  ;; CHECK:       (type $10 (func (param (ref $A))))

  ;; CHECK:      (import "env" "import" (func $import (type $pub) (param (ref $A)) (result i32)))
  ;; NO_TNH:      (type $5 (func (param (ref $A))))

  ;; NO_TNH:      (type $6 (func (param (ref $A) i32) (result i32)))

  ;; NO_TNH:      (type $7 (func (param (ref null $A)) (result (ref $A))))

  ;; NO_TNH:      (type $8 (func (param (ref null $A) (ref $sig)) (result (ref $A))))

  ;; NO_TNH:      (type $9 (func (param (ref null $A))))

  ;; NO_TNH:      (type $10 (func (param (ref null $A) i32)))

  ;; NO_TNH:      (import "env" "import" (func $import (type $pub) (param (ref $A)) (result i32)))
  (import "env" "import" (func $import (param (ref $A)) (result i32)))

  ;; CHECK:      (global $g (mut (ref null $A)) (ref.null none))
  ;; NO_TNH:      (global $g (mut (ref null $A)) (ref.null none))
  (global $g (mut (ref null $A)) (ref.null $A))
  ;; CHECK:      (global $gnn (mut (ref $A)) (struct.new $A
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT: ))
  ;; NO_TNH:      (global $gnn (mut (ref $A)) (struct.new $A
  ;; NO_TNH-NEXT:  (i32.const 0)
  ;; NO_TNH-NEXT: ))
  (global $gnn (mut (ref $A)) (struct.new $A (i32.const 0)))

  ;; CHECK:      (tag $tag (type $10) (param (ref $A)))
  ;; NO_TNH:      (tag $tag (type $5) (param (ref $A)))
  (tag $tag (param (ref $A)))

  ;; Private callee: the param becomes nullable. The struct.get on it accepts a
  ;; nullable ref, so no cast is needed inside.
  ;; CHECK:      (export "exported" (func $exported))

  ;; CHECK:      (func $callee (type $9) (param $a (ref null $A)) (param $i i32) (result i32)
  ;; CHECK-NEXT:  (struct.get $A 0
  ;; CHECK-NEXT:   (local.get $a)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; NO_TNH:      (export "exported" (func $exported))

  ;; NO_TNH:      (func $callee (type $6) (param $a (ref $A)) (param $i i32) (result i32)
  ;; NO_TNH-NEXT:  (struct.get $A 0
  ;; NO_TNH-NEXT:   (local.get $a)
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT: )
  (func $callee (param $a (ref $A)) (param $i i32) (result i32)
    (struct.get $A 0
      (local.get $a)
    )
  )

  ;; The arg cast to the private callee is removed; the arg cast to the import
  ;; is kept (its type is public).
  ;; CHECK:      (func $caller (type $8) (param $a (ref null $A)) (result i32)
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (call $callee
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (call $import
  ;; CHECK-NEXT:    (ref.as_non_null
  ;; CHECK-NEXT:     (local.get $a)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; NO_TNH:      (func $caller (type $3) (param $a (ref null $A)) (result i32)
  ;; NO_TNH-NEXT:  (i32.add
  ;; NO_TNH-NEXT:   (call $callee
  ;; NO_TNH-NEXT:    (ref.as_non_null
  ;; NO_TNH-NEXT:     (local.get $a)
  ;; NO_TNH-NEXT:    )
  ;; NO_TNH-NEXT:    (i32.const 0)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:   (call $import
  ;; NO_TNH-NEXT:    (ref.as_non_null
  ;; NO_TNH-NEXT:     (local.get $a)
  ;; NO_TNH-NEXT:    )
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT: )
  (func $caller (param $a (ref null $A)) (result i32)
    (i32.add
      (call $callee
        (ref.as_non_null
          (local.get $a)
        )
        (i32.const 0)
      )
      (call $import
        (ref.as_non_null
          (local.get $a)
        )
      )
    )
  )

  ;; A non-nullable local becomes nullable; the copy through a cast becomes a
  ;; plain copy (that coalesce-locals can remove later). The struct.new operand
  ;; and the global.set of a non-nullable global demand non-null values, so
  ;; casts are inserted there. The explicit and implicit returns of a
  ;; non-nullable result get casts too.
  ;; CHECK:      (func $locals (type $7) (param $a (ref null $A)) (result (ref $A))
  ;; CHECK-NEXT:  (local $b (ref null $A))
  ;; CHECK-NEXT:  (local $c (ref null $A))
  ;; CHECK-NEXT:  (ref.as_non_null
  ;; CHECK-NEXT:   (block (result (ref null $A))
  ;; CHECK-NEXT:    (local.set $b
  ;; CHECK-NEXT:     (local.get $a)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $c
  ;; CHECK-NEXT:     (local.get $b)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (struct.new $B
  ;; CHECK-NEXT:      (ref.as_non_null
  ;; CHECK-NEXT:       (local.get $c)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (global.set $gnn
  ;; CHECK-NEXT:     (ref.as_non_null
  ;; CHECK-NEXT:      (local.get $b)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (global.set $g
  ;; CHECK-NEXT:     (local.get $b)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (if
  ;; CHECK-NEXT:     (struct.get $A 0
  ;; CHECK-NEXT:      (local.get $c)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (then
  ;; CHECK-NEXT:      (return
  ;; CHECK-NEXT:       (ref.as_non_null
  ;; CHECK-NEXT:        (local.get $c)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.get $b)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; NO_TNH:      (func $locals (type $7) (param $a (ref null $A)) (result (ref $A))
  ;; NO_TNH-NEXT:  (local $b (ref $A))
  ;; NO_TNH-NEXT:  (local $c (ref $A))
  ;; NO_TNH-NEXT:  (local.set $b
  ;; NO_TNH-NEXT:   (ref.as_non_null
  ;; NO_TNH-NEXT:    (local.get $a)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (local.set $c
  ;; NO_TNH-NEXT:   (local.get $b)
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (drop
  ;; NO_TNH-NEXT:   (struct.new $B
  ;; NO_TNH-NEXT:    (local.get $c)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (global.set $gnn
  ;; NO_TNH-NEXT:   (local.get $b)
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (global.set $g
  ;; NO_TNH-NEXT:   (local.get $b)
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (if
  ;; NO_TNH-NEXT:   (struct.get $A 0
  ;; NO_TNH-NEXT:    (local.get $c)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:   (then
  ;; NO_TNH-NEXT:    (return
  ;; NO_TNH-NEXT:     (local.get $c)
  ;; NO_TNH-NEXT:    )
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (local.get $b)
  ;; NO_TNH-NEXT: )
  (func $locals (param $a (ref null $A)) (result (ref $A))
    (local $b (ref $A))
    (local $c (ref $A))
    (local.set $b
      (ref.as_non_null
        (local.get $a)
      )
    )
    (local.set $c
      (local.get $b)
    )
    (drop
      (struct.new $B
        (local.get $c)
      )
    )
    (global.set $gnn
      (local.get $b)
    )
    (global.set $g
      (local.get $b)
    )
    (if
      (struct.get $A 0
        (local.get $c)
      )
      (then
        (return
          (local.get $c)
        )
      )
    )
    (local.get $b)
  )

  ;; A function whose type is used by a call_ref: the signature is rewritten
  ;; for both the function and the call_ref, whose arg cast goes away. The
  ;; result stays non-nullable, so the body gets a cast.
  ;; CHECK:      (func $indirect (type $sig) (param $a (ref null $A)) (result (ref $A))
  ;; CHECK-NEXT:  (ref.as_non_null
  ;; CHECK-NEXT:   (local.get $a)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; NO_TNH:      (func $indirect (type $sig) (param $a (ref $A)) (result (ref $A))
  ;; NO_TNH-NEXT:  (local.get $a)
  ;; NO_TNH-NEXT: )
  (func $indirect (type $sig) (param $a (ref $A)) (result (ref $A))
    (local.get $a)
  )

  ;; CHECK:      (func $call-indirect (type $4) (param $a (ref null $A)) (param $f (ref null $sig)) (result (ref $A))
  ;; CHECK-NEXT:  (call_ref $sig
  ;; CHECK-NEXT:   (local.get $a)
  ;; CHECK-NEXT:   (local.get $f)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; NO_TNH:      (func $call-indirect (type $8) (param $a (ref null $A)) (param $f (ref $sig)) (result (ref $A))
  ;; NO_TNH-NEXT:  (call_ref $sig
  ;; NO_TNH-NEXT:   (ref.as_non_null
  ;; NO_TNH-NEXT:    (local.get $a)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:   (local.get $f)
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT: )
  (func $call-indirect (param $a (ref null $A)) (param $f (ref $sig)) (result (ref $A))
    (call_ref $sig
      (ref.as_non_null
        (local.get $a)
      )
      (local.get $f)
    )
  )

  ;; Exported function: the signature is public and must not change, but its
  ;; locals still relax.
  ;; CHECK:      (func $exported (type $pub) (param $a (ref $A)) (result i32)
  ;; CHECK-NEXT:  (local $t (ref null $A))
  ;; CHECK-NEXT:  (local.set $t
  ;; CHECK-NEXT:   (local.get $a)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (struct.get $A 0
  ;; CHECK-NEXT:   (local.get $t)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; NO_TNH:      (func $exported (type $pub) (param $a (ref $A)) (result i32)
  ;; NO_TNH-NEXT:  (local $t (ref $A))
  ;; NO_TNH-NEXT:  (local.set $t
  ;; NO_TNH-NEXT:   (local.get $a)
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (struct.get $A 0
  ;; NO_TNH-NEXT:   (local.get $t)
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT: )
  (func $exported (export "exported") (type $pub) (param $a (ref $A)) (result i32)
    (local $t (ref $A))
    (local.set $t
      (local.get $a)
    )
    (struct.get $A 0
      (local.get $t)
    )
  )

  ;; Tag types are not changed; the throw operand demands a non-null value.
  ;; CHECK:      (func $thrower (type $3) (param $a (ref null $A))
  ;; CHECK-NEXT:  (throw $tag
  ;; CHECK-NEXT:   (ref.as_non_null
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; NO_TNH:      (func $thrower (type $9) (param $a (ref null $A))
  ;; NO_TNH-NEXT:  (throw $tag
  ;; NO_TNH-NEXT:   (ref.as_non_null
  ;; NO_TNH-NEXT:    (local.get $a)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT: )
  (func $thrower (param $a (ref null $A))
    (throw $tag
      (ref.as_non_null
        (local.get $a)
      )
    )
  )

  ;; Casts whose value is already non-nullable are dropped where allowed, and
  ;; a nested chain of casts is removed entirely.
  ;; CHECK:      (func $chain (type $8) (param $a (ref null $A)) (result i32)
  ;; CHECK-NEXT:  (local $b (ref null $A))
  ;; CHECK-NEXT:  (local.set $b
  ;; CHECK-NEXT:   (local.get $a)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $callee
  ;; CHECK-NEXT:   (local.get $b)
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; NO_TNH:      (func $chain (type $3) (param $a (ref null $A)) (result i32)
  ;; NO_TNH-NEXT:  (local $b (ref $A))
  ;; NO_TNH-NEXT:  (local.set $b
  ;; NO_TNH-NEXT:   (ref.as_non_null
  ;; NO_TNH-NEXT:    (ref.as_non_null
  ;; NO_TNH-NEXT:     (local.get $a)
  ;; NO_TNH-NEXT:    )
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (call $callee
  ;; NO_TNH-NEXT:   (ref.as_non_null
  ;; NO_TNH-NEXT:    (local.get $b)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:   (i32.const 1)
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT: )
  (func $chain (param $a (ref null $A)) (result i32)
    (local $b (ref $A))
    (local.set $b
      (ref.as_non_null
        (ref.as_non_null
          (local.get $a)
        )
      )
    )
    (call $callee
      (ref.as_non_null
        (local.get $b)
      )
      (i32.const 1)
    )
  )

  ;; Values flowing through control flow: the if's type becomes nullable and
  ;; the demanding consumer gets a single cast on the outside.
  ;; CHECK:      (func $flow (type $2) (param $a (ref null $A)) (param $x i32)
  ;; CHECK-NEXT:  (local $b (ref null $A))
  ;; CHECK-NEXT:  (local.set $b
  ;; CHECK-NEXT:   (local.get $a)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (struct.new $B
  ;; CHECK-NEXT:    (ref.as_non_null
  ;; CHECK-NEXT:     (if (result (ref null $A))
  ;; CHECK-NEXT:      (local.get $x)
  ;; CHECK-NEXT:      (then
  ;; CHECK-NEXT:       (local.get $b)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (else
  ;; CHECK-NEXT:       (struct.new $A
  ;; CHECK-NEXT:        (i32.const 1)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; NO_TNH:      (func $flow (type $10) (param $a (ref null $A)) (param $x i32)
  ;; NO_TNH-NEXT:  (local $b (ref $A))
  ;; NO_TNH-NEXT:  (local.set $b
  ;; NO_TNH-NEXT:   (ref.as_non_null
  ;; NO_TNH-NEXT:    (local.get $a)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (drop
  ;; NO_TNH-NEXT:   (struct.new $B
  ;; NO_TNH-NEXT:    (if (result (ref $A))
  ;; NO_TNH-NEXT:     (local.get $x)
  ;; NO_TNH-NEXT:     (then
  ;; NO_TNH-NEXT:      (local.get $b)
  ;; NO_TNH-NEXT:     )
  ;; NO_TNH-NEXT:     (else
  ;; NO_TNH-NEXT:      (struct.new $A
  ;; NO_TNH-NEXT:       (i32.const 1)
  ;; NO_TNH-NEXT:      )
  ;; NO_TNH-NEXT:     )
  ;; NO_TNH-NEXT:    )
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT: )
  (func $flow (param $a (ref null $A)) (param $x i32)
    (local $b (ref $A))
    (local.set $b
      (ref.as_non_null
        (local.get $a)
      )
    )
    (drop
      (struct.new $B
        (if (result (ref $A))
          (local.get $x)
          (then
            (local.get $b)
          )
          (else
            (struct.new $A
              (i32.const 1)
            )
          )
        )
      )
    )
  )
)

(module
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $Base (sub (struct (field (mut i32)))))
    ;; NO_TNH:      (rec
    ;; NO_TNH-NEXT:  (type $Base (sub (struct (field (mut i32)))))
    (type $Base (sub (struct (field (mut i32)))))
    ;; CHECK:       (type $Mid (sub $Base (struct (field (mut i32)) (field i64))))
    ;; NO_TNH:       (type $Mid (sub $Base (struct (field (mut i32)) (field i64))))
    (type $Mid (sub $Base (struct (field (mut i32)) (field i64))))
    ;; CHECK:       (type $Holder (struct (field (ref $Base))))

    ;; CHECK:       (type $3 (func (param (ref null $Base) (ref null $Base)) (result (ref $Base))))

    ;; CHECK:       (type $4 (func (param (ref null $Mid) (ref null $Base)) (result i64)))

    ;; CHECK:       (type $5 (func (param (ref null $Base)) (result i32)))

    ;; CHECK:       (type $Sub (sub $Mid (struct (field (mut i32)) (field i64) (field f32))))
    ;; NO_TNH:       (type $Sub (sub $Mid (struct (field (mut i32)) (field i64) (field f32))))
    (type $Sub (sub $Mid (struct (field (mut i32)) (field i64) (field f32))))
    ;; NO_TNH:       (type $Holder (struct (field (ref $Base))))
    (type $Holder (struct (field (ref $Base))))
  )

  ;; Private signature parameter $p is only used for field 0 (defined on $Base),
  ;; so $p widens from (ref $Sub) to (ref null $Base) and the struct.get
  ;; canonicalizes to $Base.
  ;; CHECK:       (type $7 (func (param (ref null $Base)) (result i32)))

  ;; CHECK:      (func $read-base-field (type $7) (param $p (ref null $Base)) (result i32)
  ;; CHECK-NEXT:  (struct.get $Base 0
  ;; CHECK-NEXT:   (local.get $p)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; NO_TNH:      (type $4 (func (param (ref $Sub)) (result i32)))

  ;; NO_TNH:      (type $5 (func (param (ref null $Base)) (result i32)))

  ;; NO_TNH:      (type $6 (func (param (ref $Sub) (ref null $Mid)) (result i64)))

  ;; NO_TNH:      (type $7 (func (param (ref null $Base) (ref null $Mid)) (result (ref $Base))))

  ;; NO_TNH:      (func $read-base-field (type $4) (param $p (ref $Sub)) (result i32)
  ;; NO_TNH-NEXT:  (struct.get $Sub 0
  ;; NO_TNH-NEXT:   (local.get $p)
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT: )
  (func $read-base-field (param $p (ref $Sub)) (result i32)
    (struct.get $Sub 0
      (local.get $p)
    )
  )

  ;; Caller's ref.cast to $Sub is redundant once $read-base-field widens its
  ;; parameter to (ref null $Base); body local $l also widens from (ref $Sub)
  ;; to (ref null $Base).
  ;; CHECK:      (func $bridge-caller (type $5) (param $x (ref null $Base)) (result i32)
  ;; CHECK-NEXT:  (local $l (ref null $Base))
  ;; CHECK-NEXT:  (local.set $l
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $read-base-field
  ;; CHECK-NEXT:   (local.get $l)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; NO_TNH:      (func $bridge-caller (type $5) (param $x (ref null $Base)) (result i32)
  ;; NO_TNH-NEXT:  (local $l (ref $Sub))
  ;; NO_TNH-NEXT:  (local.set $l
  ;; NO_TNH-NEXT:   (ref.cast (ref $Sub)
  ;; NO_TNH-NEXT:    (local.get $x)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (call $read-base-field
  ;; NO_TNH-NEXT:   (ref.cast (ref $Sub)
  ;; NO_TNH-NEXT:    (local.get $l)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT: )
  (func $bridge-caller (param $x (ref null $Base)) (result i32)
    (local $l (ref $Sub))
    (local.set $l
      (ref.cast (ref $Sub)
        (local.get $x)
      )
    )
    (call $read-base-field
      (ref.cast (ref $Sub)
        (local.get $l)
      )
    )
  )

  ;; Field 1 is introduced on $Mid, so $p widens from (ref $Sub) to
  ;; (ref null $Mid) (not $Base), and a ref.cast from $Mid to $Sub is stripped.
  ;; CHECK:      (func $write-mid-field (type $4) (param $p (ref null $Mid)) (param $m (ref null $Base)) (result i64)
  ;; CHECK-NEXT:  (struct.set $Base 0
  ;; CHECK-NEXT:   (local.get $m)
  ;; CHECK-NEXT:   (i32.const 42)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (struct.get $Mid 1
  ;; CHECK-NEXT:   (local.get $p)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; NO_TNH:      (func $write-mid-field (type $6) (param $p (ref $Sub)) (param $m (ref null $Mid)) (result i64)
  ;; NO_TNH-NEXT:  (struct.set $Sub 0
  ;; NO_TNH-NEXT:   (ref.cast (ref null $Sub)
  ;; NO_TNH-NEXT:    (local.get $m)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:   (i32.const 42)
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (struct.get $Sub 1
  ;; NO_TNH-NEXT:   (local.get $p)
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT: )
  (func $write-mid-field (param $p (ref $Sub)) (param $m (ref null $Mid)) (result i64)
    (struct.set $Sub 0
      (ref.cast (ref null $Sub)
        (local.get $m)
      )
      (i32.const 42)
    )
    (struct.get $Sub 1
      (local.get $p)
    )
  )

  ;; Non-nullable parent demand (struct.new $Holder expects (ref $Base)) strips
  ;; ref.cast (ref $Sub) on a nullable $Base and replaces it with ref.as_non_null.
  ;; Also strips redundant ref.cast in ref.is_null, ref.eq, drop, and return.
  ;; CHECK:      (func $strip-casts (type $3) (param $x (ref null $Base)) (param $y (ref null $Base)) (result (ref $Base))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (ref.is_null
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (ref.eq
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:    (local.get $y)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (struct.new $Holder
  ;; CHECK-NEXT:    (ref.as_non_null
  ;; CHECK-NEXT:     (local.get $x)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (ref.as_non_null
  ;; CHECK-NEXT:   (local.get $y)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; NO_TNH:      (func $strip-casts (type $7) (param $x (ref null $Base)) (param $y (ref null $Mid)) (result (ref $Base))
  ;; NO_TNH-NEXT:  (drop
  ;; NO_TNH-NEXT:   (ref.cast (ref null $Sub)
  ;; NO_TNH-NEXT:    (local.get $x)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (drop
  ;; NO_TNH-NEXT:   (ref.is_null
  ;; NO_TNH-NEXT:    (ref.cast (ref null $Sub)
  ;; NO_TNH-NEXT:     (local.get $x)
  ;; NO_TNH-NEXT:    )
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (drop
  ;; NO_TNH-NEXT:   (ref.eq
  ;; NO_TNH-NEXT:    (ref.cast (ref null $Sub)
  ;; NO_TNH-NEXT:     (local.get $x)
  ;; NO_TNH-NEXT:    )
  ;; NO_TNH-NEXT:    (ref.cast (ref null $Sub)
  ;; NO_TNH-NEXT:     (local.get $y)
  ;; NO_TNH-NEXT:    )
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (drop
  ;; NO_TNH-NEXT:   (struct.new $Holder
  ;; NO_TNH-NEXT:    (ref.cast (ref $Sub)
  ;; NO_TNH-NEXT:     (local.get $x)
  ;; NO_TNH-NEXT:    )
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT:  (ref.cast (ref $Sub)
  ;; NO_TNH-NEXT:   (local.get $y)
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT: )
  (func $strip-casts (param $x (ref null $Base)) (param $y (ref null $Mid)) (result (ref $Base))
    (drop
      (ref.cast (ref null $Sub)
        (local.get $x)
      )
    )
    (drop
      (ref.is_null
        (ref.cast (ref null $Sub)
          (local.get $x)
        )
      )
    )
    (drop
      (ref.eq
        (ref.cast (ref null $Sub)
          (local.get $x)
        )
        (ref.cast (ref null $Sub)
          (local.get $y)
        )
      )
    )
    (drop
      (struct.new $Holder
        (ref.cast (ref $Sub)
          (local.get $x)
        )
      )
    )
    (ref.cast (ref $Sub)
      (local.get $y)
    )
  )
)
