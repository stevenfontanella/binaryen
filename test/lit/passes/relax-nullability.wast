  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT: )
  (func $relax-unstripped-cast (export "relax-unstripped-cast") (param $a anyref) (result i32)
    (struct.get $Sub 0
      (ref.cast (ref $Sub)
        (local.get $a)
      )
    )
  )

  ;; CHECK:      (func $callee-named-block (type $3) (param $x (ref null $Base)) (result (ref null $Base))
  ;; CHECK-NEXT:  (block $b (result (ref null $Base))
