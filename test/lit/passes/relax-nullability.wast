  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT: )
  (func $caller-named-block (export "caller-named-block") (param $x (ref null $Base)) (result i32)
    (struct.get $Base 0
      (block $outer (result (ref $Base))
        (br $outer
          (call $callee-named-block
            (local.get $x)
          )
        )
      )
    )
  )
)

