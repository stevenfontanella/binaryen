  ;; NO_TNH-NEXT:    (local.get $b)
  ;; NO_TNH-NEXT:   )
  ;; NO_TNH-NEXT:   (i32.const 7)
  ;; NO_TNH-NEXT:  )
  ;; NO_TNH-NEXT: )
  (func $call-multi-get-sub (export "call-multi") (param $b (ref null $Base)) (result i32)
    (call $multi-get-sub
      (ref.cast (ref null $Sub)
        (local.get $b)
      )
      (i32.const 7)
    )
  )
