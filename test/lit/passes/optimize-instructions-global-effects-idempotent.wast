;; NOTE: Assertions have been generated by update_lit_checks.py and should not be edited.
;; RUN: foreach %s %t wasm-opt --generate-global-effects --optimize-instructions -all -S -o - \
;; RUN:   | filecheck %s
;; RUN: foreach %s %t wasm-opt --closed-world --coalesce-locals --reorder-locals --optimize-instructions -all -S -o - \
;; RUN:   | filecheck %s --check-prefix=CLOSED

(module
  ;; CHECK:      (type $struct (shared (struct (field (mut i32)))))
  ;; CLOSED:      (type $struct (shared (struct (field (mut i32)))))
  (type $struct (shared (struct (field (mut i32)))))

  ;; CHECK:      (global $g i31ref (ref.i31
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (memory $mem 1 1 shared)
  ;; CLOSED:      (global $g i31ref (ref.i31
  ;; CLOSED-NEXT:  (i32.const 0)
  ;; CLOSED-NEXT: ))

  ;; CLOSED:      (memory $mem 1 1 shared)
  (memory $mem 1 1 shared)

  (global $g i31ref (ref.i31 (i32.const 0)))

  ;; CHECK:      (@binaryen.idempotent)
  ;; CHECK-NEXT: (func $acquire-mem (type $1) (param $0 i32) (result eqref)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (i32.atomic.load acqrel
  ;; CHECK-NEXT:    (local.get $0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (global.get $g)
  ;; CHECK-NEXT: )
  ;; CLOSED:      (@binaryen.idempotent)
  ;; CLOSED-NEXT: (func $acquire-mem (type $1) (param $0 i32) (result eqref)
  ;; CLOSED-NEXT:  (drop
  ;; CLOSED-NEXT:   (i32.atomic.load acqrel
  ;; CLOSED-NEXT:    (local.get $0)
  ;; CLOSED-NEXT:   )
  ;; CLOSED-NEXT:  )
  ;; CLOSED-NEXT:  (global.get $g)
  ;; CLOSED-NEXT: )
  (@binaryen.idempotent)
  (func $acquire-mem (param i32) (result eqref)
    (drop
      (i32.atomic.load acqrel (local.get 0))
    )
    (global.get $g)
  )

  ;; CHECK:      (@binaryen.idempotent)
  ;; CHECK-NEXT: (func $release-mem (type $1) (param $0 i32) (result eqref)
  ;; CHECK-NEXT:  (i32.atomic.store acqrel
  ;; CHECK-NEXT:   (local.get $0)
  ;; CHECK-NEXT:   (local.get $0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (global.get $g)
  ;; CHECK-NEXT: )
  ;; CLOSED:      (@binaryen.idempotent)
  ;; CLOSED-NEXT: (func $release-mem (type $1) (param $0 i32) (result eqref)
  ;; CLOSED-NEXT:  (i32.atomic.store acqrel
  ;; CLOSED-NEXT:   (local.get $0)
  ;; CLOSED-NEXT:   (local.get $0)
  ;; CLOSED-NEXT:  )
  ;; CLOSED-NEXT:  (global.get $g)
  ;; CLOSED-NEXT: )
  (@binaryen.idempotent)
  (func $release-mem (param i32) (result eqref)
    (i32.atomic.store acqrel (local.get 0) (local.get 0))
    (global.get $g)
  )

  ;; CHECK:      (func $fold (type $2) (param $s (ref $struct)) (result i32)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $release-mem
  ;; CHECK-NEXT:    (struct.get $struct 0
  ;; CHECK-NEXT:     (local.get $s)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT: )
  ;; CLOSED:      (func $fold (type $2) (param $0 (ref $struct)) (result i32)
  ;; CLOSED-NEXT:  (ref.eq
  ;; CLOSED-NEXT:   (call $release-mem
  ;; CLOSED-NEXT:    (struct.get $struct 0
  ;; CLOSED-NEXT:     (local.get $0)
  ;; CLOSED-NEXT:    )
  ;; CLOSED-NEXT:   )
  ;; CLOSED-NEXT:   (call $release-mem
  ;; CLOSED-NEXT:    (struct.get $struct 0
  ;; CLOSED-NEXT:     (local.get $0)
  ;; CLOSED-NEXT:    )
  ;; CLOSED-NEXT:   )
  ;; CLOSED-NEXT:  )
  ;; CLOSED-NEXT: )
  (func $fold (param $s (ref $struct)) (result i32)
    ;; The value loaded by the second struct.get cannot be forced to be
    ;; different by the release operation done by the first call, so we can
    ;; assume the same value is passed to both calls. That lets us fold them
    ;; because they are marked idempotent.
    (ref.eq
      (call $release-mem (struct.get $struct 0 (local.get $s)))
      (call $release-mem (struct.get $struct 0 (local.get $s)))
    )
  )

  ;; CHECK:      (func $no-fold (type $2) (param $s (ref $struct)) (result i32)
  ;; CHECK-NEXT:  (ref.eq
  ;; CHECK-NEXT:   (call $acquire-mem
  ;; CHECK-NEXT:    (struct.get $struct 0
  ;; CHECK-NEXT:     (local.get $s)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (call $acquire-mem
  ;; CHECK-NEXT:    (struct.get $struct 0
  ;; CHECK-NEXT:     (local.get $s)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; CLOSED:      (func $no-fold (type $2) (param $0 (ref $struct)) (result i32)
  ;; CLOSED-NEXT:  (ref.eq
  ;; CLOSED-NEXT:   (call $acquire-mem
  ;; CLOSED-NEXT:    (struct.get $struct 0
  ;; CLOSED-NEXT:     (local.get $0)
  ;; CLOSED-NEXT:    )
  ;; CLOSED-NEXT:   )
  ;; CLOSED-NEXT:   (call $acquire-mem
  ;; CLOSED-NEXT:    (struct.get $struct 0
  ;; CLOSED-NEXT:     (local.get $0)
  ;; CLOSED-NEXT:    )
  ;; CLOSED-NEXT:   )
  ;; CLOSED-NEXT:  )
  ;; CLOSED-NEXT: )
  (func $no-fold (param $s (ref $struct)) (result i32)
    ;; The second struct.get might see a different value because of
    ;; synchronization established by the first call, so the calls might receive
    ;; different arguments and therefore cannot be folded even though the callee
    ;; is marked idempotent.
    (ref.eq
      (call $acquire-mem (struct.get $struct 0 (local.get $s)))
      (call $acquire-mem (struct.get $struct 0 (local.get $s)))
    )
  )
)

(module
  ;; CHECK:      (global $f (mut f32) (f32.const -3))
  ;; CLOSED:      (global $f (mut f32) (f32.const -3))
  (global $f (mut f32) (f32.const -3))

  ;; CHECK:      (func $potent (type $0) (result f32)
  ;; CHECK-NEXT:  (global.set $f
  ;; CHECK-NEXT:   (f32.add
  ;; CHECK-NEXT:    (global.get $f)
  ;; CHECK-NEXT:    (f32.const 2)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (global.get $f)
  ;; CHECK-NEXT: )
  ;; CLOSED:      (func $potent (type $0) (result f32)
  ;; CLOSED-NEXT:  (global.set $f
  ;; CLOSED-NEXT:   (f32.add
  ;; CLOSED-NEXT:    (global.get $f)
  ;; CLOSED-NEXT:    (f32.const 2)
  ;; CLOSED-NEXT:   )
  ;; CLOSED-NEXT:  )
  ;; CLOSED-NEXT:  (global.get $f)
  ;; CLOSED-NEXT: )
  (func $potent (result f32)
    (global.set $f (f32.add (global.get $f) (f32.const 2)))
    (global.get $f)
  )

  ;; CHECK:      (func $function-effects-interfere (type $0) (result f32)
  ;; CHECK-NEXT:  (f32.abs
  ;; CHECK-NEXT:   (f32.mul
  ;; CHECK-NEXT:    (call $potent)
  ;; CHECK-NEXT:    (call $potent)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; CLOSED:      (func $function-effects-interfere (type $0) (result f32)
  ;; CLOSED-NEXT:  (f32.abs
  ;; CLOSED-NEXT:   (f32.mul
  ;; CLOSED-NEXT:    (call $potent)
  ;; CLOSED-NEXT:    (call $potent)
  ;; CLOSED-NEXT:   )
  ;; CLOSED-NEXT:  )
  ;; CLOSED-NEXT: )
  (func $function-effects-interfere (result f32)
    ;; Even knowing the effects of the call, we should not be able to optimize
    ;; here because the calls will return different values.
    (f32.abs
      (f32.mul
        (call $potent)
        (call $potent)
      )
    )
  )
)

(module
  ;; CHECK:      (type $bool-holder (struct (field $b (mut i8))))
  ;; CLOSED:      (type $bool-holder (struct (field $b (mut i8))))
  (type $bool-holder (struct (field $b (mut i8))))

  ;; CHECK:      (func $is-zero (type $1) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (i32.eqz
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; CLOSED:      (func $is-zero (type $1) (param $0 i32) (result i32)
  ;; CLOSED-NEXT:  (i32.eqz
  ;; CLOSED-NEXT:   (local.get $0)
  ;; CLOSED-NEXT:  )
  ;; CLOSED-NEXT: )
  (func $is-zero (param $x i32) (result i32)
    (i32.eqz (local.get $x))
  )

  ;; CHECK:      (func $write-bool-field (type $2) (param $h (ref $bool-holder)) (param $x i32)
  ;; CHECK-NEXT:  (struct.set $bool-holder $b
  ;; CHECK-NEXT:   (local.get $h)
  ;; CHECK-NEXT:   (call $is-zero
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; CLOSED:      (func $write-bool-field (type $2) (param $0 (ref $bool-holder)) (param $1 i32)
  ;; CLOSED-NEXT:  (struct.set $bool-holder $b
  ;; CLOSED-NEXT:   (local.get $0)
  ;; CLOSED-NEXT:   (call $is-zero
  ;; CLOSED-NEXT:    (local.get $1)
  ;; CLOSED-NEXT:   )
  ;; CLOSED-NEXT:  )
  ;; CLOSED-NEXT: )
  (func $write-bool-field (param $h (ref $bool-holder)) (param $x i32)
    (struct.set $bool-holder $b
      (local.get $h)
      (call $is-zero (local.get $x))
    )
  )

  ;; CHECK:      (func $use-one-bit-call (type $3) (param $h (ref $bool-holder)) (param $x i32) (param $y i32) (result i32)
  ;; CHECK-NEXT:  (local $unused i32)
  ;; CHECK-NEXT:  (local $c i32)
  ;; CHECK-NEXT:  (local.set $c
  ;; CHECK-NEXT:   (i32.add
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:    (i32.const 10)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (i32.gt_s
  ;; CHECK-NEXT:    (local.get $c)
  ;; CHECK-NEXT:    (i32.const 127)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (return
  ;; CHECK-NEXT:     (i32.const 99)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (select
  ;; CHECK-NEXT:   (call $is-zero
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (struct.get_s $bool-holder $b
  ;; CHECK-NEXT:    (local.get $h)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; CLOSED:      (func $use-one-bit-call (type $3) (param $0 (ref $bool-holder)) (param $1 i32) (param $2 i32) (result i32)
  ;; CLOSED-NEXT:  (local.set $2
  ;; CLOSED-NEXT:   (i32.add
  ;; CLOSED-NEXT:    (local.get $1)
  ;; CLOSED-NEXT:    (i32.const 10)
  ;; CLOSED-NEXT:   )
  ;; CLOSED-NEXT:  )
  ;; CLOSED-NEXT:  (if
  ;; CLOSED-NEXT:   (i32.gt_s
  ;; CLOSED-NEXT:    (local.get $2)
  ;; CLOSED-NEXT:    (i32.const 127)
  ;; CLOSED-NEXT:   )
  ;; CLOSED-NEXT:   (then
  ;; CLOSED-NEXT:    (return
  ;; CLOSED-NEXT:     (i32.const 99)
  ;; CLOSED-NEXT:    )
  ;; CLOSED-NEXT:   )
  ;; CLOSED-NEXT:  )
  ;; CLOSED-NEXT:  (i32.and
  ;; CLOSED-NEXT:   (call $is-zero
  ;; CLOSED-NEXT:    (local.get $1)
  ;; CLOSED-NEXT:   )
  ;; CLOSED-NEXT:   (struct.get_s $bool-holder $b
  ;; CLOSED-NEXT:    (local.get $0)
  ;; CLOSED-NEXT:   )
  ;; CLOSED-NEXT:  )
  ;; CLOSED-NEXT: )
  (func $use-one-bit-call (param $h (ref $bool-holder)) (param $x i32) (param $y i32) (result i32)
    (local $unused i32)
    (local $c i32)
    (local.set $c (i32.add (local.get $x) (i32.const 10)))
    (if
      (i32.gt_s (local.get $c) (i32.const 127))
      (then
        (return (i32.const 99))
      )
    )
    (select
      (call $is-zero (local.get $x))
      (i32.const 0)
      (struct.get_s $bool-holder $b (local.get $h))
    )
  )

  ;; CHECK:      (func $use-one-bit-calls-open (type $4) (param $x i32) (param $y i32) (result i32)
  ;; CHECK-NEXT:  (i32.and
  ;; CHECK-NEXT:   (call $is-zero
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (call $is-zero
  ;; CHECK-NEXT:    (local.get $y)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; CLOSED:      (func $use-one-bit-calls-open (type $4) (param $0 i32) (param $1 i32) (result i32)
  ;; CLOSED-NEXT:  (i32.and
  ;; CLOSED-NEXT:   (call $is-zero
  ;; CLOSED-NEXT:    (local.get $0)
  ;; CLOSED-NEXT:   )
  ;; CLOSED-NEXT:   (call $is-zero
  ;; CLOSED-NEXT:    (local.get $1)
  ;; CLOSED-NEXT:   )
  ;; CLOSED-NEXT:  )
  ;; CLOSED-NEXT: )
  (func $use-one-bit-calls-open (param $x i32) (param $y i32) (result i32)
    (select
      (call $is-zero (local.get $x))
      (i32.const 0)
      (call $is-zero (local.get $y))
    )
  )
)
