;; NOTE: Assertions have been generated by update_lit_checks.py and should not be edited.

;; Test inlining at call sites where all arguments are constants. Such call
;; sites can be inlined even if the callee is larger than the flexible inline
;; max size (and even if it has calls), as long as the callee branches on a
;; parameter: after inlining, the branches fold away.

;; (-caimfs=0 disables constant-argument inlining; nothing is inlined then.)
;; RUN: foreach %s %t wasm-opt -all --inlining-optimizing --optimize-level=3 -S -o - | filecheck %s --check-prefix=O3
;; RUN: foreach %s %t wasm-opt -all --inlining-optimizing --optimize-level=3 -caimfs=0 -S -o - | filecheck %s --check-prefix=NO

(module
  ;; O3:      (type $String (struct (field $chars externref)))
  ;; NO:      (type $String (struct (field $chars externref)))
  (type $String (struct (field $chars externref)))

  ;; O3:      (global $TRUE (ref $String) (struct.new $String
  ;; O3-NEXT:  (string.const "TRUE")
  ;; O3-NEXT: ))
  ;; NO:      (global $TRUE (ref $String) (struct.new $String
  ;; NO-NEXT:  (string.const "TRUE")
  ;; NO-NEXT: ))
  (global $TRUE (ref $String) (struct.new $String (string.const "TRUE")))
  ;; O3:      (global $FALSE (ref $String) (struct.new $String
  ;; O3-NEXT:  (string.const "FALSE")
  ;; O3-NEXT: ))
  ;; NO:      (global $FALSE (ref $String) (struct.new $String
  ;; NO-NEXT:  (string.const "FALSE")
  ;; NO-NEXT: ))
  (global $FALSE (ref $String) (struct.new $String (string.const "FALSE")))
  ;; O3:      (global $mutable (mut (ref null $String)) (ref.null none))
  ;; NO:      (global $mutable (mut (ref null $String)) (ref.null none))
  (global $mutable (mut (ref null $String)) (ref.null $String))

  ;; O3:      (global $CHECKS_ENABLED (mut i32) (i32.const 0))
  ;; NO:      (global $CHECKS_ENABLED (mut i32) (i32.const 0))
  (global $CHECKS_ENABLED (mut i32) (i32.const 0))

  ;; A function of more than 20 nodes (the flexible inline max size) that
  ;; branches on its parameters. It is too large to inline normally, but it is
  ;; inlined at constant-argument call sites.
  ;; O3:      (func $equals (type $3) (param $a (ref null $String)) (param $b (ref null $String)) (result i32)
  ;; O3-NEXT:  (if
  ;; O3-NEXT:   (ref.eq
  ;; O3-NEXT:    (local.get $a)
  ;; O3-NEXT:    (local.get $b)
  ;; O3-NEXT:   )
  ;; O3-NEXT:   (then
  ;; O3-NEXT:    (return
  ;; O3-NEXT:     (i32.const 1)
  ;; O3-NEXT:    )
  ;; O3-NEXT:   )
  ;; O3-NEXT:  )
  ;; O3-NEXT:  (if
  ;; O3-NEXT:   (ref.is_null
  ;; O3-NEXT:    (local.get $b)
  ;; O3-NEXT:   )
  ;; O3-NEXT:   (then
  ;; O3-NEXT:    (return
  ;; O3-NEXT:     (i32.const 0)
  ;; O3-NEXT:    )
  ;; O3-NEXT:   )
  ;; O3-NEXT:  )
  ;; O3-NEXT:  (if
  ;; O3-NEXT:   (ref.is_null
  ;; O3-NEXT:    (local.get $a)
  ;; O3-NEXT:   )
  ;; O3-NEXT:   (then
  ;; O3-NEXT:    (return
  ;; O3-NEXT:     (i32.const 0)
  ;; O3-NEXT:    )
  ;; O3-NEXT:   )
  ;; O3-NEXT:  )
  ;; O3-NEXT:  (return
  ;; O3-NEXT:   (i32.add
  ;; O3-NEXT:    (i32.add
  ;; O3-NEXT:     (i32.const 1)
  ;; O3-NEXT:     (i32.const 2)
  ;; O3-NEXT:    )
  ;; O3-NEXT:    (i32.add
  ;; O3-NEXT:     (i32.const 3)
  ;; O3-NEXT:     (i32.const 4)
  ;; O3-NEXT:    )
  ;; O3-NEXT:   )
  ;; O3-NEXT:  )
  ;; O3-NEXT: )
  ;; NO:      (func $equals (type $3) (param $a (ref null $String)) (param $b (ref null $String)) (result i32)
  ;; NO-NEXT:  (if
  ;; NO-NEXT:   (ref.eq
  ;; NO-NEXT:    (local.get $a)
  ;; NO-NEXT:    (local.get $b)
  ;; NO-NEXT:   )
  ;; NO-NEXT:   (then
  ;; NO-NEXT:    (return
  ;; NO-NEXT:     (i32.const 1)
  ;; NO-NEXT:    )
  ;; NO-NEXT:   )
  ;; NO-NEXT:  )
  ;; NO-NEXT:  (if
  ;; NO-NEXT:   (ref.is_null
  ;; NO-NEXT:    (local.get $b)
  ;; NO-NEXT:   )
  ;; NO-NEXT:   (then
  ;; NO-NEXT:    (return
  ;; NO-NEXT:     (i32.const 0)
  ;; NO-NEXT:    )
  ;; NO-NEXT:   )
  ;; NO-NEXT:  )
  ;; NO-NEXT:  (if
  ;; NO-NEXT:   (ref.is_null
  ;; NO-NEXT:    (local.get $a)
  ;; NO-NEXT:   )
  ;; NO-NEXT:   (then
  ;; NO-NEXT:    (return
  ;; NO-NEXT:     (i32.const 0)
  ;; NO-NEXT:    )
  ;; NO-NEXT:   )
  ;; NO-NEXT:  )
  ;; NO-NEXT:  (return
  ;; NO-NEXT:   (i32.add
  ;; NO-NEXT:    (i32.add
  ;; NO-NEXT:     (i32.const 1)
  ;; NO-NEXT:     (i32.const 2)
  ;; NO-NEXT:    )
  ;; NO-NEXT:    (i32.add
  ;; NO-NEXT:     (i32.const 3)
  ;; NO-NEXT:     (i32.const 4)
  ;; NO-NEXT:    )
  ;; NO-NEXT:   )
  ;; NO-NEXT:  )
  ;; NO-NEXT: )
  (func $equals (param $a (ref null $String)) (param $b (ref null $String)) (result i32)
    (if
      (ref.eq
        (local.get $a)
        (local.get $b)
      )
      (then
        (return
          (i32.const 1)
        )
      )
    )
    (if
      (ref.is_null
        (local.get $b)
      )
      (then
        (return
          (i32.const 0)
        )
      )
    )
    (if
      (ref.is_null
        (local.get $a)
      )
      (then
        (return
          (i32.const 0)
        )
      )
    )
    (return
      (i32.add
        (i32.add
          (i32.const 1)
          (i32.const 2)
        )
        (i32.add
          (i32.const 3)
          (i32.const 4)
        )
      )
    )
  )

  ;; Both arguments are immutable globals with constant initializers: inlined
  ;; and folded (ref.eq of two different allocations is 0, and nothing is
  ;; null, so the result is the final constant).
  ;; O3:      (func $clinit (type $4)
  ;; O3-NEXT:  (global.set $CHECKS_ENABLED
  ;; O3-NEXT:   (i32.const 10)
  ;; O3-NEXT:  )
  ;; O3-NEXT: )
  ;; NO:      (func $clinit (type $4)
  ;; NO-NEXT:  (global.set $CHECKS_ENABLED
  ;; NO-NEXT:   (call $equals
  ;; NO-NEXT:    (global.get $TRUE)
  ;; NO-NEXT:    (global.get $FALSE)
  ;; NO-NEXT:   )
  ;; NO-NEXT:  )
  ;; NO-NEXT: )
  (func $clinit
    (global.set $CHECKS_ENABLED
      (call $equals
        (global.get $TRUE)
        (global.get $FALSE)
      )
    )
  )

  ;; Same global in both arguments: folds to 1.
  ;; O3:      (func $same (type $1) (result i32)
  ;; O3-NEXT:  (i32.const 1)
  ;; O3-NEXT: )
  ;; NO:      (func $same (type $1) (result i32)
  ;; NO-NEXT:  (call $equals
  ;; NO-NEXT:   (global.get $TRUE)
  ;; NO-NEXT:   (global.get $TRUE)
  ;; NO-NEXT:  )
  ;; NO-NEXT: )
  (func $same (result i32)
    (call $equals
      (global.get $TRUE)
      (global.get $TRUE)
    )
  )

  ;; A null constant and a global: folds to 0.
  ;; O3:      (func $null (type $1) (result i32)
  ;; O3-NEXT:  (i32.const 0)
  ;; O3-NEXT: )
  ;; NO:      (func $null (type $1) (result i32)
  ;; NO-NEXT:  (call $equals
  ;; NO-NEXT:   (ref.null none)
  ;; NO-NEXT:   (global.get $FALSE)
  ;; NO-NEXT:  )
  ;; NO-NEXT: )
  (func $null (result i32)
    (call $equals
      (ref.null $String)
      (global.get $FALSE)
    )
  )

  ;; A non-constant argument: not inlined.
  ;; O3:      (func $nonconst (type $5) (param $x (ref null $String)) (result i32)
  ;; O3-NEXT:  (call $equals
  ;; O3-NEXT:   (local.get $x)
  ;; O3-NEXT:   (global.get $FALSE)
  ;; O3-NEXT:  )
  ;; O3-NEXT: )
  ;; NO:      (func $nonconst (type $5) (param $x (ref null $String)) (result i32)
  ;; NO-NEXT:  (call $equals
  ;; NO-NEXT:   (local.get $x)
  ;; NO-NEXT:   (global.get $FALSE)
  ;; NO-NEXT:  )
  ;; NO-NEXT: )
  (func $nonconst (param $x (ref null $String)) (result i32)
    (call $equals
      (local.get $x)
      (global.get $FALSE)
    )
  )

  ;; A mutable global is not a constant: not inlined.
  ;; O3:      (func $mut (type $1) (result i32)
  ;; O3-NEXT:  (call $equals
  ;; O3-NEXT:   (global.get $mutable)
  ;; O3-NEXT:   (global.get $FALSE)
  ;; O3-NEXT:  )
  ;; O3-NEXT: )
  ;; NO:      (func $mut (type $1) (result i32)
  ;; NO-NEXT:  (call $equals
  ;; NO-NEXT:   (global.get $mutable)
  ;; NO-NEXT:   (global.get $FALSE)
  ;; NO-NEXT:  )
  ;; NO-NEXT: )
  (func $mut (result i32)
    (call $equals
      (global.get $mutable)
      (global.get $FALSE)
    )
  )

  ;; A function with calls, which is never inlined normally at this size, but
  ;; branches on its parameter.
  ;; O3:      (func $with-call (type $2) (param $x i32) (result i32)
  ;; O3-NEXT:  (if
  ;; O3-NEXT:   (i32.eqz
  ;; O3-NEXT:    (local.get $x)
  ;; O3-NEXT:   )
  ;; O3-NEXT:   (then
  ;; O3-NEXT:    (return
  ;; O3-NEXT:     (call $with-call
  ;; O3-NEXT:      (i32.const 1)
  ;; O3-NEXT:     )
  ;; O3-NEXT:    )
  ;; O3-NEXT:   )
  ;; O3-NEXT:  )
  ;; O3-NEXT:  (if
  ;; O3-NEXT:   (i32.eq
  ;; O3-NEXT:    (local.get $x)
  ;; O3-NEXT:    (i32.const 1)
  ;; O3-NEXT:   )
  ;; O3-NEXT:   (then
  ;; O3-NEXT:    (return
  ;; O3-NEXT:     (i32.const 100)
  ;; O3-NEXT:    )
  ;; O3-NEXT:   )
  ;; O3-NEXT:  )
  ;; O3-NEXT:  (return
  ;; O3-NEXT:   (i32.add
  ;; O3-NEXT:    (i32.add
  ;; O3-NEXT:     (local.get $x)
  ;; O3-NEXT:     (i32.const 2)
  ;; O3-NEXT:    )
  ;; O3-NEXT:    (i32.add
  ;; O3-NEXT:     (i32.const 3)
  ;; O3-NEXT:     (i32.const 4)
  ;; O3-NEXT:    )
  ;; O3-NEXT:   )
  ;; O3-NEXT:  )
  ;; O3-NEXT: )
  ;; NO:      (func $with-call (type $2) (param $x i32) (result i32)
  ;; NO-NEXT:  (if
  ;; NO-NEXT:   (i32.eqz
  ;; NO-NEXT:    (local.get $x)
  ;; NO-NEXT:   )
  ;; NO-NEXT:   (then
  ;; NO-NEXT:    (return
  ;; NO-NEXT:     (call $with-call
  ;; NO-NEXT:      (i32.const 1)
  ;; NO-NEXT:     )
  ;; NO-NEXT:    )
  ;; NO-NEXT:   )
  ;; NO-NEXT:  )
  ;; NO-NEXT:  (if
  ;; NO-NEXT:   (i32.eq
  ;; NO-NEXT:    (local.get $x)
  ;; NO-NEXT:    (i32.const 1)
  ;; NO-NEXT:   )
  ;; NO-NEXT:   (then
  ;; NO-NEXT:    (return
  ;; NO-NEXT:     (i32.const 100)
  ;; NO-NEXT:    )
  ;; NO-NEXT:   )
  ;; NO-NEXT:  )
  ;; NO-NEXT:  (return
  ;; NO-NEXT:   (i32.add
  ;; NO-NEXT:    (i32.add
  ;; NO-NEXT:     (local.get $x)
  ;; NO-NEXT:     (i32.const 2)
  ;; NO-NEXT:    )
  ;; NO-NEXT:    (i32.add
  ;; NO-NEXT:     (i32.const 3)
  ;; NO-NEXT:     (i32.const 4)
  ;; NO-NEXT:    )
  ;; NO-NEXT:   )
  ;; NO-NEXT:  )
  ;; NO-NEXT: )
  (func $with-call (param $x i32) (result i32)
    (if
      (i32.eqz
        (local.get $x)
      )
      (then
        (return
          (call $with-call
            (i32.const 1)
          )
        )
      )
    )
    (if
      (i32.eq
        (local.get $x)
        (i32.const 1)
      )
      (then
        (return
          (i32.const 100)
        )
      )
    )
    (return
      (i32.add
        (i32.add
          (local.get $x)
          (i32.const 2)
        )
        (i32.add
          (i32.const 3)
          (i32.const 4)
        )
      )
    )
  )

  ;; Constant argument: inlined, folds to 100.
  ;; O3:      (func $call-with-call-const (type $1) (result i32)
  ;; O3-NEXT:  (i32.const 100)
  ;; O3-NEXT: )
  ;; NO:      (func $call-with-call-const (type $1) (result i32)
  ;; NO-NEXT:  (call $with-call
  ;; NO-NEXT:   (i32.const 1)
  ;; NO-NEXT:  )
  ;; NO-NEXT: )
  (func $call-with-call-const (result i32)
    (call $with-call
      (i32.const 1)
    )
  )

  ;; Non-constant: not inlined.
  ;; O3:      (func $call-with-call-nonconst (type $2) (param $x i32) (result i32)
  ;; O3-NEXT:  (call $with-call
  ;; O3-NEXT:   (local.get $x)
  ;; O3-NEXT:  )
  ;; O3-NEXT: )
  ;; NO:      (func $call-with-call-nonconst (type $2) (param $x i32) (result i32)
  ;; NO-NEXT:  (call $with-call
  ;; NO-NEXT:   (local.get $x)
  ;; NO-NEXT:  )
  ;; NO-NEXT: )
  (func $call-with-call-nonconst (param $x i32) (result i32)
    (call $with-call
      (local.get $x)
    )
  )

  ;; A large function that does not branch on its parameter: not inlined even
  ;; with constant arguments.
  ;; O3:      (func $no-branch (type $2) (param $x i32) (result i32)
  ;; O3-NEXT:  (if
  ;; O3-NEXT:   (global.get $CHECKS_ENABLED)
  ;; O3-NEXT:   (then
  ;; O3-NEXT:    (return
  ;; O3-NEXT:     (i32.const 100)
  ;; O3-NEXT:    )
  ;; O3-NEXT:   )
  ;; O3-NEXT:  )
  ;; O3-NEXT:  (return
  ;; O3-NEXT:   (i32.add
  ;; O3-NEXT:    (i32.add
  ;; O3-NEXT:     (i32.add
  ;; O3-NEXT:      (local.get $x)
  ;; O3-NEXT:      (i32.const 2)
  ;; O3-NEXT:     )
  ;; O3-NEXT:     (i32.add
  ;; O3-NEXT:      (i32.const 3)
  ;; O3-NEXT:      (i32.const 4)
  ;; O3-NEXT:     )
  ;; O3-NEXT:    )
  ;; O3-NEXT:    (i32.add
  ;; O3-NEXT:     (i32.add
  ;; O3-NEXT:      (local.get $x)
  ;; O3-NEXT:      (i32.const 5)
  ;; O3-NEXT:     )
  ;; O3-NEXT:     (i32.add
  ;; O3-NEXT:      (i32.const 6)
  ;; O3-NEXT:      (i32.const 7)
  ;; O3-NEXT:     )
  ;; O3-NEXT:    )
  ;; O3-NEXT:   )
  ;; O3-NEXT:  )
  ;; O3-NEXT: )
  ;; NO:      (func $no-branch (type $2) (param $x i32) (result i32)
  ;; NO-NEXT:  (if
  ;; NO-NEXT:   (global.get $CHECKS_ENABLED)
  ;; NO-NEXT:   (then
  ;; NO-NEXT:    (return
  ;; NO-NEXT:     (i32.const 100)
  ;; NO-NEXT:    )
  ;; NO-NEXT:   )
  ;; NO-NEXT:  )
  ;; NO-NEXT:  (return
  ;; NO-NEXT:   (i32.add
  ;; NO-NEXT:    (i32.add
  ;; NO-NEXT:     (i32.add
  ;; NO-NEXT:      (local.get $x)
  ;; NO-NEXT:      (i32.const 2)
  ;; NO-NEXT:     )
  ;; NO-NEXT:     (i32.add
  ;; NO-NEXT:      (i32.const 3)
  ;; NO-NEXT:      (i32.const 4)
  ;; NO-NEXT:     )
  ;; NO-NEXT:    )
  ;; NO-NEXT:    (i32.add
  ;; NO-NEXT:     (i32.add
  ;; NO-NEXT:      (local.get $x)
  ;; NO-NEXT:      (i32.const 5)
  ;; NO-NEXT:     )
  ;; NO-NEXT:     (i32.add
  ;; NO-NEXT:      (i32.const 6)
  ;; NO-NEXT:      (i32.const 7)
  ;; NO-NEXT:     )
  ;; NO-NEXT:    )
  ;; NO-NEXT:   )
  ;; NO-NEXT:  )
  ;; NO-NEXT: )
  (func $no-branch (param $x i32) (result i32)
    (if
      (global.get $CHECKS_ENABLED)
      (then
        (return
          (i32.const 100)
        )
      )
    )
    (return
      (i32.add
        (i32.add
          (i32.add
            (local.get $x)
            (i32.const 2)
          )
          (i32.add
            (i32.const 3)
            (i32.const 4)
          )
        )
        (i32.add
          (i32.add
            (local.get $x)
            (i32.const 5)
          )
          (i32.add
            (i32.const 6)
            (i32.const 7)
          )
        )
      )
    )
  )

  ;; O3:      (func $call-no-branch (type $1) (result i32)
  ;; O3-NEXT:  (call $no-branch
  ;; O3-NEXT:   (i32.const 1)
  ;; O3-NEXT:  )
  ;; O3-NEXT: )
  ;; NO:      (func $call-no-branch (type $1) (result i32)
  ;; NO-NEXT:  (call $no-branch
  ;; NO-NEXT:   (i32.const 1)
  ;; NO-NEXT:  )
  ;; NO-NEXT: )
  (func $call-no-branch (result i32)
    (call $no-branch
      (i32.const 1)
    )
  )

  ;; O3:      (func $call-no-branch-nonconst (type $2) (param $x i32) (result i32)
  ;; O3-NEXT:  (call $no-branch
  ;; O3-NEXT:   (local.get $x)
  ;; O3-NEXT:  )
  ;; O3-NEXT: )
  ;; NO:      (func $call-no-branch-nonconst (type $2) (param $x i32) (result i32)
  ;; NO-NEXT:  (call $no-branch
  ;; NO-NEXT:   (local.get $x)
  ;; NO-NEXT:  )
  ;; NO-NEXT: )
  (func $call-no-branch-nonconst (param $x i32) (result i32)
    (call $no-branch
      (local.get $x)
    )
  )
)
