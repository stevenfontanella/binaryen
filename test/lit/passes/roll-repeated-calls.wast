    (struct.new $str (local.get $i))
  )

  ;; CHECK:      (func $one (type $8) (result (ref $box))
  ;; CHECK-NEXT:  (struct.new $box
  ;; CHECK-NEXT:   (global.get $one)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $one (result (ref $box))
    (struct.new $box (global.get $one))
  )

  ;; CHECK:      (func $fill (type $9) (param $map (ref $map))
  ;; CHECK-NEXT:  (local $1 (ref $4))
  ;; CHECK-NEXT:  (local $2 (ref $5))
  ;; CHECK-NEXT:  (local $3 i32)
  ;; CHECK-NEXT:  (local $4 i32)
  ;; CHECK-NEXT:  (local.set $1
  ;; CHECK-NEXT:   (array.new_data $4 $roll
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:    (i32.const 16)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $2
  ;; CHECK-NEXT:   (array.new_data $5 $roll
  ;; CHECK-NEXT:    (i32.const 16)
  ;; CHECK-NEXT:    (i32.const 16)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block
  ;; CHECK-NEXT:   (local.set $3
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (loop $roll
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (call $put
  ;; CHECK-NEXT:      (local.get $map)
  ;; CHECK-NEXT:      (if (result (ref $str))
  ;; CHECK-NEXT:       (i32.lt_u
  ;; CHECK-NEXT:        (local.tee $4
  ;; CHECK-NEXT:         (array.get_u $4
  ;; CHECK-NEXT:          (local.get $1)
  ;; CHECK-NEXT:          (local.get $3)
  ;; CHECK-NEXT:         )
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:        (i32.const 2)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:       (then
  ;; CHECK-NEXT:        (array.get $3
  ;; CHECK-NEXT:         (global.get $roll$table)
  ;; CHECK-NEXT:         (local.get $4)
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:       (else
  ;; CHECK-NEXT:        (call $factory
  ;; CHECK-NEXT:         (i32.sub
  ;; CHECK-NEXT:          (local.get $4)
  ;; CHECK-NEXT:          (i32.const 2)
  ;; CHECK-NEXT:         )
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (struct.new $box
  ;; CHECK-NEXT:       (array.get $5
  ;; CHECK-NEXT:        (local.get $2)
  ;; CHECK-NEXT:        (local.get $3)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (br_if $roll
  ;; CHECK-NEXT:     (i32.lt_u
  ;; CHECK-NEXT:      (local.tee $3
  ;; CHECK-NEXT:       (i32.add
  ;; CHECK-NEXT:        (local.get $3)
  ;; CHECK-NEXT:        (i32.const 1)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (i32.const 16)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $fill (param $map (ref $map))
    (drop (call $put (local.get $map) (call $factory (i32.const 100)) (struct.new $box (f64.const 2.5))))
    (drop (call $put (local.get $map) (call $factory (i32.const 101)) (struct.new $box (f64.const 3.5))))
    (drop (call $put (local.get $map) (global.get $a) (call $one)))
    (drop (call $put (local.get $map) (call $factory (i32.const 102)) (struct.new $box (f64.const 4.5))))
    (drop (call $put (local.get $map) (call $factory (i32.const 103)) (struct.new $box (f64.const 5.5))))
    (drop (call $put (local.get $map) (global.get $b) (struct.new $box (f64.const 6.5))))
    (drop (call $put (local.get $map) (call $factory (i32.const 104)) (struct.new $box (f64.const 7.5))))
    (drop (call $put (local.get $map) (call $factory (i32.const 105)) (call $one)))
    (drop (call $put (local.get $map) (global.get $a) (struct.new $box (f64.const 8.5))))
    (drop (call $put (local.get $map) (call $factory (i32.const 106)) (struct.new $box (f64.const 10.5))))
    (drop (call $put (local.get $map) (call $factory (i32.const 107)) (struct.new $box (f64.const 11.5))))
    (drop (call $put (local.get $map) (call $factory (i32.const 108)) (struct.new $box (f64.const 13.5))))
    (drop (call $put (local.get $map) (call $factory (i32.const 109)) (struct.new $box (f64.const 14.5))))
    (drop (call $put (local.get $map) (call $factory (i32.const 110)) (struct.new $box (f64.const 15.5))))
    (drop (call $put (local.get $map) (call $factory (i32.const 111)) (struct.new $box (f64.const 16.5))))
    (drop (call $put (local.get $map) (call $factory (i32.const 112)) (struct.new $box (f64.const 17.5))))
  )
)

;; Values that are close to their predecessors become a byte column of
;; differences, accumulated in a local. The two factories differ, so the
;; statements form two runs (the loose run over both does not work out, and
;; the strict runs are tried instead).
(module
  ;; CHECK:      (type $str (struct (field i32)))
  (type $str (struct (field i32)))

  ;; CHECK:      (type $1 (array (mut i16)))

  ;; CHECK:      (type $2 (func (param i32) (result (ref $str))))

  ;; CHECK:      (type $3 (func (param (ref $str))))

  ;; CHECK:      (type $4 (func))

  ;; CHECK:      (import "env" "use" (func $use (type $3) (param (ref $str))))
  (import "env" "use" (func $use (param (ref $str))))

  ;; CHECK:      (data $roll "\e8\03\eb\03\ef\03\ef\03\f2\03\fc\03\06\04j\04k\04\b0\04\b1\04\b2\04;\18>\18B\18B\18E\18O\18Y\18\bd\18\be\18\03\19\04\19\05\19")

  ;; CHECK:      (func $factory (type $2) (param $i i32) (result (ref $str))
  ;; CHECK-NEXT:  (struct.new $str
  ;; CHECK-NEXT:   (local.get $i)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $factory (param $i i32) (result (ref $str))
    (struct.new $str (local.get $i))
  )
  ;; CHECK:      (func $factory2 (type $2) (param $i i32) (result (ref $str))
  ;; CHECK-NEXT:  (struct.new $str
  ;; CHECK-NEXT:   (i32.add
  ;; CHECK-NEXT:    (local.get $i)
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $factory2 (param $i i32) (result (ref $str))
    (struct.new $str (i32.add (local.get $i) (i32.const 1)))
  )

  ;; CHECK:      (func $run (type $4)
  ;; CHECK-NEXT:  (local $0 (ref $1))
  ;; CHECK-NEXT:  (local $1 i32)
  ;; CHECK-NEXT:  (local $2 i32)
  ;; CHECK-NEXT:  (local.set $0
  ;; CHECK-NEXT:   (array.new_data $1 $roll
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:    (i32.const 24)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block
  ;; CHECK-NEXT:   (local.set $1
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (loop $roll
  ;; CHECK-NEXT:    (call $use
  ;; CHECK-NEXT:     (if (result (ref $str))
  ;; CHECK-NEXT:      (i32.lt_u
  ;; CHECK-NEXT:       (local.tee $2
  ;; CHECK-NEXT:        (array.get_u $1
  ;; CHECK-NEXT:         (local.get $0)
  ;; CHECK-NEXT:         (local.get $1)
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:       (i32.const 1203)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (then
  ;; CHECK-NEXT:       (call $factory
  ;; CHECK-NEXT:        (local.get $2)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (else
  ;; CHECK-NEXT:       (call $factory2
  ;; CHECK-NEXT:        (i32.sub
  ;; CHECK-NEXT:         (local.get $2)
  ;; CHECK-NEXT:         (i32.const 1203)
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (br_if $roll
  ;; CHECK-NEXT:     (i32.lt_u
  ;; CHECK-NEXT:      (local.tee $1
  ;; CHECK-NEXT:       (i32.add
  ;; CHECK-NEXT:        (local.get $1)
  ;; CHECK-NEXT:        (i32.const 1)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (i32.const 24)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $run
    (call $use (call $factory (i32.const 1000)))
    (call $use (call $factory (i32.const 1003)))
    (call $use (call $factory (i32.const 1007)))
    (call $use (call $factory (i32.const 1007)))
    (call $use (call $factory (i32.const 1010)))
    (call $use (call $factory (i32.const 1020)))
    (call $use (call $factory (i32.const 1030)))
    (call $use (call $factory (i32.const 1130)))
    (call $use (call $factory (i32.const 1131)))
    (call $use (call $factory (i32.const 1200)))
    (call $use (call $factory (i32.const 1201)))
    (call $use (call $factory (i32.const 1202)))
    (call $use (call $factory2 (i32.const 5000)))
    (call $use (call $factory2 (i32.const 5003)))
    (call $use (call $factory2 (i32.const 5007)))
    (call $use (call $factory2 (i32.const 5007)))
    (call $use (call $factory2 (i32.const 5010)))
    (call $use (call $factory2 (i32.const 5020)))
    (call $use (call $factory2 (i32.const 5030)))
    (call $use (call $factory2 (i32.const 5130)))
    (call $use (call $factory2 (i32.const 5131)))
    (call $use (call $factory2 (i32.const 5200)))
    (call $use (call $factory2 (i32.const 5201)))
    (call $use (call $factory2 (i32.const 5202)))
  )
)

;; Uniform br_table switch ladders: rolled into bounds-checked arithmetic
;; progressions, mixed table/factory lookups (including ref.null and hoisted
;; i32 constant globals), or gap-aware column lookups.
(module
  ;; CHECK:      (type $str (struct (field i32)))
  (type $str (struct (field i32)))

  ;; CHECK:      (type $1 (array (mut i8)))

  ;; CHECK:      (type $2 (array (ref null $str)))

  ;; CHECK:      (type $3 (func (param i32)))

  ;; CHECK:      (type $4 (func (param i32) (result (ref null $str))))

  ;; CHECK:      (type $5 (func (param i32) (result (ref $str))))

  ;; CHECK:      (import "env" "use" (func $use (type $3) (param i32)))
  (import "env" "use" (func $use (param i32)))

  ;; CHECK:      (global $a (ref $str) (struct.new $str
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT: ))
  (global $a (ref $str) (struct.new $str (i32.const 1)))
  ;; CHECK:      (global $b (ref $str) (struct.new $str
  ;; CHECK-NEXT:  (i32.const 2)
  ;; CHECK-NEXT: ))
  (global $b (ref $str) (struct.new $str (i32.const 2)))
  ;; CHECK:      (global $c10 i32 (i32.const 10))
  (global $c10 i32 (i32.const 10))

  ;; CHECK:      (global $roll$table (ref $2) (array.new_fixed $2 3
  ;; CHECK-NEXT:  (global.get $a)
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT:  (global.get $b)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (data $roll "\00\08\01\02\r\00\12\02\01\17\00\1c\n\00\14\00\1e*2\00<FP")

  ;; CHECK:      (func $factory (type $5) (param $i i32) (result (ref $str))
  ;; CHECK-NEXT:  (struct.new $str
  ;; CHECK-NEXT:   (local.get $i)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $factory (param $i i32) (result (ref $str))
    (struct.new $str (local.get $i))
  )

  ;; CHECK:      (func $switch-ap (type $4) (param $x i32) (result (ref null $str))
  ;; CHECK-NEXT:  (local $1 i32)
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (i32.lt_u
  ;; CHECK-NEXT:    (local.tee $1
  ;; CHECK-NEXT:     (local.get $x)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (i32.const 6)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (return
  ;; CHECK-NEXT:     (call $factory
  ;; CHECK-NEXT:      (i32.add
  ;; CHECK-NEXT:       (local.get $1)
  ;; CHECK-NEXT:       (i32.const 100)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT: )
  (func $switch-ap (param $x i32) (result (ref null $str))
    (block $def
      (block $b5
        (block $b4
          (block $b3
            (block $b2
              (block $b1
                (block $b0
                  (br_table $b0 $b1 $b2 $b3 $b4 $b5 $def (local.get $x))
                )
                (return (call $factory (i32.const 100)))
              )
              (return (call $factory (i32.const 101)))
            )
            (return (call $factory (i32.const 102)))
          )
          (return (call $factory (i32.const 103)))
        )
        (return (call $factory (i32.const 104)))
      )
      (return (call $factory (i32.const 105)))
    )
    (ref.null none)
  )

  ;; CHECK:      (func $switch-mixed (type $4) (param $x i32) (result (ref null $str))
  ;; CHECK-NEXT:  (local $1 (ref $1))
  ;; CHECK-NEXT:  (local $2 i32)
  ;; CHECK-NEXT:  (local $3 i32)
  ;; CHECK-NEXT:  (block $out (result (ref null $str))
  ;; CHECK-NEXT:   (local.set $1
  ;; CHECK-NEXT:    (array.new_data $1 $roll
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:     (i32.const 12)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (if
  ;; CHECK-NEXT:    (i32.lt_u
  ;; CHECK-NEXT:     (local.tee $2
  ;; CHECK-NEXT:      (local.get $x)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (i32.const 12)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (then
  ;; CHECK-NEXT:     (br $out
  ;; CHECK-NEXT:      (if (result (ref null $str))
  ;; CHECK-NEXT:       (i32.lt_u
  ;; CHECK-NEXT:        (local.tee $3
  ;; CHECK-NEXT:         (array.get_u $1
  ;; CHECK-NEXT:          (local.get $1)
  ;; CHECK-NEXT:          (local.get $2)
  ;; CHECK-NEXT:         )
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:        (i32.const 3)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:       (then
  ;; CHECK-NEXT:        (array.get $2
  ;; CHECK-NEXT:         (global.get $roll$table)
  ;; CHECK-NEXT:         (local.get $3)
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:       (else
  ;; CHECK-NEXT:        (call $factory
  ;; CHECK-NEXT:         (i32.sub
  ;; CHECK-NEXT:          (local.get $3)
  ;; CHECK-NEXT:          (i32.const 3)
  ;; CHECK-NEXT:         )
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $switch-mixed (param $x i32) (result (ref null $str))
    (block $out (result (ref null $str))
      (block $def
        (block $b11
          (block $b10
            (block $b9
              (block $b8
                (block $b7
                  (block $b6
                    (block $b5
                      (block $b4
                        (block $b3
                          (block $b2
                            (block $b1
                              (block $b0
                                (br_table $b0 $b1 $b2 $b3 $b4 $b5 $b6 $b7 $b8 $b9 $b10 $b11 $def (local.get $x))
                              )
                              (br $out (global.get $a))
                            )
                            (br $out (call $factory (i32.const 5)))
                          )
                          (br $out (ref.null none))
                        )
                        (br $out (global.get $b))
                      )
                      (br $out (call $factory (global.get $c10)))
                    )
                    (br $out (global.get $a))
                  )
                  (br $out (call $factory (i32.const 15)))
                )
                (br $out (global.get $b))
              )
              (br $out (ref.null none))
            )
            (br $out (call $factory (i32.const 20)))
          )
          (br $out (global.get $a))
        )
        (br $out (call $factory (i32.const 25)))
      )
      (unreachable)
    )
  )

  ;; CHECK:      (func $switch-gaps (type $3) (param $x i32)
  ;; CHECK-NEXT:  (local $1 (ref $1))
  ;; CHECK-NEXT:  (local $2 i32)
  ;; CHECK-NEXT:  (local $3 i32)
  ;; CHECK-NEXT:  (local.set $1
  ;; CHECK-NEXT:   (array.new_data $1 $roll
  ;; CHECK-NEXT:    (i32.const 12)
  ;; CHECK-NEXT:    (i32.const 11)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (i32.lt_u
  ;; CHECK-NEXT:    (local.tee $2
  ;; CHECK-NEXT:     (local.get $x)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (i32.const 11)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (if
  ;; CHECK-NEXT:     (local.tee $3
  ;; CHECK-NEXT:      (array.get_u $1
  ;; CHECK-NEXT:       (local.get $1)
  ;; CHECK-NEXT:       (local.get $2)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (then
  ;; CHECK-NEXT:      (call $use
  ;; CHECK-NEXT:       (local.get $3)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $use
  ;; CHECK-NEXT:   (i32.const 99)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $switch-gaps (param $x i32)
    (block $def
      (block $b7
        (block $b6
          (block $b5
            (block $b4
              (block $b3
                (block $b2
                  (block $b1
                    (block $b0
                      (br_table $b0 $def $b1 $def $b2 $b3 $b4 $def $b5 $b6 $b7 $def (local.get $x))
                    )
                    (call $use (i32.const 10))
                    (br $def)
                  )
                  (call $use (i32.const 20))
                  (br $def)
                )
                (call $use (i32.const 30))
                (br $def)
              )
              (call $use (i32.const 42))
              (br $def)
            )
            (call $use (i32.const 50))
            (br $def)
          )
          (call $use (i32.const 60))
          (br $def)
        )
        (call $use (i32.const 70))
        (br $def)
      )
      (call $use (i32.const 80))
    )
    (call $use (i32.const 99))
  )
)

;; Multi-factory reference holes (in statement runs and switch ladders) and
;; multi-hole switch ladders with default gaps.
(module
  ;; CHECK:      (type $0 (array (mut i8)))

  ;; CHECK:      (type $str (struct (field i32)))
  (type $str (struct (field i32)))
  ;; CHECK:      (type $2 (func (param i32) (result (ref $str))))

  ;; CHECK:      (type $3 (func))

  ;; CHECK:      (type $4 (func (param (ref $str))))

  ;; CHECK:      (type $5 (func (param i32 (ref $str))))

  ;; CHECK:      (type $6 (func (param i32) (result (ref null $str))))

  ;; CHECK:      (type $7 (func (param i32)))

  ;; CHECK:      (import "env" "use" (func $use (type $4) (param (ref $str))))
  (import "env" "use" (func $use (param (ref $str))))
  ;; CHECK:      (import "env" "use2" (func $use2 (type $5) (param i32 (ref $str))))
  (import "env" "use2" (func $use2 (param i32 (ref $str))))

  ;; CHECK:      (data $roll "\00\03\04\00\03\n\nd\01E\01\01\01\15\05\17\t\19\0c\1b\0f\1d\12\1f\03\r\07\10\t\12\0b\14\n\00\14\1e\00*2<\01\00\08\03\00\n\05\0c")

  ;; CHECK:      (func $factory1 (type $2) (param $i i32) (result (ref $str))
  ;; CHECK-NEXT:  (struct.new $str
  ;; CHECK-NEXT:   (local.get $i)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $factory1 (param $i i32) (result (ref $str))
    (struct.new $str (local.get $i))
  )
  ;; CHECK:      (func $factory2 (type $2) (param $i i32) (result (ref $str))
  ;; CHECK-NEXT:  (struct.new $str
  ;; CHECK-NEXT:   (i32.add
  ;; CHECK-NEXT:    (local.get $i)
  ;; CHECK-NEXT:    (i32.const 100)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $factory2 (param $i i32) (result (ref $str))
    (struct.new $str (i32.add (local.get $i) (i32.const 100)))
  )

  ;; CHECK:      (func $run-delta (type $3)
  ;; CHECK-NEXT:  (local $0 (ref $0))
  ;; CHECK-NEXT:  (local $1 i32)
  ;; CHECK-NEXT:  (local $2 i32)
  ;; CHECK-NEXT:  (local.set $0
  ;; CHECK-NEXT:   (array.new_data $0 $roll
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:    (i32.const 12)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block
  ;; CHECK-NEXT:   (local.set $1
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (local.set $2
