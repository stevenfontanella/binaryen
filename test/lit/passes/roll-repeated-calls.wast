  ;; CHECK-NEXT:  (local $2 i32)
  ;; CHECK-NEXT:  (local $3 i32)
  ;; CHECK-NEXT:  (local.set $0
  ;; CHECK-NEXT:   (array.new_default $arr
  ;; CHECK-NEXT:    (i32.const 28)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $1
  ;; CHECK-NEXT:   (array.new_data $3 $roll
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:    (i32.const 28)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block
  ;; CHECK-NEXT:   (local.set $2
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (loop $roll
  ;; CHECK-NEXT:    (array.set $arr
  ;; CHECK-NEXT:     (local.get $0)
  ;; CHECK-NEXT:     (local.get $2)
  ;; CHECK-NEXT:     (if (result (ref $str))
  ;; CHECK-NEXT:      (i32.lt_u
  ;; CHECK-NEXT:       (local.tee $3
  ;; CHECK-NEXT:        (array.get_u $3
  ;; CHECK-NEXT:         (local.get $1)
  ;; CHECK-NEXT:         (local.get $2)
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:       (i32.const 1)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (then
  ;; CHECK-NEXT:       (array.get $2
  ;; CHECK-NEXT:        (global.get $roll$table)
  ;; CHECK-NEXT:        (local.get $3)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (else
  ;; CHECK-NEXT:       (if (result (ref $str))
  ;; CHECK-NEXT:        (i32.lt_u
  ;; CHECK-NEXT:         (local.get $3)
  ;; CHECK-NEXT:         (i32.const 127)
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:        (then
  ;; CHECK-NEXT:         (call $f1
  ;; CHECK-NEXT:          (i32.sub
  ;; CHECK-NEXT:           (local.get $3)
  ;; CHECK-NEXT:           (i32.const 1)
  ;; CHECK-NEXT:          )
  ;; CHECK-NEXT:         )
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:        (else
  ;; CHECK-NEXT:         (call $f2
  ;; CHECK-NEXT:          (i32.sub
  ;; CHECK-NEXT:           (local.get $3)
  ;; CHECK-NEXT:           (i32.const 127)
  ;; CHECK-NEXT:          )
  ;; CHECK-NEXT:         )
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (br_if $roll
  ;; CHECK-NEXT:     (i32.lt_u
  ;; CHECK-NEXT:      (local.tee $2
  ;; CHECK-NEXT:       (i32.add
  ;; CHECK-NEXT:        (local.get $2)
  ;; CHECK-NEXT:        (i32.const 1)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (i32.const 28)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.get $0)
  ;; CHECK-NEXT: )
  (func $array-mixed (result (ref $arr))
    (array.new_fixed $arr 28
      (call $f1 (i32.const 105))
      (call $f2 (i32.const 102))
      (global.get $g)
      (call $f1 (i32.const 119))
      (call $thunk)
