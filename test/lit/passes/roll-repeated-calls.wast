  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $same (param $map (ref $map))
    (call $other (local.get $map) (struct.new $pair (global.get $d) (global.get $d)) (i32.const 3))
    (call $other (local.get $map) (struct.new $pair (global.get $d) (global.get $d)) (i32.const 3))
    (call $other (local.get $map) (struct.new $pair (global.get $d) (global.get $d)) (i32.const 3))
