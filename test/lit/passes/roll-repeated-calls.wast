    (call $other (local.get $map) (struct.new $pair (global.get $d) (global.get $d)) (i32.const 3))
    (call $other (local.get $map) (struct.new $pair (global.get $d) (global.get $d)) (i32.const 3))
    (call $other (local.get $map) (struct.new $pair (global.get $d) (global.get $d)) (i32.const 3))
    (call $other (local.get $map) (struct.new $pair (global.get $d) (global.get $d)) (i32.const 3))
    (call $other (local.get $map) (struct.new $pair (global.get $d) (global.get $d)) (i32.const 3))
    (call $other (local.get $map) (struct.new $pair (global.get $d) (global.get $d)) (i32.const 3))
    (call $other (local.get $map) (struct.new $pair (global.get $d) (global.get $d)) (i32.const 3))
    (call $other (local.get $map) (struct.new $pair (global.get $d) (global.get $d)) (i32.const 3))
    (call $other (local.get $map) (struct.new $pair (global.get $d) (global.get $d)) (i32.const 3))
    (call $other (local.get $map) (struct.new $pair (global.get $d) (global.get $d)) (i32.const 3))
    (call $other (local.get $map) (struct.new $pair (global.get $d) (global.get $d)) (i32.const 3))
  )
)

;; Nothing to do: a short run, a run interrupted by a different statement, a
;; run of statements with different shapes (a different local), and
;; statements with control flow are all left alone.
(module






  ;; CHECK:      (type $0 (func (param i32)))

  ;; CHECK:      (type $1 (func (param i32 i32)))

  ;; CHECK:      (import "env" "f" (func $f (type $0) (param i32)))
  (import "env" "f" (func $f (param i32)))

  ;; CHECK:      (func $short (type $1) (param $x i32) (param $y i32)
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (i32.const 1000)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (i32.const 1003)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (i32.const 1007)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $x
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (i32.const 1010)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (i32.const 1020)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (i32.const 1030)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (local.get $y)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (local.get $y)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (local.get $y)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (local.get $y)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (if (result i32)
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:    (then
  ;; CHECK-NEXT:     (i32.const 1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (else
  ;; CHECK-NEXT:     (i32.const 2)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (if (result i32)
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:    (then
  ;; CHECK-NEXT:     (i32.const 3)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (else
  ;; CHECK-NEXT:     (i32.const 4)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (if (result i32)
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:    (then
  ;; CHECK-NEXT:     (i32.const 5)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (else
  ;; CHECK-NEXT:     (i32.const 6)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (if (result i32)
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:    (then
  ;; CHECK-NEXT:     (i32.const 7)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (else
  ;; CHECK-NEXT:     (i32.const 8)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $short (param $x i32) (param $y i32)
    (call $f (i32.const 1000))
    (call $f (i32.const 1003))
    (call $f (i32.const 1007))
    (local.set $x (i32.const 0))
    (call $f (i32.const 1010))
    (call $f (i32.const 1020))
    (call $f (i32.const 1030))
    (call $f (local.get $x))
    (call $f (local.get $y))
    (call $f (local.get $x))
    (call $f (local.get $y))
    (call $f (local.get $x))
    (call $f (local.get $y))
    (call $f (local.get $x))
    (call $f (local.get $y))
    (call $f (if (result i32) (local.get $x) (then (i32.const 1)) (else (i32.const 2))))
    (call $f (if (result i32) (local.get $x) (then (i32.const 3)) (else (i32.const 4))))
    (call $f (if (result i32) (local.get $x) (then (i32.const 5)) (else (i32.const 6))))
    (call $f (if (result i32) (local.get $x) (then (i32.const 7)) (else (i32.const 8))))
  )
)

;; A hole may mix global.gets with calls of one factory on a constant: the
;; column then holds a table index or, past the table size, the argument of
;; the call. Calls of small pure functions without parameters (here $one, an
;; outlined allocation) are inlined so that they take the shape of the other
;; statements. The second f64 column reads the constant global of $one.
(module
  ;; CHECK:      (type $str (struct (field i32)))
  (type $str (struct (field i32)))
  ;; CHECK:      (type $box (struct (field f64)))
  (type $box (struct (field f64)))
  ;; CHECK:      (type $map (struct (field (mut i32))))
  (type $map (struct (field (mut i32))))

  ;; CHECK:      (type $3 (array (ref $str)))

  ;; CHECK:      (type $4 (array (mut i8)))

  ;; CHECK:      (type $5 (array (mut f64)))

  ;; CHECK:      (type $6 (func (param (ref $map) (ref $str) (ref $box)) (result (ref $map))))

  ;; CHECK:      (type $7 (func (param i32) (result (ref $str))))

  ;; CHECK:      (type $8 (func (result (ref $box))))

  ;; CHECK:      (type $9 (func (param (ref $map))))

  ;; CHECK:      (import "env" "put" (func $put (type $6) (param (ref $map) (ref $str) (ref $box)) (result (ref $map))))
  (import "env" "put" (func $put (param (ref $map) (ref $str) (ref $box)) (result (ref $map))))

  ;; CHECK:      (global $a (ref $str) (struct.new $str
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT: ))
  (global $a (ref $str) (struct.new $str (i32.const 1)))
  ;; CHECK:      (global $b (ref $str) (struct.new $str
  ;; CHECK-NEXT:  (i32.const 2)
  ;; CHECK-NEXT: ))
  (global $b (ref $str) (struct.new $str (i32.const 2)))
  ;; CHECK:      (global $one f64 (f64.const 1))
  (global $one f64 (f64.const 1))

  ;; CHECK:      (global $roll$table (ref $3) (array.new_fixed $3 2
  ;; CHECK-NEXT:  (global.get $a)
  ;; CHECK-NEXT:  (global.get $b)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (data $roll "fg\00hi\01jk\00lmnopqr\00\00\00\00\00\00\04@\00\00\00\00\00\00\0c@\00\00\00\00\00\00\f0?\00\00\00\00\00\00\12@\00\00\00\00\00\00\16@\00\00\00\00\00\00\1a@\00\00\00\00\00\00\1e@\00\00\00\00\00\00\f0?\00\00\00\00\00\00!@\00\00\00\00\00\00%@\00\00\00\00\00\00\'@\00\00\00\00\00\00+@\00\00\00\00\00\00-@\00\00\00\00\00\00/@\00\00\00\00\00\800@\00\00\00\00\00\801@")

  ;; CHECK:      (func $factory (type $7) (param $i i32) (result (ref $str))
  ;; CHECK-NEXT:  (struct.new $str
  ;; CHECK-NEXT:   (local.get $i)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
