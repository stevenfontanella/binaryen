  ;; CHECK-NEXT:  (global.get $a)
  ;; CHECK-NEXT:  (global.get $d)
  ;; CHECK-NEXT:  (global.get $c)
  ;; CHECK-NEXT:  (global.get $b)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (data $roll "\00\01\02\03\00\01\02\03\00\01\02\03\00\01\02\03\03\02\01\00\03\02\01\00\03\02\01\00\03\02\01\00\00\00\00\00\00\00\f0?\00\00\00\00\00\00\04@\00\00\00\00\00\00\08@\00\00\00\00\00\00\10@\00\00\00\00\00\00\15@\00\00\00\00\00\00\18@\00\00\00\00\00\00\1c@\00\00\00\00\00\00 @\00\00\00\00\00\00$@\00\00\00\00\00\00&@\00\00\00\00\00\00*@\00\00\00\00\00\00,@\00\00\00\00\00\00.@\00\00\00\00\00\00\e0?\00\00\00\00\00\000@\00\00\00\00\00\001@")

  ;; CHECK:      (func $fill (type $7) (param $map (ref $map))
  ;; CHECK-NEXT:  (local $1 (ref $4))
  ;; CHECK-NEXT:  (local $2 (ref $5))
  ;; CHECK-NEXT:  (local $3 i32)
  ;; CHECK-NEXT:  (call $other
  ;; CHECK-NEXT:   (local.get $map)
  ;; CHECK-NEXT:   (struct.new $pair
  ;; CHECK-NEXT:    (global.get $a)
  ;; CHECK-NEXT:    (global.get $a)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (i32.const 0)
