    (call $other (local.get $map) (struct.new $pair (global.get $d) (global.get $d)) (i32.const 3))
    (call $other (local.get $map) (struct.new $pair (global.get $d) (global.get $d)) (i32.const 3))
    (call $other (local.get $map) (struct.new $pair (global.get $d) (global.get $d)) (i32.const 3))
    (call $other (local.get $map) (struct.new $pair (global.get $d) (global.get $d)) (i32.const 3))
    (call $other (local.get $map) (struct.new $pair (global.get $d) (global.get $d)) (i32.const 3))
    (call $other (local.get $map) (struct.new $pair (global.get $d) (global.get $d)) (i32.const 3))
    (call $other (local.get $map) (struct.new $pair (global.get $d) (global.get $d)) (i32.const 3))
    (call $other (local.get $map) (struct.new $pair (global.get $d) (global.get $d)) (i32.const 3))
    (call $other (local.get $map) (struct.new $pair (global.get $d) (global.get $d)) (i32.const 3))
    (call $other (local.get $map) (struct.new $pair (global.get $d) (global.get $d)) (i32.const 3))
    (call $other (local.get $map) (struct.new $pair (global.get $d) (global.get $d)) (i32.const 3))
  )
)

;; Nothing to do: a short run, a run interrupted by a different statement, a
;; run of statements with different shapes (a different local), and
;; statements with control flow are all left alone.
(module






  ;; CHECK:      (type $0 (func (param i32)))

  ;; CHECK:      (type $1 (func (param i32 i32)))

  ;; CHECK:      (import "env" "f" (func $f (type $0) (param i32)))
  (import "env" "f" (func $f (param i32)))

  ;; CHECK:      (func $short (type $1) (param $x i32) (param $y i32)
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (i32.const 1000)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (i32.const 1003)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (i32.const 1007)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $x
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (i32.const 1010)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (i32.const 1020)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (i32.const 1030)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (local.get $y)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (local.get $y)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (local.get $y)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (local.get $y)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (if (result i32)
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:    (then
  ;; CHECK-NEXT:     (i32.const 1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (else
  ;; CHECK-NEXT:     (i32.const 2)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (if (result i32)
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:    (then
  ;; CHECK-NEXT:     (i32.const 3)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (else
  ;; CHECK-NEXT:     (i32.const 4)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (if (result i32)
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:    (then
  ;; CHECK-NEXT:     (i32.const 5)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (else
  ;; CHECK-NEXT:     (i32.const 6)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (if (result i32)
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:    (then
  ;; CHECK-NEXT:     (i32.const 7)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (else
  ;; CHECK-NEXT:     (i32.const 8)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $short (param $x i32) (param $y i32)
    (call $f (i32.const 1000))
    (call $f (i32.const 1003))
    (call $f (i32.const 1007))
    (local.set $x (i32.const 0))
    (call $f (i32.const 1010))
    (call $f (i32.const 1020))
    (call $f (i32.const 1030))
    (call $f (local.get $x))
    (call $f (local.get $y))
    (call $f (local.get $x))
    (call $f (local.get $y))
    (call $f (local.get $x))
    (call $f (local.get $y))
    (call $f (local.get $x))
    (call $f (local.get $y))
    (call $f (if (result i32) (local.get $x) (then (i32.const 1)) (else (i32.const 2))))
    (call $f (if (result i32) (local.get $x) (then (i32.const 3)) (else (i32.const 4))))
    (call $f (if (result i32) (local.get $x) (then (i32.const 5)) (else (i32.const 6))))
    (call $f (if (result i32) (local.get $x) (then (i32.const 7)) (else (i32.const 8))))
  )
)

;; A hole may mix global.gets with calls of one factory on a constant: the
;; column then holds a table index or, past the table size, the argument of
;; the call. Calls of small pure functions without parameters (here $one, an
;; outlined allocation) are inlined so that they take the shape of the other
;; statements. The second f64 column reads the constant global of $one.
(module
  ;; CHECK:      (type $str (struct (field i32)))
  (type $str (struct (field i32)))
  ;; CHECK:      (type $box (struct (field f64)))
  (type $box (struct (field f64)))
  ;; CHECK:      (type $map (struct (field (mut i32))))
  (type $map (struct (field (mut i32))))

  ;; CHECK:      (type $3 (array (ref $str)))

  ;; CHECK:      (type $4 (array (mut i8)))

  ;; CHECK:      (type $5 (array (mut f64)))

  ;; CHECK:      (type $6 (func (param (ref $map) (ref $str) (ref $box)) (result (ref $map))))

  ;; CHECK:      (type $7 (func (param i32) (result (ref $str))))

  ;; CHECK:      (type $8 (func (result (ref $box))))

  ;; CHECK:      (type $9 (func (param (ref $map))))

  ;; CHECK:      (import "env" "put" (func $put (type $6) (param (ref $map) (ref $str) (ref $box)) (result (ref $map))))
  (import "env" "put" (func $put (param (ref $map) (ref $str) (ref $box)) (result (ref $map))))

  ;; CHECK:      (global $a (ref $str) (struct.new $str
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT: ))
  (global $a (ref $str) (struct.new $str (i32.const 1)))
  ;; CHECK:      (global $b (ref $str) (struct.new $str
  ;; CHECK-NEXT:  (i32.const 2)
  ;; CHECK-NEXT: ))
  (global $b (ref $str) (struct.new $str (i32.const 2)))
  ;; CHECK:      (global $one f64 (f64.const 1))
  (global $one f64 (f64.const 1))

  ;; CHECK:      (global $roll$table (ref $3) (array.new_fixed $3 2
  ;; CHECK-NEXT:  (global.get $a)
  ;; CHECK-NEXT:  (global.get $b)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (data $roll "fg\00hi\01jk\00lmnopqr\00\00\00\00\00\00\04@\00\00\00\00\00\00\0c@\00\00\00\00\00\00\f0?\00\00\00\00\00\00\12@\00\00\00\00\00\00\16@\00\00\00\00\00\00\1a@\00\00\00\00\00\00\1e@\00\00\00\00\00\00\f0?\00\00\00\00\00\00!@\00\00\00\00\00\00%@\00\00\00\00\00\00\'@\00\00\00\00\00\00+@\00\00\00\00\00\00-@\00\00\00\00\00\00/@\00\00\00\00\00\800@\00\00\00\00\00\801@")

  ;; CHECK:      (func $factory (type $7) (param $i i32) (result (ref $str))
  ;; CHECK-NEXT:  (struct.new $str
  ;; CHECK-NEXT:   (local.get $i)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $factory (param $i i32) (result (ref $str))
    (struct.new $str (local.get $i))
  )

  ;; CHECK:      (func $one (type $8) (result (ref $box))
  ;; CHECK-NEXT:  (struct.new $box
  ;; CHECK-NEXT:   (global.get $one)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $one (result (ref $box))
    (struct.new $box (global.get $one))
  )

  ;; CHECK:      (func $fill (type $9) (param $map (ref $map))
  ;; CHECK-NEXT:  (local $1 (ref $4))
  ;; CHECK-NEXT:  (local $2 (ref $5))
  ;; CHECK-NEXT:  (local $3 i32)
  ;; CHECK-NEXT:  (local $4 i32)
  ;; CHECK-NEXT:  (local.set $1
  ;; CHECK-NEXT:   (array.new_data $4 $roll
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:    (i32.const 16)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $2
  ;; CHECK-NEXT:   (array.new_data $5 $roll
  ;; CHECK-NEXT:    (i32.const 16)
  ;; CHECK-NEXT:    (i32.const 16)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block
  ;; CHECK-NEXT:   (local.set $3
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (loop $roll
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (call $put
  ;; CHECK-NEXT:      (local.get $map)
  ;; CHECK-NEXT:      (if (result (ref $str))
  ;; CHECK-NEXT:       (i32.lt_u
  ;; CHECK-NEXT:        (local.tee $4
  ;; CHECK-NEXT:         (array.get_u $4
  ;; CHECK-NEXT:          (local.get $1)
  ;; CHECK-NEXT:          (local.get $3)
  ;; CHECK-NEXT:         )
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:        (i32.const 2)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:       (then
  ;; CHECK-NEXT:        (array.get $3
  ;; CHECK-NEXT:         (global.get $roll$table)
  ;; CHECK-NEXT:         (local.get $4)
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:       (else
  ;; CHECK-NEXT:        (call $factory
  ;; CHECK-NEXT:         (i32.sub
  ;; CHECK-NEXT:          (local.get $4)
  ;; CHECK-NEXT:          (i32.const 2)
  ;; CHECK-NEXT:         )
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (struct.new $box
  ;; CHECK-NEXT:       (array.get $5
  ;; CHECK-NEXT:        (local.get $2)
  ;; CHECK-NEXT:        (local.get $3)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (br_if $roll
  ;; CHECK-NEXT:     (i32.lt_u
  ;; CHECK-NEXT:      (local.tee $3
  ;; CHECK-NEXT:       (i32.add
  ;; CHECK-NEXT:        (local.get $3)
  ;; CHECK-NEXT:        (i32.const 1)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (i32.const 16)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $fill (param $map (ref $map))
    (drop (call $put (local.get $map) (call $factory (i32.const 100)) (struct.new $box (f64.const 2.5))))
    (drop (call $put (local.get $map) (call $factory (i32.const 101)) (struct.new $box (f64.const 3.5))))
    (drop (call $put (local.get $map) (global.get $a) (call $one)))
    (drop (call $put (local.get $map) (call $factory (i32.const 102)) (struct.new $box (f64.const 4.5))))
    (drop (call $put (local.get $map) (call $factory (i32.const 103)) (struct.new $box (f64.const 5.5))))
    (drop (call $put (local.get $map) (global.get $b) (struct.new $box (f64.const 6.5))))
    (drop (call $put (local.get $map) (call $factory (i32.const 104)) (struct.new $box (f64.const 7.5))))
    (drop (call $put (local.get $map) (call $factory (i32.const 105)) (call $one)))
    (drop (call $put (local.get $map) (global.get $a) (struct.new $box (f64.const 8.5))))
    (drop (call $put (local.get $map) (call $factory (i32.const 106)) (struct.new $box (f64.const 10.5))))
    (drop (call $put (local.get $map) (call $factory (i32.const 107)) (struct.new $box (f64.const 11.5))))
    (drop (call $put (local.get $map) (call $factory (i32.const 108)) (struct.new $box (f64.const 13.5))))
    (drop (call $put (local.get $map) (call $factory (i32.const 109)) (struct.new $box (f64.const 14.5))))
    (drop (call $put (local.get $map) (call $factory (i32.const 110)) (struct.new $box (f64.const 15.5))))
    (drop (call $put (local.get $map) (call $factory (i32.const 111)) (struct.new $box (f64.const 16.5))))
    (drop (call $put (local.get $map) (call $factory (i32.const 112)) (struct.new $box (f64.const 17.5))))
  )
)

;; Values that are close to their predecessors become a byte column of
;; differences, accumulated in a local. The two factories differ, so the
;; statements form two runs (the loose run over both does not work out, and
;; the strict runs are tried instead).
(module
  ;; CHECK:      (type $str (struct (field i32)))
  (type $str (struct (field i32)))

  ;; CHECK:      (type $1 (array (mut i8)))

  ;; CHECK:      (type $2 (func (param i32) (result (ref $str))))

  ;; CHECK:      (type $3 (func (param (ref $str))))

  ;; CHECK:      (type $4 (func))

  ;; CHECK:      (import "env" "use" (func $use (type $3) (param (ref $str))))
  (import "env" "use" (func $use (param (ref $str))))

  ;; CHECK:      (data $roll "\00\03\04\00\03\n\nd\01E\01\01\00\03\04\00\03\n\nd\01E\01\01")

  ;; CHECK:      (func $factory (type $2) (param $i i32) (result (ref $str))
  ;; CHECK-NEXT:  (struct.new $str
  ;; CHECK-NEXT:   (local.get $i)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $factory (param $i i32) (result (ref $str))
    (struct.new $str (local.get $i))
  )
  ;; CHECK:      (func $factory2 (type $2) (param $i i32) (result (ref $str))
  ;; CHECK-NEXT:  (struct.new $str
  ;; CHECK-NEXT:   (i32.add
  ;; CHECK-NEXT:    (local.get $i)
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $factory2 (param $i i32) (result (ref $str))
    (struct.new $str (i32.add (local.get $i) (i32.const 1)))
  )

  ;; CHECK:      (func $run (type $4)
  ;; CHECK-NEXT:  (local $0 (ref $1))
  ;; CHECK-NEXT:  (local $1 i32)
  ;; CHECK-NEXT:  (local $2 i32)
  ;; CHECK-NEXT:  (local $3 i32)
  ;; CHECK-NEXT:  (local $4 i32)
  ;; CHECK-NEXT:  (local.set $0
  ;; CHECK-NEXT:   (array.new_data $1 $roll
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:    (i32.const 24)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block
  ;; CHECK-NEXT:   (local.set $3
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (local.set $4
  ;; CHECK-NEXT:    (i32.const 1000)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (loop $roll_1
  ;; CHECK-NEXT:    (call $use
  ;; CHECK-NEXT:     (call $factory
  ;; CHECK-NEXT:      (local.tee $4
  ;; CHECK-NEXT:       (i32.add
  ;; CHECK-NEXT:        (local.get $4)
  ;; CHECK-NEXT:        (array.get_u $1
  ;; CHECK-NEXT:         (local.get $0)
  ;; CHECK-NEXT:         (local.get $3)
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (br_if $roll_1
  ;; CHECK-NEXT:     (i32.lt_u
  ;; CHECK-NEXT:      (local.tee $3
  ;; CHECK-NEXT:       (i32.add
  ;; CHECK-NEXT:        (local.get $3)
  ;; CHECK-NEXT:        (i32.const 1)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (i32.const 12)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block
  ;; CHECK-NEXT:   (local.set $1
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (local.set $2
  ;; CHECK-NEXT:    (i32.const 5000)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (loop $roll
  ;; CHECK-NEXT:    (call $use
  ;; CHECK-NEXT:     (call $factory2
  ;; CHECK-NEXT:      (local.tee $2
  ;; CHECK-NEXT:       (i32.add
  ;; CHECK-NEXT:        (local.get $2)
  ;; CHECK-NEXT:        (array.get_u $1
  ;; CHECK-NEXT:         (local.get $0)
  ;; CHECK-NEXT:         (i32.add
  ;; CHECK-NEXT:          (local.get $1)
  ;; CHECK-NEXT:          (i32.const 12)
  ;; CHECK-NEXT:         )
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (br_if $roll
  ;; CHECK-NEXT:     (i32.lt_u
  ;; CHECK-NEXT:      (local.tee $1
  ;; CHECK-NEXT:       (i32.add
  ;; CHECK-NEXT:        (local.get $1)
  ;; CHECK-NEXT:        (i32.const 1)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (i32.const 12)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $run
    (call $use (call $factory (i32.const 1000)))
    (call $use (call $factory (i32.const 1003)))
    (call $use (call $factory (i32.const 1007)))
    (call $use (call $factory (i32.const 1007)))
    (call $use (call $factory (i32.const 1010)))
    (call $use (call $factory (i32.const 1020)))
    (call $use (call $factory (i32.const 1030)))
    (call $use (call $factory (i32.const 1130)))
    (call $use (call $factory (i32.const 1131)))
    (call $use (call $factory (i32.const 1200)))
    (call $use (call $factory (i32.const 1201)))
    (call $use (call $factory (i32.const 1202)))
    (call $use (call $factory2 (i32.const 5000)))
    (call $use (call $factory2 (i32.const 5003)))
    (call $use (call $factory2 (i32.const 5007)))
    (call $use (call $factory2 (i32.const 5007)))
    (call $use (call $factory2 (i32.const 5010)))
    (call $use (call $factory2 (i32.const 5020)))
    (call $use (call $factory2 (i32.const 5030)))
    (call $use (call $factory2 (i32.const 5130)))
    (call $use (call $factory2 (i32.const 5131)))
    (call $use (call $factory2 (i32.const 5200)))
    (call $use (call $factory2 (i32.const 5201)))
    (call $use (call $factory2 (i32.const 5202)))
  )
)
