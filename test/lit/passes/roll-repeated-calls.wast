  ;; CHECK-NEXT:   (loop $roll
  ;; CHECK-NEXT:    (drop
  ;; CHECK-NEXT:     (call $put
  ;; CHECK-NEXT:      (local.get $map)
  ;; CHECK-NEXT:      (struct.new $pair
  ;; CHECK-NEXT:       (array.get $3
  ;; CHECK-NEXT:        (global.get $roll$table)
  ;; CHECK-NEXT:        (array.get_u $4
  ;; CHECK-NEXT:         (local.get $1)
  ;; CHECK-NEXT:         (local.get $3)
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:       (array.get $3
  ;; CHECK-NEXT:        (global.get $roll$table)
  ;; CHECK-NEXT:        (array.get_u $4
  ;; CHECK-NEXT:         (local.get $1)
  ;; CHECK-NEXT:         (i32.add
  ;; CHECK-NEXT:          (local.get $3)
  ;; CHECK-NEXT:          (i32.const 16)
  ;; CHECK-NEXT:         )
  ;; CHECK-NEXT:        )
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (struct.new $box
  ;; CHECK-NEXT:       (array.get $5
  ;; CHECK-NEXT:        (local.get $2)
  ;; CHECK-NEXT:        (local.get $3)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (br_if $roll
  ;; CHECK-NEXT:     (i32.lt_u
  ;; CHECK-NEXT:      (local.tee $3
  ;; CHECK-NEXT:       (i32.add
  ;; CHECK-NEXT:        (local.get $3)
  ;; CHECK-NEXT:        (i32.const 1)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (i32.const 16)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $other
  ;; CHECK-NEXT:   (local.get $map)
  ;; CHECK-NEXT:   (struct.new $pair
  ;; CHECK-NEXT:    (global.get $a)
  ;; CHECK-NEXT:    (global.get $a)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $fill (param $map (ref $map))
    (call $other (local.get $map) (struct.new $pair (global.get $a) (global.get $a)) (i32.const 0))
    (drop (call $put (local.get $map) (struct.new $pair (global.get $a) (global.get $b)) (struct.new $box (f64.const 1))))
    (drop (call $put (local.get $map) (struct.new $pair (global.get $d) (global.get $c)) (struct.new $box (f64.const 2.5))))
    (drop (call $put (local.get $map) (struct.new $pair (global.get $c) (global.get $d)) (struct.new $box (f64.const 3))))
    (drop (call $put (local.get $map) (struct.new $pair (global.get $b) (global.get $a)) (struct.new $box (f64.const 4))))
    (drop (call $put (local.get $map) (struct.new $pair (global.get $a) (global.get $b)) (struct.new $box (f64.const 5.25))))
    (drop (call $put (local.get $map) (struct.new $pair (global.get $d) (global.get $c)) (struct.new $box (f64.const 6))))
    (drop (call $put (local.get $map) (struct.new $pair (global.get $c) (global.get $d)) (struct.new $box (f64.const 7))))
    (drop (call $put (local.get $map) (struct.new $pair (global.get $b) (global.get $a)) (struct.new $box (f64.const 8))))
    (drop (call $put (local.get $map) (struct.new $pair (global.get $a) (global.get $b)) (struct.new $box (f64.const 10))))
    (drop (call $put (local.get $map) (struct.new $pair (global.get $d) (global.get $c)) (struct.new $box (f64.const 11))))
    (drop (call $put (local.get $map) (struct.new $pair (global.get $c) (global.get $d)) (struct.new $box (f64.const 13))))
    (drop (call $put (local.get $map) (struct.new $pair (global.get $b) (global.get $a)) (struct.new $box (f64.const 14))))
    (drop (call $put (local.get $map) (struct.new $pair (global.get $a) (global.get $b)) (struct.new $box (f64.const 15))))
    (drop (call $put (local.get $map) (struct.new $pair (global.get $d) (global.get $c)) (struct.new $box (f64.const 0.5))))
    (drop (call $put (local.get $map) (struct.new $pair (global.get $c) (global.get $d)) (struct.new $box (f64.const 16))))
    (drop (call $put (local.get $map) (struct.new $pair (global.get $b) (global.get $a)) (struct.new $box (f64.const 17))))
    (call $other (local.get $map) (struct.new $pair (global.get $a) (global.get $a)) (i32.const 1))
  )

  ;; Identical statements: no columns at all. The globals are all the same, so
  ;; they are fixed; a second table is not needed.
  ;; CHECK:      (func $same (type $7) (param $map (ref $map))
  ;; CHECK-NEXT:  (local $1 i32)
  ;; CHECK-NEXT:  (block
  ;; CHECK-NEXT:   (local.set $1
