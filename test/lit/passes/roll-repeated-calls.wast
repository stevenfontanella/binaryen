;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: foreach %s %t wasm-opt --roll-repeated-calls -all -S -o - | filecheck %s

;; Varying i32 constants with gaps become a byte column in a passive data
;; segment; an arithmetic progression becomes a computation on the counter;
;; constants on which all the statements agree stay inline.
(module










  ;; CHECK:      (type $0 (array (mut i8)))

  ;; CHECK:      (type $1 (func (param i32 i32 i32)))

  ;; CHECK:      (type $2 (func))

  ;; CHECK:      (import "env" "f" (func $f (type $1) (param i32 i32 i32)))
  (import "env" "f" (func $f (param i32 i32 i32)))



  ;; CHECK:      (data $roll "\01\03\04\07\n\0b\0c\10\11\13\14\17\18\19\1a\1e")

  ;; CHECK:      (func $run (type $2)
  ;; CHECK-NEXT:  (local $0 (ref $0))
  ;; CHECK-NEXT:  (local $1 i32)
  ;; CHECK-NEXT:  (local.set $0
  ;; CHECK-NEXT:   (array.new_data $0 $roll
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:    (i32.const 16)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block
  ;; CHECK-NEXT:   (local.set $1
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (loop $roll
  ;; CHECK-NEXT:    (call $f
  ;; CHECK-NEXT:     (array.get_u $0
  ;; CHECK-NEXT:      (local.get $0)
  ;; CHECK-NEXT:      (local.get $1)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (i32.add
  ;; CHECK-NEXT:      (i32.mul
  ;; CHECK-NEXT:       (local.get $1)
  ;; CHECK-NEXT:       (i32.const 10)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (i32.const 1000)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (i32.const 42)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (br_if $roll
  ;; CHECK-NEXT:     (i32.lt_u
  ;; CHECK-NEXT:      (local.tee $1
  ;; CHECK-NEXT:       (i32.add
  ;; CHECK-NEXT:        (local.get $1)
  ;; CHECK-NEXT:        (i32.const 1)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (i32.const 16)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $run
    (call $f (i32.const 1) (i32.const 1000) (i32.const 42))
    (call $f (i32.const 3) (i32.const 1010) (i32.const 42))
    (call $f (i32.const 4) (i32.const 1020) (i32.const 42))
    (call $f (i32.const 7) (i32.const 1030) (i32.const 42))
    (call $f (i32.const 10) (i32.const 1040) (i32.const 42))
    (call $f (i32.const 11) (i32.const 1050) (i32.const 42))
    (call $f (i32.const 12) (i32.const 1060) (i32.const 42))
    (call $f (i32.const 16) (i32.const 1070) (i32.const 42))
    (call $f (i32.const 17) (i32.const 1080) (i32.const 42))
    (call $f (i32.const 19) (i32.const 1090) (i32.const 42))
    (call $f (i32.const 20) (i32.const 1100) (i32.const 42))
    (call $f (i32.const 23) (i32.const 1110) (i32.const 42))
    (call $f (i32.const 24) (i32.const 1120) (i32.const 42))
    (call $f (i32.const 25) (i32.const 1130) (i32.const 42))
    (call $f (i32.const 26) (i32.const 1140) (i32.const 42))
    (call $f (i32.const 30) (i32.const 1150) (i32.const 42))
  )
)

;; Varying immutable globals become a table of the distinct globals indexed by
;; a byte column; varying f64 constants become an f64 column; the local.get and
;; the vtable global that every statement agrees on stay. The two i8 columns
;; share one array (the second one is read at an offset). The runs in both
;; functions are rolled; statements between them stay as they are.
(module
  ;; CHECK:      (type $unit (struct (field i32)))
  (type $unit (struct (field i32)))
  ;; CHECK:      (type $pair (struct (field (ref $unit)) (field (ref $unit))))
  (type $pair (struct (field (ref $unit)) (field (ref $unit))))








  ;; CHECK:      (type $map (struct (field (mut i32))))

  ;; CHECK:      (type $3 (array (ref $unit)))

  ;; CHECK:      (type $4 (array (mut i8)))

  ;; CHECK:      (type $5 (array (mut f64)))

  ;; CHECK:      (type $box (struct (field f64)))
  (type $box (struct (field f64)))
  (type $map (struct (field (mut i32))))













  ;; CHECK:      (type $7 (func (param (ref $map))))

  ;; CHECK:      (type $8 (func (param (ref $map) (ref $pair) (ref $box)) (result (ref $map))))

  ;; CHECK:      (type $9 (func (param (ref $map) (ref $pair) i32)))

  ;; CHECK:      (import "env" "put" (func $put (type $8) (param (ref $map) (ref $pair) (ref $box)) (result (ref $map))))
  (import "env" "put" (func $put (param (ref $map) (ref $pair) (ref $box)) (result (ref $map))))
  ;; CHECK:      (import "env" "other" (func $other (type $9) (param (ref $map) (ref $pair) i32)))
  (import "env" "other" (func $other (param (ref $map) (ref $pair) i32)))

  ;; CHECK:      (global $a (ref $unit) (struct.new $unit
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT: ))
  (global $a (ref $unit) (struct.new $unit (i32.const 1)))
  ;; CHECK:      (global $b (ref $unit) (struct.new $unit
  ;; CHECK-NEXT:  (i32.const 2)
  ;; CHECK-NEXT: ))
  (global $b (ref $unit) (struct.new $unit (i32.const 2)))
  ;; CHECK:      (global $c (ref $unit) (struct.new $unit
  ;; CHECK-NEXT:  (i32.const 3)
  ;; CHECK-NEXT: ))
  (global $c (ref $unit) (struct.new $unit (i32.const 3)))
  ;; CHECK:      (global $d (ref $unit) (struct.new $unit
  ;; CHECK-NEXT:  (i32.const 4)
  ;; CHECK-NEXT: ))
  (global $d (ref $unit) (struct.new $unit (i32.const 4)))







