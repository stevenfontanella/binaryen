  ;; CHECK-NEXT:   (local.get $i)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $f1 (param $i i32) (result (ref $str))
    (struct.new $str (local.get $i))
  )
  ;; CHECK:      (func $f2 (type $4) (param $i i32) (result (ref $str))
  ;; CHECK-NEXT:  (struct.new $str
  ;; CHECK-NEXT:   (i32.add
  ;; CHECK-NEXT:    (local.get $i)
  ;; CHECK-NEXT:    (i32.const 100)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
