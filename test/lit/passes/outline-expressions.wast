  (func $caller_c (param $k i32) (param $r (ref null $Mid)) (param $other (ref null $Base)) (result i32)
    (i32.xor
      (call $partial_wrap_callee (local.get $k) (local.get $other))
      (i32.add
        (struct.get $Sub 2
          (ref.cast (ref null $Sub) (local.get $r))
