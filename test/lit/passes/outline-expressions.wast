  ;; SHRINK:      (type $1 (func (param i32 i32 i32)))

  ;; SHRINK:      (type $2 (func (param i32)))

  ;; SHRINK:      (func $f (type $1) (param $0 i32) (param $1 i32) (param $2 i32)
  ;; SHRINK-NEXT: )
  (func $f (param i32 i32 i32))

  ;; CHECK:      (func $a (type $0) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (i32.const 1000)
  ;; CHECK-NEXT:   (i32.const 2000)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $a (type $0) (param $x i32) (result i32)
  ;; SHRINK-NEXT:  (call $outlined
  ;; SHRINK-NEXT:   (local.get $x)
  ;; SHRINK-NEXT:  )
  ;; SHRINK-NEXT:  (i32.const 1)
  ;; SHRINK-NEXT: )
  (func $a (param $x i32) (result i32)
    (call $f (local.get $x) (i32.const 1000) (i32.const 2000))
    (i32.const 1)
  )

  ;; CHECK:      (func $b (type $0) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (i32.const 1000)
  ;; CHECK-NEXT:   (i32.const 2000)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (i32.const 2)
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $b (type $0) (param $x i32) (result i32)
  ;; SHRINK-NEXT:  (call $outlined
  ;; SHRINK-NEXT:   (local.get $x)
  ;; SHRINK-NEXT:  )
  ;; SHRINK-NEXT:  (i32.const 2)
  ;; SHRINK-NEXT: )
  (func $b (param $x i32) (result i32)
    (call $f (local.get $x) (i32.const 1000) (i32.const 2000))
    (i32.const 2)
  )

  ;; CHECK:      (func $c (type $0) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (i32.const 1000)
  ;; CHECK-NEXT:   (i32.const 2000)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (i32.const 3)
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $c (type $0) (param $x i32) (result i32)
  ;; SHRINK-NEXT:  (call $outlined
  ;; SHRINK-NEXT:   (local.get $x)
  ;; SHRINK-NEXT:  )
  ;; SHRINK-NEXT:  (i32.const 3)
  ;; SHRINK-NEXT: )
  (func $c (param $x i32) (result i32)
    (call $f (local.get $x) (i32.const 1000) (i32.const 2000))
    (i32.const 3)
  )
)

;; A pure tree with no call is only outlined when shrinking.
;; SHRINK:      (func $outlined (type $2) (param $0 i32)
;; SHRINK-NEXT:  (call $f
;; SHRINK-NEXT:   (local.get $0)
;; SHRINK-NEXT:   (i32.const 1000)
;; SHRINK-NEXT:   (i32.const 2000)
;; SHRINK-NEXT:  )
;; SHRINK-NEXT: )
(module
  ;; CHECK:      (type $A (struct (field i32) (field (ref null $A))))
  ;; SHRINK:      (type $A (struct (field i32) (field (ref null $A))))
  (type $A (struct (field i32) (field (ref null $A))))

  ;; CHECK:      (type $1 (func (param (ref $A)) (result i32)))

  ;; CHECK:      (func $a (type $1) (param $x (ref $A)) (result i32)
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (struct.get $A 0
  ;; CHECK-NEXT:    (struct.get $A 1
  ;; CHECK-NEXT:     (struct.get $A 1
  ;; CHECK-NEXT:      (local.get $x)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; SHRINK:      (type $1 (func (param (ref $A)) (result i32)))

  ;; SHRINK:      (func $a (type $1) (param $x (ref $A)) (result i32)
  ;; SHRINK-NEXT:  (i32.add
  ;; SHRINK-NEXT:   (i32.const 1)
  ;; SHRINK-NEXT:   (struct.get $A 0
  ;; SHRINK-NEXT:    (struct.get $A 1
  ;; SHRINK-NEXT:     (struct.get $A 1
  ;; SHRINK-NEXT:      (local.get $x)
  ;; SHRINK-NEXT:     )
  ;; SHRINK-NEXT:    )
  ;; SHRINK-NEXT:   )
  ;; SHRINK-NEXT:  )
  ;; SHRINK-NEXT: )
  (func $a (param $x (ref $A)) (result i32)
    (i32.add
      (i32.const 1)
      (struct.get $A 0
        (struct.get $A 1
          (struct.get $A 1
            (local.get $x)
          )
        )
      )
    )
  )

  ;; CHECK:      (func $b (type $1) (param $x (ref $A)) (result i32)
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (struct.get $A 0
  ;; CHECK-NEXT:    (struct.get $A 1
  ;; CHECK-NEXT:     (struct.get $A 1
  ;; CHECK-NEXT:      (local.get $x)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $b (type $1) (param $x (ref $A)) (result i32)
  ;; SHRINK-NEXT:  (call $a
  ;; SHRINK-NEXT:   (local.get $x)
  ;; SHRINK-NEXT:  )
  ;; SHRINK-NEXT: )
  (func $b (param $x (ref $A)) (result i32)
    (i32.add
      (i32.const 1)
      (struct.get $A 0
        (struct.get $A 1
          (struct.get $A 1
            (local.get $x)
          )
        )
      )
    )
  )

  ;; CHECK:      (func $c (type $1) (param $x (ref $A)) (result i32)
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (struct.get $A 0
  ;; CHECK-NEXT:    (struct.get $A 1
  ;; CHECK-NEXT:     (struct.get $A 1
  ;; CHECK-NEXT:      (local.get $x)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $c (type $1) (param $x (ref $A)) (result i32)
  ;; SHRINK-NEXT:  (call $a
  ;; SHRINK-NEXT:   (local.get $x)
  ;; SHRINK-NEXT:  )
  ;; SHRINK-NEXT: )
  (func $c (param $x (ref $A)) (result i32)
    (i32.add
      (i32.const 1)
      (struct.get $A 0
        (struct.get $A 1
          (struct.get $A 1
            (local.get $x)
          )
        )
      )
    )
  )
)

;; A guard of a once function is only outlined when shrinking.
(module

  ;; CHECK:      (type $0 (func))

  ;; CHECK:      (global $g (mut i32) (i32.const 0))
  ;; SHRINK:      (type $0 (func))

  ;; SHRINK:      (global $g (mut i32) (i32.const 0))
  (global $g (mut i32) (i32.const 0))

  ;; CHECK:      (func $init (type $0)
  ;; CHECK-NEXT:  (global.set $g
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $init (type $0)
  ;; SHRINK-NEXT:  (global.set $g
  ;; SHRINK-NEXT:   (i32.const 1)
  ;; SHRINK-NEXT:  )
  ;; SHRINK-NEXT: )
  (func $init
    (global.set $g (i32.const 1))
  )

  ;; CHECK:      (func $a (type $0)
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (i32.eqz
  ;; CHECK-NEXT:    (global.get $g)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (call $init)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $a (type $0)
  ;; SHRINK-NEXT:  (if
  ;; SHRINK-NEXT:   (i32.eqz
  ;; SHRINK-NEXT:    (global.get $g)
  ;; SHRINK-NEXT:   )
  ;; SHRINK-NEXT:   (then
  ;; SHRINK-NEXT:    (call $init)
  ;; SHRINK-NEXT:   )
  ;; SHRINK-NEXT:  )
  ;; SHRINK-NEXT:  (nop)
  ;; SHRINK-NEXT: )
  (func $a
    (if
      (i32.eqz (global.get $g))
      (then
        (call $init)
      )
    )
    (nop)
  )

  ;; CHECK:      (func $b (type $0)
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (i32.eqz
  ;; CHECK-NEXT:    (global.get $g)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (call $init)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $b (type $0)
  ;; SHRINK-NEXT:  (call $a)
  ;; SHRINK-NEXT: )
  (func $b
    (if
      (i32.eqz (global.get $g))
      (then
        (call $init)
      )
    )
    (nop)
  )

  ;; CHECK:      (func $c (type $0)
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (i32.eqz
  ;; CHECK-NEXT:    (global.get $g)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (call $init)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $c (type $0)
  ;; SHRINK-NEXT:  (call $a)
  ;; SHRINK-NEXT: )
  (func $c
    (if
      (i32.eqz (global.get $g))
      (then
        (call $init)
      )
    )
    (nop)
  )

  ;; CHECK:      (func $d (type $0)
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (i32.eqz
  ;; CHECK-NEXT:    (global.get $g)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (call $init)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $d (type $0)
  ;; SHRINK-NEXT:  (call $a)
  ;; SHRINK-NEXT: )
  (func $d
    (if
      (i32.eqz (global.get $g))
      (then
        (call $init)
      )
    )
    (nop)
  )

  ;; CHECK:      (func $e (type $0)
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (i32.eqz
  ;; CHECK-NEXT:    (global.get $g)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (call $init)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $e (type $0)
  ;; SHRINK-NEXT:  (call $a)
  ;; SHRINK-NEXT: )
  (func $e
    (if
      (i32.eqz (global.get $g))
      (then
        (call $init)
      )
    )
    (nop)
  )
)

;; Throws: the trees are unreachable, so the helper returns nothing and we add
;; an unreachable after each call.
(module
  ;; CHECK:      (type $E (struct (field i32) (field anyref)))
  ;; SHRINK:      (type $E (struct (field i32) (field anyref)))
  (type $E (struct (field i32) (field anyref)))

  ;; CHECK:      (type $1 (func (param i32)))

  ;; CHECK:      (type $2 (func (param (ref $E))))

  ;; CHECK:      (type $3 (func (param i32) (result (ref $E))))

  ;; CHECK:      (type $4 (func (param i32) (result i32)))

  ;; CHECK:      (type $5 (func (param i32) (result f64)))

  ;; CHECK:      (tag $e (type $2) (param (ref $E)))
  ;; SHRINK:      (type $1 (func (param i32)))

  ;; SHRINK:      (type $2 (func (param (ref $E))))

  ;; SHRINK:      (type $3 (func (param i32) (result (ref $E))))

  ;; SHRINK:      (type $4 (func (param i32) (result i32)))

  ;; SHRINK:      (type $5 (func (param i32) (result f64)))

  ;; SHRINK:      (tag $e (type $2) (param (ref $E)))
  (tag $e (param (ref $E)))

  ;; CHECK:      (func $make (type $3) (param $0 i32) (result (ref $E))
  ;; CHECK-NEXT:  (struct.new $E
  ;; CHECK-NEXT:   (local.get $0)
  ;; CHECK-NEXT:   (ref.null none)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $make (type $3) (param $0 i32) (result (ref $E))
  ;; SHRINK-NEXT:  (struct.new $E
  ;; SHRINK-NEXT:   (local.get $0)
  ;; SHRINK-NEXT:   (ref.null none)
  ;; SHRINK-NEXT:  )
  ;; SHRINK-NEXT: )
  (func $make (param i32) (result (ref $E))
    (struct.new $E (local.get 0) (ref.null none))
  )

  ;; CHECK:      (func $a (type $1) (param $x i32)
  ;; CHECK-NEXT:  (nop)
  ;; CHECK-NEXT:  (block
  ;; CHECK-NEXT:   (call $outlined
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (unreachable)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $a (type $1) (param $x i32)
  ;; SHRINK-NEXT:  (nop)
  ;; SHRINK-NEXT:  (block
  ;; SHRINK-NEXT:   (call $outlined
  ;; SHRINK-NEXT:    (local.get $x)
  ;; SHRINK-NEXT:   )
  ;; SHRINK-NEXT:   (unreachable)
  ;; SHRINK-NEXT:  )
  ;; SHRINK-NEXT: )
  (func $a (param $x i32)
    (nop)
    (throw $e
      (call $make
        (i32.add (local.get $x) (i32.const 1000000000))
      )
    )
  )

  ;; CHECK:      (func $b (type $4) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (call $outlined
  ;; CHECK-NEXT:     (local.get $x)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (i32.const 2)
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $b (type $4) (param $x i32) (result i32)
  ;; SHRINK-NEXT:  (if
  ;; SHRINK-NEXT:   (local.get $x)
  ;; SHRINK-NEXT:   (then
  ;; SHRINK-NEXT:    (call $outlined
  ;; SHRINK-NEXT:     (local.get $x)
  ;; SHRINK-NEXT:    )
  ;; SHRINK-NEXT:    (unreachable)
  ;; SHRINK-NEXT:   )
  ;; SHRINK-NEXT:  )
  ;; SHRINK-NEXT:  (i32.const 2)
  ;; SHRINK-NEXT: )
  (func $b (param $x i32) (result i32)
    (if
      (local.get $x)
      (then
        (throw $e
          (call $make
            (i32.add (local.get $x) (i32.const 1000000000))
          )
        )
      )
    )
    (i32.const 2)
  )

  ;; CHECK:      (func $c (type $5) (param $x i32) (result f64)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (block
  ;; CHECK-NEXT:    (call $outlined
  ;; CHECK-NEXT:     (local.get $x)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (unreachable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $c (type $5) (param $x i32) (result f64)
  ;; SHRINK-NEXT:  (drop
  ;; SHRINK-NEXT:   (block
  ;; SHRINK-NEXT:    (call $outlined
  ;; SHRINK-NEXT:     (local.get $x)
  ;; SHRINK-NEXT:    )
  ;; SHRINK-NEXT:    (unreachable)
  ;; SHRINK-NEXT:   )
  ;; SHRINK-NEXT:  )
  ;; SHRINK-NEXT: )
  (func $c (param $x i32) (result f64)
    (drop
      (throw $e
        (call $make
          (i32.add (local.get $x) (i32.const 1000000000))
        )
      )
    )
  )
)

;; Nested sites: the inner call appears five times, and would be worth outlining
;; on its own, but three of them are inside the outer tree, which we outline
;; instead, leaving the inner one with only two sites, which is not enough.

;; CHECK:      (func $outlined (type $1) (param $0 i32)
;; CHECK-NEXT:  (throw $e
;; CHECK-NEXT:   (call $make
;; CHECK-NEXT:    (i32.add
;; CHECK-NEXT:     (local.get $0)
;; CHECK-NEXT:     (i32.const 1000000000)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:  )
;; CHECK-NEXT: )

;; SHRINK:      (func $outlined (type $1) (param $0 i32)
;; SHRINK-NEXT:  (throw $e
;; SHRINK-NEXT:   (call $make
;; SHRINK-NEXT:    (i32.add
;; SHRINK-NEXT:     (local.get $0)
;; SHRINK-NEXT:     (i32.const 1000000000)
;; SHRINK-NEXT:    )
;; SHRINK-NEXT:   )
;; SHRINK-NEXT:  )
;; SHRINK-NEXT: )
(module
  ;; CHECK:      (type $A (sub (struct (field i32))))
  ;; SHRINK:      (type $A (sub (struct (field i32))))
  (type $A (sub (struct (field i32))))

  ;; CHECK:      (type $1 (func (param (ref null $A)) (result i32)))

  ;; CHECK:      (type $2 (func (param (ref null $A) i32) (result i32)))

  ;; CHECK:      (type $B (sub $A (struct (field i32) (field i32))))
  ;; SHRINK:      (type $1 (func (param (ref null $A)) (result i32)))

  ;; SHRINK:      (type $2 (func (param (ref null $A) i32) (result i32)))

  ;; SHRINK:      (type $B (sub $A (struct (field i32) (field i32))))
  (type $B (sub $A (struct (field i32) (field i32))))

  ;; CHECK:      (func $f (type $2) (param $0 (ref null $A)) (param $1 i32) (result i32)
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $f (type $2) (param $0 (ref null $A)) (param $1 i32) (result i32)
  ;; SHRINK-NEXT:  (i32.const 1)
  ;; SHRINK-NEXT: )
  (func $f (param (ref null $A)) (param i32) (result i32)
    (i32.const 1)
  )

  ;; CHECK:      (func $a (type $1) (param $x (ref null $A)) (result i32)
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (if (result i32)
  ;; CHECK-NEXT:    (ref.test (ref $B)
  ;; CHECK-NEXT:     (local.get $x)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (then
  ;; CHECK-NEXT:     (call $f
  ;; CHECK-NEXT:      (local.get $x)
  ;; CHECK-NEXT:      (i32.const 1000000)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (else
  ;; CHECK-NEXT:     (i32.const 2147483647)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $a (type $1) (param $x (ref null $A)) (result i32)
  ;; SHRINK-NEXT:  (i32.add
  ;; SHRINK-NEXT:   (i32.const 1)
  ;; SHRINK-NEXT:   (if (result i32)
  ;; SHRINK-NEXT:    (ref.test (ref $B)
  ;; SHRINK-NEXT:     (local.get $x)
  ;; SHRINK-NEXT:    )
  ;; SHRINK-NEXT:    (then
  ;; SHRINK-NEXT:     (call $f
  ;; SHRINK-NEXT:      (local.get $x)
  ;; SHRINK-NEXT:      (i32.const 1000000)
  ;; SHRINK-NEXT:     )
  ;; SHRINK-NEXT:    )
  ;; SHRINK-NEXT:    (else
  ;; SHRINK-NEXT:     (i32.const 2147483647)
  ;; SHRINK-NEXT:    )
  ;; SHRINK-NEXT:   )
  ;; SHRINK-NEXT:  )
  ;; SHRINK-NEXT: )
  (func $a (param $x (ref null $A)) (result i32)
    (i32.add
      (i32.const 1)
      (if (result i32)
        (ref.test (ref $B) (local.get $x))
        (then
          (call $f (local.get $x) (i32.const 1000000))
        )
        (else
          (i32.const 2147483647)
        )
      )
    )
  )

  ;; CHECK:      (func $b (type $1) (param $x (ref null $A)) (result i32)
  ;; CHECK-NEXT:  (call $a
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $b (type $1) (param $x (ref null $A)) (result i32)
  ;; SHRINK-NEXT:  (call $a
  ;; SHRINK-NEXT:   (local.get $x)
  ;; SHRINK-NEXT:  )
  ;; SHRINK-NEXT: )
  (func $b (param $x (ref null $A)) (result i32)
    (i32.add
      (i32.const 1)
      (if (result i32)
        (ref.test (ref $B) (local.get $x))
        (then
          (call $f (local.get $x) (i32.const 1000000))
        )
        (else
          (i32.const 2147483647)
        )
      )
    )
  )

  ;; CHECK:      (func $c (type $1) (param $x (ref null $A)) (result i32)
  ;; CHECK-NEXT:  (call $a
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $c (type $1) (param $x (ref null $A)) (result i32)
  ;; SHRINK-NEXT:  (call $a
  ;; SHRINK-NEXT:   (local.get $x)
  ;; SHRINK-NEXT:  )
  ;; SHRINK-NEXT: )
  (func $c (param $x (ref null $A)) (result i32)
    (i32.add
      (i32.const 1)
      (if (result i32)
        (ref.test (ref $B) (local.get $x))
        (then
          (call $f (local.get $x) (i32.const 1000000))
        )
        (else
          (i32.const 2147483647)
        )
      )
    )
  )

  ;; CHECK:      (func $d (type $1) (param $x (ref null $A)) (result i32)
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (call $f
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:    (i32.const 1000000)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $d (type $1) (param $x (ref null $A)) (result i32)
  ;; SHRINK-NEXT:  (i32.add
  ;; SHRINK-NEXT:   (i32.const 1)
  ;; SHRINK-NEXT:   (call $f
  ;; SHRINK-NEXT:    (local.get $x)
  ;; SHRINK-NEXT:    (i32.const 1000000)
  ;; SHRINK-NEXT:   )
  ;; SHRINK-NEXT:  )
