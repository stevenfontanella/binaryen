  ;; CHECK-NEXT:    (call $multi_sink_callee
  ;; CHECK-NEXT:     (local.get $a)
  ;; CHECK-NEXT:     (i32.eqz
  ;; CHECK-NEXT:      (local.get $b)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (call $imp_throw
  ;; CHECK-NEXT:      (local.get $b)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (i32.add
  ;; CHECK-NEXT:     (call $imp_outer
  ;; CHECK-NEXT:      (i32.eqz
  ;; CHECK-NEXT:       (local.get $a)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (call $multi_wrap
  ;; CHECK-NEXT:       (i32.clz
