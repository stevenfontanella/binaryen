  ;; SHRINK-NEXT:       (i32.add
  ;; SHRINK-NEXT:        (call $outlined_w
  ;; SHRINK-NEXT:         (local.get $a)
  ;; SHRINK-NEXT:         (i32.clz
  ;; SHRINK-NEXT:          (local.get $b)
  ;; SHRINK-NEXT:         )
