  ;; SHRINK-NEXT:    (local.get $x)
  ;; SHRINK-NEXT:    (i32.const 3)
  ;; SHRINK-NEXT:   )
  ;; SHRINK-NEXT:  )
  ;; SHRINK-NEXT: )
  (func $absorb_eqz (param $x i32) (result i32)
    (i32.and (local.get $x) (i32.const 3))
  )

  ;; CHECK:      (func $box_maker (type $4) (param $x i32) (result (ref $Box))
  ;; CHECK-NEXT:  (struct.new $Box
