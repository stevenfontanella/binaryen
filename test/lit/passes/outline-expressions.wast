;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.
;; RUN: foreach %s %t wasm-opt --outline-expressions -all -S -o - | filecheck %s
;; RUN: foreach %s %t wasm-opt --outline-expressions --shrink-level=1 -all -S -o - | filecheck %s --check-prefix=SHRINK

;; Three identical ifs with a call: outline them into one helper. The local.gets
;; are holes and become parameters.
(module
  ;; CHECK:      (type $A (sub (struct (field i32))))
  ;; SHRINK:      (type $A (sub (struct (field i32))))
  (type $A (sub (struct (field i32))))

  ;; CHECK:      (type $1 (func (param (ref null $A)) (result i32)))

  ;; CHECK:      (type $2 (func (param i32 (ref null $A)) (result i32)))

  ;; CHECK:      (type $B (sub $A (struct (field i32) (field i32))))
  ;; SHRINK:      (type $1 (func (param (ref null $A)) (result i32)))

  ;; SHRINK:      (type $2 (func (param i32 (ref null $A)) (result i32)))

  ;; SHRINK:      (type $B (sub $A (struct (field i32) (field i32))))
  (type $B (sub $A (struct (field i32) (field i32))))

  ;; CHECK:      (func $f (type $1) (param $0 (ref null $A)) (result i32)
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $f (type $1) (param $0 (ref null $A)) (result i32)
  ;; SHRINK-NEXT:  (i32.const 1)
  ;; SHRINK-NEXT: )
  (func $f (param (ref null $A)) (result i32)
    (i32.const 1)
  )

  ;; CHECK:      (func $a (type $1) (param $x (ref null $A)) (result i32)
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (call $outlined
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $a (type $1) (param $x (ref null $A)) (result i32)
  ;; SHRINK-NEXT:  (i32.add
  ;; SHRINK-NEXT:   (i32.const 1)
  ;; SHRINK-NEXT:   (call $outlined
  ;; SHRINK-NEXT:    (local.get $x)
  ;; SHRINK-NEXT:   )
  ;; SHRINK-NEXT:  )
  ;; SHRINK-NEXT: )
  (func $a (param $x (ref null $A)) (result i32)
    (i32.add
      (i32.const 1)
      (if (result i32)
        (ref.test (ref $B) (local.get $x))
        (then
          (call $f (local.get $x))
        )
        (else
          (i32.const 2147483647)
        )
      )
    )
  )

  ;; CHECK:      (func $b (type $1) (param $y (ref null $A)) (result i32)
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:   (call $outlined
  ;; CHECK-NEXT:    (local.get $y)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $b (type $1) (param $y (ref null $A)) (result i32)
  ;; SHRINK-NEXT:  (i32.add
  ;; SHRINK-NEXT:   (i32.const 2)
  ;; SHRINK-NEXT:   (call $outlined
  ;; SHRINK-NEXT:    (local.get $y)
  ;; SHRINK-NEXT:   )
  ;; SHRINK-NEXT:  )
  ;; SHRINK-NEXT: )
  (func $b (param $y (ref null $A)) (result i32)
    (i32.add
      (i32.const 2)
      (if (result i32)
        (ref.test (ref $B) (local.get $y))
        (then
          (call $f (local.get $y))
        )
        (else
          (i32.const 2147483647)
        )
      )
    )
  )

  ;; CHECK:      (func $c (type $2) (param $p i32) (param $z (ref null $A)) (result i32)
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (local.get $p)
  ;; CHECK-NEXT:   (call $outlined
  ;; CHECK-NEXT:    (local.get $z)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $c (type $2) (param $p i32) (param $z (ref null $A)) (result i32)
  ;; SHRINK-NEXT:  (i32.add
  ;; SHRINK-NEXT:   (local.get $p)
  ;; SHRINK-NEXT:   (call $outlined
  ;; SHRINK-NEXT:    (local.get $z)
  ;; SHRINK-NEXT:   )
  ;; SHRINK-NEXT:  )
  ;; SHRINK-NEXT: )
  (func $c (param $p i32) (param $z (ref null $A)) (result i32)
    (i32.add
      (local.get $p)
      (if (result i32)
        (ref.test (ref $B) (local.get $z))
        (then
          (call $f (local.get $z))
        )
        (else
          (i32.const 2147483647)
        )
      )
    )
  )
)

;; As above, but the trees are entire function bodies whose holes are the params
;; in order, so the first such function is reused as the helper.

;; CHECK:      (func $outlined (type $1) (param $0 (ref null $A)) (result i32)
;; CHECK-NEXT:  (if (result i32)
;; CHECK-NEXT:   (ref.test (ref $B)
;; CHECK-NEXT:    (local.get $0)
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (then
;; CHECK-NEXT:    (call $f
;; CHECK-NEXT:     (local.get $0)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (else
;; CHECK-NEXT:    (i32.const 2147483647)
;; CHECK-NEXT:   )
;; CHECK-NEXT:  )
;; CHECK-NEXT: )

;; SHRINK:      (func $outlined (type $1) (param $0 (ref null $A)) (result i32)
;; SHRINK-NEXT:  (if (result i32)
;; SHRINK-NEXT:   (ref.test (ref $B)
;; SHRINK-NEXT:    (local.get $0)
;; SHRINK-NEXT:   )
;; SHRINK-NEXT:   (then
;; SHRINK-NEXT:    (call $f
;; SHRINK-NEXT:     (local.get $0)
;; SHRINK-NEXT:    )
;; SHRINK-NEXT:   )
;; SHRINK-NEXT:   (else
;; SHRINK-NEXT:    (i32.const 2147483647)
;; SHRINK-NEXT:   )
;; SHRINK-NEXT:  )
;; SHRINK-NEXT: )
(module
  ;; CHECK:      (type $A (sub (struct (field i32))))
  ;; SHRINK:      (type $A (sub (struct (field i32))))
  (type $A (sub (struct (field i32))))

  ;; CHECK:      (type $1 (func (param (ref null $A)) (result i32)))

  ;; CHECK:      (type $B (sub $A (struct (field i32) (field i32))))
  ;; SHRINK:      (type $1 (func (param (ref null $A)) (result i32)))

  ;; SHRINK:      (type $B (sub $A (struct (field i32) (field i32))))
  (type $B (sub $A (struct (field i32) (field i32))))

  ;; CHECK:      (type $3 (func (param i32 (ref null $A)) (result i32)))

  ;; CHECK:      (func $f (type $1) (param $0 (ref null $A)) (result i32)
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT: )
  ;; SHRINK:      (type $3 (func (param i32 (ref null $A)) (result i32)))

  ;; SHRINK:      (func $f (type $1) (param $0 (ref null $A)) (result i32)
  ;; SHRINK-NEXT:  (i32.const 1)
  ;; SHRINK-NEXT: )
  (func $f (param (ref null $A)) (result i32)
    (i32.const 1)
  )

  ;; CHECK:      (func $a (type $1) (param $x (ref null $A)) (result i32)
  ;; CHECK-NEXT:  (if (result i32)
  ;; CHECK-NEXT:   (ref.test (ref $B)
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (call $f
  ;; CHECK-NEXT:     (local.get $x)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (else
  ;; CHECK-NEXT:    (i32.const 2147483647)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $a (type $1) (param $x (ref null $A)) (result i32)
  ;; SHRINK-NEXT:  (if (result i32)
  ;; SHRINK-NEXT:   (ref.test (ref $B)
  ;; SHRINK-NEXT:    (local.get $x)
  ;; SHRINK-NEXT:   )
  ;; SHRINK-NEXT:   (then
  ;; SHRINK-NEXT:    (call $f
  ;; SHRINK-NEXT:     (local.get $x)
  ;; SHRINK-NEXT:    )
  ;; SHRINK-NEXT:   )
  ;; SHRINK-NEXT:   (else
  ;; SHRINK-NEXT:    (i32.const 2147483647)
  ;; SHRINK-NEXT:   )
  ;; SHRINK-NEXT:  )
  ;; SHRINK-NEXT: )
  (func $a (param $x (ref null $A)) (result i32)
    (if (result i32)
      (ref.test (ref $B) (local.get $x))
      (then
        (call $f (local.get $x))
      )
      (else
