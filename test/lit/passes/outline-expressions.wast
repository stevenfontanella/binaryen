  (func $box_maker (param $x i32) (result (ref $Box))
    (struct.new $Box (i32.mul (local.get $x) (i32.const 5)) (local.get $x))
  )

  ;; CHECK:      (func $unboxed (type $1) (param $x i32) (result i32)
