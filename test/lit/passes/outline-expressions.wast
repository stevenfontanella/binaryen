  ;; SHRINK-NEXT:          (call $outlined_w2
  ;; SHRINK-NEXT:           (local.get $s1)
  ;; SHRINK-NEXT:           (local.get $s1)
  ;; SHRINK-NEXT:          )
  ;; SHRINK-NEXT:          (call $outlined_w2
  ;; SHRINK-NEXT:           (local.get $s2)
