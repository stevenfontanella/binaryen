  ;; CHECK:      (func $c (type $3) (param $p i32) (param $z (ref null $A)) (result i32)
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (local.get $p)
  ;; CHECK-NEXT:   (call $a
  ;; CHECK-NEXT:    (local.get $z)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $c (type $3) (param $p i32) (param $z (ref null $A)) (result i32)
  ;; SHRINK-NEXT:  (i32.add
  ;; SHRINK-NEXT:   (local.get $p)
