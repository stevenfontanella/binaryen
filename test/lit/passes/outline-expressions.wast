  ;; SHRINK-NEXT:       (struct.get $Base 0
  ;; SHRINK-NEXT:        (call $chain_maker
  ;; SHRINK-NEXT:         (local.get $a)
  ;; SHRINK-NEXT:        )
  ;; SHRINK-NEXT:       )
