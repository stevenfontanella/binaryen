  (func $c (param $p i32) (param $z (ref null $A)) (result i32)
    (i32.add
      (local.get $p)
      (if (result i32)
        (ref.test (ref $B) (local.get $z))
        (then
          (call $f (local.get $z))
        )
        (else
          (i32.const 2147483647)
        )
      )
    )
  )
)

;; An existing function whose body is the tree is only reused if the holes are
;; its params in order. Here they are swapped, so a helper is created, and the
;; function calls it like any other site. Also, the same local used twice is a
;; single hole.
(module
  ;; CHECK:      (type $A (sub (struct (field i32))))
  ;; SHRINK:      (type $A (sub (struct (field i32))))
  (type $A (sub (struct (field i32))))

  ;; CHECK:      (type $1 (func (param (ref null $A) i32) (result i32)))

  ;; CHECK:      (type $2 (func (param i32 (ref null $A)) (result i32)))

  ;; CHECK:      (type $B (sub $A (struct (field i32) (field i32))))
  ;; SHRINK:      (type $1 (func (param (ref null $A) i32) (result i32)))

  ;; SHRINK:      (type $2 (func (param i32 (ref null $A)) (result i32)))

  ;; SHRINK:      (type $B (sub $A (struct (field i32) (field i32))))
  (type $B (sub $A (struct (field i32) (field i32))))

  ;; CHECK:      (type $4 (func (param i32 (ref null $A) (ref null $A)) (result i32)))

  ;; CHECK:      (func $f (type $1) (param $0 (ref null $A)) (param $1 i32) (result i32)
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT: )
  ;; SHRINK:      (type $4 (func (param i32 (ref null $A) (ref null $A)) (result i32)))

  ;; SHRINK:      (func $f (type $1) (param $0 (ref null $A)) (param $1 i32) (result i32)
  ;; SHRINK-NEXT:  (i32.const 1)
  ;; SHRINK-NEXT: )
  (func $f (param (ref null $A)) (param i32) (result i32)
    (i32.const 1)
  )

  ;; CHECK:      (func $swapped (type $2) (param $y i32) (param $x (ref null $A)) (result i32)
  ;; CHECK-NEXT:  (call $outlined
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (local.get $y)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $swapped (type $2) (param $y i32) (param $x (ref null $A)) (result i32)
  ;; SHRINK-NEXT:  (call $outlined
  ;; SHRINK-NEXT:   (local.get $x)
  ;; SHRINK-NEXT:   (local.get $y)
  ;; SHRINK-NEXT:  )
  ;; SHRINK-NEXT: )
  (func $swapped (param $y i32) (param $x (ref null $A)) (result i32)
    (if (result i32)
      (ref.test (ref $B) (local.get $x))
      (then
        (call $f (local.get $x) (local.get $y))
      )
      (else
        (i32.const 2147483647)
      )
    )
  )

  ;; CHECK:      (func $a (type $2) (param $p i32) (param $q (ref null $A)) (result i32)
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (call $outlined
  ;; CHECK-NEXT:    (local.get $q)
  ;; CHECK-NEXT:    (local.get $p)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $a (type $2) (param $p i32) (param $q (ref null $A)) (result i32)
  ;; SHRINK-NEXT:  (i32.add
  ;; SHRINK-NEXT:   (i32.const 1)
  ;; SHRINK-NEXT:   (call $outlined
  ;; SHRINK-NEXT:    (local.get $q)
  ;; SHRINK-NEXT:    (local.get $p)
  ;; SHRINK-NEXT:   )
  ;; SHRINK-NEXT:  )
  ;; SHRINK-NEXT: )
  (func $a (param $p i32) (param $q (ref null $A)) (result i32)
    (i32.add
      (i32.const 1)
      (if (result i32)
        (ref.test (ref $B) (local.get $q))
        (then
          (call $f (local.get $q) (local.get $p))
        )
        (else
          (i32.const 2147483647)
        )
      )
    )
  )

  ;; This one uses different locals in the two places the others use the same
  ;; one, so it has a different shape.
  ;; CHECK:      (func $b (type $4) (param $p i32) (param $q (ref null $A)) (param $r (ref null $A)) (result i32)
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (if (result i32)
  ;; CHECK-NEXT:    (ref.test (ref $B)
  ;; CHECK-NEXT:     (local.get $q)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (then
  ;; CHECK-NEXT:     (call $f
  ;; CHECK-NEXT:      (local.get $r)
  ;; CHECK-NEXT:      (local.get $p)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (else
  ;; CHECK-NEXT:     (i32.const 2147483647)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; SHRINK:      (func $b (type $4) (param $p i32) (param $q (ref null $A)) (param $r (ref null $A)) (result i32)
  ;; SHRINK-NEXT:  (i32.add
  ;; SHRINK-NEXT:   (i32.const 1)
  ;; SHRINK-NEXT:   (if (result i32)
  ;; SHRINK-NEXT:    (ref.test (ref $B)
  ;; SHRINK-NEXT:     (local.get $q)
  ;; SHRINK-NEXT:    )
  ;; SHRINK-NEXT:    (then
  ;; SHRINK-NEXT:     (call $f
  ;; SHRINK-NEXT:      (local.get $r)
  ;; SHRINK-NEXT:      (local.get $p)
  ;; SHRINK-NEXT:     )
  ;; SHRINK-NEXT:    )
  ;; SHRINK-NEXT:    (else
  ;; SHRINK-NEXT:     (i32.const 2147483647)
  ;; SHRINK-NEXT:    )
  ;; SHRINK-NEXT:   )
  ;; SHRINK-NEXT:  )
  ;; SHRINK-NEXT: )
  (func $b (param $p i32) (param $q (ref null $A)) (param $r (ref null $A)) (result i32)
    (i32.add
      (i32.const 1)
      (if (result i32)
        (ref.test (ref $B) (local.get $q))
        (then
          (call $f (local.get $r) (local.get $p))
        )
        (else
          (i32.const 2147483647)
        )
      )
    )
  )
)

;; The constants differ, so the shapes differ for the exact rounds, but the
;; final round treats constants as holes: the differing constant becomes a
;; param, while the constant 1 that all sites agree on stays in the helper.

;; CHECK:      (func $outlined (type $1) (param $0 (ref null $A)) (param $1 i32) (result i32)
;; CHECK-NEXT:  (if (result i32)
;; CHECK-NEXT:   (ref.test (ref $B)
;; CHECK-NEXT:    (local.get $0)
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (then
;; CHECK-NEXT:    (call $f
;; CHECK-NEXT:     (local.get $0)
;; CHECK-NEXT:     (local.get $1)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (else
;; CHECK-NEXT:    (i32.const 2147483647)
;; CHECK-NEXT:   )
;; CHECK-NEXT:  )
;; CHECK-NEXT: )

;; SHRINK:      (func $outlined (type $1) (param $0 (ref null $A)) (param $1 i32) (result i32)
;; SHRINK-NEXT:  (if (result i32)
;; SHRINK-NEXT:   (ref.test (ref $B)
