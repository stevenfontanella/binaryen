;; CHECK-NEXT:     (call $calc
;; CHECK-NEXT:      (i32.add
;; CHECK-NEXT:       (local.get $1)
;; CHECK-NEXT:       (i32.const 300000)
;; CHECK-NEXT:      )
;; CHECK-NEXT:     )
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
