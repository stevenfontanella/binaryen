;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.
;; RUN: foreach %s %t wasm-opt --outline-expressions=trees -all -S -o - | filecheck %s

;; After the rounds with exact keys, a round treats constants as holes.
(module
  ;; CHECK:      (type $vt (struct (field i32)))

  ;; CHECK:      (type $1 (func (param anyref) (result i32)))

  ;; CHECK:      (type $T (struct (field anyref) (field i32) (field f64)))
  (type $T (struct (field anyref) (field i32) (field f64)))
  (type $vt (struct (field i32)))
  ;; CHECK:      (type $3 (func (result (ref $T))))

  ;; CHECK:      (type $4 (func (param anyref) (result anyref)))

  ;; CHECK:      (type $sig (func (param anyref i32 i32 i32) (result i32)))
  (type $sig (func (param anyref i32 i32 i32) (result i32)))

  ;; CHECK:      (type $6 (func (param anyref i32) (result anyref)))

  ;; CHECK:      (type $7 (func (param f64) (result (ref (exact $T)))))

  ;; CHECK:      (type $8 (func (param anyref i32) (result i32)))

  ;; CHECK:      (import "env" "f" (func $f (type $sig) (param anyref i32 i32 i32) (result i32)))
  (import "env" "f" (func $f (param anyref i32 i32 i32) (result i32)))
  ;; CHECK:      (import "env" "g" (func $g (type $6) (param anyref i32) (result anyref)))
  (import "env" "g" (func $g (param anyref i32) (result anyref)))

  ;; CHECK:      (global $vtable (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT: ))
  (global $vtable (ref $vt) (struct.new $vt (i32.const 1)))
  ;; CHECK:      (global $mut (mut (ref $vt)) (struct.new $vt
  ;; CHECK-NEXT:  (i32.const 2)
  ;; CHECK-NEXT: ))
  (global $mut (mut (ref $vt)) (struct.new $vt (i32.const 2)))


  ;; Three allocations that differ only in the f64: one helper with one f64
  ;; param. The vtable and the 0 are the same at all sites, so they stay inline
  ;; in the helper ("fixed").
  ;; CHECK:      (export "alloc1" (func $alloc1))

  ;; CHECK:      (export "alloc2" (func $alloc2))

  ;; CHECK:      (export "alloc3" (func $alloc3))

  ;; CHECK:      (export "call1" (func $call1))

  ;; CHECK:      (export "call2" (func $call2))

  ;; CHECK:      (export "call3" (func $call3))

  ;; CHECK:      (export "mutable1" (func $mutable1))

  ;; CHECK:      (export "mutable2" (func $mutable2))

  ;; CHECK:      (export "mutable3" (func $mutable3))

  ;; CHECK:      (export "small1" (func $small1))

  ;; CHECK:      (export "small2" (func $small2))

  ;; CHECK:      (export "small3" (func $small3))

  ;; CHECK:      (func $alloc1 (type $3) (result (ref $T))
  ;; CHECK-NEXT:  (call $outlined
  ;; CHECK-NEXT:   (f64.const 1.5)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $alloc1 (export "alloc1") (result (ref $T))
    (struct.new $T (global.get $vtable) (i32.const 0) (f64.const 1.5))
  )
  ;; CHECK:      (func $alloc2 (type $3) (result (ref $T))
  ;; CHECK-NEXT:  (call $outlined
  ;; CHECK-NEXT:   (f64.const 2.5)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $alloc2 (export "alloc2") (result (ref $T))
    (struct.new $T (global.get $vtable) (i32.const 0) (f64.const 2.5))
  )
  ;; CHECK:      (func $alloc3 (type $3) (result (ref $T))
  ;; CHECK-NEXT:  (call $outlined
  ;; CHECK-NEXT:   (f64.const 3.5)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $alloc3 (export "alloc3") (result (ref $T))
    (struct.new $T (global.get $vtable) (i32.const 0) (f64.const 3.5))
  )

  ;; A local hole, two fixed constants, and a varying one: the helper gets the
  ;; local and the varying constant as params, in evaluation order.
  ;; CHECK:      (func $call1 (type $1) (param $x anyref) (result i32)
  ;; CHECK-NEXT:  (call $outlined_15
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $call1 (export "call1") (param $x anyref) (result i32)
    (call $f (local.get $x) (i32.const 100000) (i32.const 100001) (i32.const 1))
  )
  ;; CHECK:      (func $call2 (type $1) (param $y anyref) (result i32)
  ;; CHECK-NEXT:  (call $outlined_15
  ;; CHECK-NEXT:   (local.get $y)
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $call2 (export "call2") (param $y anyref) (result i32)
    (call $f (local.get $y) (i32.const 100000) (i32.const 100001) (i32.const 2))
  )
  ;; CHECK:      (func $call3 (type $1) (param $z anyref) (result i32)
  ;; CHECK-NEXT:  (call $outlined_15
  ;; CHECK-NEXT:   (local.get $z)
  ;; CHECK-NEXT:   (i32.const 3)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $call3 (export "call3") (param $z anyref) (result i32)
    (call $f (local.get $z) (i32.const 100000) (i32.const 100001) (i32.const 3))
  )

  ;; A mutable global.get is not a hole, so these are three different shapes
  ;; and nothing is outlined.
  ;; CHECK:      (func $mutable1 (type $1) (param $x anyref) (result i32)
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (struct.get $vt 0
  ;; CHECK-NEXT:    (global.get $mut)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (i32.const 100001)
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $mutable1 (export "mutable1") (param $x anyref) (result i32)
    (call $f (local.get $x) (struct.get $vt 0 (global.get $mut)) (i32.const 100001) (i32.const 1))
  )
  ;; CHECK:      (func $mutable2 (type $1) (param $y anyref) (result i32)
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (local.get $y)
  ;; CHECK-NEXT:   (struct.get $vt 0
  ;; CHECK-NEXT:    (global.get $vtable)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (i32.const 100001)
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $mutable2 (export "mutable2") (param $y anyref) (result i32)
    (call $f (local.get $y) (struct.get $vt 0 (global.get $vtable)) (i32.const 100001) (i32.const 2))
  )
  ;; CHECK:      (func $mutable3 (type $1) (param $z anyref) (result i32)
  ;; CHECK-NEXT:  (call $f
  ;; CHECK-NEXT:   (local.get $z)
  ;; CHECK-NEXT:   (i32.const 100000)
  ;; CHECK-NEXT:   (struct.get $vt 0
  ;; CHECK-NEXT:    (global.get $mut)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (i32.const 3)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $mutable3 (export "mutable3") (param $z anyref) (result i32)
    (call $f (local.get $z) (i32.const 100000) (struct.get $vt 0 (global.get $mut)) (i32.const 3))
  )

  ;; A call whose only varying constant is as big as the call itself saves
  ;; nothing per site: not outlined.
  ;; CHECK:      (func $small1 (type $4) (param $x anyref) (result anyref)
  ;; CHECK-NEXT:  (call $g
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $small1 (export "small1") (param $x anyref) (result anyref)
    (call $g (local.get $x) (i32.const 1))
  )
  ;; CHECK:      (func $small2 (type $4) (param $y anyref) (result anyref)
  ;; CHECK-NEXT:  (call $g
  ;; CHECK-NEXT:   (local.get $y)
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $small2 (export "small2") (param $y anyref) (result anyref)
    (call $g (local.get $y) (i32.const 2))
  )
  ;; CHECK:      (func $small3 (type $4) (param $z anyref) (result anyref)
  ;; CHECK-NEXT:  (call $g
  ;; CHECK-NEXT:   (local.get $z)
  ;; CHECK-NEXT:   (i32.const 3)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $small3 (export "small3") (param $z anyref) (result anyref)
    (call $g (local.get $z) (i32.const 3))
  )
)
;; CHECK:      (func $outlined (type $7) (param $0 f64) (result (ref (exact $T)))
;; CHECK-NEXT:  (struct.new $T
;; CHECK-NEXT:   (global.get $vtable)
;; CHECK-NEXT:   (i32.const 0)
;; CHECK-NEXT:   (local.get $0)
;; CHECK-NEXT:  )
;; CHECK-NEXT: )

;; CHECK:      (func $outlined_15 (type $8) (param $0 anyref) (param $1 i32) (result i32)
;; CHECK-NEXT:  (call $f
;; CHECK-NEXT:   (local.get $0)
;; CHECK-NEXT:   (i32.const 100000)
;; CHECK-NEXT:   (i32.const 100001)
;; CHECK-NEXT:   (local.get $1)
;; CHECK-NEXT:  )
;; CHECK-NEXT: )
