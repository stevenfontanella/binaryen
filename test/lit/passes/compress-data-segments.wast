  ;; MODEL-NEXT:   (local.get $off)
  ;; MODEL-NEXT:   (local.get $n)
  ;; MODEL-NEXT:  )
  ;; MODEL-NEXT: )
  (func $bytes (param $off i32) (param $n i32) (result (ref $i8))
    (array.new_data $i8 $bytes (local.get $off) (local.get $n))
  )

