;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: foreach %s %t wasm-opt --compress-data-segments --pass-arg=compress-data-segments-always@1 --pass-arg=compress-data-segments-huffman@1 -all -S -o - | filecheck %s
;; RUN: foreach %s %t wasm-opt --compress-data-segments -all -S -o - | filecheck %s --check-prefix=MODEL

;; Segments read only by array.new_data are concatenated and coded into one
;; segment; the arrays are built by per-type slice helpers from the decoded
;; bytes. $pinned is read by array.init_data and stays; $active is active.
;; The MODEL run (no --pass-arg=compress-data-segments-always) leaves these
;; small segments alone, since the decoder would cost more than it saves.
(module

  ;; CHECK:      (type $i8 (array (mut i8)))
  ;; MODEL:      (type $i8 (array (mut i8)))
  (type $i8 (array (mut i8)))
  ;; CHECK:      (type $i16 (array (mut i16)))
  ;; MODEL:      (type $i16 (array (mut i16)))
  (type $i16 (array (mut i16)))
  ;; CHECK:      (type $i32 (array (mut i32)))
  ;; MODEL:      (type $i32 (array (mut i32)))
  (type $i32 (array (mut i32)))
  ;; CHECK:      (type $f64 (array (mut f64)))
  ;; MODEL:      (type $f64 (array (mut f64)))
  (type $f64 (array (mut f64)))

  (memory 1)









