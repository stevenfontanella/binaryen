  ;; MODEL:      (type $9 (func (param (ref $i8))))

  ;; MODEL:      (type $10 (func (result (ref $i8))))

  ;; MODEL:      (memory $0 1)

  ;; MODEL:      (data $bytes "Hello, World! abcabcabcabcabcabcabcabcabcabcabcabc")
  (data $bytes "Hello, World! abcabcabcabcabcabcabcabcabcabcabcabc")
  ;; MODEL:      (data $units "a\00b\00c\00a\00b\00c\00a\00b\00c\00a\00b\00c\00a\00b\00c\00")
  (data $units "a\00b\00c\00a\00b\00c\00a\00b\00c\00a\00b\00c\00a\00b\00c\00")
  ;; MODEL:      (data $words "\01\00\00\00\02\00\00\00\03\00\00\00\01\00\00\00\02\00\00\00\03\00\00\00\01\00\00\00\02\00\00\00")
  (data $words "\01\00\00\00\02\00\00\00\03\00\00\00\01\00\00\00\02\00\00\00\03\00\00\00\01\00\00\00\02\00\00\00")
  ;; MODEL:      (data $doubles "\00\00\00\00\00\00\f0?\00\00\00\00\00\00\00@\00\00\00\00\00\00\f0?\00\00\00\00\00\00\00@\00\00\00\00\00\00\f0?")
  (data $doubles "\00\00\00\00\00\00\f0?\00\00\00\00\00\00\00@\00\00\00\00\00\00\f0?\00\00\00\00\00\00\00@\00\00\00\00\00\00\f0?")















  ;; CHECK:      (type $4 (func))

  ;; CHECK:      (type $5 (func (result (ref $i8))))

  ;; CHECK:      (type $6 (func (param i32 i32) (result (ref $i8))))

  ;; CHECK:      (type $7 (func (result (ref $i16))))

