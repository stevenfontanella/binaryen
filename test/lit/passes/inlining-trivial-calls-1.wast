 ;; CHECK-NEXT:   (local.set $23
 ;; CHECK-NEXT:    (i32.const 6)
 ;; CHECK-NEXT:   )
 ;; CHECK-NEXT:   (drop
 ;; CHECK-NEXT:    (call $imported-bar
 ;; CHECK-NEXT:     (local.get $18)
