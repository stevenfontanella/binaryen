 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $main (type $1)
  (call $call-foo
   (i32.const 1)
   (i32.const 2)
   (i32.const 3)
   (i32.const 4)
   (i32.const 5)
   (i32.const 6)
  )
  (call $call-foo
   (i32.const 7)
   (i32.const 8)
   (i32.const 9)
