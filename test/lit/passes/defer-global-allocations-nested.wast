;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: foreach %s %t wasm-opt --defer-global-allocations -all -S -o - \
;; RUN:   --pass-arg=defer-global-allocations-import-bonus@40 | filecheck %s

;; Enum-like constants holding a freshly allocated string wrapper (a nested
;; constant struct.new) and an integer. The initializers are flattened: the
;; wrapper's vtable and hash are fixed, its externref and the ordinal become
;; columns, and the factory rebuilds the nested struct.new. The enum values
;; are also operands of an array.new_fixed (the values() array), which does
;; not count as an allocation-operand use.
;;
;; Each enum has eight uses, so without the import bonus the model would keep
;; them eager; with it, the string imports (used nowhere else) are expected to
;; be removed by a later pass. $e3's string is also used from code, so it gets
;; no bonus and stays eager.
(module
  ;; CHECK:      (type $vt (struct (field i32)))
  (type $vt (struct (field i32)))
  ;; CHECK:      (type $str (struct (field (ref $vt)) (field (mut i32)) (field externref)))
  (type $str (struct (field (ref $vt)) (field (mut i32)) (field externref)))
  ;; CHECK:      (type $enum (struct (field (ref $vt)) (field (mut i32)) (field (ref $str)) (field i32)))
  (type $enum (struct (field (ref $vt)) (field (mut i32)) (field (ref $str)) (field i32)))
  ;; CHECK:      (type $3 (array (mut (ref null $enum))))

  ;; CHECK:      (type $4 (array externref))

  ;; CHECK:      (type $5 (array i32))

  ;; CHECK:      (type $values (array (ref null $enum)))
  (type $values (array (ref null $enum)))

  ;; CHECK:      (type $7 (func (param i32) (result (ref $enum))))

  ;; CHECK:      (type $8 (func (result (ref $values))))

  ;; CHECK:      (import "env" "s0" (global $import0 externref))
  (import "env" "s0" (global $import0 externref))
  ;; CHECK:      (import "env" "s1" (global $import1 externref))
  (import "env" "s1" (global $import1 externref))
  ;; CHECK:      (import "env" "s2" (global $import2 externref))
  (import "env" "s2" (global $import2 externref))
  ;; CHECK:      (import "env" "s3" (global $import3 externref))
  (import "env" "s3" (global $import3 externref))

  ;; CHECK:      (global $vt (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT: ))
  (global $vt (ref $vt) (struct.new $vt (i32.const 1)))
  ;; CHECK:      (global $svt (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (i32.const 2)
  ;; CHECK-NEXT: ))
  (global $svt (ref $vt) (struct.new $vt (i32.const 2)))

  (global $e0 (ref $enum) (struct.new $enum
    (global.get $vt)
    (i32.const 0)
    (struct.new $str (global.get $svt) (i32.const 0) (global.get $import0))
    (i32.const 0)
  ))
  (global $e1 (ref $enum) (struct.new $enum
    (global.get $vt)
    (i32.const 0)
    (struct.new $str (global.get $svt) (i32.const 0) (global.get $import1))
    (i32.const 1)
  ))
  (global $e2 (ref $enum) (struct.new $enum
    (global.get $vt)
    (i32.const 0)
    (struct.new $str (global.get $svt) (i32.const 0) (global.get $import2))
    (i32.const 2)
  ))
  ;; CHECK:      (global $e3 (ref $enum) (struct.new $enum
  ;; CHECK-NEXT:  (global.get $vt)
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT:  (struct.new $str
  ;; CHECK-NEXT:   (global.get $svt)
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (global.get $import3)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (i32.const 3)
  ;; CHECK-NEXT: ))
  (global $e3 (ref $enum) (struct.new $enum
    (global.get $vt)
    (i32.const 0)
    (struct.new $str (global.get $svt) (i32.const 0) (global.get $import3))
    (i32.const 3)
  ))

  ;; CHECK:      (global $defer$enum$cache (ref $3) (array.new_default $3
  ;; CHECK-NEXT:  (i32.const 3)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (global $defer$enum$table$4 (ref $4) (array.new_fixed $4 3
  ;; CHECK-NEXT:  (global.get $import0)
  ;; CHECK-NEXT:  (global.get $import1)
  ;; CHECK-NEXT:  (global.get $import2)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (global $defer$enum$table$5 (ref $5) (array.new_fixed $5 3
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT:  (i32.const 2)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (export "values" (func $values))

  ;; CHECK:      (export "get" (func $get))

  ;; CHECK:      (func $values (type $8) (result (ref $values))
  ;; CHECK-NEXT:  (array.new_fixed $values 4
  ;; CHECK-NEXT:   (call $defer$enum
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (call $defer$enum
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (call $defer$enum
  ;; CHECK-NEXT:    (i32.const 2)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (global.get $e3)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $values (export "values") (result (ref $values))
    (array.new_fixed $values 4
      (global.get $e0)
      (global.get $e1)
      (global.get $e2)
      (global.get $e3)
    )
  )

  ;; CHECK:      (func $get (type $7) (param $i i32) (result (ref $enum))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $import3)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$enum
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$enum
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $e3)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$enum
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$enum
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $e3)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$enum
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$enum
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $e3)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$enum
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$enum
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $e3)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$enum
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$enum
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $e3)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$enum
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$enum
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $e3)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$enum
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$enum
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $e3)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$enum
  ;; CHECK-NEXT:    (i32.const 2)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$enum
  ;; CHECK-NEXT:    (i32.const 2)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$enum
  ;; CHECK-NEXT:    (i32.const 2)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$enum
  ;; CHECK-NEXT:    (i32.const 2)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$enum
  ;; CHECK-NEXT:    (i32.const 2)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$enum
  ;; CHECK-NEXT:    (i32.const 2)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $defer$enum
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $get (export "get") (param $i i32) (result (ref $enum))
    (drop (global.get $import3))
    (drop (global.get $e0))
    (drop (global.get $e1))
    (drop (global.get $e3))
    (drop (global.get $e0))
    (drop (global.get $e1))
    (drop (global.get $e3))
    (drop (global.get $e0))
    (drop (global.get $e1))
    (drop (global.get $e3))
    (drop (global.get $e0))
    (drop (global.get $e1))
    (drop (global.get $e3))
    (drop (global.get $e0))
    (drop (global.get $e1))
    (drop (global.get $e3))
    (drop (global.get $e0))
    (drop (global.get $e1))
    (drop (global.get $e3))
    (drop (global.get $e0))
    (drop (global.get $e1))
    (drop (global.get $e3))
    (drop (global.get $e2))
    (drop (global.get $e2))
    (drop (global.get $e2))
    (drop (global.get $e2))
    (drop (global.get $e2))
    (drop (global.get $e2))
    (global.get $e2)
  )
)

;; Vtable-like globals used as struct.new operands are still skipped, even
;; when they would get an import bonus.
;; CHECK:      (func $defer$enum (type $7) (param $0 i32) (result (ref $enum))
;; CHECK-NEXT:  (local $1 (ref $enum))
;; CHECK-NEXT:  (block $cached (result (ref $enum))
;; CHECK-NEXT:   (br_on_non_null $cached
;; CHECK-NEXT:    (array.get $3
;; CHECK-NEXT:     (global.get $defer$enum$cache)
;; CHECK-NEXT:     (local.get $0)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (array.set $3
;; CHECK-NEXT:    (global.get $defer$enum$cache)
;; CHECK-NEXT:    (local.get $0)
;; CHECK-NEXT:    (local.tee $1
;; CHECK-NEXT:     (struct.new $enum
;; CHECK-NEXT:      (global.get $vt)
;; CHECK-NEXT:      (i32.const 0)
;; CHECK-NEXT:      (struct.new $str
;; CHECK-NEXT:       (global.get $svt)
;; CHECK-NEXT:       (i32.const 0)
;; CHECK-NEXT:       (array.get $4
;; CHECK-NEXT:        (global.get $defer$enum$table$4)
;; CHECK-NEXT:        (local.get $0)
;; CHECK-NEXT:       )
;; CHECK-NEXT:      )
;; CHECK-NEXT:      (array.get $5
;; CHECK-NEXT:       (global.get $defer$enum$table$5)
;; CHECK-NEXT:       (local.get $0)
;; CHECK-NEXT:      )
;; CHECK-NEXT:     )
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (local.get $1)
;; CHECK-NEXT:  )
;; CHECK-NEXT: )
(module
  ;; CHECK:      (type $vt (struct (field externref)))
  (type $vt (struct (field externref)))
  ;; CHECK:      (type $obj (struct (field (ref $vt)) (field i32)))
  (type $obj (struct (field (ref $vt)) (field i32)))

  ;; CHECK:      (type $2 (func (param i32) (result (ref $obj))))

  ;; CHECK:      (import "env" "s0" (global $import0 externref))
  (import "env" "s0" (global $import0 externref))
  ;; CHECK:      (import "env" "s1" (global $import1 externref))
  (import "env" "s1" (global $import1 externref))

  ;; CHECK:      (global $vt0 (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (global.get $import0)
  ;; CHECK-NEXT: ))
  (global $vt0 (ref $vt) (struct.new $vt (global.get $import0)))
  ;; CHECK:      (global $vt1 (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (global.get $import1)
  ;; CHECK-NEXT: ))
  (global $vt1 (ref $vt) (struct.new $vt (global.get $import1)))

  ;; CHECK:      (export "new" (func $new))

  ;; CHECK:      (func $new (type $2) (param $x i32) (result (ref $obj))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (struct.new $obj
  ;; CHECK-NEXT:    (global.get $vt0)
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (struct.new $obj
  ;; CHECK-NEXT:   (global.get $vt1)
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $new (export "new") (param $x i32) (result (ref $obj))
    (drop (struct.new $obj (global.get $vt0) (local.get $x)))
    (struct.new $obj (global.get $vt1) (local.get $x))
  )
)
