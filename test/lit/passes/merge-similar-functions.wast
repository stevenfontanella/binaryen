  ;; CHECK:      (type $0 (func (param i32 i32)))

  ;; CHECK:      (type $1 (func (param i32 i32 i32)))

  ;; CHECK:      (func $yes-offset-local-indices-1 (type $0) (param $a i32) (param $b i32)
  ;; CHECK-NEXT:  (call $byn$mgfn-shared$yes-offset-local-indices-1
  ;; CHECK-NEXT:   (local.get $a)
  ;; CHECK-NEXT:   (local.get $b)
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $yes-offset-local-indices-1 (param $a i32) (param $b i32)
    (local $x i32)
    (local $y i32)
    (drop (local.get $a))
    (drop (local.get $b))
    (drop (local.get $x))
    (drop (local.get $y))
    (drop (local.tee $x (local.get $x)))
    (drop (local.tee $y (local.get $y)))
    (drop (local.tee $a (local.get $a)))
    (drop (local.tee $b (local.get $b)))
    (drop (i32.const 1))
  )
  ;; CHECK:      (func $yes-offset-local-indices-2 (type $0) (param $a i32) (param $b i32)
  ;; CHECK-NEXT:  (call $byn$mgfn-shared$yes-offset-local-indices-1
  ;; CHECK-NEXT:   (local.get $a)
  ;; CHECK-NEXT:   (local.get $b)
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $yes-offset-local-indices-2 (param $a i32) (param $b i32)
    (local $x i32)
    (local $y i32)
    (drop (local.get $a))
    (drop (local.get $b))
    (drop (local.get $x))
    (drop (local.get $y))
    (drop (local.tee $x (local.get $x)))
    (drop (local.tee $y (local.get $y)))
    (drop (local.tee $a (local.get $a)))
    (drop (local.tee $b (local.get $b)))
    (drop (i32.const 2))
  )

)

;; CHECK:      (func $byn$mgfn-shared$yes-offset-local-indices-1 (type $1) (param $0 i32) (param $1 i32) (param $2 i32)
;; CHECK-NEXT:  (local $3 i32)
;; CHECK-NEXT:  (local $4 i32)
;; CHECK-NEXT:  (drop
;; CHECK-NEXT:   (local.get $0)
;; CHECK-NEXT:  )
;; CHECK-NEXT:  (drop
;; CHECK-NEXT:   (local.get $1)
;; CHECK-NEXT:  )
;; CHECK-NEXT:  (drop
;; CHECK-NEXT:   (local.get $3)
;; CHECK-NEXT:  )
;; CHECK-NEXT:  (drop
;; CHECK-NEXT:   (local.get $4)
;; CHECK-NEXT:  )
;; CHECK-NEXT:  (drop
;; CHECK-NEXT:   (local.tee $3
;; CHECK-NEXT:    (local.get $3)
;; CHECK-NEXT:   )
;; CHECK-NEXT:  )
;; CHECK-NEXT:  (drop
;; CHECK-NEXT:   (local.tee $4
;; CHECK-NEXT:    (local.get $4)
;; CHECK-NEXT:   )
;; CHECK-NEXT:  )
;; CHECK-NEXT:  (drop
;; CHECK-NEXT:   (local.tee $0
;; CHECK-NEXT:    (local.get $0)
;; CHECK-NEXT:   )
;; CHECK-NEXT:  )
;; CHECK-NEXT:  (drop
;; CHECK-NEXT:   (local.tee $1
;; CHECK-NEXT:    (local.get $1)
;; CHECK-NEXT:   )
;; CHECK-NEXT:  )
;; CHECK-NEXT:  (drop
;; CHECK-NEXT:   (local.get $2)
;; CHECK-NEXT:  )
;; CHECK-NEXT: )
(module
  ;; CHECK:      (type $0 (func (param i32) (result i32)))

  ;; CHECK:      (type $1 (func (param i32 (ref $0) i32) (result i32)))

  ;; CHECK:      (global $g1 i32 (i32.const 100))
  (global $g1 i32 (i32.const 100))
  ;; CHECK:      (global $g2 i32 (i32.const 200))
  (global $g2 i32 (i32.const 200))

  ;; CHECK:      (elem declare func $target-a $target-b)

  ;; CHECK:      (export "caller1" (func $caller-1))

  ;; CHECK:      (export "caller2" (func $caller-2))

  ;; CHECK:      (func $target-a (type $0) (param $0 i32) (result i32)
  ;; CHECK-NEXT:  (local.get $0)
  ;; CHECK-NEXT: )
  (func $target-a (param i32) (result i32)
    (local.get 0)
  )
  ;; CHECK:      (func $target-b (type $0) (param $0 i32) (result i32)
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (local.get $0)
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $target-b (param i32) (result i32)
    (i32.add (local.get 0) (i32.const 1))
  )

  ;; Non-escaped 1-caller cluster members with repeated global.get + call target
  ;; differences: both callers should be forwarded directly to the shared helper
  ;; and the intermediate thunks eliminated.
  (func $merged-callee-1 (param $x i32) (result i32)
    (local $a i32)
    (local $b i32)
    (local.set $b (i32.add (local.get $x) (global.get $g1)))
    (local.set $a (call $target-a (local.get $b)))
    (if (result i32)
      (i32.eq (i32.const 7) (local.get $a))
      (then (i32.add (local.get $b) (global.get $g1)))
      (else (call $target-a (local.get $a)))
    )
  )

  (func $merged-callee-2 (param $x i32) (result i32)
    (local $a i32)
    (local $b i32)
    (local.set $a (i32.add (local.get $x) (global.get $g2)))
    (local.set $b (call $target-b (local.get $a)))
    (if (result i32)
      (i32.eq (local.get $b) (i32.const 7))
      (then (i32.add (local.get $a) (global.get $g2)))
      (else (call $target-b (local.get $b)))
    )
  )

  ;; CHECK:      (func $caller-1 (type $0) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (call $byn$mgfn-shared$merged-callee-1
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (ref.func $target-a)
  ;; CHECK-NEXT:   (global.get $g1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $caller-1 (export "caller1") (param $x i32) (result i32)
    (call $merged-callee-1 (local.get $x))
  )

  ;; CHECK:      (func $caller-2 (type $0) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (call $byn$mgfn-shared$merged-callee-1
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (ref.func $target-b)
  ;; CHECK-NEXT:   (global.get $g2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $caller-2 (export "caller2") (param $x i32) (result i32)
    (call $merged-callee-2 (local.get $x))
  )
)

;; CHECK:      (func $byn$mgfn-shared$merged-callee-1 (type $1) (param $0 i32) (param $1 (ref $0)) (param $2 i32) (result i32)
;; CHECK-NEXT:  (local $3 i32)
;; CHECK-NEXT:  (local $4 i32)
;; CHECK-NEXT:  (local.set $3
;; CHECK-NEXT:   (i32.add
;; CHECK-NEXT:    (local.get $0)
;; CHECK-NEXT:    (local.get $2)
;; CHECK-NEXT:   )
;; CHECK-NEXT:  )
;; CHECK-NEXT:  (local.set $4
;; CHECK-NEXT:   (call_ref $0
;; CHECK-NEXT:    (local.get $3)
;; CHECK-NEXT:    (local.get $1)
;; CHECK-NEXT:   )
;; CHECK-NEXT:  )
;; CHECK-NEXT:  (if (result i32)
;; CHECK-NEXT:   (i32.eq
;; CHECK-NEXT:    (local.get $4)
;; CHECK-NEXT:    (i32.const 7)
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (then
;; CHECK-NEXT:    (i32.add
;; CHECK-NEXT:     (local.get $3)
;; CHECK-NEXT:     (local.get $2)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (else
;; CHECK-NEXT:    (call_ref $0
;; CHECK-NEXT:     (local.get $4)
;; CHECK-NEXT:     (local.get $1)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:  )
;; CHECK-NEXT: )
(module
  ;; CHECK:      (type $fn (func (param i32) (result i32)))
  (type $fn (func (param i32) (result i32)))

  ;; CHECK:      (type $1 (func (param i32 (ref $fn)) (result i32)))

  ;; CHECK:      (type $2 (func (param (ref $fn) i32) (result i32)))

  ;; CHECK:      (type $3 (func (param i32 i32) (result i32)))

  ;; CHECK:      (elem declare func $const-thunk-a $non-thunk-b $target-a $target-b)

  ;; CHECK:      (export "rf1" (func $ref-func-and-call-1))

  ;; CHECK:      (export "rf2" (func $ref-func-and-call-2))

  ;; CHECK:      (export "obc" (func $other-base-caller))

  ;; CHECK:      (export "asym1" (func $asym-1))

  ;; CHECK:      (export "asym2" (func $asym-2))

  ;; CHECK:      (func $target-a (type $fn) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (i32.const 10)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $target-a (type $fn) (param $x i32) (result i32)
    (i32.add (local.get $x) (i32.const 10))
  )
  ;; CHECK:      (func $target-b (type $fn) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (i32.sub
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (i32.const 10)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $target-b (type $fn) (param $x i32) (result i32)
    (i32.sub (local.get $x) (i32.const 10))
  )
  ;; CHECK:      (func $consume-fn (type $2) (param $0 (ref $fn)) (param $1 i32) (result i32)
  ;; CHECK-NEXT:  (call_ref $fn
  ;; CHECK-NEXT:   (local.get $1)
  ;; CHECK-NEXT:   (local.get $0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $consume-fn (param (ref $fn) i32) (result i32)
    (call_ref $fn (local.get 1) (local.get 0))
  )

  ;; Differ in both (ref.func $target-{a,b}) and (call $target-{a,b} ...):
  ;; both uses should share a single (ref $fn) parameter on the merged helper.
  ;; CHECK:      (func $ref-func-and-call-1 (type $fn) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (call $byn$mgfn-shared$ref-func-and-call-1
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (ref.func $target-a)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $ref-func-and-call-1 (export "rf1") (param $x i32) (result i32)
    (i32.add
      (i32.add
        (call $consume-fn (ref.func $target-a) (local.get $x))
        (call $consume-fn (ref.func $target-a) (i32.add (local.get $x) (i32.const 1)))
      )
      (call $target-a (i32.mul (local.get $x) (i32.const 3)))
    )
  )
  ;; CHECK:      (func $ref-func-and-call-2 (type $fn) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (call $byn$mgfn-shared$ref-func-and-call-1
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (ref.func $target-b)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $ref-func-and-call-2 (export "rf2") (param $x i32) (result i32)
    (i32.add
      (i32.add
        (call $consume-fn (ref.func $target-b) (local.get $x))
        (call $consume-fn (ref.func $target-b) (i32.add (local.get $x) (i32.const 1)))
      )
      (call $target-b (i32.mul (local.get $x) (i32.const 3)))
    )
  )

  ;; Asymmetric constThunk fallback: $const-thunk-a is an active constThunk
  ;; (its base $base-two-arg has >= 2 callers), whereas $non-thunk-b is not a
  ;; constThunk. Unwrapping $const-thunk-a in rounds 0..1 changes $asym-1's call
  ;; arity from 1 to 2, so round 2 (without unwrapping) merges $asym-1 and
  ;; $asym-2 via their 1-arg targets.
  ;; CHECK:      (func $base-two-arg (type $3) (param $x i32) (param $k i32) (result i32)
  ;; CHECK-NEXT:  (i32.xor
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (local.get $k)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $base-two-arg (param $x i32) (param $k i32) (result i32)
    (i32.xor (local.get $x) (local.get $k))
  )
  ;; CHECK:      (func $const-thunk-a (type $fn) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (call $base-two-arg
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (i32.const 99)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $const-thunk-a (type $fn) (param $x i32) (result i32)
    (call $base-two-arg (local.get $x) (i32.const 99))
  )
  ;; CHECK:      (func $other-base-caller (type $fn) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (call $base-two-arg
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (i32.const 77)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $other-base-caller (export "obc") (param $x i32) (result i32)
    (call $base-two-arg (local.get $x) (i32.const 77))
  )
  ;; CHECK:      (func $non-thunk-b (type $fn) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (i32.mul
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $non-thunk-b (type $fn) (param $x i32) (result i32)
    (i32.mul (local.get $x) (local.get $x))
  )
  ;; CHECK:      (func $asym-1 (type $fn) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (call $byn$mgfn-shared$asym-1
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (ref.func $const-thunk-a)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $asym-1 (export "asym1") (param $x i32) (result i32)
    (i32.add
      (i32.add
        (call $const-thunk-a (i32.add (local.get $x) (i32.const 1)))
        (call $const-thunk-a (i32.add (local.get $x) (i32.const 2)))
      )
      (call $const-thunk-a (i32.add (local.get $x) (i32.const 3)))
    )
  )
  ;; CHECK:      (func $asym-2 (type $fn) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (call $byn$mgfn-shared$asym-1
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (ref.func $non-thunk-b)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $asym-2 (export "asym2") (param $x i32) (result i32)
    (i32.add
      (i32.add
        (call $non-thunk-b (i32.add (local.get $x) (i32.const 1)))
        (call $non-thunk-b (i32.add (local.get $x) (i32.const 2)))
      )
      (call $non-thunk-b (i32.add (local.get $x) (i32.const 3)))
    )
  )
)
;; CHECK:      (func $byn$mgfn-shared$asym-1 (type $1) (param $0 i32) (param $1 (ref $fn)) (result i32)
;; CHECK-NEXT:  (i32.add
;; CHECK-NEXT:   (i32.add
;; CHECK-NEXT:    (call_ref $fn
;; CHECK-NEXT:     (i32.add
;; CHECK-NEXT:      (local.get $0)
;; CHECK-NEXT:      (i32.const 1)
;; CHECK-NEXT:     )
;; CHECK-NEXT:     (local.get $1)
;; CHECK-NEXT:    )
;; CHECK-NEXT:    (call_ref $fn
;; CHECK-NEXT:     (i32.add
;; CHECK-NEXT:      (local.get $0)
;; CHECK-NEXT:      (i32.const 2)
;; CHECK-NEXT:     )
;; CHECK-NEXT:     (local.get $1)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (call_ref $fn
;; CHECK-NEXT:    (i32.add
;; CHECK-NEXT:     (local.get $0)
;; CHECK-NEXT:     (i32.const 3)
;; CHECK-NEXT:    )
;; CHECK-NEXT:    (local.get $1)
;; CHECK-NEXT:   )
;; CHECK-NEXT:  )
;; CHECK-NEXT: )

;; CHECK:      (func $byn$mgfn-shared$ref-func-and-call-1 (type $1) (param $0 i32) (param $1 (ref $fn)) (result i32)
;; CHECK-NEXT:  (i32.add
;; CHECK-NEXT:   (i32.add
;; CHECK-NEXT:    (call $consume-fn
;; CHECK-NEXT:     (local.get $1)
;; CHECK-NEXT:     (local.get $0)
;; CHECK-NEXT:    )
;; CHECK-NEXT:    (call $consume-fn
;; CHECK-NEXT:     (local.get $1)
;; CHECK-NEXT:     (i32.add
;; CHECK-NEXT:      (local.get $0)
;; CHECK-NEXT:      (i32.const 1)
;; CHECK-NEXT:     )
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (call_ref $fn
;; CHECK-NEXT:    (i32.mul
;; CHECK-NEXT:     (local.get $0)
;; CHECK-NEXT:     (i32.const 3)
;; CHECK-NEXT:    )
;; CHECK-NEXT:    (local.get $1)
;; CHECK-NEXT:   )
;; CHECK-NEXT:  )
;; CHECK-NEXT: )
