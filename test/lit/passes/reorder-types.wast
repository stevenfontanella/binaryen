(module
  ;; Regression test. ReorderTypes used to collect the types used in the binary
  ;; for their counts, which in this case includes $multi because it is part of
  ;; the rec group. However, GlobalTypeRewriter separately collected only the
  ;; used IR types, which includes a standalone function type instead of $multi.
  ;; The sort then tried to lookup the count for the standalone function type
  ;; and crashed when it couldn't find it.
  (rec
    (type $multi (func (result (ref $A) (ref $B))))
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $A (sub (struct)))
    (type $A (sub (struct)))
    ;; CHECK:       (type $B (sub $A (struct)))
    (type $B (sub $A (struct)))
  )
  ;; CHECK:      (func $test (type $3) (param $0 i32) (result (ref $A) (ref $B))
  ;; CHECK-NEXT:  (unreachable)
  ;; CHECK-NEXT: )
  (func $test (param i32) (result (ref $A) (ref $B))
    (block (type $multi) (result (ref $A) (ref $B))
      (unreachable)
    )
  )
)

(module
  ;; Two-tier S33 (< 2 in testing mode) vs U32 (< 4 in testing mode) density
  ;; ordering: $parent and $child have S33 uses (via subtype and local types) so
  ;; their ancestor closure is placed in indices 0..1 ahead of $sig1 and $sig2
  ;; (which have higher total uses, but only U32 function-type uses and zero S33
  ;; uses), while $sig1 and $sig2 are placed in indices 2..3 ahead of $low1 and
  ;; $low2.
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $parent (sub (struct)))

    ;; CHECK:       (type $child (sub $parent (struct)))

    ;; CHECK:       (type $sig1 (func (param i32)))

    ;; CHECK:       (type $sig2 (func (param i64)))

    ;; CHECK:       (type $low1 (struct))
    (type $low1 (struct))
    ;; CHECK:       (type $low2 (struct))
    (type $low2 (struct))
    (type $sig1 (func (param i32)))
    (type $sig2 (func (param i64)))
    (type $parent (sub (struct)))
    (type $child (sub $parent (struct)))
  )

  ;; CHECK:      (global $k1 (ref null $low1) (ref.null none))
  (global $k1 (ref null $low1) (ref.null none))
  ;; CHECK:      (global $k2 (ref null $low2) (ref.null none))
  (global $k2 (ref null $low2) (ref.null none))

  ;; CHECK:      (func $f1 (type $sig1) (param $0 i32)
  ;; CHECK-NEXT:  (local $1 (ref $child))
  ;; CHECK-NEXT: )
  (func $f1 (type $sig1) (param i32)
    (local (ref $child))
  )
  ;; CHECK:      (func $f2 (type $sig1) (param $0 i32)
  ;; CHECK-NEXT:  (local $1 (ref $child))
  ;; CHECK-NEXT: )
  (func $f2 (type $sig1) (param i32)
    (local (ref $child))
  )
  ;; CHECK:      (func $f3 (type $sig1) (param $0 i32)
  ;; CHECK-NEXT:  (local $1 (ref $child))
  ;; CHECK-NEXT: )
  (func $f3 (type $sig1) (param i32)
    (local (ref $child))
  )
  ;; CHECK:      (func $f4 (type $sig1) (param $0 i32)
  ;; CHECK-NEXT:  (local $1 (ref $child))
  ;; CHECK-NEXT: )
  (func $f4 (type $sig1) (param i32)
    (local (ref $child))
  )
  ;; CHECK:      (func $f5 (type $sig1) (param $0 i32)
  ;; CHECK-NEXT:  (local $1 (ref $child))
  ;; CHECK-NEXT: )
  (func $f5 (type $sig1) (param i32)
    (local (ref $child))
  )
  ;; CHECK:      (func $g1 (type $sig2) (param $0 i64)
  ;; CHECK-NEXT: )
  (func $g1 (type $sig2) (param i64))
  ;; CHECK:      (func $g2 (type $sig2) (param $0 i64)
  ;; CHECK-NEXT: )
  (func $g2 (type $sig2) (param i64))
  ;; CHECK:      (func $g3 (type $sig2) (param $0 i64)
  ;; CHECK-NEXT: )
  (func $g3 (type $sig2) (param i64))
  ;; CHECK:      (func $g4 (type $sig2) (param $0 i64)
  ;; CHECK-NEXT: )
  (func $g4 (type $sig2) (param i64))
)

(module
  ;; Public singleton signature splitting and tail singleton detachment:
  ;; $pub_split is used by 1 import and 5 private functions, so its private uses
  ;; are split onto a private signature inside the rec group. $tail is a low-use
  ;; private struct that is the sole private user of $pub_tail, so $tail is
  ;; detached as a singleton after the main private rec group.
  ;; CHECK:      (rec
  ;; CHECK-NEXT:  (type $s1 (struct))

  ;; CHECK:       (type $s2 (struct))

  ;; CHECK:       (type $sig1 (func (param i64)))

  ;; CHECK:       (type $sig2 (func (param f64)))

  ;; CHECK:       (type $low (struct))

  ;; CHECK:      (type $pub_tail (func (param i32) (result i32)))

  ;; CHECK:      (type $tail (struct (field (ref null $pub_tail))))

  ;; CHECK:      (type $pub_split (func))
  (type $pub_split (func))
  (type $pub_tail (func (param i32) (result i32)))
  (rec
    (type $tail (struct (field (ref null $pub_tail))))
    (type $low (struct))
    (type $s1 (struct))
    (type $s2 (struct))
    (type $sig1 (func (param i64)))
    (type $sig2 (func (param f64)))
  )

  ;; CHECK:      (import "env" "imp1" (func $imp1 (type $pub_split)))
  (import "env" "imp1" (func $imp1 (type $pub_split)))
  ;; CHECK:      (import "env" "imp2" (func $imp2 (type $pub_tail) (param i32) (result i32)))
  (import "env" "imp2" (func $imp2 (type $pub_tail) (param i32) (result i32)))

  ;; CHECK:      (global $gt (ref null $tail) (ref.null none))
  (global $gt (ref null $tail) (ref.null none))
  ;; CHECK:      (global $gl (ref null $low) (ref.null none))
  (global $gl (ref null $low) (ref.null none))

  ;; CHECK:      (func $p1 (type $2)
  ;; CHECK-NEXT:  (local $0 (ref $s1))
  ;; CHECK-NEXT:  (local $1 (ref $s2))
  ;; CHECK-NEXT: )
  (func $p1 (type $pub_split)
    (local (ref $s1) (ref $s2))
  )
  ;; CHECK:      (func $p2 (type $2)
  ;; CHECK-NEXT:  (local $0 (ref $s1))
  ;; CHECK-NEXT:  (local $1 (ref $s2))
  ;; CHECK-NEXT: )
  (func $p2 (type $pub_split)
    (local (ref $s1) (ref $s2))
  )
  ;; CHECK:      (func $p3 (type $2)
  ;; CHECK-NEXT:  (local $0 (ref $s1))
  ;; CHECK-NEXT:  (local $1 (ref $s2))
  ;; CHECK-NEXT: )
  (func $p3 (type $pub_split)
    (local (ref $s1) (ref $s2))
  )
  ;; CHECK:      (func $p4 (type $2)
  ;; CHECK-NEXT:  (local $0 (ref $s1))
  ;; CHECK-NEXT:  (local $1 (ref $s2))
  ;; CHECK-NEXT: )
  (func $p4 (type $pub_split)
    (local (ref $s1) (ref $s2))
  )
  ;; CHECK:      (func $p5 (type $2)
  ;; CHECK-NEXT: )
  (func $p5 (type $pub_split))
  ;; CHECK:      (func $q1 (type $sig1) (param $0 i64)
  ;; CHECK-NEXT: )
  (func $q1 (type $sig1) (param i64))
  ;; CHECK:      (func $q2 (type $sig1) (param $0 i64)
  ;; CHECK-NEXT: )
  (func $q2 (type $sig1) (param i64))
  ;; CHECK:      (func $q3 (type $sig1) (param $0 i64)
  ;; CHECK-NEXT: )
  (func $q3 (type $sig1) (param i64))
  ;; CHECK:      (func $r1 (type $sig2) (param $0 f64)
  ;; CHECK-NEXT: )
  (func $r1 (type $sig2) (param f64))
  ;; CHECK:      (func $r2 (type $sig2) (param $0 f64)
  ;; CHECK-NEXT: )
  (func $r2 (type $sig2) (param f64))
  ;; CHECK:      (func $r3 (type $sig2) (param $0 f64)
  ;; CHECK-NEXT: )
  (func $r3 (type $sig2) (param f64))
)
