    ;; CHECK:       (type $C (sub $B (struct)))
    (type $C (sub $B (struct)))
  )

  ;; CHECK:      (func $test (type $3)
  ;; CHECK-NEXT:  (local $0 (ref $A))
  ;; CHECK-NEXT:  (local $1 (ref $B))
  ;; CHECK-NEXT:  (local $2 (ref $B))
  ;; CHECK-NEXT:  (local $3 (ref $C))
  ;; CHECK-NEXT:  (local $4 (ref $C))
  ;; CHECK-NEXT:  (local $5 (ref $C))
  ;; CHECK-NEXT: )
