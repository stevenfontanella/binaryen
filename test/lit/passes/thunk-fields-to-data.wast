;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: foreach %s %t wasm-opt --closed-world --thunk-fields-to-data --pass-arg=thunk-fields-to-data-always@1 --remove-unused-module-elements -all -S -o - | filecheck %s

;; Lazy mode: a getClass-like slot. Every vtable's slot is a thunk returning a
;; Class global; all Class objects are created identically and are used nowhere
;; else, so the slot becomes a mutable nullable Class field that a helper fills
;; on first read. $vt.shared and $vt.shared2 use the same thunk (the Class
;; object is reachable from two vtables), so they stay eager; $vt.array's thunk
;; is not a constant and $vt.null's returns null, so both are called through an
;; identity check in the helper. The thunks and the Class globals become
;; unused, and --remove-unused-module-elements removes them.
(module
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $vt (sub (struct (field (mut (ref null $Class))))))

    ;; CHECK:       (type $1 (func (param (ref null $vt)) (result (ref null $Class))))

    ;; CHECK:       (type $Object (struct (field (ref $vt))))

    ;; CHECK:       (type $get-class (func (result (ref null $Class))))

    ;; CHECK:       (type $vt.sub (sub $vt (struct (field (mut (ref null $Class))) (field i32))))

    ;; CHECK:       (type $Class (struct (field (mut i32))))
    (type $Class (struct (field (mut i32))))
    (type $vt (sub (struct (field (ref $get-class)))))
    (type $vt.sub (sub $vt (struct (field (ref $get-class)) (field i32))))
    (type $get-class (func (result (ref null $Class))))
  )
  (type $Object (struct (field (ref $vt))))

  (global $class.a (ref $Class) (struct.new $Class (i32.const 0)))
  (global $class.b (ref $Class) (struct.new $Class (i32.const 0)))
  (global $class.c (ref $Class) (struct.new $Class (i32.const 0)))
  ;; CHECK:      (type $6 (func (param anyref) (result anyref)))

  ;; CHECK:      (type $7 (func))

  ;; CHECK:      (global $class.shared (ref $Class) (struct.new $Class
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT: ))
  (global $class.shared (ref $Class) (struct.new $Class (i32.const 0)))

  ;; CHECK:      (global $vt.a (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT: ))
  (global $vt.a (ref $vt) (struct.new $vt (ref.func $thunk.a)))
  ;; CHECK:      (global $vt.array (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (global $vt.null (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (global $vt.b (ref $vt.sub) (struct.new $vt.sub
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT: ))
  (global $vt.b (ref $vt.sub) (struct.new $vt.sub (ref.func $thunk.b) (i32.const 1)))
  ;; CHECK:      (global $vt.c (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT: ))
  (global $vt.c (ref $vt) (struct.new $vt (ref.func $thunk.c)))
  ;; CHECK:      (global $vt.shared (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (global.get $class.shared)
  ;; CHECK-NEXT: ))
  (global $vt.shared (ref $vt) (struct.new $vt (ref.func $thunk.shared)))
  ;; CHECK:      (global $vt.shared2 (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (global.get $class.shared)
  ;; CHECK-NEXT: ))
  (global $vt.shared2 (ref $vt) (struct.new $vt (ref.func $thunk.shared)))
  (global $vt.array (ref $vt) (struct.new $vt (ref.func $thunk.array)))
  (global $vt.null (ref $vt) (struct.new $vt (ref.func $thunk.null)))

  (func $thunk.a (type $get-class) (result (ref null $Class))
    (global.get $class.a)
  )
  (func $thunk.b (type $get-class) (result (ref null $Class))
    (global.get $class.b)
  )
  (func $thunk.c (type $get-class) (result (ref null $Class))
    (global.get $class.c)
  )
  (func $thunk.shared (type $get-class) (result (ref null $Class))
    (global.get $class.shared)
  )
  ;; CHECK:      (export "getClass" (func $getClass))

  ;; CHECK:      (export "use" (func $use))

  ;; CHECK:      (export "keep" (func $keep))

  ;; CHECK:      (func $thunk.array (type $get-class) (result (ref null $Class))
  ;; CHECK-NEXT:  (struct.new $Class
  ;; CHECK-NEXT:   (i32.const 42)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $thunk.array (type $get-class) (result (ref null $Class))
    (struct.new $Class (i32.const 42))
  )
  ;; CHECK:      (func $thunk.null (type $get-class) (result (ref null $Class))
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT: )
  (func $thunk.null (type $get-class) (result (ref null $Class))
    (ref.null none)
  )

  ;; CHECK:      (func $getClass (type $6) (param $obj anyref) (result anyref)
  ;; CHECK-NEXT:  (call $lazy$vt$0
  ;; CHECK-NEXT:   (struct.get $Object 0
  ;; CHECK-NEXT:    (ref.cast (ref $Object)
  ;; CHECK-NEXT:     (local.get $obj)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $getClass (export "getClass") (param $obj anyref) (result anyref)
    (call_ref $get-class
      (struct.get $vt 0
        (struct.get $Object 0
          (ref.cast (ref $Object)
            (local.get $obj)
          )
        )
      )
    )
  )

  ;; CHECK:      (func $use (type $6) (param $vt anyref) (result anyref)
  ;; CHECK-NEXT:  (return_call $lazy$vt$0
  ;; CHECK-NEXT:   (ref.cast (ref null $vt)
  ;; CHECK-NEXT:    (local.get $vt)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $use (export "use") (param $vt anyref) (result anyref)
    (return_call_ref $get-class
      (struct.get $vt 0
        (ref.cast (ref null $vt)
          (local.get $vt)
        )
      )
    )
  )

  ;; CHECK:      (func $keep (type $7)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $vt.a)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $vt.b)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $vt.c)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $vt.shared)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $vt.shared2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $vt.array)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $vt.null)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (ref.as_non_null
  ;; CHECK-NEXT:    (call $lazy$vt$0
  ;; CHECK-NEXT:     (global.get $vt.a)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $keep (export "keep")
    (drop (global.get $vt.a))
    (drop (global.get $vt.b))
    (drop (global.get $vt.c))
    (drop (global.get $vt.shared))
    (drop (global.get $vt.shared2))
    (drop (global.get $vt.array))
    (drop (global.get $vt.null))
    (drop (global.get $class.a))
  )
)

;; Eager mode: thunks returning i32 constants. The field becomes an immutable
;; i32 and the call_refs become plain struct.gets.
;; CHECK:      (func $lazy$vt$0 (type $1) (param $0 (ref null $vt)) (result (ref null $Class))
;; CHECK-NEXT:  (local $1 (ref (exact $Class)))
;; CHECK-NEXT:  (block $out (result (ref $Class))
;; CHECK-NEXT:   (br_on_non_null $out
;; CHECK-NEXT:    (struct.get $vt 0
;; CHECK-NEXT:     (local.get $0)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (if
;; CHECK-NEXT:    (ref.eq
;; CHECK-NEXT:     (local.get $0)
;; CHECK-NEXT:     (global.get $vt.array)
;; CHECK-NEXT:    )
;; CHECK-NEXT:    (then
;; CHECK-NEXT:     (return
;; CHECK-NEXT:      (call $thunk.array)
;; CHECK-NEXT:     )
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (if
;; CHECK-NEXT:    (ref.eq
;; CHECK-NEXT:     (local.get $0)
;; CHECK-NEXT:     (global.get $vt.null)
;; CHECK-NEXT:    )
;; CHECK-NEXT:    (then
;; CHECK-NEXT:     (return
;; CHECK-NEXT:      (call $thunk.null)
;; CHECK-NEXT:     )
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (struct.set $vt 0
;; CHECK-NEXT:    (local.get $0)
;; CHECK-NEXT:    (local.tee $1
;; CHECK-NEXT:     (struct.new $Class
;; CHECK-NEXT:      (i32.const 0)
;; CHECK-NEXT:     )
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (local.get $1)
;; CHECK-NEXT:  )
;; CHECK-NEXT: )
(module
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $get-i32 (func (result i32)))
    (type $get-i32 (func (result i32)))
    ;; CHECK:       (type $vt (sub (struct (field i32))))
    (type $vt (sub (struct (field (ref $get-i32)))))
  )

  ;; CHECK:      (type $2 (func (param anyref) (result i32)))

  ;; CHECK:      (type $3 (func))

  ;; CHECK:      (global $vt.a (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT: ))
  (global $vt.a (ref $vt) (struct.new $vt (ref.func $thunk.1)))
  ;; CHECK:      (global $vt.b (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (i32.const 2)
  ;; CHECK-NEXT: ))
  (global $vt.b (ref $vt) (struct.new $vt (ref.func $thunk.2)))
  ;; CHECK:      (global $vt.c (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT: ))
  (global $vt.c (ref $vt) (struct.new $vt (ref.func $thunk.1)))

  (func $thunk.1 (type $get-i32) (result i32)
    (i32.const 1)
  )
  (func $thunk.2 (type $get-i32) (result i32)
    (i32.const 2)
  )

  ;; CHECK:      (export "get" (func $get))

  ;; CHECK:      (export "keep" (func $keep))

  ;; CHECK:      (func $get (type $2) (param $vt anyref) (result i32)
  ;; CHECK-NEXT:  (struct.get $vt 0
  ;; CHECK-NEXT:   (ref.cast (ref $vt)
  ;; CHECK-NEXT:    (local.get $vt)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $get (export "get") (param $vt anyref) (result i32)
    (call_ref $get-i32
      (struct.get $vt 0
        (ref.cast (ref $vt)
          (local.get $vt)
        )
      )
    )
  )

  ;; CHECK:      (func $keep (type $3)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $vt.a)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $vt.b)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $vt.c)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $keep (export "keep")
    (drop (global.get $vt.a))
    (drop (global.get $vt.b))
    (drop (global.get $vt.c))
  )
)

