;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; Test the Huffman coding of the token stream: each class of bytes (tokens,
;; extra lengths, narrow literals, wide literal low/high bytes, short
;; distances, long distance low/high bytes) gets a canonical code; the segment
;; holds the tables (15 counts, then the symbols) and one bit stream, and a
;; shared symbol decoder reads the codes bit by bit.

;; RUN: wasm-opt %s -all --string-lowering --string-consts-to-data --pass-arg=string-consts-to-data-always@1 --pass-arg=string-consts-to-data-huffman@1 -S -o - | filecheck %s

(module
  (type $col (array externref))














  (global $column (ref $col) (array.new_fixed $col 5
    (string.const "foo")
    (string.const "héllo\n\thello foo")
    (string.const "日本語")
    (string.const "foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo foo")
    (string.const "héllo")
  ))

