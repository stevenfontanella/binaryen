  ;; CHECK:      (type $10 (func (param externref i32) (result i32)))

  ;; CHECK:      (type $11 (func (param externref i32 i32) (result (ref extern))))

  ;; CHECK:      (type $12 (func (param (ref $2) i32) (result i32)))

  ;; CHECK:      (type $13 (func))

