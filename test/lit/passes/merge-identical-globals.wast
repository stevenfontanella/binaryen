;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: foreach %s %t wasm-opt -all --closed-world --merge-identical-globals -S -o - | filecheck %s
;; RUN: foreach %s %t wasm-opt -all --closed-world --merge-identical-globals \
;; RUN:   --pass-arg=merge-identical-globals-merge-lazy-null@1 -S -o - | filecheck %s --check-prefix=LAZY

(module
  ;; CHECK:      (type $Class (struct (field i32)))
  ;; LAZY:      (type $Class (struct (field i32)))
  (type $Class (struct (field i32)))
  ;; CHECK:      (type $itable (struct))
  ;; LAZY:      (type $itable (struct))
  (type $itable (struct))
  ;; CHECK:      (type $vtable (sub (struct (field (ref $itable)) (field (mut (ref null $Class))) (field funcref) (field funcref))))

  ;; CHECK:      (type $box (struct (field (mut i32))))

  ;; CHECK:      (type $marr (array (mut i32)))

  ;; CHECK:      (type $pair (struct (field funcref) (field funcref) (field i32)))
  ;; LAZY:      (type $vtable (sub (struct (field (ref $itable)) (field (mut (ref null $Class))) (field funcref) (field funcref))))

  ;; LAZY:      (type $box (struct (field (mut i32))))

  ;; LAZY:      (type $marr (array (mut i32)))

  ;; LAZY:      (type $pair (struct (field funcref) (field funcref) (field i32)))
  (type $pair (struct (field funcref) (field funcref) (field i32)))
  ;; A vtable: itable, a lazily initialized Class slot, two methods.
  (type $vtable (sub (struct (field (ref $itable))
                             (field (mut (ref null $Class)))
                             (field funcref)
                             (field funcref))))
  ;; CHECK:      (type $vtable2 (sub $vtable (struct (field (ref $itable)) (field (mut (ref null $Class))) (field funcref) (field funcref) (field (ref null $pair)) (field i32))))
  ;; LAZY:      (type $vtable2 (sub $vtable (struct (field (ref $itable)) (field (mut (ref null $Class))) (field funcref) (field funcref) (field (ref null $pair)) (field i32))))
  (type $vtable2 (sub $vtable (struct (field (ref $itable))
                                      (field (mut (ref null $Class)))
                                      (field funcref)
                                      (field funcref)
                                      (field (ref null $pair))
                                      (field i32))))
  (type $box (struct (field (mut i32))))
  ;; CHECK:      (type $arr (array i32))
  ;; LAZY:      (type $arr (array i32))
  (type $arr (array i32))
  (type $marr (array (mut i32)))

  ;; CHECK:      (type $8 (func))

  ;; CHECK:      (type $9 (func (param (ref null $vtable)) (result (ref $Class))))

  ;; CHECK:      (type $10 (func (param (ref null $vtable))))

  ;; CHECK:      (type $11 (func (param (ref $box) (ref $marr))))

  ;; CHECK:      (type $12 (func (result anyref)))

  ;; CHECK:      (global $itable (ref $itable) (struct.new_default $itable))

  ;; CHECK:      (global $class (ref $Class) (struct.new $Class
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT: ))
  ;; LAZY:      (type $8 (func))

  ;; LAZY:      (type $9 (func (param (ref null $vtable)) (result (ref $Class))))

  ;; LAZY:      (type $10 (func (param (ref null $vtable))))

  ;; LAZY:      (type $11 (func (param (ref $box) (ref $marr))))

  ;; LAZY:      (type $12 (func (result anyref)))

  ;; LAZY:      (global $itable (ref $itable) (struct.new_default $itable))

  ;; LAZY:      (global $class (ref $Class) (struct.new $Class
  ;; LAZY-NEXT:  (i32.const 0)
  ;; LAZY-NEXT: ))
  (global $class (ref $Class) (struct.new $Class (i32.const 0)))

  ;; Identical vtables with an eager, shared Class: merged into $vt1. The
  ;; nested empty itables are hoisted into the existing $itable global.
  ;; CHECK:      (global $hoisted (ref (exact $pair)) (struct.new $pair
  ;; CHECK-NEXT:  (ref.func $f)
  ;; CHECK-NEXT:  (ref.func $g)
  ;; CHECK-NEXT:  (i32.const 1000)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (global $vt1 (ref $vtable) (struct.new $vtable
  ;; CHECK-NEXT:  (global.get $itable)
  ;; CHECK-NEXT:  (global.get $class)
  ;; CHECK-NEXT:  (ref.func $f)
  ;; CHECK-NEXT:  (ref.func $g)
  ;; CHECK-NEXT: ))
  ;; LAZY:      (global $hoisted (ref (exact $pair)) (struct.new $pair
  ;; LAZY-NEXT:  (ref.func $f)
  ;; LAZY-NEXT:  (ref.func $g)
  ;; LAZY-NEXT:  (i32.const 1000)
  ;; LAZY-NEXT: ))

  ;; LAZY:      (global $vt1 (ref $vtable) (struct.new $vtable
  ;; LAZY-NEXT:  (global.get $itable)
  ;; LAZY-NEXT:  (global.get $class)
  ;; LAZY-NEXT:  (ref.func $f)
  ;; LAZY-NEXT:  (ref.func $g)
  ;; LAZY-NEXT: ))
  (global $vt1 (ref $vtable) (struct.new $vtable
    (struct.new_default $itable)
    (global.get $class)
    (ref.func $f)
    (ref.func $g)
  ))
  (global $vt2 (ref $vtable) (struct.new $vtable
    (struct.new_default $itable)
    (global.get $class)
    (ref.func $f)
    (ref.func $g)
  ))
  ;; Different methods: kept.
  ;; CHECK:      (global $arr1 (ref $arr) (array.new_fixed $arr 2
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT:  (i32.const 2)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (global $vt3 (ref $vtable) (struct.new $vtable
  ;; CHECK-NEXT:  (global.get $itable)
  ;; CHECK-NEXT:  (global.get $class)
  ;; CHECK-NEXT:  (ref.func $g)
  ;; CHECK-NEXT:  (ref.func $f)
  ;; CHECK-NEXT: ))
  ;; LAZY:      (global $lazy1 (ref $vtable) (struct.new $vtable
  ;; LAZY-NEXT:  (global.get $itable)
  ;; LAZY-NEXT:  (ref.null none)
  ;; LAZY-NEXT:  (ref.func $f)
  ;; LAZY-NEXT:  (ref.func $g)
  ;; LAZY-NEXT: ))

  ;; LAZY:      (global $arr1 (ref $arr) (array.new_fixed $arr 2
  ;; LAZY-NEXT:  (i32.const 1)
  ;; LAZY-NEXT:  (i32.const 2)
  ;; LAZY-NEXT: ))

  ;; LAZY:      (global $vt3 (ref $vtable) (struct.new $vtable
  ;; LAZY-NEXT:  (global.get $itable)
  ;; LAZY-NEXT:  (global.get $class)
  ;; LAZY-NEXT:  (ref.func $g)
  ;; LAZY-NEXT:  (ref.func $f)
  ;; LAZY-NEXT: ))
  (global $vt3 (ref $vtable) (struct.new $vtable
    (struct.new_default $itable)
    (global.get $class)
    (ref.func $g)
    (ref.func $f)
  ))

  ;; Identical vtables with a null lazy Class slot: kept, unless the lazy-null
  ;; knob is set.
  ;; CHECK:      (global $lazy1 (ref $vtable) (struct.new $vtable
  ;; CHECK-NEXT:  (global.get $itable)
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT:  (ref.func $f)
  ;; CHECK-NEXT:  (ref.func $g)
  ;; CHECK-NEXT: ))
  (global $lazy1 (ref $vtable) (struct.new $vtable
    (struct.new_default $itable)
    (ref.null none)
    (ref.func $f)
    (ref.func $g)
  ))
  ;; CHECK:      (global $lazy2 (ref $vtable) (struct.new $vtable
  ;; CHECK-NEXT:  (global.get $itable)
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT:  (ref.func $f)
  ;; CHECK-NEXT:  (ref.func $g)
  ;; CHECK-NEXT: ))
  (global $lazy2 (ref $vtable) (struct.new $vtable
    (struct.new_default $itable)
    (ref.null none)
    (ref.func $f)
    (ref.func $g)
  ))
  ;; Identical to the above, but used as a ref.eq operand: kept.
  ;; CHECK:      (global $key (ref $vtable) (struct.new $vtable
  ;; CHECK-NEXT:  (global.get $itable)
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT:  (ref.func $f)
  ;; CHECK-NEXT:  (ref.func $g)
  ;; CHECK-NEXT: ))
  ;; LAZY:      (global $key (ref $vtable) (struct.new $vtable
  ;; LAZY-NEXT:  (global.get $itable)
  ;; LAZY-NEXT:  (ref.null none)
  ;; LAZY-NEXT:  (ref.func $f)
  ;; LAZY-NEXT:  (ref.func $g)
  ;; LAZY-NEXT: ))
  (global $key (ref $vtable) (struct.new $vtable
    (struct.new_default $itable)
    (ref.null none)
    (ref.func $f)
    (ref.func $g)
  ))

  ;; A written field: kept.
  ;; CHECK:      (global $box1 (ref $box) (struct.new $box
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT: ))
  ;; LAZY:      (global $box1 (ref $box) (struct.new $box
  ;; LAZY-NEXT:  (i32.const 1)
  ;; LAZY-NEXT: ))
  (global $box1 (ref $box) (struct.new $box (i32.const 1)))
  ;; CHECK:      (global $box2 (ref $box) (struct.new $box
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT: ))
  ;; LAZY:      (global $box2 (ref $box) (struct.new $box
  ;; LAZY-NEXT:  (i32.const 1)
  ;; LAZY-NEXT: ))
  (global $box2 (ref $box) (struct.new $box (i32.const 1)))

  ;; Exported: kept.
  ;; CHECK:      (global $marr1 (ref $marr) (array.new_fixed $marr 1
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (global $marr2 (ref $marr) (array.new_fixed $marr 1
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (global $n1 (ref $vtable2) (struct.new $vtable2
  ;; CHECK-NEXT:  (global.get $itable)
  ;; CHECK-NEXT:  (global.get $class)
  ;; CHECK-NEXT:  (ref.func $f)
  ;; CHECK-NEXT:  (ref.func $g)
  ;; CHECK-NEXT:  (global.get $hoisted)
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (global $n2 (ref $vtable2) (struct.new $vtable2
  ;; CHECK-NEXT:  (global.get $itable)
  ;; CHECK-NEXT:  (global.get $class)
  ;; CHECK-NEXT:  (ref.func $f)
  ;; CHECK-NEXT:  (ref.func $g)
  ;; CHECK-NEXT:  (global.get $hoisted)
  ;; CHECK-NEXT:  (i32.const 2)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (global $n3 (ref $vtable2) (struct.new $vtable2
  ;; CHECK-NEXT:  (global.get $itable)
  ;; CHECK-NEXT:  (global.get $class)
  ;; CHECK-NEXT:  (ref.func $f)
  ;; CHECK-NEXT:  (ref.func $g)
  ;; CHECK-NEXT:  (global.get $hoisted)
  ;; CHECK-NEXT:  (i32.const 3)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (global $n4 (ref $vtable2) (struct.new $vtable2
  ;; CHECK-NEXT:  (global.get $itable)
  ;; CHECK-NEXT:  (global.get $class)
  ;; CHECK-NEXT:  (ref.func $f)
  ;; CHECK-NEXT:  (ref.func $g)
  ;; CHECK-NEXT:  (global.get $hoisted)
  ;; CHECK-NEXT:  (i32.const 4)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (global $exported (ref $Class) (struct.new $Class
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT: ))
  ;; LAZY:      (global $marr1 (ref $marr) (array.new_fixed $marr 1
  ;; LAZY-NEXT:  (i32.const 1)
  ;; LAZY-NEXT: ))

  ;; LAZY:      (global $marr2 (ref $marr) (array.new_fixed $marr 1
  ;; LAZY-NEXT:  (i32.const 1)
  ;; LAZY-NEXT: ))

  ;; LAZY:      (global $n1 (ref $vtable2) (struct.new $vtable2
  ;; LAZY-NEXT:  (global.get $itable)
  ;; LAZY-NEXT:  (global.get $class)
  ;; LAZY-NEXT:  (ref.func $f)
  ;; LAZY-NEXT:  (ref.func $g)
  ;; LAZY-NEXT:  (global.get $hoisted)
  ;; LAZY-NEXT:  (i32.const 1)
  ;; LAZY-NEXT: ))

  ;; LAZY:      (global $n2 (ref $vtable2) (struct.new $vtable2
  ;; LAZY-NEXT:  (global.get $itable)
  ;; LAZY-NEXT:  (global.get $class)
  ;; LAZY-NEXT:  (ref.func $f)
  ;; LAZY-NEXT:  (ref.func $g)
  ;; LAZY-NEXT:  (global.get $hoisted)
  ;; LAZY-NEXT:  (i32.const 2)
  ;; LAZY-NEXT: ))

  ;; LAZY:      (global $n3 (ref $vtable2) (struct.new $vtable2
  ;; LAZY-NEXT:  (global.get $itable)
  ;; LAZY-NEXT:  (global.get $class)
  ;; LAZY-NEXT:  (ref.func $f)
  ;; LAZY-NEXT:  (ref.func $g)
  ;; LAZY-NEXT:  (global.get $hoisted)
  ;; LAZY-NEXT:  (i32.const 3)
  ;; LAZY-NEXT: ))

  ;; LAZY:      (global $n4 (ref $vtable2) (struct.new $vtable2
  ;; LAZY-NEXT:  (global.get $itable)
  ;; LAZY-NEXT:  (global.get $class)
  ;; LAZY-NEXT:  (ref.func $f)
  ;; LAZY-NEXT:  (ref.func $g)
  ;; LAZY-NEXT:  (global.get $hoisted)
  ;; LAZY-NEXT:  (i32.const 4)
  ;; LAZY-NEXT: ))

  ;; LAZY:      (global $exported (ref $Class) (struct.new $Class
  ;; LAZY-NEXT:  (i32.const 0)
  ;; LAZY-NEXT: ))
  (global $exported (ref $Class) (struct.new $Class (i32.const 0)))
  ;; CHECK:      (export "class" (global $exported))
  ;; LAZY:      (export "class" (global $exported))
  (export "class" (global $exported))

  ;; Immutable arrays: merged.
  (global $arr1 (ref $arr) (array.new_fixed $arr 2 (i32.const 1) (i32.const 2)))
  (global $arr2 (ref $arr) (array.new_fixed $arr 2 (i32.const 1) (i32.const 2)))
  ;; Mutable arrays that are written: kept.
  (global $marr1 (ref $marr) (array.new_fixed $marr 1 (i32.const 1)))
  (global $marr2 (ref $marr) (array.new_fixed $marr 1 (i32.const 1)))

  ;; Four different vtables with an identical nested pair: the pair is hoisted
  ;; into a new global.
  (global $n1 (ref $vtable2) (struct.new $vtable2
    (struct.new_default $itable)
    (global.get $class)
    (ref.func $f)
    (ref.func $g)
    (struct.new $pair (ref.func $f) (ref.func $g) (i32.const 1000))
    (i32.const 1)
  ))
  (global $n2 (ref $vtable2) (struct.new $vtable2
    (struct.new_default $itable)
    (global.get $class)
    (ref.func $f)
    (ref.func $g)
    (struct.new $pair (ref.func $f) (ref.func $g) (i32.const 1000))
    (i32.const 2)
  ))
  (global $n3 (ref $vtable2) (struct.new $vtable2
    (struct.new_default $itable)
    (global.get $class)
    (ref.func $f)
    (ref.func $g)
    (struct.new $pair (ref.func $f) (ref.func $g) (i32.const 1000))
    (i32.const 3)
  ))
  (global $n4 (ref $vtable2) (struct.new $vtable2
    (struct.new_default $itable)
    (global.get $class)
    (ref.func $f)
    (ref.func $g)
    (struct.new $pair (ref.func $f) (ref.func $g) (i32.const 1000))
    (i32.const 4)
  ))

  ;; An existing global identical to the nested itables: reused for them.
  (global $itable (ref $itable) (struct.new_default $itable))

  ;; CHECK:      (func $f (type $8)
  ;; CHECK-NEXT: )
  ;; LAZY:      (func $f (type $8)
  ;; LAZY-NEXT: )
  (func $f)
  ;; CHECK:      (func $g (type $8)
  ;; CHECK-NEXT: )
  ;; LAZY:      (func $g (type $8)
  ;; LAZY-NEXT: )
  (func $g)

  ;; The lazy Class slot: only written under a null check (br_on_non_null).
  ;; CHECK:      (func $lazy (type $9) (param $vt (ref null $vtable)) (result (ref $Class))
  ;; CHECK-NEXT:  (block $b (result (ref $Class))
  ;; CHECK-NEXT:   (br_on_non_null $b
  ;; CHECK-NEXT:    (struct.get $vtable 1
  ;; CHECK-NEXT:     (local.get $vt)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (if
  ;; CHECK-NEXT:    (ref.eq
  ;; CHECK-NEXT:     (local.get $vt)
  ;; CHECK-NEXT:     (global.get $key)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (then
  ;; CHECK-NEXT:     (return
  ;; CHECK-NEXT:      (global.get $class)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (struct.set $vtable 1
  ;; CHECK-NEXT:    (local.get $vt)
  ;; CHECK-NEXT:    (struct.new $Class
  ;; CHECK-NEXT:     (i32.const 1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (ref.as_non_null
  ;; CHECK-NEXT:    (struct.get $vtable 1
  ;; CHECK-NEXT:     (local.get $vt)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; LAZY:      (func $lazy (type $9) (param $vt (ref null $vtable)) (result (ref $Class))
  ;; LAZY-NEXT:  (block $b (result (ref $Class))
  ;; LAZY-NEXT:   (br_on_non_null $b
  ;; LAZY-NEXT:    (struct.get $vtable 1
  ;; LAZY-NEXT:     (local.get $vt)
  ;; LAZY-NEXT:    )
  ;; LAZY-NEXT:   )
  ;; LAZY-NEXT:   (if
  ;; LAZY-NEXT:    (ref.eq
  ;; LAZY-NEXT:     (local.get $vt)
  ;; LAZY-NEXT:     (global.get $key)
  ;; LAZY-NEXT:    )
  ;; LAZY-NEXT:    (then
  ;; LAZY-NEXT:     (return
  ;; LAZY-NEXT:      (global.get $class)
  ;; LAZY-NEXT:     )
  ;; LAZY-NEXT:    )
  ;; LAZY-NEXT:   )
  ;; LAZY-NEXT:   (struct.set $vtable 1
  ;; LAZY-NEXT:    (local.get $vt)
  ;; LAZY-NEXT:    (struct.new $Class
  ;; LAZY-NEXT:     (i32.const 1)
  ;; LAZY-NEXT:    )
  ;; LAZY-NEXT:   )
  ;; LAZY-NEXT:   (ref.as_non_null
  ;; LAZY-NEXT:    (struct.get $vtable 1
  ;; LAZY-NEXT:     (local.get $vt)
  ;; LAZY-NEXT:    )
  ;; LAZY-NEXT:   )
  ;; LAZY-NEXT:  )
  ;; LAZY-NEXT: )
  (func $lazy (param $vt (ref null $vtable)) (result (ref $Class))
    (block $b (result (ref $Class))
      (br_on_non_null $b (struct.get $vtable 1 (local.get $vt)))
      (if
        (ref.eq (local.get $vt) (global.get $key))
        (then
          (return (global.get $class))
        )
      )
      (struct.set $vtable 1 (local.get $vt) (struct.new $Class (i32.const 1)))
      (ref.as_non_null (struct.get $vtable 1 (local.get $vt)))
    )
  )

  ;; Another guarded write, with an if.
  ;; CHECK:      (func $lazy-if (type $10) (param $vt (ref null $vtable))
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (ref.is_null
  ;; CHECK-NEXT:    (struct.get $vtable 1
  ;; CHECK-NEXT:     (local.get $vt)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (struct.set $vtable 1
  ;; CHECK-NEXT:     (local.get $vt)
  ;; CHECK-NEXT:     (struct.new $Class
  ;; CHECK-NEXT:      (i32.const 2)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; LAZY:      (func $lazy-if (type $10) (param $vt (ref null $vtable))
  ;; LAZY-NEXT:  (if
  ;; LAZY-NEXT:   (ref.is_null
  ;; LAZY-NEXT:    (struct.get $vtable 1
  ;; LAZY-NEXT:     (local.get $vt)
  ;; LAZY-NEXT:    )
  ;; LAZY-NEXT:   )
  ;; LAZY-NEXT:   (then
  ;; LAZY-NEXT:    (struct.set $vtable 1
  ;; LAZY-NEXT:     (local.get $vt)
  ;; LAZY-NEXT:     (struct.new $Class
  ;; LAZY-NEXT:      (i32.const 2)
  ;; LAZY-NEXT:     )
  ;; LAZY-NEXT:    )
  ;; LAZY-NEXT:   )
  ;; LAZY-NEXT:  )
  ;; LAZY-NEXT: )
  (func $lazy-if (param $vt (ref null $vtable))
    (if
      (ref.is_null (struct.get $vtable 1 (local.get $vt)))
      (then
        (struct.set $vtable 1 (local.get $vt) (struct.new $Class (i32.const 2)))
      )
    )
  )

  ;; CHECK:      (func $writes (type $11) (param $box (ref $box)) (param $marr (ref $marr))
  ;; CHECK-NEXT:  (struct.set $box 0
  ;; CHECK-NEXT:   (local.get $box)
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (array.set $marr
  ;; CHECK-NEXT:   (local.get $marr)
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; LAZY:      (func $writes (type $11) (param $box (ref $box)) (param $marr (ref $marr))
  ;; LAZY-NEXT:  (struct.set $box 0
  ;; LAZY-NEXT:   (local.get $box)
  ;; LAZY-NEXT:   (i32.const 2)
  ;; LAZY-NEXT:  )
  ;; LAZY-NEXT:  (array.set $marr
  ;; LAZY-NEXT:   (local.get $marr)
  ;; LAZY-NEXT:   (i32.const 0)
  ;; LAZY-NEXT:   (i32.const 2)
  ;; LAZY-NEXT:  )
  ;; LAZY-NEXT: )
  (func $writes (param $box (ref $box)) (param $marr (ref $marr))
    (struct.set $box 0 (local.get $box) (i32.const 2))
    (array.set $marr (local.get $marr) (i32.const 0) (i32.const 2))
  )

