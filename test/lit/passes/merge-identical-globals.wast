    (drop (global.get $n3))
    (drop (global.get $n4))
    (global.get $itable)
  )
)

;; An unguarded write to the lazy slot (the local is reassigned inside the
;; guard) makes the field written: nothing is merged, even with the knob.
(module
  ;; CHECK:      (type $Class (struct (field i32)))
  ;; LAZY:      (type $Class (struct (field i32)))
  (type $Class (struct (field i32)))
  ;; CHECK:      (type $vtable (sub (struct (field (mut (ref null $Class))) (field funcref))))
  ;; LAZY:      (type $vtable (sub (struct (field (mut (ref null $Class))) (field funcref))))
  (type $vtable (sub (struct (field (mut (ref null $Class))) (field funcref))))

  ;; CHECK:      (type $2 (func))

  ;; CHECK:      (type $3 (func (param (ref null $vtable) (ref null $vtable))))

  ;; CHECK:      (global $vt1 (ref $vtable) (struct.new $vtable
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT:  (ref.func $f)
  ;; CHECK-NEXT: ))
  ;; LAZY:      (type $2 (func))

  ;; LAZY:      (type $3 (func (param (ref null $vtable) (ref null $vtable))))

  ;; LAZY:      (global $vt1 (ref $vtable) (struct.new $vtable
  ;; LAZY-NEXT:  (ref.null none)
  ;; LAZY-NEXT:  (ref.func $f)
  ;; LAZY-NEXT: ))
  (global $vt1 (ref $vtable) (struct.new $vtable (ref.null none) (ref.func $f)))
  ;; CHECK:      (global $vt2 (ref $vtable) (struct.new $vtable
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT:  (ref.func $f)
  ;; CHECK-NEXT: ))
  ;; LAZY:      (global $vt2 (ref $vtable) (struct.new $vtable
  ;; LAZY-NEXT:  (ref.null none)
  ;; LAZY-NEXT:  (ref.func $f)
  ;; LAZY-NEXT: ))
  (global $vt2 (ref $vtable) (struct.new $vtable (ref.null none) (ref.func $f)))

  ;; CHECK:      (func $f (type $2)
  ;; CHECK-NEXT: )
  ;; LAZY:      (func $f (type $2)
  ;; LAZY-NEXT: )
  (func $f)

  ;; CHECK:      (func $lazy (type $3) (param $vt (ref null $vtable)) (param $other (ref null $vtable))
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (ref.is_null
  ;; CHECK-NEXT:    (struct.get $vtable 0
  ;; CHECK-NEXT:     (local.get $vt)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (local.set $vt
  ;; CHECK-NEXT:     (local.get $other)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (struct.set $vtable 0
  ;; CHECK-NEXT:     (local.get $vt)
  ;; CHECK-NEXT:     (struct.new $Class
  ;; CHECK-NEXT:      (i32.const 1)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; LAZY:      (func $lazy (type $3) (param $vt (ref null $vtable)) (param $other (ref null $vtable))
  ;; LAZY-NEXT:  (if
  ;; LAZY-NEXT:   (ref.is_null
  ;; LAZY-NEXT:    (struct.get $vtable 0
  ;; LAZY-NEXT:     (local.get $vt)
  ;; LAZY-NEXT:    )
  ;; LAZY-NEXT:   )
  ;; LAZY-NEXT:   (then
  ;; LAZY-NEXT:    (local.set $vt
  ;; LAZY-NEXT:     (local.get $other)
  ;; LAZY-NEXT:    )
  ;; LAZY-NEXT:    (struct.set $vtable 0
  ;; LAZY-NEXT:     (local.get $vt)
  ;; LAZY-NEXT:     (struct.new $Class
  ;; LAZY-NEXT:      (i32.const 1)
  ;; LAZY-NEXT:     )
  ;; LAZY-NEXT:    )
  ;; LAZY-NEXT:   )
  ;; LAZY-NEXT:  )
  ;; LAZY-NEXT: )
  (func $lazy (param $vt (ref null $vtable)) (param $other (ref null $vtable))
    (if
      (ref.is_null (struct.get $vtable 0 (local.get $vt)))
      (then
        (local.set $vt (local.get $other))
        (struct.set $vtable 0 (local.get $vt) (struct.new $Class (i32.const 1)))
      )
    )
  )

  ;; CHECK:      (func $uses (type $2)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $vt1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $vt2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; LAZY:      (func $uses (type $2)
  ;; LAZY-NEXT:  (drop
  ;; LAZY-NEXT:   (global.get $vt1)
  ;; LAZY-NEXT:  )
  ;; LAZY-NEXT:  (drop
  ;; LAZY-NEXT:   (global.get $vt2)
  ;; LAZY-NEXT:  )
  ;; LAZY-NEXT: )
  (func $uses
    (drop (global.get $vt1))
    (drop (global.get $vt2))
  )
)
