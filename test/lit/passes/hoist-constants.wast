;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: foreach %s %t wasm-opt --enable-gc --enable-reference-types --hoist-constants=top128 -S -o - | filecheck %s

(module
  ;; An existing immutable global with a constant init is reused for the
  ;; constant 2.5 (so even 2 uses are worth replacing).
  ;;
  ;; This module has few globals, so a global.get is estimated as 2 bytes, and
  ;; a new global as its constant plus 4 bytes.
  ;; CHECK:      (type $0 (func (result f64)))

  ;; CHECK:      (type $1 (func (result i32)))

  ;; CHECK:      (type $2 (func (result i64)))

  ;; CHECK:      (type $3 (func (result f32)))

  ;; CHECK:      (global $existing f64 (f64.const 2.5))
  (global $existing f64 (f64.const 2.5))

  ;; A mutable global is not reused.
  ;; CHECK:      (global $mut (mut f64) (f64.const 3.5))
  (global $mut (mut f64) (f64.const 3.5))

  ;; Global initializers are never modified, even for hoisted values.
  ;; CHECK:      (global $init-zero f64 (f64.const 0))
  (global $init-zero f64 (f64.const 0))

  ;; CHECK:      (global $const_f64_1 f64 (f64.const 1))

  ;; CHECK:      (global $const_f64_3 f64 (f64.const 3))

  ;; CHECK:      (global $const_f64_3.5 f64 (f64.const 3.5))

  ;; CHECK:      (global $const_i32_2147483647 i32 (i32.const 2147483647))

  ;; CHECK:      (global $const_i64_9223372036854775807 i64 (i64.const 9223372036854775807))

  ;; CHECK:      (global $const_f32_1.5 f32 (f32.const 1.5))

  ;; CHECK:      (global $const_f64_nan:0x8000000000001 f64 (f64.const nan:0x8000000000001))

  ;; CHECK:      (func $f64-zero-5-uses (type $0) (result f64)
  ;; CHECK-NEXT:  (f64.add
  ;; CHECK-NEXT:   (f64.add
  ;; CHECK-NEXT:    (global.get $init-zero)
  ;; CHECK-NEXT:    (global.get $init-zero)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (f64.add
  ;; CHECK-NEXT:    (f64.add
  ;; CHECK-NEXT:     (global.get $init-zero)
  ;; CHECK-NEXT:     (global.get $init-zero)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (global.get $init-zero)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $f64-zero-5-uses (result f64)
    ;; f64 0 is used 5 times: 45 bytes before, 5 * 2 + 13 after. The existing
    ;; global $init-zero is reused, and its own initializer is left alone.
    (f64.add
      (f64.add
        (f64.const 0)
        (f64.const 0)
      )
      (f64.add
        (f64.add
          (f64.const 0)
          (f64.const 0)
        )
        (f64.const 0)
      )
    )
  )

  ;; CHECK:      (func $f64-one-2-uses (type $0) (result f64)
  ;; CHECK-NEXT:  (f64.add
  ;; CHECK-NEXT:   (global.get $const_f64_1)
  ;; CHECK-NEXT:   (global.get $const_f64_1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $f64-one-2-uses (result f64)
    ;; f64 1 is used only twice, which is just enough: 2 * (9 - 2) = 14 > 13.
    (f64.add
      (f64.const 1)
      (f64.const 1)
    )
  )

  ;; CHECK:      (func $f64-three-3-uses (type $0) (result f64)
  ;; CHECK-NEXT:  (f64.add
  ;; CHECK-NEXT:   (f64.add
  ;; CHECK-NEXT:    (global.get $const_f64_3)
  ;; CHECK-NEXT:    (global.get $const_f64_3)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (global.get $const_f64_3)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $f64-three-3-uses (result f64)
    ;; 3 uses of an f64 are enough (3 * 7 = 21 > 13).
    (f64.add
      (f64.add
        (f64.const 3)
        (f64.const 3)
      )
      (f64.const 3)
    )
  )

  ;; CHECK:      (func $reuse-existing (type $0) (result f64)
  ;; CHECK-NEXT:  (f64.add
  ;; CHECK-NEXT:   (global.get $existing)
  ;; CHECK-NEXT:   (global.get $existing)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $reuse-existing (result f64)
    ;; 2.5 is the init of $existing, so reusing it is free.
    (f64.add
      (f64.const 2.5)
      (f64.const 2.5)
    )
  )

  ;; CHECK:      (func $no-reuse-mutable (type $0) (result f64)
  ;; CHECK-NEXT:  (f64.add
  ;; CHECK-NEXT:   (global.get $const_f64_3.5)
  ;; CHECK-NEXT:   (global.get $const_f64_3.5)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $no-reuse-mutable (result f64)
    ;; 3.5 is only the init of a mutable global, which is not reused; a new
    ;; immutable global is added instead.
    (f64.add
      (f64.const 3.5)
      (f64.const 3.5)
    )
  )

  ;; CHECK:      (func $small-i32 (type $1) (result i32)
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (i32.add
  ;; CHECK-NEXT:    (i32.add
  ;; CHECK-NEXT:     (i32.const 7)
  ;; CHECK-NEXT:     (i32.const 7)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (i32.add
  ;; CHECK-NEXT:     (i32.const 7)
  ;; CHECK-NEXT:     (i32.const 7)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (i32.add
  ;; CHECK-NEXT:    (i32.add
  ;; CHECK-NEXT:     (i32.const 7)
  ;; CHECK-NEXT:     (i32.const 7)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (i32.add
  ;; CHECK-NEXT:     (i32.const 7)
  ;; CHECK-NEXT:     (i32.const 7)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $small-i32 (result i32)
    ;; Small i32 constants are never hoisted, no matter how many uses.
    (i32.add
      (i32.add
        (i32.add
          (i32.const 7)
          (i32.const 7)
        )
        (i32.add
          (i32.const 7)
          (i32.const 7)
        )
      )
      (i32.add
        (i32.add
          (i32.const 7)
          (i32.const 7)
        )
        (i32.add
          (i32.const 7)
          (i32.const 7)
        )
      )
    )
  )

  ;; CHECK:      (func $wide-i32 (type $1) (result i32)
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (i32.add
  ;; CHECK-NEXT:    (i32.add
  ;; CHECK-NEXT:     (global.get $const_i32_2147483647)
  ;; CHECK-NEXT:     (global.get $const_i32_2147483647)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (i32.add
  ;; CHECK-NEXT:     (global.get $const_i32_2147483647)
  ;; CHECK-NEXT:     (global.get $const_i32_2147483647)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (i32.add
  ;; CHECK-NEXT:    (global.get $const_i32_2147483647)
  ;; CHECK-NEXT:    (global.get $const_i32_2147483647)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $wide-i32 (result i32)
    ;; i32 0x7fffffff takes 6 bytes; 6 uses save 6 * 4 = 24 > 10.
    (i32.add
      (i32.add
        (i32.add
          (i32.const 0x7fffffff)
          (i32.const 0x7fffffff)
        )
        (i32.add
          (i32.const 0x7fffffff)
          (i32.const 0x7fffffff)
        )
      )
      (i32.add
        (i32.const 0x7fffffff)
        (i32.const 0x7fffffff)
      )
    )
  )

  ;; CHECK:      (func $wide-i32-2-uses (type $1) (result i32)
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (i32.const 2147483646)
  ;; CHECK-NEXT:   (i32.const 2147483646)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $wide-i32-2-uses (result i32)
    ;; 2 uses of a 6-byte i32 save 8 bytes, which is less than the global.
    (i32.add
      (i32.const 0x7ffffffe)
      (i32.const 0x7ffffffe)
    )
  )

  ;; CHECK:      (func $i64 (type $2) (result i64)
  ;; CHECK-NEXT:  (i64.add
  ;; CHECK-NEXT:   (i64.add
  ;; CHECK-NEXT:    (i64.add
  ;; CHECK-NEXT:     (i64.const -1)
  ;; CHECK-NEXT:     (i64.const -1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (i64.add
  ;; CHECK-NEXT:     (i64.const -1)
  ;; CHECK-NEXT:     (global.get $const_i64_9223372036854775807)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (i64.add
  ;; CHECK-NEXT:    (global.get $const_i64_9223372036854775807)
  ;; CHECK-NEXT:    (global.get $const_i64_9223372036854775807)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $i64 (result i64)
    ;; i64 -1 is only 2 bytes: not hoisted. i64 0x7fffffffffffffff is 11
    ;; bytes: hoisted with 3 uses.
    (i64.add
      (i64.add
        (i64.add
          (i64.const -1)
          (i64.const -1)
        )
        (i64.add
          (i64.const -1)
          (i64.const 0x7fffffffffffffff)
        )
      )
      (i64.add
        (i64.const 0x7fffffffffffffff)
        (i64.const 0x7fffffffffffffff)
      )
    )
  )

  ;; CHECK:      (func $f32 (type $3) (result f32)
  ;; CHECK-NEXT:  (f32.add
  ;; CHECK-NEXT:   (f32.add
  ;; CHECK-NEXT:    (global.get $const_f32_1.5)
  ;; CHECK-NEXT:    (global.get $const_f32_1.5)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (f32.add
  ;; CHECK-NEXT:    (global.get $const_f32_1.5)
  ;; CHECK-NEXT:    (global.get $const_f32_1.5)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $f32 (result f32)
    ;; f32 1.5 is 5 bytes: 4 uses save 12 > 9.
    (f32.add
      (f32.add
        (f32.const 1.5)
        (f32.const 1.5)
      )
      (f32.add
        (f32.const 1.5)
        (f32.const 1.5)
      )
    )
  )

  ;; CHECK:      (func $nan (type $0) (result f64)
  ;; CHECK-NEXT:  (f64.add
  ;; CHECK-NEXT:   (f64.add
  ;; CHECK-NEXT:    (global.get $const_f64_nan:0x8000000000001)
  ;; CHECK-NEXT:    (global.get $const_f64_nan:0x8000000000001)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (f64.add
  ;; CHECK-NEXT:    (global.get $const_f64_nan:0x8000000000001)
  ;; CHECK-NEXT:    (f64.const nan:0x8000000000002)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $nan (result f64)
    ;; NaN payloads are compared bitwise.
    (f64.add
      (f64.add
        (f64.const nan:0x8000000000001)
        (f64.const nan:0x8000000000001)
      )
      (f64.add
        (f64.const nan:0x8000000000001)
        (f64.const nan:0x8000000000002)
      )
    )
  )
)

;; Test composite global initializer walking, 3-byte constant hoisting, and
;; ref.func hoisting in top128 mode.
(module
  ;; CHECK:      (type $fn (func (result i32)))
  (type $fn (func (result i32)))
  ;; CHECK:      (type $S (struct (field f64) (field i32) (field (ref $fn))))
  (type $S (struct (field f64) (field i32) (field (ref $fn))))

  ;; CHECK:      (type $2 (func (param i32) (result (ref $fn))))

  ;; CHECK:      (global $const_i32_100 i32 (i32.const 100))

  ;; CHECK:      (global $const_f64_5.5 f64 (f64.const 5.5))

  ;; CHECK:      (global $ref_func_target (ref (exact $fn)) (ref.func $target))

  ;; CHECK:      (global $comp1 (ref $S) (struct.new $S
  ;; CHECK-NEXT:  (global.get $const_f64_5.5)
  ;; CHECK-NEXT:  (global.get $const_i32_100)
  ;; CHECK-NEXT:  (global.get $ref_func_target)
  ;; CHECK-NEXT: ))
  (global $comp1 (ref $S)
    (struct.new $S
      (f64.const 5.5)
      (i32.const 100)
      (ref.func $target)
    )
  )
  ;; CHECK:      (global $comp2 (ref $S) (struct.new $S
  ;; CHECK-NEXT:  (global.get $const_f64_5.5)
  ;; CHECK-NEXT:  (global.get $const_i32_100)
  ;; CHECK-NEXT:  (global.get $ref_func_target)
  ;; CHECK-NEXT: ))
  (global $comp2 (ref $S)
    (struct.new $S
      (f64.const 5.5)
      (i32.const 100)
      (ref.func $target)
    )
  )

  ;; CHECK:      (func $target (type $fn) (result i32)
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (i32.add
  ;; CHECK-NEXT:    (i32.add
  ;; CHECK-NEXT:     (global.get $const_i32_100)
  ;; CHECK-NEXT:     (global.get $const_i32_100)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (i32.add
  ;; CHECK-NEXT:     (global.get $const_i32_100)
  ;; CHECK-NEXT:     (global.get $const_i32_100)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (i32.add
  ;; CHECK-NEXT:    (global.get $const_i32_100)
  ;; CHECK-NEXT:    (global.get $const_i32_100)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $target (type $fn) (result i32)
    (i32.add
      (i32.add
        (i32.add
          (i32.const 100)
          (i32.const 100)
        )
        (i32.add
          (i32.const 100)
          (i32.const 100)
        )
      )
      (i32.add
        (i32.const 100)
        (i32.const 100)
      )
    )
  )

  ;; CHECK:      (func $use-refs (type $2) (param $c i32) (result (ref $fn))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $ref_func_target)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $ref_func_target)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $ref_func_target)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $ref_func_target)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (select (result (ref (exact $fn)))
  ;; CHECK-NEXT:   (global.get $ref_func_target)
  ;; CHECK-NEXT:   (global.get $ref_func_target)
  ;; CHECK-NEXT:   (local.get $c)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $use-refs (param $c i32) (result (ref $fn))
    (drop (ref.func $target))
    (drop (ref.func $target))
    (drop (ref.func $target))
    (drop (ref.func $target))
    (select (result (ref $fn))
      (ref.func $target)
      (ref.func $target)
      (local.get $c)
    )
  )
)

;; Test deduplication of existing Const and post-roundtrip inexact RefFunc
;; globals, plus reuse of existing top-128 globals for single remaining inline
;; occurrences.
(module
  ;; CHECK:      (type $fn (func (result i32)))
  (type $fn (func (result i32)))

  ;; CHECK:      (type $1 (func (param i32) (result (ref $fn))))

  ;; CHECK:      (global $c1 i32 (i32.const 100))
  (global $c1 i32 (i32.const 100))
  (global $c2 i32 (i32.const 100))
  ;; CHECK:      (global $rf1 (ref (exact $fn)) (ref.func $target))
  (global $rf1 (ref $fn) (ref.func $target))
  (global $rf2 (ref $fn) (ref.func $target))

  ;; CHECK:      (func $target (type $fn) (result i32)
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (i32.add
  ;; CHECK-NEXT:    (global.get $c1)
  ;; CHECK-NEXT:    (global.get $c1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (global.get $c1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $target (type $fn) (result i32)
    (i32.add
      (i32.add
        (global.get $c1)
        (global.get $c2)
      )
      (i32.const 100)
    )
  )

  ;; CHECK:      (func $use-refs (type $1) (param $c i32) (result (ref $fn))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $rf1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (select (result (ref (exact $fn)))
  ;; CHECK-NEXT:   (global.get $rf1)
  ;; CHECK-NEXT:   (global.get $rf1)
  ;; CHECK-NEXT:   (local.get $c)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $use-refs (param $c i32) (result (ref $fn))
    (drop (global.get $rf1))
    (select (result (ref $fn))
      (global.get $rf2)
      (ref.func $target)
      (local.get $c)
    )
  )
)
