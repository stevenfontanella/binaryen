;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: foreach %s %t wasm-opt --roll-constant-tables --pass-arg=roll-constant-tables-always@1 --pass-arg=roll-constant-tables-mode@fixed -all -S -o - | filecheck %s

;; Three range tables (a struct wrapping an array of same-shape elements whose
;; only varying leaves are three i32 constants) become one passive data
;; segment and a lazy factory. The second leaf is stored as the difference to
;; the first (i8), the third raw (i8); the first needs i32. $small is a
;; member too (only one element).
(module
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $Object (sub (struct (field (ref null $Object)))))
    (type $Object (sub (struct (field (ref null $Object)))))
    ;; CHECK:       (type $Ints (array (mut i32)))
    (type $Ints (array (mut i32)))
    ;; CHECK:       (type $Range (sub $Object (struct (field (ref null $Object)) (field (mut i32)) (field (ref null $Ints)))))
    (type $Range (sub $Object (struct (field (ref null $Object)) (field (mut i32)) (field (ref null $Ints)))))
    ;; CHECK:       (type $Elems (array (mut (ref null $Object))))
    (type $Elems (array (mut (ref null $Object))))
    ;; CHECK:       (type $Table (sub $Object (struct (field (ref null $Object)) (field (mut i32)) (field (ref null $Elems)))))
    (type $Table (sub $Object (struct (field (ref null $Object)) (field (mut i32)) (field (ref null $Elems)))))
    ;; CHECK:       (type $Other (struct (field (ref $Table))))
    (type $Other (struct (field (ref $Table))))
  )







  ;; CHECK:      (type $6 (array (mut i8)))

  ;; CHECK:      (type $7 (array (mut (ref null $Table))))

  ;; CHECK:      (type $8 (array (mut i16)))

  ;; CHECK:      (type $9 (array (mut i32)))

  ;; CHECK:      (type $10 (func (result (ref $Table) (ref $Table) (ref $Table) (ref $Table) (ref $Table))))

  ;; CHECK:      (type $11 (func (param i32) (result (ref $Table))))

  ;; CHECK:      (global $vt (ref null $Object) (ref.null none))
  (global $vt (ref null $Object) (ref.null none))

  (global $t0 (ref $Table) (struct.new $Table
    (global.get $vt)
    (i32.const 0)
    (array.new_fixed $Elems 4
      (struct.new $Range (global.get $vt) (i32.const 0) (array.new_fixed $Ints 3 (i32.const 48) (i32.const 57) (i32.const 1)))
      (struct.new $Range (global.get $vt) (i32.const 0) (array.new_fixed $Ints 3 (i32.const 65) (i32.const 90) (i32.const 2)))
      (struct.new $Range (global.get $vt) (i32.const 0) (array.new_fixed $Ints 3 (i32.const 97) (i32.const 122) (i32.const 3)))
      (struct.new $Range (global.get $vt) (i32.const 0) (array.new_fixed $Ints 3 (i32.const 170) (i32.const 181) (i32.const 11)))
    )
  ))

  (global $t1 (ref $Table) (struct.new $Table
    (global.get $vt)
    (i32.const 0)
    (array.new_fixed $Elems 3
      (struct.new $Range (global.get $vt) (i32.const 0) (array.new_fixed $Ints 3 (i32.const 65536) (i32.const 65600) (i32.const 5)))
      (struct.new $Range (global.get $vt) (i32.const 0) (array.new_fixed $Ints 3 (i32.const 70000) (i32.const 70010) (i32.const 6)))
      (struct.new $Range (global.get $vt) (i32.const 0) (array.new_fixed $Ints 3 (i32.const 1114100) (i32.const 1114111) (i32.const 7)))
    )
  ))

  (global $small (ref $Table) (struct.new $Table
    (global.get $vt)
    (i32.const 0)
    (array.new_fixed $Elems 1
      (struct.new $Range (global.get $vt) (i32.const 0) (array.new_fixed $Ints 3 (i32.const 7) (i32.const 8) (i32.const 9)))
    )
  ))

  ;; This table is referenced from another global's initializer, so it stays.
  ;; CHECK:      (global $pinned (ref $Table) (struct.new $Table
  ;; CHECK-NEXT:  (global.get $vt)
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT:  (array.new_fixed $Elems 2
  ;; CHECK-NEXT:   (struct.new $Range
  ;; CHECK-NEXT:    (global.get $vt)
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:    (array.new_fixed $Ints 3
  ;; CHECK-NEXT:     (i32.const 1)
