  ;; CHECK:      (global $tables$0$cache (ref $7) (array.new_default $7
  ;; CHECK-NEXT:  (i32.const 3)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (data $tables$0 "\00\00\03\00\07\00\08\00\00\00\01\00p\11\01\00\f4\ff\10\000\00\00\00A\00\00\00a\00\00\00\aa\00\00\00\07\00\00\00@\n\0b\t\19\19\0b\01\05\06\07\01\02\03\0b\t")

  ;; CHECK:      (func $use (type $10) (result (ref $Table) (ref $Table) (ref $Table) (ref $Table) (ref $Table))
  ;; CHECK-NEXT:  (tuple.make 5
  ;; CHECK-NEXT:   (call $tables$0
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (call $tables$0
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (call $tables$0
  ;; CHECK-NEXT:    (i32.const 2)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (global.get $pinned)
  ;; CHECK-NEXT:   (global.get $mixed)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $use (result (ref $Table) (ref $Table) (ref $Table) (ref $Table) (ref $Table))
    (tuple.make 5
      (global.get $t1)
      (global.get $t0)
      (global.get $small)
      (global.get $pinned)
      (global.get $mixed)
    )
  )
)

