  ;; CHECK-NEXT:     (i32.const 6)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: ))
  (global $pinned (ref $Table) (struct.new $Table
    (global.get $vt)
    (i32.const 0)
    (array.new_fixed $Elems 2
      (struct.new $Range (global.get $vt) (i32.const 0) (array.new_fixed $Ints 3 (i32.const 1) (i32.const 2) (i32.const 3)))
      (struct.new $Range (global.get $vt) (i32.const 0) (array.new_fixed $Ints 3 (i32.const 4) (i32.const 5) (i32.const 6)))
    )
  ))
  ;; CHECK:      (global $other (ref $Other) (struct.new $Other
  ;; CHECK-NEXT:  (global.get $pinned)
  ;; CHECK-NEXT: ))
  (global $other (ref $Other) (struct.new $Other (global.get $pinned)))

  ;; Elements of different shapes: not a table.
  ;; CHECK:      (global $mixed (ref $Table) (struct.new $Table
  ;; CHECK-NEXT:  (global.get $vt)
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT:  (array.new_fixed $Elems 2
  ;; CHECK-NEXT:   (struct.new $Range
  ;; CHECK-NEXT:    (global.get $vt)
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:    (array.new_fixed $Ints 3
  ;; CHECK-NEXT:     (i32.const 1)
  ;; CHECK-NEXT:     (i32.const 2)
  ;; CHECK-NEXT:     (i32.const 3)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (struct.new $Range
  ;; CHECK-NEXT:    (global.get $vt)
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:    (array.new_fixed $Ints 2
  ;; CHECK-NEXT:     (i32.const 4)
  ;; CHECK-NEXT:     (i32.const 5)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: ))
  (global $mixed (ref $Table) (struct.new $Table
    (global.get $vt)
    (i32.const 0)
    (array.new_fixed $Elems 2
      (struct.new $Range (global.get $vt) (i32.const 0) (array.new_fixed $Ints 3 (i32.const 1) (i32.const 2) (i32.const 3)))
      (struct.new $Range (global.get $vt) (i32.const 0) (array.new_fixed $Ints 2 (i32.const 4) (i32.const 5)))
    )
