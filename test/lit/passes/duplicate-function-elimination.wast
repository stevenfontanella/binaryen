;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: foreach %s %t wasm-opt --duplicate-function-elimination --optimize-level=3 --all-features --closed-world --traps-never-happen -S -o - | filecheck %s

;; 1. Eliminate same-signature 0-local identity forwarding thunks (including
;;    return-wrapped calls and transitive chains) even when referenced by
;;    ref.func or exported.
(module
  ;; CHECK:      (type $sig (func (param i32) (result i32)))
  (type $sig (func (param i32) (result i32)))

  ;; CHECK:      (global $g1 (ref $sig) (ref.func $target))
  (global $g1 (ref $sig) (ref.func $thunk1))
  ;; CHECK:      (global $g2 (ref $sig) (ref.func $target))
  (global $g2 (ref $sig) (ref.func $thunk2))
  (export "exp" (func $thunk1))

  ;; CHECK:      (export "exp" (func $target))

  ;; CHECK:      (func $target (type $sig) (param $x i32) (result i32)
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $target (type $sig) (param $x i32) (result i32)
    (i32.add (local.get $x) (i32.const 1))
  )

  (func $thunk1 (type $sig) (param $x i32) (result i32)
    (call $target (local.get $x))
  )

  (func $thunk2 (type $sig) (param $x i32) (result i32)
    (return
      (call $thunk1 (local.get $x))
    )
  )
)

;; 2. Unify non-subtyped private signature types with identical non-subtyped
;;    public signature types, and fold resulting same-signature identity thunks.
(module
  ;; CHECK:      (type $pub_sig (func (param f64) (result f64)))
  (type $pub_sig (func (param f64) (result f64)))
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $holder (struct (field (ref null $pub_sig))))

    ;; CHECK:       (type $priv_sig (func (param f64) (result f64)))
    (type $priv_sig (func (param f64) (result f64)))
    (type $holder (struct (field (ref null $priv_sig))))
  )

  ;; CHECK:      (type $3 (func (result f64)))

  ;; CHECK:      (import "env" "ext" (func $imp (type $pub_sig) (param f64) (result f64)))
  (import "env" "ext" (func $imp (type $pub_sig) (param f64) (result f64)))
  ;; CHECK:      (global $g (ref $pub_sig) (ref.func $real))
  (global $g (ref $priv_sig) (ref.func $bridge))
  ;; CHECK:      (global $h (ref null $holder) (ref.null none))
  (global $h (ref null $holder) (ref.null none))
  ;; CHECK:      (export "keep_holder" (func $use_holder))
  (export "keep_holder" (func $use_holder))

  ;; CHECK:      (func $real (type $pub_sig) (param $x f64) (result f64)
  ;; CHECK-NEXT:  (f64.add
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (call $imp
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $real (type $pub_sig) (param $x f64) (result f64)
    (f64.add (local.get $x) (call $imp (local.get $x)))
  )

  (func $bridge (type $priv_sig) (param $x f64) (result f64)
    (call $real (local.get $x))
  )

  ;; CHECK:      (func $use_holder (type $3) (result f64)
  ;; CHECK-NEXT:  (call_ref $pub_sig
  ;; CHECK-NEXT:   (f64.const 2)
  ;; CHECK-NEXT:   (struct.get $holder 0
  ;; CHECK-NEXT:    (global.get $h)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $use_holder (result f64)
    (call_ref $priv_sig
      (f64.const 2.0)
      (struct.get $holder 0 (global.get $h))
    )
  )
)

;; 3. Bypass direct calls to non-escaped subtype-compatible identity thunks, and
;;    narrow non-escaped target signatures for escaped identity thunks when all
;;    direct callers satisfy the thunk's signature.
(module
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $base (sub (struct (field i32))))
    (type $base (sub (struct (field i32))))
    ;; CHECK:       (type $sub (sub final $base (struct (field i32) (field i32))))
    (type $sub (sub final $base (struct (field i32) (field i32))))
    ;; CHECK:       (type $wide_res_sig (func (param (ref null $base)) (result (ref null $base))))
    (type $wide_res_sig (func (param (ref null $base)) (result (ref null $base))))
    ;; CHECK:       (type $narrow_res_sig (func (param (ref null $base)) (result (ref $sub))))
    (type $narrow_res_sig (func (param (ref null $base)) (result (ref $sub))))
    ;; CHECK:       (type $narrow_param_sig (func (param (ref null $sub)) (result i32)))
    (type $narrow_param_sig (func (param (ref null $sub)) (result i32)))
    ;; CHECK:       (type $wide_param_sig (func (param (ref null $base)) (result i32)))
    (type $wide_param_sig (func (param (ref null $base)) (result i32)))
  )

  ;; CHECK:      (type $6 (func (param (ref null $sub)) (result i32)))

  ;; CHECK:      (global $vtable (ref $narrow_param_sig) (ref.func $non_escaped_target))
  (global $vtable (ref $narrow_param_sig) (ref.func $escaped_thunk))
  ;; CHECK:      (export "caller" (func $caller))
  (export "caller" (func $caller))

  ;; CHECK:      (func $make_sub (type $narrow_res_sig) (param $p (ref null $base)) (result (ref $sub))
  ;; CHECK-NEXT:  (struct.new $sub
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $make_sub (type $narrow_res_sig) (param $p (ref null $base)) (result (ref $sub))
    (struct.new $sub (i32.const 1) (i32.const 2))
  )

  (func $direct_thunk (type $wide_res_sig) (param $p (ref null $base)) (result (ref null $base))
    (call $make_sub (local.get $p))
  )

  ;; CHECK:      (func $non_escaped_target (type $narrow_param_sig) (param $p (ref null $sub)) (result i32)
  ;; CHECK-NEXT:  (struct.get $sub 0
  ;; CHECK-NEXT:   (local.get $p)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $non_escaped_target (type $wide_param_sig) (param $p (ref null $base)) (result i32)
    (struct.get $base 0 (local.get $p))
  )

  (func $escaped_thunk (type $narrow_param_sig) (param $p (ref null $sub)) (result i32)
    (call $non_escaped_target (local.get $p))
  )

  ;; CHECK:      (func $caller (type $6) (param $s (ref null $sub)) (result i32)
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (struct.get $sub 0
  ;; CHECK-NEXT:    (call $make_sub
  ;; CHECK-NEXT:     (local.get $s)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (call $non_escaped_target
  ;; CHECK-NEXT:    (local.get $s)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $caller (param $s (ref null $sub)) (result i32)
    (i32.add
      (struct.get $base 0 (call $direct_thunk (local.get $s)))
      (call $non_escaped_target (local.get $s))
    )
  )
)
