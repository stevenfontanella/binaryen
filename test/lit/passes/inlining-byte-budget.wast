;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; Test --pass-arg=inlining-byte-budget@1:
;; 1. Direct substitution for single-use in-order and permuted parameters.
;; 2. Direct duplication and scratch-local tee reuse for multi-use parameters.
;; 3. Local variable remapping into reusable caller scratch locals.
;; 4. Rejection of multi-caller helpers when total site growth >= saved function bytes.

;; RUN: foreach %s %t wasm-opt -all --pass-arg=inlining-byte-budget@1 --inlining --shrink-level=2 -S -o - | filecheck %s

(module
 ;; CHECK:      (type $0 (func (param i32 i32 i32)))

 ;; CHECK:      (type $1 (func (result i32)))

 ;; CHECK:      (type $2 (func (param i32) (result i32)))

 ;; CHECK:      (type $3 (func (param i32 i32) (result i32)))

 ;; CHECK:      (import "env" "sink" (func $sink (type $0) (param i32 i32 i32)))
 (import "env" "sink" (func $sink (param i32 i32 i32)))
 ;; CHECK:      (import "env" "prod" (func $prod (type $1) (result i32)))
 (import "env" "prod" (func $prod (result i32)))

 ;; Single-use permuted parameters: inlined directly without block/local.set prologue.
 (func $permuted (param $a i32) (param $b i32) (result i32)
  (i32.sub
   (local.get $b)
   (local.get $a)
  )
 )

 ;; Multi-use parameter: DirectDup when caller passes local.get, ScratchTee when caller passes call.
 (func $multi-use (param $x i32) (result i32)
  (i32.add
   (local.get $x)
   (local.get $x)
  )
 )

 ;; Callee with local variable: remapped to caller scratch local without zero-init prologue.
 (func $with-local (param $p i32) (param $q i32) (result i32)
  (local $v i32)
  (local.set $v
   (i32.add
    (local.get $p)
    (local.get $q)
   )
  )
  (i32.mul
   (local.get $v)
   (local.get $v)
  )
 )

 ;; Multi-caller helper whose total call-site growth exceeds savedFuncBytes: not inlined.
 ;; CHECK:      (export "caller" (func $caller))

 ;; CHECK:      (func $unprofitable (type $2) (param $x i32) (result i32)
 ;; CHECK-NEXT:  (i32.add
 ;; CHECK-NEXT:   (i32.mul
 ;; CHECK-NEXT:    (local.get $x)
 ;; CHECK-NEXT:    (i32.const 12345)
 ;; CHECK-NEXT:   )
 ;; CHECK-NEXT:   (i32.xor
 ;; CHECK-NEXT:    (local.get $x)
 ;; CHECK-NEXT:    (i32.const 67890)
 ;; CHECK-NEXT:   )
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $unprofitable (param $x i32) (result i32)
  (i32.add
   (i32.mul
    (local.get $x)
    (i32.const 12345)
   )
   (i32.xor
    (local.get $x)
    (i32.const 67890)
   )
  )
 )

 ;; CHECK:      (func $caller (type $3) (param $p0 i32) (param $p1 i32) (result i32)
 ;; CHECK-NEXT:  (local $2 i32)
 ;; CHECK-NEXT:  (i32.add
 ;; CHECK-NEXT:   (i32.add
 ;; CHECK-NEXT:    (i32.sub
 ;; CHECK-NEXT:     (local.get $p1)
 ;; CHECK-NEXT:     (local.get $p0)
 ;; CHECK-NEXT:    )
 ;; CHECK-NEXT:    (i32.sub
 ;; CHECK-NEXT:     (i32.const 2)
 ;; CHECK-NEXT:     (i32.const 1)
 ;; CHECK-NEXT:    )
 ;; CHECK-NEXT:   )
 ;; CHECK-NEXT:   (i32.add
 ;; CHECK-NEXT:    (i32.add
 ;; CHECK-NEXT:     (i32.add
 ;; CHECK-NEXT:      (local.get $p0)
 ;; CHECK-NEXT:      (local.get $p0)
 ;; CHECK-NEXT:     )
 ;; CHECK-NEXT:     (i32.add
 ;; CHECK-NEXT:      (local.tee $2
 ;; CHECK-NEXT:       (call $prod)
 ;; CHECK-NEXT:      )
 ;; CHECK-NEXT:      (local.get $2)
 ;; CHECK-NEXT:     )
 ;; CHECK-NEXT:    )
 ;; CHECK-NEXT:    (i32.add
 ;; CHECK-NEXT:     (i32.add
 ;; CHECK-NEXT:      (block (result i32)
 ;; CHECK-NEXT:       (local.set $2
 ;; CHECK-NEXT:        (i32.add
 ;; CHECK-NEXT:         (local.get $p0)
 ;; CHECK-NEXT:         (local.get $p1)
 ;; CHECK-NEXT:        )
 ;; CHECK-NEXT:       )
 ;; CHECK-NEXT:       (i32.mul
 ;; CHECK-NEXT:        (local.get $2)
 ;; CHECK-NEXT:        (local.get $2)
 ;; CHECK-NEXT:       )
 ;; CHECK-NEXT:      )
 ;; CHECK-NEXT:      (block (result i32)
 ;; CHECK-NEXT:       (local.set $2
 ;; CHECK-NEXT:        (i32.add
 ;; CHECK-NEXT:         (local.get $p1)
 ;; CHECK-NEXT:         (local.get $p0)
 ;; CHECK-NEXT:        )
 ;; CHECK-NEXT:       )
 ;; CHECK-NEXT:       (i32.mul
 ;; CHECK-NEXT:        (local.get $2)
 ;; CHECK-NEXT:        (local.get $2)
 ;; CHECK-NEXT:       )
 ;; CHECK-NEXT:      )
 ;; CHECK-NEXT:     )
 ;; CHECK-NEXT:     (i32.add
 ;; CHECK-NEXT:      (call $unprofitable
 ;; CHECK-NEXT:       (local.get $p0)
 ;; CHECK-NEXT:      )
 ;; CHECK-NEXT:      (call $unprofitable
 ;; CHECK-NEXT:       (local.get $p1)
 ;; CHECK-NEXT:      )
 ;; CHECK-NEXT:     )
 ;; CHECK-NEXT:    )
 ;; CHECK-NEXT:   )
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $caller (export "caller") (param $p0 i32) (param $p1 i32) (result i32)
  (i32.add
   (i32.add
    (call $permuted
     (local.get $p0)
     (local.get $p1)
    )
    (call $permuted
     (i32.const 1)
     (i32.const 2)
    )
   )
   (i32.add
    (i32.add
     (call $multi-use
      (local.get $p0)
     )
     (call $multi-use
      (call $prod)
     )
    )
    (i32.add
     (i32.add
      (call $with-local
       (local.get $p0)
       (local.get $p1)
      )
      (call $with-local
       (local.get $p1)
       (local.get $p0)
      )
     )
     (i32.add
      (call $unprofitable
       (local.get $p0)
      )
      (call $unprofitable
       (local.get $p1)
      )
     )
    )
   )
  )
 )
)
