;; With string-consts-to-data-compress@0 the unit stream is emitted as literal
;; runs only (the decoder is the same).

;; RUN: wasm-opt %s -all --string-lowering --string-consts-to-data --pass-arg=string-consts-to-data-always@1 --pass-arg=string-consts-to-data-compress@0 -S -o - | filecheck %s

