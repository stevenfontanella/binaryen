;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.
;; RUN: foreach %s %t wasm-opt --outline-allocations -all -S -o - | filecheck %s

;; Three identical allocations of constants: outline them into one helper.
(module
  ;; CHECK:      (type $0 (func (result anyref)))

  ;; CHECK:      (type $A (struct (field i32) (field i32) (field anyref) (field funcref)))
  (type $A (struct (field i32) (field i32) (field anyref) (field funcref)))

  ;; CHECK:      (type $2 (func))

  ;; CHECK:      (type $3 (func (result (ref (exact $A)))))

  ;; CHECK:      (global $imm i32 (i32.const 7))
  (global $imm i32 (i32.const 7))

  ;; CHECK:      (elem declare func $f)

  ;; CHECK:      (export "f" (func $f))

  ;; CHECK:      (func $f (type $2)
  ;; CHECK-NEXT: )
  (func $f
    (export "f")
  )

  ;; CHECK:      (func $a (type $0) (result anyref)
  ;; CHECK-NEXT:  (call $alloc$A)
  ;; CHECK-NEXT: )
  (func $a (result anyref)
    (struct.new $A
      (i32.const 1)
      (global.get $imm)
      (ref.null none)
      (ref.func $f)
    )
  )

  ;; CHECK:      (func $b (type $0) (result anyref)
  ;; CHECK-NEXT:  (call $alloc$A)
  ;; CHECK-NEXT: )
  (func $b (result anyref)
    (struct.new $A
      (i32.const 1)
      (global.get $imm)
      (ref.null none)
      (ref.func $f)
    )
  )

  ;; CHECK:      (func $c (type $0) (result anyref)
  ;; CHECK-NEXT:  (call $alloc$A)
  ;; CHECK-NEXT: )
  (func $c (result anyref)
    (struct.new $A
      (i32.const 1)
      (global.get $imm)
      (ref.null none)
      (ref.func $f)
    )
  )

  ;; A different constant: not the same shape, and it appears only once.
  ;; CHECK:      (func $d (type $0) (result anyref)
  ;; CHECK-NEXT:  (struct.new $A
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:   (global.get $imm)
  ;; CHECK-NEXT:   (ref.null none)
  ;; CHECK-NEXT:   (ref.func $f)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $d (result anyref)
    (struct.new $A
      (i32.const 2)
      (global.get $imm)
      (ref.null none)
      (ref.func $f)
    )
  )
)

;; Non-constant operands become parameters of the helper, in order. The
;; parameter types are the declared field types, so sites with refined operand
;; types can share the helper. A get of a mutable global is not constant.
;; CHECK:      (func $alloc$A (type $3) (result (ref (exact $A)))
;; CHECK-NEXT:  (struct.new $A
;; CHECK-NEXT:   (i32.const 1)
;; CHECK-NEXT:   (global.get $imm)
;; CHECK-NEXT:   (ref.null none)
;; CHECK-NEXT:   (ref.func $f)
;; CHECK-NEXT:  )
;; CHECK-NEXT: )
(module
  ;; CHECK:      (type $A (struct (field i32) (field (mut i32)) (field anyref) (field i64)))
  (type $A (struct (field i32) (field (mut i32)) (field anyref) (field i64)))

  ;; CHECK:      (type $1 (func (param i32) (result anyref)))

  ;; CHECK:      (type $2 (func (param anyref) (result anyref)))

  ;; CHECK:      (type $3 (func (param (ref $A)) (result anyref)))

  ;; CHECK:      (type $4 (func (result anyref)))

  ;; CHECK:      (type $5 (func (param i32) (result (ref (exact $A)))))

  ;; CHECK:      (global $mut (mut i32) (i32.const 7))
  (global $mut (mut i32) (i32.const 7))

  ;; CHECK:      (func $a (type $1) (param $x i32) (result anyref)
  ;; CHECK-NEXT:  (call $alloc$A
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $a (param $x i32) (result anyref)
    (struct.new $A
      (local.get $x)
      (i32.const 1)
      (ref.null none)
      (i64.const 42)
    )
  )

  ;; CHECK:      (func $b (type $1) (param $x i32) (result anyref)
  ;; CHECK-NEXT:  (call $alloc$A
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $b (param $x i32) (result anyref)
    (struct.new $A
      (local.get $x)
      (i32.const 1)
      (ref.null none)
      (i64.const 42)
    )
  )

  ;; CHECK:      (func $c (type $1) (param $y i32) (result anyref)
  ;; CHECK-NEXT:  (call $alloc$A
  ;; CHECK-NEXT:   (i32.add
  ;; CHECK-NEXT:    (local.get $y)
  ;; CHECK-NEXT:    (i32.const 2)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $c (param $y i32) (result anyref)
    (struct.new $A
      (i32.add
        (local.get $y)
        (i32.const 2)
      )
      (i32.const 1)
      (ref.null none)
      (i64.const 42)
    )
  )

  ;; Two holes, one of which is a mutable global get. There are only two such
  ;; sites, which is not enough to be worth outlining given the two holes.
  ;; CHECK:      (func $d (type $2) (param $r anyref) (result anyref)
  ;; CHECK-NEXT:  (struct.new $A
  ;; CHECK-NEXT:   (global.get $mut)
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (local.get $r)
  ;; CHECK-NEXT:   (i64.const 42)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $d (param $r anyref) (result anyref)
    (struct.new $A
      (global.get $mut)
      (i32.const 1)
      (local.get $r)
      (i64.const 42)
    )
  )

  ;; CHECK:      (func $e (type $3) (param $r (ref $A)) (result anyref)
  ;; CHECK-NEXT:  (struct.new $A
  ;; CHECK-NEXT:   (global.get $mut)
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (local.get $r)
  ;; CHECK-NEXT:   (i64.const 42)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $e (param $r (ref $A)) (result anyref)
    (struct.new $A
      (global.get $mut)
      (i32.const 1)
      (local.get $r)
      (i64.const 42)
    )
  )

  ;; The mutable global get is a hole, so this has the same shape as $a.
  ;; CHECK:      (func $f (type $4) (result anyref)
  ;; CHECK-NEXT:  (call $alloc$A
  ;; CHECK-NEXT:   (global.get $mut)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $f (result anyref)
    (struct.new $A
      (global.get $mut)
      (i32.const 1)
      (ref.null none)
      (i64.const 42)
    )
  )
)

;; Nested allocations are part of the parent's key, and the parent wins over
;; the children when both are duplicated. The children that only appear inside
;; outlined parents vanish, while the one in $other remains.
;; CHECK:      (func $alloc$A (type $5) (param $0 i32) (result (ref (exact $A)))
;; CHECK-NEXT:  (struct.new $A
;; CHECK-NEXT:   (local.get $0)
;; CHECK-NEXT:   (i32.const 1)
;; CHECK-NEXT:   (ref.null none)
;; CHECK-NEXT:   (i64.const 42)
;; CHECK-NEXT:  )
;; CHECK-NEXT: )
(module
  ;; CHECK:      (type $Inner (struct (field i32) (field i32) (field i32)))
  (type $Inner (struct (field i32) (field i32) (field i32)))

  ;; CHECK:      (type $1 (func (result anyref)))

  ;; CHECK:      (type $Outer (struct (field (ref $Inner)) (field i32) (field (ref null $Inner))))
  (type $Outer (struct (field (ref $Inner)) (field i32) (field (ref null $Inner))))

  ;; CHECK:      (type $3 (func (result (ref (exact $Outer)))))

  ;; CHECK:      (func $a (type $1) (result anyref)
  ;; CHECK-NEXT:  (call $alloc$Outer)
  ;; CHECK-NEXT: )
  (func $a (result anyref)
    (struct.new $Outer
      (struct.new $Inner
        (i32.const 1)
        (i32.const 2)
        (i32.const 3)
      )
      (i32.const 4)
      (struct.new_default $Inner)
    )
  )

  ;; CHECK:      (func $b (type $1) (result anyref)
  ;; CHECK-NEXT:  (call $alloc$Outer)
  ;; CHECK-NEXT: )
  (func $b (result anyref)
    (struct.new $Outer
      (struct.new $Inner
        (i32.const 1)
        (i32.const 2)
        (i32.const 3)
      )
      (i32.const 4)
      (struct.new_default $Inner)
    )
  )

  ;; CHECK:      (func $c (type $1) (result anyref)
  ;; CHECK-NEXT:  (call $alloc$Outer)
  ;; CHECK-NEXT: )
  (func $c (result anyref)
    (struct.new $Outer
      (struct.new $Inner
        (i32.const 1)
        (i32.const 2)
        (i32.const 3)
      )
      (i32.const 4)
      (struct.new_default $Inner)
    )
  )

  ;; CHECK:      (func $other (type $1) (result anyref)
  ;; CHECK-NEXT:  (struct.new $Inner
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:   (i32.const 3)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $other (result anyref)
    (struct.new $Inner
      (i32.const 1)
      (i32.const 2)
      (i32.const 3)
    )
  )
)

;; A nested allocation with a hole is itself a hole of the parent, and can be
;; outlined separately.
;; CHECK:      (func $alloc$Outer (type $3) (result (ref (exact $Outer)))
;; CHECK-NEXT:  (struct.new $Outer
;; CHECK-NEXT:   (struct.new $Inner
;; CHECK-NEXT:    (i32.const 1)
;; CHECK-NEXT:    (i32.const 2)
;; CHECK-NEXT:    (i32.const 3)
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (i32.const 4)
;; CHECK-NEXT:   (struct.new_default $Inner)
;; CHECK-NEXT:  )
;; CHECK-NEXT: )
(module
  ;; CHECK:      (type $Inner (struct (field f64) (field i32) (field i32)))
  (type $Inner (struct (field f64) (field i32) (field i32)))

  ;; CHECK:      (type $1 (func (param i32) (result anyref)))

  ;; CHECK:      (type $Outer (struct (field (ref $Inner)) (field i32) (field f64)))
  (type $Outer (struct (field (ref $Inner)) (field i32) (field f64)))

  ;; CHECK:      (type $3 (func (param i32) (result (ref (exact $Inner)))))

  ;; CHECK:      (type $4 (func (param (ref $Inner)) (result (ref (exact $Outer)))))

  ;; CHECK:      (func $a (type $1) (param $x i32) (result anyref)
  ;; CHECK-NEXT:  (call $alloc$Outer
  ;; CHECK-NEXT:   (call $alloc$Inner
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $a (param $x i32) (result anyref)
    (struct.new $Outer
      (struct.new $Inner
        (f64.const 1)
        (local.get $x)
        (i32.const 3)
      )
      (i32.const 4)
      (f64.const 5)
    )
  )

  ;; CHECK:      (func $b (type $1) (param $x i32) (result anyref)
  ;; CHECK-NEXT:  (call $alloc$Outer
  ;; CHECK-NEXT:   (call $alloc$Inner
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $b (param $x i32) (result anyref)
    (struct.new $Outer
      (struct.new $Inner
        (f64.const 1)
        (local.get $x)
        (i32.const 3)
      )
      (i32.const 4)
      (f64.const 5)
    )
  )

  ;; CHECK:      (func $c (type $1) (param $x i32) (result anyref)
  ;; CHECK-NEXT:  (call $alloc$Outer
  ;; CHECK-NEXT:   (call $alloc$Inner
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $c (param $x i32) (result anyref)
    (struct.new $Outer
      (struct.new $Inner
        (f64.const 1)
        (local.get $x)
        (i32.const 3)
      )
      (i32.const 4)
      (f64.const 5)
    )
  )
)

;; array.new_fixed is handled too.

;; CHECK:      (func $alloc$Inner (type $3) (param $0 i32) (result (ref (exact $Inner)))
;; CHECK-NEXT:  (struct.new $Inner
;; CHECK-NEXT:   (f64.const 1)
;; CHECK-NEXT:   (local.get $0)
;; CHECK-NEXT:   (i32.const 3)
;; CHECK-NEXT:  )
;; CHECK-NEXT: )

;; CHECK:      (func $alloc$Outer (type $4) (param $0 (ref $Inner)) (result (ref (exact $Outer)))
;; CHECK-NEXT:  (struct.new $Outer
;; CHECK-NEXT:   (local.get $0)
;; CHECK-NEXT:   (i32.const 4)
;; CHECK-NEXT:   (f64.const 5)
;; CHECK-NEXT:  )
;; CHECK-NEXT: )
(module
  ;; CHECK:      (type $0 (func (result anyref)))

  ;; CHECK:      (type $Arr (array (mut i32)))
  (type $Arr (array (mut i32)))

  ;; CHECK:      (type $2 (func (result (ref (exact $Arr)))))

  ;; CHECK:      (func $a (type $0) (result anyref)
  ;; CHECK-NEXT:  (call $alloc$Arr)
  ;; CHECK-NEXT: )
  (func $a (result anyref)
    (array.new_fixed $Arr 4
      (i32.const 1)
      (i32.const 2)
      (i32.const 3)
      (i32.const 4)
    )
  )

  ;; CHECK:      (func $b (type $0) (result anyref)
  ;; CHECK-NEXT:  (call $alloc$Arr)
  ;; CHECK-NEXT: )
  (func $b (result anyref)
    (array.new_fixed $Arr 4
      (i32.const 1)
      (i32.const 2)
      (i32.const 3)
      (i32.const 4)
    )
  )

  ;; CHECK:      (func $c (type $0) (result anyref)
  ;; CHECK-NEXT:  (call $alloc$Arr)
  ;; CHECK-NEXT: )
  (func $c (result anyref)
    (array.new_fixed $Arr 4
      (i32.const 1)
      (i32.const 2)
      (i32.const 3)
      (i32.const 4)
    )
  )

  ;; A different length is a different shape.
  ;; CHECK:      (func $d (type $0) (result anyref)
  ;; CHECK-NEXT:  (array.new_fixed $Arr 3
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:   (i32.const 3)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $d (result anyref)
    (array.new_fixed $Arr 3
      (i32.const 1)
      (i32.const 2)
      (i32.const 3)
    )
  )
)

;; Too small to be worth it: two copies of a tiny allocation. Nothing changes.
;; CHECK:      (func $alloc$Arr (type $2) (result (ref (exact $Arr)))
;; CHECK-NEXT:  (array.new_fixed $Arr 4
;; CHECK-NEXT:   (i32.const 1)
;; CHECK-NEXT:   (i32.const 2)
;; CHECK-NEXT:   (i32.const 3)
;; CHECK-NEXT:   (i32.const 4)
;; CHECK-NEXT:  )
;; CHECK-NEXT: )
(module
  ;; CHECK:      (type $0 (func (result anyref)))

  ;; CHECK:      (type $A (struct (field i32)))
  (type $A (struct (field i32)))

  ;; CHECK:      (func $a (type $0) (result anyref)
  ;; CHECK-NEXT:  (struct.new $A
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $a (result anyref)
    (struct.new $A
      (i32.const 1)
    )
  )

  ;; CHECK:      (func $b (type $0) (result anyref)
  ;; CHECK-NEXT:  (struct.new $A
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $b (result anyref)
    (struct.new $A
      (i32.const 1)
    )
  )
)

;; Constant expressions assigned to globals may be hoisted to global
;; initializers by other passes, so we leave them alone, including allocations
;; nested in them. Note that $c is not assigned to a global and is still
;; outlined, as the key is shared with $a's inner allocation, and $d is assigned
;; to a global but is not a constant expression (it reads a mutable global).
(module
  ;; CHECK:      (type $Inner (struct (field i32) (field i32) (field i32)))
  (type $Inner (struct (field i32) (field i32) (field i32)))

  ;; CHECK:      (type $1 (func))

  ;; CHECK:      (type $Outer (struct (field (ref $Inner)) (field i32) (field i64)))
  (type $Outer (struct (field (ref $Inner)) (field i32) (field i64)))

  ;; CHECK:      (type $3 (func (result anyref)))

  ;; CHECK:      (type $4 (func (result (ref (exact $Inner)))))

  ;; CHECK:      (type $5 (func (param i32) (result (ref (exact $Inner)))))

  ;; CHECK:      (global $g (mut (ref null $Outer)) (ref.null none))
  (global $g (mut (ref null $Outer)) (ref.null none))
  ;; CHECK:      (global $h (mut (ref null $Inner)) (ref.null none))
  (global $h (mut (ref null $Inner)) (ref.null none))
  ;; CHECK:      (global $mut (mut i32) (i32.const 0))
  (global $mut (mut i32) (i32.const 0))

  ;; CHECK:      (func $a (type $1)
  ;; CHECK-NEXT:  (global.set $g
  ;; CHECK-NEXT:   (struct.new $Outer
  ;; CHECK-NEXT:    (struct.new $Inner
  ;; CHECK-NEXT:     (i32.const 1)
  ;; CHECK-NEXT:     (i32.const 2)
  ;; CHECK-NEXT:     (i32.const 3)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (i32.const 4)
  ;; CHECK-NEXT:    (i64.const 5)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $a
    (global.set $g
      (struct.new $Outer
        (struct.new $Inner
          (i32.const 1)
          (i32.const 2)
          (i32.const 3)
        )
        (i32.const 4)
        (i64.const 5)
      )
    )
  )

  ;; CHECK:      (func $b (type $1)
  ;; CHECK-NEXT:  (global.set $g
  ;; CHECK-NEXT:   (struct.new $Outer
  ;; CHECK-NEXT:    (struct.new $Inner
  ;; CHECK-NEXT:     (i32.const 1)
  ;; CHECK-NEXT:     (i32.const 2)
  ;; CHECK-NEXT:     (i32.const 3)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (i32.const 4)
  ;; CHECK-NEXT:    (i64.const 5)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $b
    (global.set $g
      (struct.new $Outer
        (struct.new $Inner
          (i32.const 1)
          (i32.const 2)
          (i32.const 3)
        )
        (i32.const 4)
        (i64.const 5)
      )
    )
  )

  ;; CHECK:      (func $c (type $3) (result anyref)
  ;; CHECK-NEXT:  (call $alloc$Inner)
  ;; CHECK-NEXT: )
  (func $c (result anyref)
    (struct.new $Inner
      (i32.const 1)
      (i32.const 2)
      (i32.const 3)
    )
  )

  ;; CHECK:      (func $c2 (type $3) (result anyref)
  ;; CHECK-NEXT:  (call $alloc$Inner)
  ;; CHECK-NEXT: )
  (func $c2 (result anyref)
    (struct.new $Inner
      (i32.const 1)
      (i32.const 2)
      (i32.const 3)
    )
  )

  ;; CHECK:      (func $c3 (type $3) (result anyref)
  ;; CHECK-NEXT:  (call $alloc$Inner)
  ;; CHECK-NEXT: )
  (func $c3 (result anyref)
    (struct.new $Inner
      (i32.const 1)
      (i32.const 2)
      (i32.const 3)
    )
  )

  ;; CHECK:      (func $d (type $1)
  ;; CHECK-NEXT:  (global.set $h
  ;; CHECK-NEXT:   (call $alloc$Inner_9
  ;; CHECK-NEXT:    (global.get $mut)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $d
    (global.set $h
      (struct.new $Inner
        (global.get $mut)
        (i32.const 2)
        (i32.const 1000000)
      )
    )
  )

  ;; CHECK:      (func $d2 (type $1)
  ;; CHECK-NEXT:  (global.set $h
  ;; CHECK-NEXT:   (call $alloc$Inner_9
  ;; CHECK-NEXT:    (global.get $mut)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $d2
    (global.set $h
      (struct.new $Inner
        (global.get $mut)
        (i32.const 2)
        (i32.const 1000000)
      )
    )
  )

  ;; CHECK:      (func $d3 (type $1)
  ;; CHECK-NEXT:  (global.set $h
  ;; CHECK-NEXT:   (call $alloc$Inner_9
  ;; CHECK-NEXT:    (global.get $mut)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $d3
    (global.set $h
      (struct.new $Inner
        (global.get $mut)
        (i32.const 2)
        (i32.const 1000000)
      )
    )
  )
)

;; An existing function whose body is exactly the allocation, with the holes as
;; its parameters in order and the exact result type, is reused as the helper,
;; so running the pass again after the module changed does not create another
;; helper. $existing itself is not modified.

;; CHECK:      (func $alloc$Inner (type $4) (result (ref (exact $Inner)))
;; CHECK-NEXT:  (struct.new $Inner
;; CHECK-NEXT:   (i32.const 1)
;; CHECK-NEXT:   (i32.const 2)
;; CHECK-NEXT:   (i32.const 3)
;; CHECK-NEXT:  )
;; CHECK-NEXT: )

;; CHECK:      (func $alloc$Inner_9 (type $5) (param $0 i32) (result (ref (exact $Inner)))
;; CHECK-NEXT:  (struct.new $Inner
;; CHECK-NEXT:   (local.get $0)
;; CHECK-NEXT:   (i32.const 2)
;; CHECK-NEXT:   (i32.const 1000000)
;; CHECK-NEXT:  )
;; CHECK-NEXT: )
(module
  ;; CHECK:      (type $A (struct (field i32) (field i32) (field anyref) (field f64)))
  (type $A (struct (field i32) (field i32) (field anyref) (field f64)))

  ;; CHECK:      (type $1 (func (param i32 anyref) (result (ref (exact $A)))))

  ;; CHECK:      (type $2 (func (param i32 anyref) (result anyref)))

  ;; CHECK:      (type $3 (func (param anyref i32) (result (ref (exact $A)))))

  ;; CHECK:      (func $existing (type $1) (param $x i32) (param $r anyref) (result (ref (exact $A)))
  ;; CHECK-NEXT:  (struct.new $A
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (local.get $r)
  ;; CHECK-NEXT:   (f64.const 42)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $existing (param $x i32) (param $r anyref) (result (ref (exact $A)))
    (struct.new $A
      (local.get $x)
      (i32.const 1)
      (local.get $r)
      (f64.const 42)
    )
  )

  ;; CHECK:      (func $a (type $2) (param $x i32) (param $r anyref) (result anyref)
  ;; CHECK-NEXT:  (call $existing
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (local.get $r)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $a (param $x i32) (param $r anyref) (result anyref)
    (struct.new $A
      (local.get $x)
      (i32.const 1)
      (local.get $r)
      (f64.const 42)
    )
  )

  ;; The parameters of this function are in the wrong order, so it is not a
  ;; helper, but its body is outlined.
  ;; CHECK:      (func $not-helper (type $3) (param $r anyref) (param $x i32) (result (ref (exact $A)))
  ;; CHECK-NEXT:  (call $existing
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (local.get $r)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $not-helper (param $r anyref) (param $x i32) (result (ref (exact $A)))
    (struct.new $A
      (local.get $x)
      (i32.const 1)
      (local.get $r)
      (f64.const 42)
    )
  )
)
