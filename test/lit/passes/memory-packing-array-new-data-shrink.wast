;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; Test that memory-packing only turns long array.new_data into array.new_fixed
;; when optimizing for size.

;; RUN: foreach %s %t wasm-opt --memory-packing --all-features -S -o - | filecheck %s
;; RUN: foreach %s %t wasm-opt --memory-packing --all-features -s 1 -S -o - | filecheck %s --check-prefix=SHRINK

(module
  ;; CHECK:      (type $i32s (array (mut i32)))
  ;; SHRINK:      (type $i32s (array (mut i32)))
  (type $i32s (array (mut i32)))

  ;; 100 small i32 values: half the size as array.new_fixed, but that is a lot of
  ;; operands, so we only do it when optimizing for size.
  ;; CHECK:      (type $1 (func (result (ref $i32s))))

