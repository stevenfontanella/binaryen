;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.
;; RUN: foreach %s %t wasm-opt --sparse-field-to-lookup -all --closed-world -S -o - | filecheck %s
;; RUN: foreach %s %t wasm-opt --sparse-field-to-lookup --gto -all --closed-world -S -o - | filecheck %s --check-prefix=GTO

;; A vtable-like hierarchy whose instances are all in globals. Field 0 is null
;; in all but one instance, so reads of it become calls to a lookup function
;; (and --gto then removes the field). Field 1 is dense, so it stays.
(module
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $vt (sub (struct (field (ref null $marker)) (field funcref))))
    ;; GTO:      (rec
    ;; GTO-NEXT:  (type $vt (sub (struct (field funcref))))
    (type $vt (sub (struct (field (ref null $marker)) (field funcref))))
    ;; A subtype that refines field 0: the read of it gets a cast.

    ;; CHECK:       (type $vt.sub (sub $vt (struct (field (ref $marker)) (field funcref))))
    ;; GTO:       (type $1 (func (param (ref null $vt)) (result (ref null $marker))))

    ;; GTO:       (type $2 (func (result (ref $vt))))

    ;; GTO:       (type $3 (func (param (ref null $vt) (ref $vt) (ref $vt.sub)) (result anyref)))

    ;; GTO:       (type $4 (func))

    ;; GTO:       (type $vt.sub (sub $vt (struct (field funcref))))
    (type $vt.sub (sub $vt (struct (field (ref $marker)) (field funcref))))
    ;; CHECK:       (type $vt.sub2 (sub $vt (struct (field nullref) (field funcref))))
    ;; GTO:       (type $vt.sub2 (sub $vt (struct (field funcref))))
    (type $vt.sub2 (sub $vt (struct (field nullref) (field funcref))))
    ;; CHECK:       (type $marker (struct))
    ;; GTO:       (type $marker (struct))
    (type $marker (struct))
  )

  ;; CHECK:      (type $4 (func))

  ;; CHECK:      (type $5 (func (param (ref null $vt) (ref $vt) (ref $vt.sub)) (result anyref)))

  ;; CHECK:      (type $6 (func (result (ref $vt))))

  ;; CHECK:      (type $7 (func (param (ref null $vt)) (result (ref null $marker))))

  ;; CHECK:      (global $m (ref $marker) (struct.new_default $marker))
  ;; GTO:      (global $m (ref $marker) (struct.new_default $marker))
  (global $m (ref $marker) (struct.new $marker))

  ;; CHECK:      (global $vt0 (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT:  (ref.func $f)
  ;; CHECK-NEXT: ))
  ;; GTO:      (global $vt0 (ref $vt) (struct.new $vt
  ;; GTO-NEXT:  (ref.func $f)
  ;; GTO-NEXT: ))
  (global $vt0 (ref $vt) (struct.new $vt (ref.null none) (ref.func $f)))
  ;; CHECK:      (global $vt1 (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT:  (ref.func $f)
  ;; CHECK-NEXT: ))
  ;; GTO:      (global $vt1 (ref $vt) (struct.new $vt
  ;; GTO-NEXT:  (ref.func $f)
  ;; GTO-NEXT: ))
  (global $vt1 (ref $vt) (struct.new $vt (ref.null none) (ref.func $f)))
  ;; CHECK:      (global $vt2 (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT:  (ref.func $f)
  ;; CHECK-NEXT: ))
  ;; GTO:      (global $vt2 (ref $vt) (struct.new $vt
  ;; GTO-NEXT:  (ref.func $f)
  ;; GTO-NEXT: ))
  (global $vt2 (ref $vt) (struct.new $vt (ref.null none) (ref.func $f)))
  ;; CHECK:      (global $vt3 (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT:  (ref.func $f)
  ;; CHECK-NEXT: ))
  ;; GTO:      (global $vt3 (ref $vt) (struct.new $vt
  ;; GTO-NEXT:  (ref.func $f)
  ;; GTO-NEXT: ))
  (global $vt3 (ref $vt) (struct.new $vt (ref.null none) (ref.func $f)))
  ;; CHECK:      (global $vt4 (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT:  (ref.func $f)
  ;; CHECK-NEXT: ))
  ;; GTO:      (global $vt4 (ref $vt) (struct.new $vt
  ;; GTO-NEXT:  (ref.func $f)
  ;; GTO-NEXT: ))
  (global $vt4 (ref $vt) (struct.new $vt (ref.null none) (ref.func $f)))
  ;; CHECK:      (global $vt5 (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT:  (ref.func $f)
  ;; CHECK-NEXT: ))
  ;; GTO:      (global $vt5 (ref $vt) (struct.new $vt
  ;; GTO-NEXT:  (ref.func $f)
  ;; GTO-NEXT: ))
  (global $vt5 (ref $vt) (struct.new $vt (ref.null none) (ref.func $f)))
  ;; CHECK:      (global $vt6 (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT:  (ref.func $f)
  ;; CHECK-NEXT: ))
  ;; GTO:      (global $vt6 (ref $vt) (struct.new $vt
  ;; GTO-NEXT:  (ref.func $f)
  ;; GTO-NEXT: ))
  (global $vt6 (ref $vt) (struct.new $vt (ref.null none) (ref.func $f)))
  ;; CHECK:      (global $vt7 (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT:  (ref.func $f)
  ;; CHECK-NEXT: ))
  ;; GTO:      (global $vt7 (ref $vt) (struct.new $vt
  ;; GTO-NEXT:  (ref.func $f)
  ;; GTO-NEXT: ))
  (global $vt7 (ref $vt) (struct.new $vt (ref.null none) (ref.func $f)))
  ;; CHECK:      (global $vt8 (ref $vt.sub2) (struct.new $vt.sub2
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT:  (ref.func $f)
  ;; CHECK-NEXT: ))
  ;; GTO:      (global $vt8 (ref $vt.sub2) (struct.new $vt.sub2
  ;; GTO-NEXT:  (ref.func $f)
  ;; GTO-NEXT: ))
  (global $vt8 (ref $vt.sub2) (struct.new $vt.sub2 (ref.null none) (ref.func $f)))
  ;; CHECK:      (global $vt9 (ref $vt) (struct.new_default $vt))
  ;; GTO:      (global $vt9 (ref $vt) (struct.new_default $vt))
  (global $vt9 (ref $vt) (struct.new_default $vt))
  ;; The single non-null instance, in a subtype.
  ;; CHECK:      (global $vt10 (ref $vt.sub) (struct.new $vt.sub
  ;; CHECK-NEXT:  (global.get $m)
  ;; CHECK-NEXT:  (ref.func $f)
  ;; CHECK-NEXT: ))
  ;; GTO:      (global $vt10 (ref $vt.sub) (struct.new $vt.sub
  ;; GTO-NEXT:  (ref.func $f)
  ;; GTO-NEXT: ))
  (global $vt10 (ref $vt.sub) (struct.new $vt.sub (global.get $m) (ref.func $f)))

  ;; CHECK:      (elem declare func $f)

  ;; CHECK:      (func $f (type $4)
  ;; CHECK-NEXT: )
  ;; GTO:      (elem declare func $f)

  ;; GTO:      (func $f (type $4)
  ;; GTO-NEXT: )
  (func $f)

  ;; CHECK:      (func $read (type $5) (param $x (ref null $vt)) (param $y (ref $vt)) (param $z (ref $vt.sub)) (result anyref)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $lookup$vt$0
  ;; CHECK-NEXT:    (ref.as_non_null
  ;; CHECK-NEXT:     (local.get $x)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $lookup$vt$0
  ;; CHECK-NEXT:    (local.get $y)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (struct.get $vt 1
  ;; CHECK-NEXT:    (local.get $y)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (ref.cast (ref $marker)
  ;; CHECK-NEXT:   (call $lookup$vt$0
  ;; CHECK-NEXT:    (local.get $z)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; GTO:      (func $read (type $3) (param $x (ref null $vt)) (param $y (ref $vt)) (param $z (ref $vt.sub)) (result anyref)
  ;; GTO-NEXT:  (drop
  ;; GTO-NEXT:   (call $lookup$vt$0
  ;; GTO-NEXT:    (ref.as_non_null
  ;; GTO-NEXT:     (local.get $x)
  ;; GTO-NEXT:    )
  ;; GTO-NEXT:   )
  ;; GTO-NEXT:  )
  ;; GTO-NEXT:  (drop
  ;; GTO-NEXT:   (call $lookup$vt$0
  ;; GTO-NEXT:    (local.get $y)
  ;; GTO-NEXT:   )
  ;; GTO-NEXT:  )
  ;; GTO-NEXT:  (drop
  ;; GTO-NEXT:   (struct.get $vt 0
  ;; GTO-NEXT:    (local.get $y)
  ;; GTO-NEXT:   )
  ;; GTO-NEXT:  )
  ;; GTO-NEXT:  (ref.cast (ref $marker)
  ;; GTO-NEXT:   (call $lookup$vt$0
  ;; GTO-NEXT:    (local.get $z)
  ;; GTO-NEXT:   )
  ;; GTO-NEXT:  )
  ;; GTO-NEXT: )
  (func $read (param $x (ref null $vt)) (param $y (ref $vt)) (param $z (ref $vt.sub)) (result anyref)
    ;; Nullable receiver: without -tnh the trap on null is preserved.
    (drop
      (struct.get $vt 0
        (local.get $x)))
    ;; Non-nullable receiver.
    (drop
      (struct.get $vt 0
        (local.get $y)))
    ;; The field is dense: no change.
    (drop
      (struct.get $vt 1
        (local.get $y)))
    ;; Refined subtype field: the call is cast to the refined type.
    (struct.get $vt.sub 0
      (local.get $z))
  )

  ;; A struct.new in code is fine when it passes null for the field.
  ;; CHECK:      (func $alloc (type $6) (result (ref $vt))
  ;; CHECK-NEXT:  (struct.new $vt
  ;; CHECK-NEXT:   (ref.null none)
  ;; CHECK-NEXT:   (ref.func $f)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  ;; GTO:      (func $alloc (type $2) (result (ref $vt))
  ;; GTO-NEXT:  (struct.new $vt
  ;; GTO-NEXT:   (ref.func $f)
  ;; GTO-NEXT:  )
  ;; GTO-NEXT: )
  (func $alloc (result (ref $vt))
    (struct.new $vt
      (ref.null none)
      (ref.func $f))
  )
)

;; As above, but one non-null instance is nested inside another global's init,
;; and its value is a nested struct.new too: both are hoisted into new globals.
;; A second non-null instance is the init of a mutable global, which cannot be
;; a key, so it is hoisted as well.
;; CHECK:      (func $lookup$vt$0 (type $7) (param $0 (ref null $vt)) (result (ref null $marker))
;; CHECK-NEXT:  (if
;; CHECK-NEXT:   (ref.eq
;; CHECK-NEXT:    (local.get $0)
;; CHECK-NEXT:    (global.get $vt10)
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (then
;; CHECK-NEXT:    (return
;; CHECK-NEXT:     (global.get $m)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:  )
;; CHECK-NEXT:  (ref.null none)
;; CHECK-NEXT: )

;; GTO:      (func $lookup$vt$0 (type $1) (param $0 (ref null $vt)) (result (ref null $marker))
;; GTO-NEXT:  (if
;; GTO-NEXT:   (ref.eq
;; GTO-NEXT:    (local.get $0)
;; GTO-NEXT:    (global.get $vt10)
;; GTO-NEXT:   )
;; GTO-NEXT:   (then
;; GTO-NEXT:    (return
;; GTO-NEXT:     (global.get $m)
;; GTO-NEXT:    )
;; GTO-NEXT:   )
;; GTO-NEXT:  )
;; GTO-NEXT:  (ref.null none)
;; GTO-NEXT: )
(module
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $vt (sub (struct (field structref))))
    ;; GTO:      (rec
    ;; GTO-NEXT:  (type $0 (func (param (ref null $vt)) (result structref)))

    ;; GTO:       (type $1 (func (param (ref $vt)) (result anyref)))

    ;; GTO:       (type $holder (struct))

    ;; GTO:       (type $vt (sub (struct)))
    (type $vt (sub (struct (field structref))))
    ;; CHECK:       (type $marker (struct))
    ;; GTO:       (type $marker (struct))
    (type $marker (struct))
    ;; CHECK:       (type $holder (struct (field (ref $vt))))
    (type $holder (struct (field (ref $vt))))
  )

  ;; CHECK:      (type $3 (func (param (ref $vt)) (result anyref)))

  ;; CHECK:      (type $4 (func (param (ref null $vt)) (result structref)))

  ;; CHECK:      (global $holder.field0 (ref (exact $marker)) (struct.new_default $marker))

  ;; CHECK:      (global $holder.hoisted (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (global.get $holder.field0)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (global $mut.field0 (ref (exact $marker)) (struct.new_default $marker))

  ;; CHECK:      (global $mut.hoisted (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (global.get $mut.field0)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (global $vt0 (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT: ))
  ;; GTO:      (global $holder.field0 (ref (exact $marker)) (struct.new_default $marker))

  ;; GTO:      (global $holder.hoisted (ref $vt) (struct.new_default $vt))

  ;; GTO:      (global $mut.field0 (ref (exact $marker)) (struct.new_default $marker))

  ;; GTO:      (global $mut.hoisted (ref $vt) (struct.new_default $vt))

  ;; GTO:      (global $vt0 (ref $vt) (struct.new_default $vt))
  (global $vt0 (ref $vt) (struct.new $vt (ref.null none)))
  ;; CHECK:      (global $vt1 (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT: ))
  ;; GTO:      (global $vt1 (ref $vt) (struct.new_default $vt))
