  ;; CHECK:      (global $holder (ref $holder) (struct.new $holder
  ;; CHECK-NEXT:  (global.get $holder.hoisted)
  ;; CHECK-NEXT: ))
  ;; GTO:      (global $holder (ref $holder) (struct.new_default $holder))
  (global $holder (ref $holder)
    (struct.new $holder
      (struct.new $vt
        (struct.new $marker))))
  ;; CHECK:      (global $mut (mut (ref $vt)) (global.get $mut.hoisted))
