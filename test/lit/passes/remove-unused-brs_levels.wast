  ;; SHRINK_0-NEXT:    (i32.div_s
  ;; SHRINK_0-NEXT:     (local.get $x)
  ;; SHRINK_0-NEXT:     (i32.const 13)
  ;; SHRINK_0-NEXT:    )
  ;; SHRINK_0-NEXT:   )
  ;; SHRINK_0-NEXT:   (else
