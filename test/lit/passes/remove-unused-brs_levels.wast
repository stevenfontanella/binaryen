  (func $restructure-if-k-gt-0 (param $x i32) (result i32)
    (i32.add
      (block $out (result i32)
        (drop
          (struct.new_default $struct)
        )
        (drop
          (br_if $out
            (i32.const 10)
            (local.get $x)
          )
        )
        (drop
          (struct.new_default $struct)
        )
        (i32.const 20)
      )
      (i32.const 1)
    )
  )

