  ;; SHRINK_2-NEXT:   (i32.const 1)
  ;; SHRINK_2-NEXT:  )
  ;; SHRINK_2-NEXT: )
  (func $restructure-if-one-arm-br (param $x i32) (result i32)
    (i32.add
      (block $out (result i32)
        (if
          (local.get $x)
          (then
            (drop
              (struct.new_default $struct)
            )
            (br $out (i32.const 42))
          )
        )
        (i32.const 0)
      )
      (i32.const 1)
    )
  )

