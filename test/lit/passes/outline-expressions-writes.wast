;; NOTE: Assertions have been generated by update_lit_checks.py and should not be edited.
;; RUN: foreach %s %t wasm-opt --outline-expressions=trees -all -S -o - | filecheck %s

;; Trees that write a single local, and branch inside themselves, can be
;; outlined: the helper returns the local's final value.
(module
  ;; CHECK:      (import "env" "f" (func $f (type $2) (param anyref)))
  (import "env" "f" (func $f (param anyref)))
  ;; CHECK:      (import "env" "g" (func $g (type $2) (param anyref)))
  (import "env" "g" (func $g (param anyref)))

  ;; Three copies of a padding loop with different limits and locals. The exact
  ;; rounds outline nothing (the limits differ), then the round with constants
  ;; as holes outlines them into one helper with the limit as a parameter. The
  ;; counter is read in the loop, so its incoming value is a parameter too, and
  ;; the site becomes a local.set of the helper's result.
  ;; CHECK:      (func $pad (type $0) (param $w anyref) (param $i i32) (param $j i32)
  ;; CHECK-NEXT:  (local.set $i
  ;; CHECK-NEXT:   (call $outlined_11
  ;; CHECK-NEXT:    (local.get $i)
  ;; CHECK-NEXT:    (i32.const 3)
  ;; CHECK-NEXT:    (local.get $w)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $j
  ;; CHECK-NEXT:   (call $outlined_11
  ;; CHECK-NEXT:    (local.get $j)
  ;; CHECK-NEXT:    (i32.const 5)
  ;; CHECK-NEXT:    (local.get $w)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $i
  ;; CHECK-NEXT:   (call $outlined_11
  ;; CHECK-NEXT:    (local.get $i)
  ;; CHECK-NEXT:    (i32.const 7)
  ;; CHECK-NEXT:    (local.get $w)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $pad (param $w anyref) (param $i i32) (param $j i32)
    (loop $l1
      (if (i32.lt_s (local.get $i) (i32.const 3))
        (then
          (call $f (local.get $w))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l1)
        )
      )
    )
    (loop $l2
      (if (i32.lt_s (local.get $j) (i32.const 5))
        (then
          (call $f (local.get $w))
          (local.set $j (i32.add (local.get $j) (i32.const 1)))
          (br $l2)
        )
      )
    )
    (loop $l3
      (if (i32.lt_s (local.get $i) (i32.const 7))
        (then
          (call $f (local.get $w))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (br $l3)
        )
      )
    )
  )

  ;; A tree that writes a local it does not read: the helper declares the local
  ;; itself and only returns it.
  ;; CHECK:      (func $write-only (type $1) (param $a anyref) (param $b anyref) (result i32)
  ;; CHECK-NEXT:  (local $x i32)
  ;; CHECK-NEXT:  (local $y i32)
  ;; CHECK-NEXT:  (local.set $x
  ;; CHECK-NEXT:   (call $outlined
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $y
  ;; CHECK-NEXT:   (call $outlined
  ;; CHECK-NEXT:    (local.get $b)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (local.get $y)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $write-only (param $a anyref) (param $b anyref) (result i32)
    (local $x i32)
    (local $y i32)
    (if (ref.is_null (local.get $a))
      (then
        (call $f (local.get $a))
        (local.set $x (i32.const 1))
      )
      (else
        (call $g (local.get $a))
        (local.set $x (i32.const 2))
      )
    )
    (if (ref.is_null (local.get $b))
      (then
        (call $f (local.get $b))
        (local.set $y (i32.const 1))
      )
      (else
        (call $g (local.get $b))
        (local.set $y (i32.const 2))
      )
    )
    (i32.add (local.get $x) (local.get $y))
  )

  ;; Two locals written: not outlined.
  ;; CHECK:      (func $two-locals (type $1) (param $a anyref) (param $b anyref) (result i32)
  ;; CHECK-NEXT:  (local $x i32)
  ;; CHECK-NEXT:  (local $y i32)
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (ref.is_null
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (call $f
  ;; CHECK-NEXT:     (local.get $a)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $x
  ;; CHECK-NEXT:     (i32.const 1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $y
  ;; CHECK-NEXT:     (i32.const 3)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (else
  ;; CHECK-NEXT:    (call $g
  ;; CHECK-NEXT:     (local.get $a)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $x
  ;; CHECK-NEXT:     (i32.const 2)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $y
  ;; CHECK-NEXT:     (i32.const 4)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (if
  ;; CHECK-NEXT:   (ref.is_null
  ;; CHECK-NEXT:    (local.get $b)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (call $f
  ;; CHECK-NEXT:     (local.get $b)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $x
  ;; CHECK-NEXT:     (i32.const 1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $y
  ;; CHECK-NEXT:     (i32.const 3)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (else
  ;; CHECK-NEXT:    (call $g
  ;; CHECK-NEXT:     (local.get $b)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $x
  ;; CHECK-NEXT:     (i32.const 2)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (local.set $y
  ;; CHECK-NEXT:     (i32.const 4)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (local.get $y)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $two-locals (param $a anyref) (param $b anyref) (result i32)
    (local $x i32)
    (local $y i32)
    (if (ref.is_null (local.get $a))
      (then
        (call $f (local.get $a))
        (local.set $x (i32.const 1))
        (local.set $y (i32.const 3))
      )
      (else
        (call $g (local.get $a))
        (local.set $x (i32.const 2))
        (local.set $y (i32.const 4))
      )
    )
    (if (ref.is_null (local.get $b))
      (then
        (call $f (local.get $b))
        (local.set $x (i32.const 1))
        (local.set $y (i32.const 3))
      )
      (else
        (call $g (local.get $b))
        (local.set $x (i32.const 2))
        (local.set $y (i32.const 4))
      )
    )
    (i32.add (local.get $x) (local.get $y))
  )

  ;; A return inside the loop: not outlined.
  ;; CHECK:      (func $return (type $0) (param $w anyref) (param $i i32) (param $j i32)
  ;; CHECK-NEXT:  (loop $l1
  ;; CHECK-NEXT:   (if
  ;; CHECK-NEXT:    (i32.lt_s
  ;; CHECK-NEXT:     (local.get $i)
  ;; CHECK-NEXT:     (i32.const 3)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (then
  ;; CHECK-NEXT:     (call $f
  ;; CHECK-NEXT:      (local.get $w)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (local.set $i
  ;; CHECK-NEXT:      (i32.add
  ;; CHECK-NEXT:       (local.get $i)
  ;; CHECK-NEXT:       (i32.const 1)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (if
  ;; CHECK-NEXT:      (i32.eqz
  ;; CHECK-NEXT:       (local.get $i)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (then
  ;; CHECK-NEXT:       (return)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (br $l1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (loop $l2
  ;; CHECK-NEXT:   (if
  ;; CHECK-NEXT:    (i32.lt_s
  ;; CHECK-NEXT:     (local.get $j)
  ;; CHECK-NEXT:     (i32.const 3)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (then
  ;; CHECK-NEXT:     (call $f
  ;; CHECK-NEXT:      (local.get $w)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (local.set $j
  ;; CHECK-NEXT:      (i32.add
  ;; CHECK-NEXT:       (local.get $j)
  ;; CHECK-NEXT:       (i32.const 1)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (if
  ;; CHECK-NEXT:      (i32.eqz
  ;; CHECK-NEXT:       (local.get $j)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:      (then
  ;; CHECK-NEXT:       (return)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (br $l2)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $return (param $w anyref) (param $i i32) (param $j i32)
    (loop $l1
      (if (i32.lt_s (local.get $i) (i32.const 3))
        (then
          (call $f (local.get $w))
          (local.set $i (i32.add (local.get $i) (i32.const 1)))
          (if (i32.eqz (local.get $i)) (then (return)))
          (br $l1)
        )
      )
    )
    (loop $l2
      (if (i32.lt_s (local.get $j) (i32.const 3))
        (then
          (call $f (local.get $w))
          (local.set $j (i32.add (local.get $j) (i32.const 1)))
          (if (i32.eqz (local.get $j)) (then (return)))
          (br $l2)
        )
      )
    )
  )

  ;; A branch to a label outside the loop: the loop is not outlined (but the
  ;; block around it, which closes the label, is).
  ;; CHECK:      (func $outer-label (type $0) (param $w anyref) (param $i i32) (param $j i32)
  ;; CHECK-NEXT:  (local.set $i
  ;; CHECK-NEXT:   (call $outlined_10
  ;; CHECK-NEXT:    (local.get $i)
  ;; CHECK-NEXT:    (local.get $w)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (local.set $j
  ;; CHECK-NEXT:   (call $outlined_10
  ;; CHECK-NEXT:    (local.get $j)
  ;; CHECK-NEXT:    (local.get $w)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $outer-label (param $w anyref) (param $i i32) (param $j i32)
    (block $out1
      (loop $l1
        (if (i32.lt_s (local.get $i) (i32.const 3))
          (then
            (call $f (local.get $w))
            (local.set $i (i32.add (local.get $i) (i32.const 1)))
            (br_if $out1 (i32.eqz (local.get $i)))
            (br $l1)
          )
        )
      )
    )
    (block $out2
      (loop $l2
        (if (i32.lt_s (local.get $j) (i32.const 3))
          (then
            (call $f (local.get $w))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br_if $out2 (i32.eqz (local.get $j)))
            (br $l2)
          )
        )
      )
    )
  )

  ;; The written local has a non-defaultable type, so the site cannot read it
  ;; before the tree: not outlined.
  ;; CHECK:      (func $non-defaultable (type $3) (param $a anyref) (param $b anyref)
  ;; CHECK-NEXT:  (local $x (ref any))
  ;; CHECK-NEXT:  (local $y (ref any))
  ;; CHECK-NEXT:  (block
  ;; CHECK-NEXT:   (call $f
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (local.set $x
  ;; CHECK-NEXT:    (ref.i31
  ;; CHECK-NEXT:     (i32.const 1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (call $g
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block
  ;; CHECK-NEXT:   (call $f
  ;; CHECK-NEXT:    (local.get $b)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (local.set $y
  ;; CHECK-NEXT:    (ref.i31
  ;; CHECK-NEXT:     (i32.const 1)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (call $g
  ;; CHECK-NEXT:    (local.get $y)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $non-defaultable (param $a anyref) (param $b anyref)
    (local $x (ref any))
    (local $y (ref any))
    (block
      (call $f (local.get $a))
      (local.set $x (ref.i31 (i32.const 1)))
      (call $g (local.get $x))
    )
    (block
      (call $f (local.get $b))
      (local.set $y (ref.i31 (i32.const 1)))
      (call $g (local.get $y))
    )
  )

  ;; A local.set whose value branches out of it: not outlined, as we compare
  ;; the values of local.sets on their own.
  ;; CHECK:      (func $set-branches-out (type $1) (param $a anyref) (param $b anyref) (result i32)
  ;; CHECK-NEXT:  (local $x i32)
  ;; CHECK-NEXT:  (local $y i32)
  ;; CHECK-NEXT:  (block $out1
  ;; CHECK-NEXT:   (call $f
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (local.set $x
  ;; CHECK-NEXT:    (if (result i32)
  ;; CHECK-NEXT:     (ref.is_null
  ;; CHECK-NEXT:      (local.get $a)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (then
  ;; CHECK-NEXT:      (br $out1)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (else
  ;; CHECK-NEXT:      (i32.const 1)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (call $g
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (block $out2
  ;; CHECK-NEXT:   (call $f
  ;; CHECK-NEXT:    (local.get $b)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (local.set $y
  ;; CHECK-NEXT:    (if (result i32)
  ;; CHECK-NEXT:     (ref.is_null
  ;; CHECK-NEXT:      (local.get $b)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (then
  ;; CHECK-NEXT:      (br $out2)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (else
  ;; CHECK-NEXT:      (i32.const 1)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (call $g
  ;; CHECK-NEXT:    (local.get $b)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (local.get $y)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $set-branches-out (param $a anyref) (param $b anyref) (result i32)
    (local $x i32)
    (local $y i32)
    (block $out1
      (call $f (local.get $a))
      (local.set $x
        (if (result i32)
          (ref.is_null (local.get $a))
          (then (br $out1))
          (else (i32.const 1))
        )
      )
      (call $g (local.get $a))
    )
    (block $out2
      (call $f (local.get $b))
      (local.set $y
        (if (result i32)
          (ref.is_null (local.get $b))
          (then (br $out2))
          (else (i32.const 1))
        )
      )
      (call $g (local.get $b))
    )
    (i32.add (local.get $x) (local.get $y))
  )
)
