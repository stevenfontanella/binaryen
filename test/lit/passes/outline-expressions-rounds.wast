;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.
;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.
;; RUN: foreach %s %t wasm-opt --outline-expressions=trees -all -S -o - | filecheck %s

;; The pass repeats until nothing more is outlined. Here two shapes, an i32.add
;; and an i32.sub of the same pure sub-tree
;;
;;   (struct.get $B 0 (struct.get $A 0 (local.get $x)))
;;
;; each appear three times and are outlined in the first round. The sub-tree
;; also appears bare twice, which is not enough on its own: in the first round
;; the copies inside the add and sub trees vanish along with their parents. In
;; the second round the sub-tree appears in the two new helpers plus the two
;; bare sites, and is outlined into a third helper that the first two call.
;; (The unused params stop the functions from being reused as the helpers.)
(module
  ;; CHECK:      (type $B (struct (field i32)))
  (type $B (struct (field i32)))
  ;; CHECK:      (type $A (struct (field (ref null $B))))
  (type $A (struct (field (ref null $B))))

  ;; CHECK:      (type $2 (func (param (ref null $A) i32) (result i32)))

  ;; CHECK:      (type $3 (func (param (ref null $A)) (result i32)))

  ;; CHECK:      (func $add1 (type $2) (param $x (ref null $A)) (param $unused i32) (result i32)
  ;; CHECK-NEXT:  (call $outlined
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $add1 (param $x (ref null $A)) (param $unused i32) (result i32)
    (i32.add
      (struct.get $B 0 (struct.get $A 0 (local.get $x)))
      (i32.const 1000)
    )
  )

  ;; CHECK:      (func $add2 (type $2) (param $y (ref null $A)) (param $unused i32) (result i32)
  ;; CHECK-NEXT:  (call $outlined
  ;; CHECK-NEXT:   (local.get $y)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $add2 (param $y (ref null $A)) (param $unused i32) (result i32)
    (i32.add
      (struct.get $B 0 (struct.get $A 0 (local.get $y)))
      (i32.const 1000)
    )
  )

  ;; CHECK:      (func $add3 (type $2) (param $z (ref null $A)) (param $unused i32) (result i32)
  ;; CHECK-NEXT:  (call $outlined
  ;; CHECK-NEXT:   (local.get $z)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $add3 (param $z (ref null $A)) (param $unused i32) (result i32)
    (i32.add
      (struct.get $B 0 (struct.get $A 0 (local.get $z)))
      (i32.const 1000)
    )
  )

  ;; CHECK:      (func $sub1 (type $2) (param $x (ref null $A)) (param $unused i32) (result i32)
  ;; CHECK-NEXT:  (call $outlined_9
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $sub1 (param $x (ref null $A)) (param $unused i32) (result i32)
    (i32.sub
      (struct.get $B 0 (struct.get $A 0 (local.get $x)))
      (i32.const 1000)
    )
  )

  ;; CHECK:      (func $sub2 (type $2) (param $y (ref null $A)) (param $unused i32) (result i32)
  ;; CHECK-NEXT:  (call $outlined_9
  ;; CHECK-NEXT:   (local.get $y)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $sub2 (param $y (ref null $A)) (param $unused i32) (result i32)
    (i32.sub
      (struct.get $B 0 (struct.get $A 0 (local.get $y)))
      (i32.const 1000)
    )
  )

  ;; CHECK:      (func $sub3 (type $2) (param $z (ref null $A)) (param $unused i32) (result i32)
  ;; CHECK-NEXT:  (call $outlined_9
  ;; CHECK-NEXT:   (local.get $z)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $sub3 (param $z (ref null $A)) (param $unused i32) (result i32)
    (i32.sub
      (struct.get $B 0 (struct.get $A 0 (local.get $z)))
      (i32.const 1000)
    )
  )

  ;; CHECK:      (func $bare1 (type $2) (param $x (ref null $A)) (param $unused i32) (result i32)
  ;; CHECK-NEXT:  (call $outlined_10
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $bare1 (param $x (ref null $A)) (param $unused i32) (result i32)
    (struct.get $B 0 (struct.get $A 0 (local.get $x)))
  )

  ;; CHECK:      (func $bare2 (type $2) (param $y (ref null $A)) (param $unused i32) (result i32)
  ;; CHECK-NEXT:  (call $outlined_10
  ;; CHECK-NEXT:   (local.get $y)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $bare2 (param $y (ref null $A)) (param $unused i32) (result i32)
    (struct.get $B 0 (struct.get $A 0 (local.get $y)))
  )
)
;; CHECK:      (func $outlined (type $3) (param $0 (ref null $A)) (result i32)
;; CHECK-NEXT:  (i32.add
;; CHECK-NEXT:   (call $outlined_10
;; CHECK-NEXT:    (local.get $0)
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (i32.const 1000)
;; CHECK-NEXT:  )
;; CHECK-NEXT: )

;; CHECK:      (func $outlined_9 (type $3) (param $0 (ref null $A)) (result i32)
;; CHECK-NEXT:  (i32.sub
;; CHECK-NEXT:   (call $outlined_10
;; CHECK-NEXT:    (local.get $0)
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (i32.const 1000)
;; CHECK-NEXT:  )
;; CHECK-NEXT: )

;; CHECK:      (func $outlined_10 (type $3) (param $0 (ref null $A)) (result i32)
;; CHECK-NEXT:  (struct.get $B 0
;; CHECK-NEXT:   (struct.get $A 0
;; CHECK-NEXT:    (local.get $0)
;; CHECK-NEXT:   )
;; CHECK-NEXT:  )
;; CHECK-NEXT: )
