;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; Lower the strings to imports + the string.consts JSON section first, then
;; move the convertible ones into a data segment.

;; RUN: wasm-opt %s -all --string-lowering --string-consts-to-data --pass-arg=string-consts-to-data-always@1 -S -o - | filecheck %s

(module
  ;; CHECK:      (type $0 (array (mut i32)))

  ;; CHECK:      (type $1 (array (mut i8)))

  ;; CHECK:      (type $2 (array (mut i16)))

  ;; CHECK:      (type $3 (array (mut externref)))

  ;; CHECK:      (type $4 (func (param i32) (result (ref extern))))

  ;; CHECK:      (rec
  ;; CHECK-NEXT:  (type $5 (func (result (ref $S))))

  ;; CHECK:       (type $6 (func (result externref externref externref)))

  ;; CHECK:       (type $7 (func (param (ref $col)) (result i32)))

  ;; CHECK:       (type $8 (func (param i32) (result externref)))

  ;; CHECK:       (type $S (struct (field externref)))

  ;; CHECK:       (type $col (array externref))
  (type $col (array externref))
  (type $S (struct (field externref)))

  ;; A column: an immutable array of strings that is only read by array.get in
  ;; code. It becomes offset and length tables, and the reads become calls.
  ;; "héllo" is Latin-1 (one byte per unit), "日本" needs i16, and the empty
  ;; string is stored as an empty i16 string.
  (global $column (ref $col) (array.new_fixed $col 4
    (string.const "foo")
    (string.const "héllo")
    (string.const "日本")
    (string.const "")
  ))

  ;; A column that is also used as a whole (passed to a function) stays, and
  ;; so do its strings.
  ;; CHECK:      (type $11 (func (param externref externref) (result i32)))

  ;; CHECK:      (type $12 (func (param externref) (result i32)))

  ;; CHECK:      (type $13 (func (param (ref null $2) i32 i32) (result (ref extern))))

  ;; CHECK:      (type $14 (func (param externref externref) (result (ref extern))))

  ;; CHECK:      (type $15 (func (param externref (ref null $2) i32) (result i32)))

  ;; CHECK:      (type $16 (func (param externref i32) (result i32)))

  ;; CHECK:      (type $17 (func (param externref i32 i32) (result (ref extern))))

  ;; CHECK:      (type $18 (func (param i32 i32) (result (ref extern))))

  ;; CHECK:      (type $19 (func (param (ref $0) (ref $1) i32)))

  ;; CHECK:      (import "string.const" "0" (global $exported (ref extern)))

  ;; CHECK:      (import "string.const" "1" (global $"string.const_\"in-struct\"" (ref extern)))

  ;; CHECK:      (import "string.const" "2" (global $"string.const_\"pinned-by-column\"" (ref extern)))

  ;; CHECK:      (import "wasm:js-string" "fromCharCodeArray" (func $fromCharCodeArray (type $13) (param (ref null $2) i32 i32) (result (ref extern))))

  ;; CHECK:      (import "wasm:js-string" "fromCodePoint" (func $fromCodePoint (type $4) (param i32) (result (ref extern))))

  ;; CHECK:      (import "wasm:js-string" "concat" (func $concat (type $14) (param externref externref) (result (ref extern))))

  ;; CHECK:      (import "wasm:js-string" "intoCharCodeArray" (func $intoCharCodeArray (type $15) (param externref (ref null $2) i32) (result i32)))

  ;; CHECK:      (import "wasm:js-string" "equals" (func $equals (type $11) (param externref externref) (result i32)))

  ;; CHECK:      (import "wasm:js-string" "test" (func $test (type $12) (param externref) (result i32)))

  ;; CHECK:      (import "wasm:js-string" "compare" (func $compare (type $11) (param externref externref) (result i32)))

  ;; CHECK:      (import "wasm:js-string" "length" (func $length (type $12) (param externref) (result i32)))

  ;; CHECK:      (import "wasm:js-string" "charCodeAt" (func $charCodeAt (type $16) (param externref i32) (result i32)))

  ;; CHECK:      (import "wasm:js-string" "substring" (func $substring (type $17) (param externref i32 i32) (result (ref extern))))

  ;; CHECK:      (global $used-column (ref $col) (array.new_fixed $col 1
  ;; CHECK-NEXT:  (global.get $"string.const_\"pinned-by-column\"")
  ;; CHECK-NEXT: ))
  (global $used-column (ref $col) (array.new_fixed $col 1
    (string.const "pinned-by-column")
  ))

  ;; A string used in another global initializer stays an import.
  ;; CHECK:      (global $wrapped (ref $S) (struct.new $S
  ;; CHECK-NEXT:  (global.get $"string.const_\"in-struct\"")
  ;; CHECK-NEXT: ))
  (global $wrapped (ref $S) (struct.new $S (string.const "in-struct")))

  ;; An exported string stays an import.
  (global $exported (ref string) (string.const "exported"))
  ;; CHECK:      (global $string.consts$col$0$table (mut (ref null $0)) (ref.null none))

  ;; CHECK:      (global $string.consts$raw$1$table (mut (ref null $0)) (ref.null none))

  ;; CHECK:      (global $string.consts$raw$1$cache (ref $3) (array.new_default $3
  ;; CHECK-NEXT:  (i32.const 2)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (data $string.consts "fooh\e9llo\e5e,g\06\n\05\01code-onlyfoo\12\06")

  ;; CHECK:      (export "exported" (global $exported))
  (export "exported" (global $exported))

  ;; CHECK:      (func $read-column (type $8) (param $i i32) (result externref)
  ;; CHECK-NEXT:  (call $string.consts$col$0
  ;; CHECK-NEXT:   (local.get $i)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $read-column (param $i i32) (result externref)
    (array.get $col
      (global.get $column)
      (local.get $i)
    )
  )

  ;; CHECK:      (func $read-used-column (type $8) (param $i i32) (result externref)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $take-column
  ;; CHECK-NEXT:    (global.get $used-column)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (array.get $col
  ;; CHECK-NEXT:   (global.get $used-column)
  ;; CHECK-NEXT:   (local.get $i)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $read-used-column (param $i i32) (result externref)
    (drop
      (call $take-column
        (global.get $used-column)
      )
    )
    (array.get $col
      (global.get $used-column)
      (local.get $i)
    )
  )

  ;; CHECK:      (func $take-column (type $7) (param $c (ref $col)) (result i32)
  ;; CHECK-NEXT:  (array.len
  ;; CHECK-NEXT:   (local.get $c)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $take-column (param $c (ref $col)) (result i32)
    (array.len
      (local.get $c)
    )
  )

  ;; Direct uses in code become calls to a caching helper. "foo" is also in the
  ;; column; it gets a second copy in the segment (each group is contiguous).
  ;; CHECK:      (func $code-uses (type $6) (result externref externref externref)
  ;; CHECK-NEXT:  (tuple.make 3
  ;; CHECK-NEXT:   (call $string.consts$raw$1
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (call $string.consts$raw$1
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (call $string.consts$raw$1
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $code-uses (result externref externref externref)
    (tuple.make 3
      (string.const "code-only")
      (string.const "foo")
      (string.const "code-only")
    )
  )

  ;; CHECK:      (func $use-wrapped (type $5) (result (ref $S))
  ;; CHECK-NEXT:  (global.get $wrapped)
  ;; CHECK-NEXT: )
  (func $use-wrapped (result (ref $S))
    (global.get $wrapped)
  )
)
;; CHECK:      (func $string.consts$make (type $18) (param $0 i32) (param $1 i32) (result (ref extern))
;; CHECK-NEXT:  (local $2 i32)
;; CHECK-NEXT:  (local $3 (ref $1))
;; CHECK-NEXT:  (local $4 (ref $2))
;; CHECK-NEXT:  (local.set $2
;; CHECK-NEXT:   (i32.shr_u
;; CHECK-NEXT:    (local.get $1)
;; CHECK-NEXT:    (i32.const 1)
;; CHECK-NEXT:   )
;; CHECK-NEXT:  )
;; CHECK-NEXT:  (if
;; CHECK-NEXT:   (i32.and
;; CHECK-NEXT:    (local.get $1)
;; CHECK-NEXT:    (i32.const 1)
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (then
;; CHECK-NEXT:    (return
;; CHECK-NEXT:     (call $fromCharCodeArray
;; CHECK-NEXT:      (array.new_data $2 $string.consts
;; CHECK-NEXT:       (local.get $0)
;; CHECK-NEXT:       (local.get $2)
;; CHECK-NEXT:      )
;; CHECK-NEXT:      (i32.const 0)
;; CHECK-NEXT:      (local.get $2)
;; CHECK-NEXT:     )
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:  )
;; CHECK-NEXT:  (local.set $3
;; CHECK-NEXT:   (array.new_data $1 $string.consts
;; CHECK-NEXT:    (local.get $0)
;; CHECK-NEXT:    (local.get $2)
;; CHECK-NEXT:   )
;; CHECK-NEXT:  )
;; CHECK-NEXT:  (local.set $4
;; CHECK-NEXT:   (array.new_default $2
;; CHECK-NEXT:    (local.get $2)
;; CHECK-NEXT:   )
;; CHECK-NEXT:  )
;; CHECK-NEXT:  (loop $copy
;; CHECK-NEXT:   (local.set $2
;; CHECK-NEXT:    (i32.sub
;; CHECK-NEXT:     (local.get $2)
;; CHECK-NEXT:     (i32.const 1)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (array.set $2
;; CHECK-NEXT:    (local.get $4)
;; CHECK-NEXT:    (local.get $2)
;; CHECK-NEXT:    (array.get_u $1
;; CHECK-NEXT:     (local.get $3)
;; CHECK-NEXT:     (local.get $2)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (br_if $copy
;; CHECK-NEXT:    (local.get $2)
;; CHECK-NEXT:   )
;; CHECK-NEXT:  )
;; CHECK-NEXT:  (call $fromCharCodeArray
;; CHECK-NEXT:   (local.get $4)
;; CHECK-NEXT:   (i32.const 0)
;; CHECK-NEXT:   (array.len
;; CHECK-NEXT:    (local.get $4)
;; CHECK-NEXT:   )
;; CHECK-NEXT:  )
;; CHECK-NEXT: )

;; CHECK:      (func $string.consts$fill (type $19) (param $0 (ref $0)) (param $1 (ref $1)) (param $2 i32)
;; CHECK-NEXT:  (local $3 i32)
;; CHECK-NEXT:  (local $4 i32)
;; CHECK-NEXT:  (local $5 i32)
;; CHECK-NEXT:  (loop $next
;; CHECK-NEXT:   (array.set $0
;; CHECK-NEXT:    (local.get $0)
