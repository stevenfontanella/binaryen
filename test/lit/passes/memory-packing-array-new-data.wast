;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; Test that memory-packing turns array.new_data of small constant segments into
;; array.new_fixed and removes the segments. Note that there is no memory here.

;; RUN: foreach %s %t wasm-opt --memory-packing --all-features -S -o - | filecheck %s

(module
  ;; CHECK:      (type $i32s (array (mut i32)))
  (type $i32s (array (mut i32)))

  ;; CHECK:      (type $1 (func (result (ref $i32s))))

  ;; CHECK:      (type $i8s (array (mut i8)))
  (type $i8s (array (mut i8)))
  ;; CHECK:      (type $i16s (array (mut i16)))
  (type $i16s (array (mut i16)))
  ;; CHECK:      (type $i64s (array (mut i64)))
  (type $i64s (array (mut i64)))
  ;; CHECK:      (type $f32s (array (mut f32)))
  (type $f32s (array (mut f32)))
  ;; CHECK:      (type $f64s (array (mut f64)))
  (type $f64s (array (mut f64)))

  ;; Three small i32s: 3 one-byte constants fit easily in less than the 12 bytes
  ;; of the segment.
  (data $small-i32 "\01\00\00\00\02\00\00\00\03\00\00\00")

  ;; Three large i32s: the constants need 5 bytes each, and the segment is as
  ;; good as the constants. We still convert, as a tie removes the segment.
  (data $large-i32 "\ff\ff\ff\7f\00\00\00\80\ff\ff\ff\7f")

  ;; Four large i32s: now the constants are more than the segment.

  ;; CHECK:      (type $7 (func (result (ref $i8s))))

  ;; CHECK:      (type $8 (func (result (ref $i16s))))

  ;; CHECK:      (type $9 (func (result (ref $i64s))))

  ;; CHECK:      (type $10 (func (result (ref $f32s))))

  ;; CHECK:      (type $11 (func (result (ref $f64s))))

  ;; CHECK:      (type $12 (func (result (ref $i32s) (ref $i32s))))

  ;; CHECK:      (type $13 (func (param i32) (result (ref $i32s))))

  ;; CHECK:      (type $14 (func (param (ref $i32s)) (result (ref $i32s))))

  ;; CHECK:      (data $four-large-i32 "\ff\ff\ff\7f\00\00\00\80\ff\ff\ff\7f\00\00\00\80")
  (data $four-large-i32 "\ff\ff\ff\7f\00\00\00\80\ff\ff\ff\7f\00\00\00\80")

  ;; Packed i8 values. 0xff is read as -1, which is a single LEB byte.
  (data $i8 "\01\ff\40\c0")

  ;; Packed i16 values.
  (data $i16 "\01\00\ff\ff\00\80")

  ;; i64 values.
  (data $i64 "\01\00\00\00\00\00\00\00\ff\ff\ff\ff\ff\ff\ff\ff")

  ;; f32 values: 1.0 and -2.5
  (data $f32 "\00\00\80\3f\00\00\20\c0")

  ;; f64 values: 1.0 and a NaN with a payload, which must be preserved.
  (data $f64 "\00\00\00\00\00\00\f0\3f\01\00\00\00\00\00\f8\7f")

  ;; A segment used by two array.new_data instructions: both are converted if
  ;; the total is still smaller.
  (data $shared "\01\00\00\00\02\00\00\00\03\00\00\00")

  ;; A segment used partially: only the read range is decoded, but the whole
  ;; segment goes away.
  (data $partial "\01\00\00\00\02\00\00\00\03\00\00\00\04\00\00\00\05\00\00\00\06\00\00\00\07\00\00\00\08\00\00\00")

  ;; A segment with a non-constant offset cannot be converted.
  ;; CHECK:      (data $nonconst "\01\00\00\00\02\00\00\00\03\00\00\00")
  (data $nonconst "\01\00\00\00\02\00\00\00\03\00\00\00")

  ;; A segment that is read out of bounds would trap, and is left alone.
  ;; CHECK:      (data $oob "\01\00\00\00\02\00\00\00")
  (data $oob "\01\00\00\00\02\00\00\00")

  ;; A segment that is also dropped is left alone, as the array.new_data could
  ;; trap.
  ;; CHECK:      (data $dropped "\01\00\00\00\02\00\00\00\03\00\00\00")
  (data $dropped "\01\00\00\00\02\00\00\00\03\00\00\00")

  ;; A segment that is also used by array.init_data must stay.
  ;; CHECK:      (data $init "\01\00\00\00\02\00\00\00\03\00\00\00")
  (data $init "\01\00\00\00\02\00\00\00\03\00\00\00")

  ;; An unused segment is not touched (RemoveUnusedModuleElements handles it).
  ;; CHECK:      (data $unused "\01\00\00\00")
  (data $unused "\01\00\00\00")

  ;; CHECK:      (func $small-i32 (type $1) (result (ref $i32s))
  ;; CHECK-NEXT:  (array.new_fixed $i32s 3
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:   (i32.const 3)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $small-i32 (result (ref $i32s))
    (array.new_data $i32s $small-i32
      (i32.const 0)
      (i32.const 3)
    )
  )

  ;; CHECK:      (func $large-i32 (type $1) (result (ref $i32s))
  ;; CHECK-NEXT:  (array.new_fixed $i32s 3
  ;; CHECK-NEXT:   (i32.const 2147483647)
  ;; CHECK-NEXT:   (i32.const -2147483648)
  ;; CHECK-NEXT:   (i32.const 2147483647)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $large-i32 (result (ref $i32s))
    (array.new_data $i32s $large-i32
      (i32.const 0)
      (i32.const 3)
    )
  )

  ;; CHECK:      (func $four-large-i32 (type $1) (result (ref $i32s))
  ;; CHECK-NEXT:  (array.new_data $i32s $four-large-i32
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (i32.const 4)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $four-large-i32 (result (ref $i32s))
    (array.new_data $i32s $four-large-i32
      (i32.const 0)
      (i32.const 4)
    )
  )

  ;; CHECK:      (func $i8 (type $7) (result (ref $i8s))
  ;; CHECK-NEXT:  (array.new_fixed $i8s 4
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (i32.const -1)
  ;; CHECK-NEXT:   (i32.const 64)
  ;; CHECK-NEXT:   (i32.const -64)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $i8 (result (ref $i8s))
    (array.new_data $i8s $i8
      (i32.const 0)
      (i32.const 4)
    )
  )

  ;; CHECK:      (func $i16 (type $8) (result (ref $i16s))
  ;; CHECK-NEXT:  (array.new_fixed $i16s 3
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (i32.const -1)
  ;; CHECK-NEXT:   (i32.const -32768)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $i16 (result (ref $i16s))
    (array.new_data $i16s $i16
      (i32.const 0)
      (i32.const 3)
    )
  )

  ;; CHECK:      (func $i64 (type $9) (result (ref $i64s))
  ;; CHECK-NEXT:  (array.new_fixed $i64s 2
  ;; CHECK-NEXT:   (i64.const 1)
  ;; CHECK-NEXT:   (i64.const -1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $i64 (result (ref $i64s))
    (array.new_data $i64s $i64
      (i32.const 0)
      (i32.const 2)
    )
  )

  ;; CHECK:      (func $f32 (type $10) (result (ref $f32s))
  ;; CHECK-NEXT:  (array.new_fixed $f32s 2
  ;; CHECK-NEXT:   (f32.const 1)
  ;; CHECK-NEXT:   (f32.const -2.5)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $f32 (result (ref $f32s))
    (array.new_data $f32s $f32
      (i32.const 0)
      (i32.const 2)
    )
  )

  ;; CHECK:      (func $f64 (type $11) (result (ref $f64s))
  ;; CHECK-NEXT:  (array.new_fixed $f64s 2
  ;; CHECK-NEXT:   (f64.const 1)
  ;; CHECK-NEXT:   (f64.const nan:0x8000000000001)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $f64 (result (ref $f64s))
    (array.new_data $f64s $f64
      (i32.const 0)
      (i32.const 2)
    )
  )

  ;; CHECK:      (func $shared (type $12) (result (ref $i32s) (ref $i32s))
  ;; CHECK-NEXT:  (tuple.make 2
  ;; CHECK-NEXT:   (array.new_fixed $i32s 3
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:    (i32.const 2)
  ;; CHECK-NEXT:    (i32.const 3)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (array.new_fixed $i32s 2
  ;; CHECK-NEXT:    (i32.const 2)
  ;; CHECK-NEXT:    (i32.const 3)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $shared (result (ref $i32s) (ref $i32s))
    (tuple.make 2
      (array.new_data $i32s $shared
        (i32.const 0)
        (i32.const 3)
      )
      (array.new_data $i32s $shared
        (i32.const 4)
        (i32.const 2)
      )
    )
  )

  ;; CHECK:      (func $partial (type $1) (result (ref $i32s))
  ;; CHECK-NEXT:  (array.new_fixed $i32s 2
  ;; CHECK-NEXT:   (i32.const 3)
  ;; CHECK-NEXT:   (i32.const 4)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $partial (result (ref $i32s))
    (array.new_data $i32s $partial
      (i32.const 8)
      (i32.const 2)
    )
  )

  ;; CHECK:      (func $nonconst (type $13) (param $x i32) (result (ref $i32s))
  ;; CHECK-NEXT:  (array.new_data $i32s $nonconst
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $nonconst (param $x i32) (result (ref $i32s))
    (array.new_data $i32s $nonconst
      (local.get $x)
      (i32.const 1)
    )
  )

  ;; CHECK:      (func $oob (type $1) (result (ref $i32s))
  ;; CHECK-NEXT:  (array.new_data $i32s $oob
  ;; CHECK-NEXT:   (i32.const 4)
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $oob (result (ref $i32s))
    (array.new_data $i32s $oob
      (i32.const 4)
      (i32.const 2)
    )
  )

  ;; CHECK:      (func $dropped (type $1) (result (ref $i32s))
  ;; CHECK-NEXT:  (data.drop $dropped)
  ;; CHECK-NEXT:  (array.new_data $i32s $dropped
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (i32.const 3)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $dropped (result (ref $i32s))
    (data.drop $dropped)
    (array.new_data $i32s $dropped
      (i32.const 0)
      (i32.const 3)
    )
  )

  ;; CHECK:      (func $init (type $14) (param $arr (ref $i32s)) (result (ref $i32s))
  ;; CHECK-NEXT:  (array.init_data $i32s $init
  ;; CHECK-NEXT:   (local.get $arr)
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (i32.const 3)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (array.new_data $i32s $init
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (i32.const 3)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $init (param $arr (ref $i32s)) (result (ref $i32s))
    (array.init_data $i32s $init
      (local.get $arr)
      (i32.const 0)
      (i32.const 0)
      (i32.const 3)
    )
    (array.new_data $i32s $init
      (i32.const 0)
      (i32.const 3)
    )
  )
)

;; A module with a memory and an active segment: array.new_data on an active
;; segment is not converted, but the passive one still is.
(module
  ;; CHECK:      (type $i32s (array (mut i32)))
  (type $i32s (array (mut i32)))

  ;; CHECK:      (type $1 (func (result (ref $i32s))))

  ;; CHECK:      (memory $mem 1 1)
  (memory $mem 1 1)

  ;; CHECK:      (data $active (i32.const 0) "\01\00\00\00\02\00\00\00")
  (data $active (i32.const 0) "\01\00\00\00\02\00\00\00")

  (data $passive "\01\00\00\00\02\00\00\00")

  ;; CHECK:      (func $active (type $1) (result (ref $i32s))
  ;; CHECK-NEXT:  (array.new_data $i32s $active
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:   (i32.const 0)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $active (result (ref $i32s))
    (array.new_data $i32s $active
      (i32.const 0)
      (i32.const 0)
    )
  )

  ;; CHECK:      (func $passive (type $1) (result (ref $i32s))
  ;; CHECK-NEXT:  (array.new_fixed $i32s 2
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $passive (result (ref $i32s))
    (array.new_data $i32s $passive
      (i32.const 0)
      (i32.const 2)
    )
  )
)
