  ;; CHECK-NEXT:     (struct.get $PermPadTarget 2
  ;; CHECK-NEXT:      (local.get $ppt)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (i32.wrap_i64
  ;; CHECK-NEXT:      (struct.get $PermPadTarget 3
  ;; CHECK-NEXT:       (local.get $ppt)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (i32.add
  ;; CHECK-NEXT:     (i32.wrap_i64
  ;; CHECK-NEXT:      (struct.get $PermPadShort 3
  ;; CHECK-NEXT:       (local.get $pps)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (struct.get $SubA 1
  ;; CHECK-NEXT:      (ref.cast (ref null $SubA)
  ;; CHECK-NEXT:       (struct.get $PermPadShort 1
  ;; CHECK-NEXT:        (local.get $pps)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $entry9 (param $x i32) (result i32)
    (local $ma (ref null $MixRootA))
    (local $mb (ref null $MixRootB))
    (local $ppt (ref null $PermPadTarget))
    (local $pps (ref null $PermPadShort))
    (local.set $ma
      (struct.new $MixRootA
        (local.get $x)
        (struct.new $SubA
          (local.get $x)
          (i32.const 1)
        )
        (struct.new $SubB
          (local.get $x)
          (i64.const 2)
        )
      )
    )
    (local.set $mb
      (struct.new $MixRootB
        (local.get $x)
        (struct.new $SubB
          (local.get $x)
          (i64.const 3)
        )
        (struct.new $Rootless
          (i32.const 4)
        )
      )
    )
    (local.set $ppt
      (struct.new $PermPadTarget
        (local.get $x)
        (ref.null none)
        (i32.const 5)
        (i64.const 6)
      )
    )
    (local.set $pps
      (struct.new $PermPadShort
        (local.get $x)
        (i64.const 7)
        (struct.new $SubA
          (local.get $x)
          (i32.const 8)
        )
      )
    )
    (i32.add
      (i32.add
        (i32.add
          (struct.get $SubA 1
            (struct.get $MixRootA 1
              (local.get $ma)
            )
          )
          (struct.get $ValBase 0
            (struct.get $MixRootA 2
              (local.get $ma)
            )
          )
        )
        (i32.add
          (struct.get $ValBase 0
            (struct.get $MixRootB 1
              (local.get $mb)
            )
          )
          (struct.get $Rootless 0
            (struct.get $MixRootB 2
              (local.get $mb)
            )
          )
        )
      )
      (i32.add
        (i32.add
          (struct.get $PermPadTarget 2
            (local.get $ppt)
          )
          (i32.wrap_i64
            (struct.get $PermPadTarget 3
              (local.get $ppt)
            )
          )
        )
        (i32.add
          (i32.wrap_i64
            (struct.get $PermPadShort 1
              (local.get $pps)
            )
          )
          (struct.get $SubA 1
            (struct.get $PermPadShort 2
              (local.get $pps)
            )
          )
        )
      )
    )
  )
)
