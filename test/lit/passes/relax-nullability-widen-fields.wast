  ;; CHECK-NEXT:       (struct.get $MixRootA 2
  ;; CHECK-NEXT:        (local.get $ma)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (struct.get $ValBase 0
  ;; CHECK-NEXT:      (struct.get $MixRootA 1
  ;; CHECK-NEXT:       (local.get $ma)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (i32.add
  ;; CHECK-NEXT:     (struct.get $ValBase 0
  ;; CHECK-NEXT:      (struct.get $MixRootB 1
  ;; CHECK-NEXT:       (local.get $mb)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
