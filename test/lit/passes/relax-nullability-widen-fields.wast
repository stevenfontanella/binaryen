;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: foreach %s %t wasm-opt -all --closed-world --traps-never-happen --pass-arg=relax-nullability-widen-fields --relax-nullability -S -o - | filecheck %s

(module
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $Base (sub (struct (field i32))))
    (type $Base (sub (struct (field i32))))
    ;; CHECK:       (type $Holder (struct (field (ref null $Base))))

    ;; CHECK:       (type $2 (func (param (ref null $Base) i32) (result i32)))

    ;; CHECK:       (type $SubArr (array (ref null $Sub)))

    ;; CHECK:       (type $BaseArr (array (ref null $Base)))

    ;; CHECK:       (type $Sub (sub $Base (struct (field i32) (field i64))))
    (type $Sub (sub $Base (struct (field i32) (field i64))))
    ;; Private struct field 0 is only read via field 0 of $Base, so it widens
    ;; from (ref $Sub) to (ref null $Base) and the ref.cast on struct.new is
    ;; stripped.
    (type $Holder (struct (field (ref $Sub))))
    (type $BaseArr (array (ref null $Base)))
    ;; Private immutable array type $SubArr is shared by $sub-arr (read as $Base)
    ;; and $sub-arr-narrow (read as $Sub), so $SubArr relaxes nullability to
    ;; (ref null $Sub) while $sub-arr retargets to $BaseArr.
    (type $SubArr (array (ref $Sub)))
  )

  ;; CHECK:      (type $6 (func (param i32) (result i32)))

  ;; CHECK:      (global $b1 (ref $Sub) (struct.new $Sub
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT:  (i64.const 2)
  ;; CHECK-NEXT: ))
  (global $b1 (ref $Sub) (struct.new $Sub (i32.const 1) (i64.const 2)))

  ;; CHECK:      (global $base-arr (ref $BaseArr) (array.new_fixed $BaseArr 1
  ;; CHECK-NEXT:  (global.get $b1)
  ;; CHECK-NEXT: ))
  (global $base-arr (ref $BaseArr) (array.new_fixed $BaseArr 1 (global.get $b1)))

  ;; CHECK:      (global $sub-arr (ref $BaseArr) (array.new_fixed $BaseArr 1
  ;; CHECK-NEXT:  (global.get $b1)
  ;; CHECK-NEXT: ))
  (global $sub-arr (ref $SubArr) (array.new_fixed $SubArr 1 (global.get $b1)))

  ;; CHECK:      (global $sub-arr-narrow (ref $SubArr) (array.new_fixed $SubArr 1
  ;; CHECK-NEXT:  (global.get $b1)
  ;; CHECK-NEXT: ))
  (global $sub-arr-narrow (ref $SubArr) (array.new_fixed $SubArr 1 (global.get $b1)))

  ;; CHECK:      (export "entry" (func $entry))

  ;; CHECK:      (func $make-and-read (type $2) (param $x (ref null $Base)) (param $i i32) (result i32)
  ;; CHECK-NEXT:  (local $h (ref null $Holder))
  ;; CHECK-NEXT:  (local.set $h
  ;; CHECK-NEXT:   (struct.new $Holder
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (i32.add
  ;; CHECK-NEXT:    (struct.get $Base 0
  ;; CHECK-NEXT:     (struct.get $Holder 0
  ;; CHECK-NEXT:      (local.get $h)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (struct.get $Base 0
  ;; CHECK-NEXT:     (array.get $BaseArr
  ;; CHECK-NEXT:      (global.get $sub-arr)
  ;; CHECK-NEXT:      (local.get $i)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (i32.add
  ;; CHECK-NEXT:    (struct.get $Base 0
  ;; CHECK-NEXT:     (array.get $BaseArr
  ;; CHECK-NEXT:      (global.get $base-arr)
  ;; CHECK-NEXT:      (local.get $i)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (i32.wrap_i64
  ;; CHECK-NEXT:     (struct.get $Sub 1
  ;; CHECK-NEXT:      (array.get $SubArr
  ;; CHECK-NEXT:       (global.get $sub-arr-narrow)
  ;; CHECK-NEXT:       (local.get $i)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $make-and-read (param $x (ref null $Base)) (param $i i32) (result i32)
    (local $h (ref $Holder))
    (local.set $h
      (struct.new $Holder
        (ref.cast (ref $Sub)
          (local.get $x)
        )
      )
    )
    (i32.add
      (i32.add
        (struct.get $Base 0
          (struct.get $Holder 0
            (local.get $h)
          )
        )
        (struct.get $Base 0
          (array.get $SubArr
            (global.get $sub-arr)
            (local.get $i)
          )
        )
      )
      (i32.add
        (struct.get $Base 0
          (array.get $BaseArr
            (global.get $base-arr)
            (local.get $i)
          )
        )
        (i32.wrap_i64
          (struct.get $Sub 1
            (array.get $SubArr
              (global.get $sub-arr-narrow)
              (local.get $i)
            )
          )
        )
      )
    )
  )

  ;; CHECK:      (func $entry (type $6) (param $i i32) (result i32)
  ;; CHECK-NEXT:  (call $make-and-read
  ;; CHECK-NEXT:   (global.get $b1)
  ;; CHECK-NEXT:   (local.get $i)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $entry (export "entry") (param $i i32) (result i32)
    (call $make-and-read
      (global.get $b1)
      (local.get $i)
    )
  )
)

(module
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $ObjRoot (sub (struct (field anyref))))

    ;; CHECK:       (type $Payload (struct (field i32)))

    ;; CHECK:       (type $MutualB (struct (field (mut (ref null $Payload)))))

    ;; CHECK:       (type $MutualA (struct (field (ref null $Payload))))

    ;; CHECK:       (type $SelfCopy (struct (field (mut (ref null $Payload)))))

    ;; CHECK:       (type $5 (func (param (ref null $SelfCopy) (ref null $MutualA) (ref null $MutualB)) (result i32)))

    ;; CHECK:       (type $VtRoot (sub (struct (field anyref))))
    (type $VtRoot (sub (struct (field structref))))
    (type $VtNull (sub $VtRoot (struct (field nullref))))
    (type $VtSub1 (sub $VtRoot (struct (field (ref $VtRoot)))))
    (type $VtSub2 (sub $VtSub1 (struct (field (ref $VtSub1)))))
    (type $ObjRoot (sub (struct (field (ref null $VtRoot)))))
    ;; $ObjSub1 has no direct struct.get on field 0, so its field 0 widens to
    ;; (ref null $VtRoot) even though sibling $ObjSub2 has a narrow struct.get.
    ;; CHECK:       (type $ObjSub2 (sub $ObjRoot (struct (field (ref null $VtRoot)))))

    ;; CHECK:       (type $ObjSub1 (sub $ObjRoot (struct (field anyref))))
    (type $ObjSub1 (sub $ObjRoot (struct (field (ref $VtSub1)))))
    (type $ObjSub2 (sub $ObjRoot (struct (field (ref $VtSub2)))))
  )

  ;; CHECK:       (type $9 (func (param (ref null $ObjRoot) (ref null $ObjSub2) (ref null $VtRoot)) (result (ref null $VtRoot))))

  ;; CHECK:      (type $10 (func))

  ;; CHECK:      (export "entry2" (func $entry2))

  ;; CHECK:      (func $use-covariant (type $9) (param $o1 (ref null $ObjRoot)) (param $o2 (ref null $ObjSub2)) (param $vn (ref null $VtRoot)) (result (ref null $VtRoot))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (struct.get $ObjRoot 0
  ;; CHECK-NEXT:    (local.get $o1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (local.get $vn)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (struct.get $ObjSub2 0
  ;; CHECK-NEXT:   (local.get $o2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $use-covariant (param $o1 (ref null $ObjSub1)) (param $o2 (ref null $ObjSub2)) (param $vn (ref null $VtNull)) (result (ref null $VtSub1))
    (drop
      (struct.get $ObjRoot 0
        (local.get $o1)
      )
    )
    (drop
      (local.get $vn)
    )
    (struct.get $ObjSub2 0
      (local.get $o2)
    )
  )

  ;; CHECK:      (func $entry2 (type $10)
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $use-covariant
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $copy-fields
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:    (ref.null none)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $entry2 (export "entry2")
    (drop
      (call $use-covariant
        (ref.null none)
        (ref.null none)
        (ref.null none)
      )
    )
    (drop
      (call $copy-fields
        (ref.null none)
        (ref.null none)
        (ref.null none)
      )
    )
  )

  ;; Self-copy and mutual-copy non-nullable fields relax to nullable when no
  ;; external consumer requires non-null.
  (rec
    (type $Payload (struct (field i32)))
    (type $SelfCopy (struct (field (mut (ref $Payload)))))
    (type $MutualA (struct (field (ref $Payload))))
    (type $MutualB (struct (field (mut (ref $Payload)))))
  )

  ;; CHECK:      (func $copy-fields (type $5) (param $s (ref null $SelfCopy)) (param $a (ref null $MutualA)) (param $b (ref null $MutualB)) (result i32)
  ;; CHECK-NEXT:  (struct.set $SelfCopy 0
  ;; CHECK-NEXT:   (local.get $s)
  ;; CHECK-NEXT:   (struct.get $SelfCopy 0
  ;; CHECK-NEXT:    (local.get $s)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (struct.set $MutualB 0
  ;; CHECK-NEXT:   (local.get $b)
  ;; CHECK-NEXT:   (struct.get $MutualA 0
  ;; CHECK-NEXT:    (local.get $a)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (struct.new $MutualA
  ;; CHECK-NEXT:    (struct.get $MutualB 0
  ;; CHECK-NEXT:     (local.get $b)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (struct.get $Payload 0
  ;; CHECK-NEXT:   (struct.get $SelfCopy 0
  ;; CHECK-NEXT:    (local.get $s)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $copy-fields (param $s (ref null $SelfCopy)) (param $a (ref null $MutualA)) (param $b (ref null $MutualB)) (result i32)
    (struct.set $SelfCopy 0
      (local.get $s)
      (struct.get $SelfCopy 0
        (local.get $s)
      )
    )
    (struct.set $MutualB 0
      (local.get $b)
      (struct.get $MutualA 0
        (local.get $a)
      )
    )
    (drop
      (struct.new $MutualA
        (struct.get $MutualB 0
          (local.get $b)
        )
      )
    )
    (struct.get $Payload 0
      (struct.get $SelfCopy 0
        (local.get $s)
      )
    )
  )
)

(module
  ;; Private immutable reference array types unify with an existing non-subtyped
  ;; mutable reference array type of the same target element type, and coupled
  ;; sole-use DGA cache array factory functions generalize their return type so
  ;; the cache array global retargets to the canonical mutable root array type.
  (rec
    ;; CHECK:      (rec
    ;; CHECK-NEXT:  (type $Root (sub (struct (field i32))))
    (type $Root (sub (struct (field i32))))
    ;; CHECK:       (type $1 (func (param i32) (result (ref null $Root))))

    ;; CHECK:       (type $RootMutArr (array (mut (ref null $Root))))

    ;; CHECK:       (type $Child (sub $Root (struct (field i32) (field i64))))
    (type $Child (sub $Root (struct (field i32) (field i64))))
    (type $RootMutArr (array (mut (ref null $Root))))
    (type $RootImmArr (array (ref null $Root)))
    (type $ChildCacheArr (array (mut (ref null $Child))))
  )

  ;; CHECK:      (type $4 (func (param i32) (result i32)))

  ;; CHECK:      (global $c1 (ref $Child) (struct.new $Child
  ;; CHECK-NEXT:  (i32.const 7)
  ;; CHECK-NEXT:  (i64.const 8)
  ;; CHECK-NEXT: ))
  (global $c1 (ref $Child) (struct.new $Child (i32.const 7) (i64.const 8)))
  ;; CHECK:      (global $mut-root (ref $RootMutArr) (array.new_default $RootMutArr
  ;; CHECK-NEXT:  (i32.const 2)
  ;; CHECK-NEXT: ))
  (global $mut-root (ref $RootMutArr) (array.new_default $RootMutArr (i32.const 2)))
  ;; CHECK:      (global $imm-root (ref $RootMutArr) (array.new_fixed $RootMutArr 1
  ;; CHECK-NEXT:  (global.get $c1)
  ;; CHECK-NEXT: ))
  (global $imm-root (ref $RootImmArr) (array.new_fixed $RootImmArr 1 (global.get $c1)))
  ;; CHECK:      (global $dga-cache (ref $RootMutArr) (array.new_default $RootMutArr
  ;; CHECK-NEXT:  (i32.const 4)
  ;; CHECK-NEXT: ))
  (global $dga-cache (ref $ChildCacheArr) (array.new_default $ChildCacheArr (i32.const 4)))

  ;; CHECK:      (export "entry3" (func $entry3))

  ;; CHECK:      (func $get-cached (type $1) (param $idx i32) (result (ref null $Root))
  ;; CHECK-NEXT:  (local $v (ref null $Root))
  ;; CHECK-NEXT:  (block $found (result (ref $Root))
  ;; CHECK-NEXT:   (br_on_non_null $found
  ;; CHECK-NEXT:    (array.get $RootMutArr
  ;; CHECK-NEXT:     (global.get $dga-cache)
  ;; CHECK-NEXT:     (local.get $idx)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (local.set $v
  ;; CHECK-NEXT:    (array.get $RootMutArr
  ;; CHECK-NEXT:     (global.get $mut-root)
  ;; CHECK-NEXT:     (local.get $idx)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (array.set $RootMutArr
  ;; CHECK-NEXT:    (global.get $dga-cache)
  ;; CHECK-NEXT:    (local.get $idx)
  ;; CHECK-NEXT:    (local.get $v)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (return
  ;; CHECK-NEXT:    (local.get $v)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $get-cached (param $idx i32) (result (ref null $Child))
    (local $v (ref null $Child))
    (block $found (result (ref $Child))
      (br_on_non_null $found
        (array.get $ChildCacheArr
          (global.get $dga-cache)
          (local.get $idx)
        )
      )
      (local.set $v
        (ref.cast (ref null $Child)
          (array.get $RootMutArr
            (global.get $mut-root)
            (local.get $idx)
          )
        )
      )
      (array.set $ChildCacheArr
        (global.get $dga-cache)
        (local.get $idx)
        (local.get $v)
      )
      (return
        (local.get $v)
      )
    )
  )

  ;; CHECK:      (func $entry3 (type $4) (param $i i32) (result i32)
  ;; CHECK-NEXT:  (i32.add
  ;; CHECK-NEXT:   (i32.add
  ;; CHECK-NEXT:    (struct.get $Root 0
  ;; CHECK-NEXT:     (array.get $RootMutArr
  ;; CHECK-NEXT:      (global.get $imm-root)
  ;; CHECK-NEXT:      (local.get $i)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (struct.get $Root 0
  ;; CHECK-NEXT:     (array.get $RootMutArr
  ;; CHECK-NEXT:      (global.get $mut-root)
  ;; CHECK-NEXT:      (local.get $i)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (i32.add
  ;; CHECK-NEXT:    (struct.get $Root 0
  ;; CHECK-NEXT:     (call $get-cached
  ;; CHECK-NEXT:      (local.get $i)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:    (i32.wrap_i64
  ;; CHECK-NEXT:     (struct.get $Child 1
  ;; CHECK-NEXT:      (ref.cast (ref null $Child)
  ;; CHECK-NEXT:       (call $get-cached
  ;; CHECK-NEXT:        (local.get $i)
  ;; CHECK-NEXT:       )
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $entry3 (export "entry3") (param $i i32) (result i32)
    (i32.add
      (i32.add
        (struct.get $Root 0
          (array.get $RootImmArr
            (global.get $imm-root)
            (local.get $i)
          )
        )
        (struct.get $Root 0
          (array.get $RootMutArr
            (global.get $mut-root)
            (local.get $i)
          )
        )
      )
      (i32.add
        (struct.get $Root 0
          (call $get-cached
            (local.get $i)
          )
        )
        (i32.wrap_i64
          (struct.get $Child 1
            (call $get-cached
              (local.get $i)
            )
          )
        )
      )
    )
  )
)
