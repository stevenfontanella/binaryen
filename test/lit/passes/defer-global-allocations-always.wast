;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.

;; RUN: foreach %s %t wasm-opt --defer-global-allocations -all -S -o - \
;; RUN:   --pass-arg=defer-global-allocations-always@1 | filecheck %s

;; With the size model disabled, every candidate is deferred.

;; An enum-like group has two varying i32 columns; the first operand is fixed.
(module
  ;; CHECK:      (type $vt (struct (field i32)))
  (type $vt (struct (field i32)))
  ;; CHECK:      (type $enum (struct (field (ref $vt)) (field i32) (field i8)))
  (type $enum (struct (field (ref $vt)) (field i32) (field i8)))

  ;; CHECK:      (type $2 (array (mut (ref null $enum))))

  ;; CHECK:      (type $3 (array i32))

  ;; CHECK:      (type $4 (array i8))

  ;; CHECK:      (type $5 (func (param i32) (result (ref $enum))))

  ;; CHECK:      (global $vt (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT: ))
  (global $vt (ref $vt) (struct.new $vt (i32.const 1)))

  (global $e0 (ref $enum) (struct.new $enum (global.get $vt) (i32.const 0) (i32.const 100)))
  (global $e1 (ref $enum) (struct.new $enum (global.get $vt) (i32.const 1) (i32.const 200)))
  (global $e2 (ref $enum) (struct.new $enum (global.get $vt) (i32.const 2) (i32.const 300)))

  ;; CHECK:      (global $defer$enum$cache (ref $2) (array.new_default $2
  ;; CHECK-NEXT:  (i32.const 3)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (global $defer$enum$table$1 (ref $3) (array.new_fixed $3 3
  ;; CHECK-NEXT:  (i32.const 2)
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (global $defer$enum$table$2 (ref $4) (array.new_fixed $4 3
  ;; CHECK-NEXT:  (i32.const 300)
  ;; CHECK-NEXT:  (i32.const 200)
  ;; CHECK-NEXT:  (i32.const 100)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (export "enums" (func $enums))

  ;; CHECK:      (func $enums (type $5) (param $i i32) (result (ref $enum))
  ;; CHECK-NEXT:  (if (result (ref $enum))
  ;; CHECK-NEXT:   (local.get $i)
  ;; CHECK-NEXT:   (then
  ;; CHECK-NEXT:    (call $defer$enum
  ;; CHECK-NEXT:     (i32.const 0)
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:   (else
  ;; CHECK-NEXT:    (if (result (ref $enum))
  ;; CHECK-NEXT:     (i32.eq
  ;; CHECK-NEXT:      (local.get $i)
  ;; CHECK-NEXT:      (i32.const 2)
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (then
  ;; CHECK-NEXT:      (call $defer$enum
  ;; CHECK-NEXT:       (i32.const 1)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:     (else
  ;; CHECK-NEXT:      (call $defer$enum
  ;; CHECK-NEXT:       (i32.const 2)
  ;; CHECK-NEXT:      )
  ;; CHECK-NEXT:     )
  ;; CHECK-NEXT:    )
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $enums (export "enums") (param $i i32) (result (ref $enum))
    (if (result (ref $enum))
      (local.get $i)
      (then
        (global.get $e2)
      )
      (else
        (if (result (ref $enum))
          (i32.eq (local.get $i) (i32.const 2))
          (then
            (global.get $e1)
          )
          (else
            (global.get $e0)
          )
        )
      )
    )
  )
)

;; Globals that are only used as struct.new operands (vtables) are not
;; deferred by default.
;; CHECK:      (func $defer$enum (type $5) (param $0 i32) (result (ref $enum))
;; CHECK-NEXT:  (local $1 (ref $enum))
;; CHECK-NEXT:  (block $cached (result (ref $enum))
;; CHECK-NEXT:   (br_on_non_null $cached
;; CHECK-NEXT:    (array.get $2
;; CHECK-NEXT:     (global.get $defer$enum$cache)
;; CHECK-NEXT:     (local.get $0)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (array.set $2
;; CHECK-NEXT:    (global.get $defer$enum$cache)
;; CHECK-NEXT:    (local.get $0)
;; CHECK-NEXT:    (local.tee $1
;; CHECK-NEXT:     (struct.new $enum
;; CHECK-NEXT:      (global.get $vt)
;; CHECK-NEXT:      (array.get $3
;; CHECK-NEXT:       (global.get $defer$enum$table$1)
;; CHECK-NEXT:       (local.get $0)
;; CHECK-NEXT:      )
;; CHECK-NEXT:      (array.get_u $4
;; CHECK-NEXT:       (global.get $defer$enum$table$2)
;; CHECK-NEXT:       (local.get $0)
;; CHECK-NEXT:      )
;; CHECK-NEXT:     )
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (local.get $1)
;; CHECK-NEXT:  )
;; CHECK-NEXT: )
(module
  ;; CHECK:      (type $vt (struct (field i32) (field i32)))
  (type $vt (struct (field i32) (field i32)))
  ;; CHECK:      (type $obj (struct (field (ref $vt)) (field i32)))
  (type $obj (struct (field (ref $vt)) (field i32)))

  ;; CHECK:      (type $2 (func (param i32) (result (ref $obj))))

  ;; CHECK:      (global $vt0 (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (i32.const 0)
  ;; CHECK-NEXT:  (i32.const 10)
  ;; CHECK-NEXT: ))
  (global $vt0 (ref $vt) (struct.new $vt (i32.const 0) (i32.const 10)))
  ;; CHECK:      (global $vt1 (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (i32.const 1)
  ;; CHECK-NEXT:  (i32.const 11)
  ;; CHECK-NEXT: ))
  (global $vt1 (ref $vt) (struct.new $vt (i32.const 1) (i32.const 11)))

  ;; CHECK:      (export "new" (func $new))

  ;; CHECK:      (func $new (type $2) (param $x i32) (result (ref $obj))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (struct.new $obj
  ;; CHECK-NEXT:    (global.get $vt0)
  ;; CHECK-NEXT:    (local.get $x)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (struct.new $obj
  ;; CHECK-NEXT:   (global.get $vt1)
  ;; CHECK-NEXT:   (local.get $x)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $new (export "new") (param $x i32) (result (ref $obj))
    (drop (struct.new $obj (global.get $vt0) (local.get $x)))
    (struct.new $obj (global.get $vt1) (local.get $x))
  )
)

;; Operands that are not constant (a nested struct.new with operands) or a
;; global whose type is not exactly the struct.new's type keep the global
;; eager. ref.func, ref.null, ref.i31 and struct.new_default
;; operands are fine.
(module
  ;; CHECK:      (type $pair (struct (field i32) (field i32)))

  ;; CHECK:      (type $vt (struct (field i32)))
  (type $vt (struct (field i32)))
  (type $pair (struct (field i32) (field i32)))
  ;; CHECK:      (type $obj (struct (field (ref $vt)) (field funcref) (field (ref null $pair)) (field i31ref)))
  (type $obj (struct (field (ref $vt)) (field funcref) (field (ref null $pair)) (field i31ref)))

  ;; CHECK:      (type $3 (array (mut (ref null $obj))))

  ;; CHECK:      (type $4 (array funcref))

  ;; CHECK:      (type $5 (array (ref null $pair)))

  ;; CHECK:      (type $6 (array i31ref))

  ;; CHECK:      (type $7 (func (result (ref $obj))))

  ;; CHECK:      (type $8 (func (param i32) (result (ref $obj))))

  ;; CHECK:      (global $vt (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (i32.const 42)
  ;; CHECK-NEXT: ))
  (global $vt (ref $vt) (struct.new $vt (i32.const 42)))

  (global $o0 (ref $obj) (struct.new $obj
    (global.get $vt)
    (ref.func $use)
    (ref.null none)
    (ref.i31 (i32.const 1))
  ))
  (global $o1 (ref $obj) (struct.new $obj
    (global.get $vt)
    (ref.null func)
    (struct.new_default $pair)
    (ref.i31 (i32.const 2))
  ))
  ;; CHECK:      (global $nested (ref $obj) (struct.new $obj
  ;; CHECK-NEXT:  (global.get $vt)
  ;; CHECK-NEXT:  (ref.null nofunc)
  ;; CHECK-NEXT:  (struct.new $pair
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT: ))
  (global $nested (ref $obj) (struct.new $obj
    (global.get $vt)
    (ref.null func)
    (struct.new $pair (i32.const 1) (i32.const 2))
    (ref.null i31)
  ))
  ;; CHECK:      (global $supertype (ref any) (struct.new $obj
  ;; CHECK-NEXT:  (global.get $vt)
  ;; CHECK-NEXT:  (ref.null nofunc)
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT: ))
  (global $supertype (ref any) (struct.new $obj
    (global.get $vt)
    (ref.null func)
    (ref.null none)
    (ref.null i31)
  ))

  ;; CHECK:      (global $defer$obj$cache (ref $3) (array.new_default $3
  ;; CHECK-NEXT:  (i32.const 2)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (global $defer$obj$table$1 (ref $4) (array.new_fixed $4 2
  ;; CHECK-NEXT:  (ref.func $use)
  ;; CHECK-NEXT:  (ref.null nofunc)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (global $defer$obj$table$2 (ref $5) (array.new_fixed $5 2
  ;; CHECK-NEXT:  (ref.null none)
  ;; CHECK-NEXT:  (struct.new_default $pair)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (global $defer$obj$table$3 (ref $6) (array.new_fixed $6 2
  ;; CHECK-NEXT:  (ref.i31
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (ref.i31
  ;; CHECK-NEXT:   (i32.const 2)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: ))

  ;; CHECK:      (export "use" (func $use))

  ;; CHECK:      (func $use (type $7) (result (ref $obj))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$obj
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$obj
  ;; CHECK-NEXT:    (i32.const 1)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (global.get $supertype)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (global.get $nested)
  ;; CHECK-NEXT: )
  (func $use (export "use") (result (ref $obj))
    (drop (global.get $o0))
    (drop (global.get $o1))
    (drop (global.get $supertype))
    (global.get $nested)
  )
)

;; Globals with an exact type (as optimization passes refine them to the type
;; of their struct.new) are deferred too; the factory returns the exact type.
;; CHECK:      (func $defer$obj (type $8) (param $0 i32) (result (ref $obj))
;; CHECK-NEXT:  (local $1 (ref $obj))
;; CHECK-NEXT:  (block $cached (result (ref $obj))
;; CHECK-NEXT:   (br_on_non_null $cached
;; CHECK-NEXT:    (array.get $3
;; CHECK-NEXT:     (global.get $defer$obj$cache)
;; CHECK-NEXT:     (local.get $0)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (array.set $3
;; CHECK-NEXT:    (global.get $defer$obj$cache)
;; CHECK-NEXT:    (local.get $0)
;; CHECK-NEXT:    (local.tee $1
;; CHECK-NEXT:     (struct.new $obj
;; CHECK-NEXT:      (global.get $vt)
;; CHECK-NEXT:      (array.get $4
;; CHECK-NEXT:       (global.get $defer$obj$table$1)
;; CHECK-NEXT:       (local.get $0)
;; CHECK-NEXT:      )
;; CHECK-NEXT:      (array.get $5
;; CHECK-NEXT:       (global.get $defer$obj$table$2)
;; CHECK-NEXT:       (local.get $0)
;; CHECK-NEXT:      )
;; CHECK-NEXT:      (array.get $6
;; CHECK-NEXT:       (global.get $defer$obj$table$3)
;; CHECK-NEXT:       (local.get $0)
;; CHECK-NEXT:      )
;; CHECK-NEXT:     )
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (local.get $1)
;; CHECK-NEXT:  )
;; CHECK-NEXT: )
(module
  ;; CHECK:      (type $vt (struct (field i32)))
  (type $vt (struct (field i32)))
  ;; CHECK:      (type $str (struct (field (ref $vt)) (field (mut i32)) (field externref)))
  (type $str (struct (field (ref $vt)) (field (mut i32)) (field externref)))

  ;; CHECK:      (type $2 (array (mut (ref null (exact $str)))))

  ;; CHECK:      (type $3 (array externref))

  ;; CHECK:      (type $4 (func (result (ref (exact $str)))))

  ;; CHECK:      (type $5 (func (param i32) (result (ref (exact $str)))))

  ;; CHECK:      (import "env" "s0" (global $import0 externref))
  (import "env" "s0" (global $import0 externref))
  ;; CHECK:      (import "env" "s1" (global $import1 externref))
  (import "env" "s1" (global $import1 externref))

  ;; CHECK:      (global $vt (ref $vt) (struct.new $vt
  ;; CHECK-NEXT:  (i32.const 42)
  ;; CHECK-NEXT: ))
  (global $vt (ref $vt) (struct.new $vt (i32.const 42)))

  (global $s0 (ref (exact $str)) (struct.new $str (global.get $vt) (i32.const 0) (global.get $import0)))
  (global $s1 (ref (exact $str)) (struct.new $str (global.get $vt) (i32.const 0) (global.get $import1)))

  ;; CHECK:      (global $defer$str$cache (ref $2) (array.new_default $2
  ;; CHECK-NEXT:  (i32.const 2)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (global $defer$str$table$2 (ref $3) (array.new_fixed $3 2
  ;; CHECK-NEXT:  (global.get $import0)
  ;; CHECK-NEXT:  (global.get $import1)
  ;; CHECK-NEXT: ))

  ;; CHECK:      (export "use" (func $use))

  ;; CHECK:      (func $use (type $4) (result (ref (exact $str)))
  ;; CHECK-NEXT:  (drop
  ;; CHECK-NEXT:   (call $defer$str
  ;; CHECK-NEXT:    (i32.const 0)
  ;; CHECK-NEXT:   )
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT:  (call $defer$str
  ;; CHECK-NEXT:   (i32.const 1)
  ;; CHECK-NEXT:  )
  ;; CHECK-NEXT: )
  (func $use (export "use") (result (ref (exact $str)))
    (drop (global.get $s0))
    (global.get $s1)
  )
)
;; CHECK:      (func $defer$str (type $5) (param $0 i32) (result (ref (exact $str)))
;; CHECK-NEXT:  (local $1 (ref (exact $str)))
;; CHECK-NEXT:  (block $cached (result (ref (exact $str)))
;; CHECK-NEXT:   (br_on_non_null $cached
;; CHECK-NEXT:    (array.get $2
;; CHECK-NEXT:     (global.get $defer$str$cache)
;; CHECK-NEXT:     (local.get $0)
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (array.set $2
;; CHECK-NEXT:    (global.get $defer$str$cache)
;; CHECK-NEXT:    (local.get $0)
;; CHECK-NEXT:    (local.tee $1
;; CHECK-NEXT:     (struct.new $str
;; CHECK-NEXT:      (global.get $vt)
;; CHECK-NEXT:      (i32.const 0)
;; CHECK-NEXT:      (array.get $3
;; CHECK-NEXT:       (global.get $defer$str$table$2)
;; CHECK-NEXT:       (local.get $0)
;; CHECK-NEXT:      )
;; CHECK-NEXT:     )
;; CHECK-NEXT:    )
;; CHECK-NEXT:   )
;; CHECK-NEXT:   (local.get $1)
;; CHECK-NEXT:  )
;; CHECK-NEXT: )
