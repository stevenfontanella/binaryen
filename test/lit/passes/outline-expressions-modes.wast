  ;; CALLS:      (func $c (type $0) (param $x i32) (result i32)
  ;; CALLS-NEXT:  (call $f
  ;; CALLS-NEXT:   (local.get $x)
  ;; CALLS-NEXT:   (i32.const 1000)
