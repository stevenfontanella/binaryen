;; The tiers of outline-expressions, selected either as --outline-expressions=MODE
;; or as --pass-arg=outline-expressions-mode@MODE. Each module contains copies
;; of one kind of tree.

;; A single call with trivial arguments: outlined from the guards tier on.
(module
  ;; CALLS:      (type $0 (func (param i32) (result i32)))

  ;; CALLS:      (type $1 (func (param i32 i32 i32)))

  ;; CALLS:      (func $f (type $1) (param $0 i32) (param $1 i32) (param $2 i32)
  ;; CALLS-NEXT: )
