  ;; CALLS-NEXT:   )
  ;; CALLS-NEXT:  )
  ;; CALLS-NEXT:  (nop)
  ;; CALLS-NEXT: )
  ;; GUARDS:      (func $a (type $0)
  ;; GUARDS-NEXT:  (if
  ;; GUARDS-NEXT:   (i32.eqz
  ;; GUARDS-NEXT:    (global.get $g)
  ;; GUARDS-NEXT:   )
