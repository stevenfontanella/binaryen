  ;; ALL_:      (func $a (type $1) (param $x (ref $A)) (result i32)
  ;; ALL_-NEXT:  (i32.add
  ;; ALL_-NEXT:   (i32.const 1)
  ;; ALL_-NEXT:   (struct.get $A 0
  ;; ALL_-NEXT:    (struct.get $A 1
  ;; ALL_-NEXT:     (struct.get $A 1
  ;; ALL_-NEXT:      (local.get $x)
  ;; ALL_-NEXT:     )
  ;; ALL_-NEXT:    )
  ;; ALL_-NEXT:   )
  ;; ALL_-NEXT:  )
  ;; ALL_-NEXT: )
  (func $a (param $x (ref $A)) (result i32)
    (i32.add
      (i32.const 1)
      (struct.get $A 0
        (struct.get $A 1
          (struct.get $A 1
            (local.get $x)
          )
        )
      )
    )
  )

  ;; CALLS:      (func $b (type $1) (param $x (ref $A)) (result i32)
  ;; CALLS-NEXT:  (i32.add
  ;; CALLS-NEXT:   (i32.const 1)
  ;; CALLS-NEXT:   (struct.get $A 0
