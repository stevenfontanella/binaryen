  ;; CALLS:      (func $a (type $0)
  ;; CALLS-NEXT:  (if
  ;; CALLS-NEXT:   (i32.eqz
  ;; CALLS-NEXT:    (global.get $g)
  ;; CALLS-NEXT:   )
  ;; CALLS-NEXT:   (then
