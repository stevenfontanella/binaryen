  ;; ALL_:      (type $2 (func (param i32)))

  ;; ALL_:      (func $f (type $1) (param $0 i32) (param $1 i32) (param $2 i32)
  ;; ALL_-NEXT: )
  (func $f (param i32 i32 i32))

  ;; CALLS:      (func $a (type $0) (param $x i32) (result i32)
  ;; CALLS-NEXT:  (call $f
  ;; CALLS-NEXT:   (local.get $x)
  ;; CALLS-NEXT:   (i32.const 1000)
  ;; CALLS-NEXT:   (i32.const 2000)
  ;; CALLS-NEXT:  )
  ;; CALLS-NEXT:  (i32.const 1)
  ;; CALLS-NEXT: )
  ;; GUARDS:      (func $a (type $0) (param $x i32) (result i32)
  ;; GUARDS-NEXT:  (call $outlined
  ;; GUARDS-NEXT:   (local.get $x)
  ;; GUARDS-NEXT:  )
  ;; GUARDS-NEXT:  (i32.const 1)
  ;; GUARDS-NEXT: )
  ;; TREES:      (func $a (type $0) (param $x i32) (result i32)
  ;; TREES-NEXT:  (call $outlined
  ;; TREES-NEXT:   (local.get $x)
  ;; TREES-NEXT:  )
  ;; TREES-NEXT:  (i32.const 1)
  ;; TREES-NEXT: )
  ;; ALL_:      (func $a (type $0) (param $x i32) (result i32)
  ;; ALL_-NEXT:  (call $outlined
  ;; ALL_-NEXT:   (local.get $x)
  ;; ALL_-NEXT:  )
  ;; ALL_-NEXT:  (i32.const 1)
  ;; ALL_-NEXT: )
  (func $a (param $x i32) (result i32)
    (call $f (local.get $x) (i32.const 1000) (i32.const 2000))
    (i32.const 1)
  )

  ;; CALLS:      (func $b (type $0) (param $x i32) (result i32)
  ;; CALLS-NEXT:  (call $f
  ;; CALLS-NEXT:   (local.get $x)
  ;; CALLS-NEXT:   (i32.const 1000)
  ;; CALLS-NEXT:   (i32.const 2000)
