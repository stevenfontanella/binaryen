  ;; GUARDS-NEXT:  (call $outlined
  ;; GUARDS-NEXT:   (local.get $x)
  ;; GUARDS-NEXT:  )
  ;; GUARDS-NEXT:  (i32.const 2)
  ;; GUARDS-NEXT: )
  ;; TREES:      (func $b (type $0) (param $x i32) (result i32)
  ;; TREES-NEXT:  (call $outlined
  ;; TREES-NEXT:   (local.get $x)
  ;; TREES-NEXT:  )
  ;; TREES-NEXT:  (i32.const 2)
