  ;; CALLS:      (type $1 (func (param (ref $A)) (result i32)))

  ;; CALLS:      (func $a (type $1) (param $x (ref $A)) (result i32)
  ;; CALLS-NEXT:  (i32.add
  ;; CALLS-NEXT:   (i32.const 1)
  ;; CALLS-NEXT:   (struct.get $A 0
  ;; CALLS-NEXT:    (struct.get $A 1
