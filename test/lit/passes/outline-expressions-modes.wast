  ;; GUARDS-NEXT:     )
  ;; GUARDS-NEXT:    )
  ;; GUARDS-NEXT:   )
  ;; GUARDS-NEXT:  )
  ;; GUARDS-NEXT: )
  ;; TREES:      (type $1 (func (param (ref $A)) (result i32)))

  ;; TREES:      (func $a (type $1) (param $x (ref $A)) (result i32)
  ;; TREES-NEXT:  (i32.add
  ;; TREES-NEXT:   (i32.const 1)
  ;; TREES-NEXT:   (struct.get $A 0
