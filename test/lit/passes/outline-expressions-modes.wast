;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.
;; RUN: foreach %s %t wasm-opt --outline-expressions=calls -all -S -o - | filecheck %s --check-prefix=CALLS
;; RUN: foreach %s %t wasm-opt --outline-expressions --pass-arg=outline-expressions-mode@guards -all -S -o - | filecheck %s --check-prefix=GUARDS
;; RUN: foreach %s %t wasm-opt --outline-expressions=trees -all -S -o - | filecheck %s --check-prefix=TREES
