;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.
;; RUN: foreach %s %t wasm-ctor-eval --ctors=test --kept-exports=test --quiet -all -S -o - | filecheck %s

(module
 ;; CHECK:      (type $A (struct (field (mut i32))))
 (type $A (struct (field (mut i32))))

 ;; This global is immutable and has the precise type of its init, so it can be
 ;; reused as the defining global for the struct it contains. After evalling,
 ;; the struct.new should be emitted directly in this global's init (with the
 ;; updated field value), rather than in a new ctor-eval$global that this one
 ;; then global.gets.
 ;; CHECK:      (type $1 (func (result i32)))

 ;; CHECK:      (type $2 (func))

 ;; CHECK:      (global $a (ref (exact $A)) (struct.new $A
 ;; CHECK-NEXT:  (i32.const 42)
 ;; CHECK-NEXT: ))
 (global $a (ref (exact $A)) (struct.new $A (i32.const 1)))

 (func $test (export "test")
  (struct.set $A 0
   (global.get $a)
   (i32.const 42)
  )
 )

 ;; CHECK:      (export "test" (func $test_2))

 ;; CHECK:      (export "keepalive" (func $keepalive))

 ;; CHECK:      (func $keepalive (type $1) (result i32)
 ;; CHECK-NEXT:  (struct.get $A 0
 ;; CHECK-NEXT:   (global.get $a)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $keepalive (export "keepalive") (result i32)
  (struct.get $A 0
   (global.get $a)
  )
 )
)

;; CHECK:      (func $test_2 (type $2)
;; CHECK-NEXT:  (nop)
;; CHECK-NEXT: )
(module
 ;; CHECK:      (type $A (struct (field (mut i32))))
 (type $A (struct (field (mut i32))))

 ;; As above, this global is immutable and has the precise type of its init,
 ;; but the init is an externalized struct. The global therefore has type
 ;; extern, not the struct's type, so it cannot be reused as the defining global
 ;; for the struct: we must emit a new defining global, and externalize a
 ;; global.get of that here.
 ;; CHECK:      (type $1 (func (result externref)))

 ;; CHECK:      (type $2 (func (result i32)))

 ;; CHECK:      (type $3 (func))

 ;; CHECK:      (global $ctor-eval$global_3 (ref (exact $A)) (struct.new $A
 ;; CHECK-NEXT:  (i32.const 42)
 ;; CHECK-NEXT: ))

 ;; CHECK:      (global $a (ref extern) (extern.convert_any
 ;; CHECK-NEXT:  (global.get $ctor-eval$global_3)
 ;; CHECK-NEXT: ))
 (global $a (ref extern) (extern.convert_any (struct.new $A (i32.const 1))))

 ;; After evalling, this global refers to the same struct, internally. It must
 ;; be serialized as a global.get of the struct's defining global (and not of
 ;; $a, which has the wrong type).
 ;; CHECK:      (global $b (mut (ref null $A)) (global.get $ctor-eval$global_3))
 (global $b (mut (ref null $A)) (ref.null none))

 (func $test (export "test")
  (global.set $b
   (ref.cast (ref $A)
    (any.convert_extern
     (global.get $a)
    )
   )
  )
  (struct.set $A 0
   (global.get $b)
   (i32.const 42)
  )
 )

 ;; CHECK:      (export "test" (func $test_3))

 ;; CHECK:      (export "keepalive-a" (func $keepalive-a))

 ;; CHECK:      (export "keepalive-b" (func $keepalive-b))

 ;; CHECK:      (func $keepalive-a (type $1) (result externref)
 ;; CHECK-NEXT:  (global.get $a)
 ;; CHECK-NEXT: )
 (func $keepalive-a (export "keepalive-a") (result externref)
  (global.get $a)
 )

 ;; CHECK:      (func $keepalive-b (type $2) (result i32)
 ;; CHECK-NEXT:  (struct.get $A 0
 ;; CHECK-NEXT:   (global.get $b)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $keepalive-b (export "keepalive-b") (result i32)
  (struct.get $A 0
   (global.get $b)
  )
 )
)

;; CHECK:      (func $test_3 (type $3)
;; CHECK-NEXT:  (nop)
;; CHECK-NEXT: )
(module
 ;; CHECK:      (type $A (shared (struct (field (mut i32)))))
 (type $A (shared (struct (field (mut i32)))))

 ;; As above, but now everything is shared.
 ;; CHECK:      (type $1 (func (result (ref null (shared extern)))))

 ;; CHECK:      (type $2 (func (result i32)))

 ;; CHECK:      (type $3 (func))

 ;; CHECK:      (global $ctor-eval$global_3 (ref (exact $A)) (struct.new $A
 ;; CHECK-NEXT:  (i32.const 42)
 ;; CHECK-NEXT: ))

 ;; CHECK:      (global $a (ref (shared extern)) (extern.convert_any
 ;; CHECK-NEXT:  (global.get $ctor-eval$global_3)
 ;; CHECK-NEXT: ))
 (global $a (ref (shared extern)) (extern.convert_any (struct.new $A (i32.const 1))))

 ;; CHECK:      (global $b (mut (ref null $A)) (global.get $ctor-eval$global_3))
 (global $b (mut (ref null $A)) (ref.null (shared none)))

 (func $test (export "test")
  (global.set $b
   (ref.cast (ref $A)
    (any.convert_extern
     (global.get $a)
    )
   )
  )
  (struct.set $A 0
   (global.get $b)
   (i32.const 42)
  )
 )

 ;; CHECK:      (export "test" (func $test_3))

 ;; CHECK:      (export "keepalive-a" (func $keepalive-a))

 ;; CHECK:      (export "keepalive-b" (func $keepalive-b))

 ;; CHECK:      (func $keepalive-a (type $1) (result (ref null (shared extern)))
 ;; CHECK-NEXT:  (global.get $a)
 ;; CHECK-NEXT: )
 (func $keepalive-a (export "keepalive-a") (result (ref null (shared extern)))
  (global.get $a)
 )

 ;; CHECK:      (func $keepalive-b (type $2) (result i32)
 ;; CHECK-NEXT:  (struct.get $A 0
 ;; CHECK-NEXT:   (global.get $b)
 ;; CHECK-NEXT:  )
 ;; CHECK-NEXT: )
 (func $keepalive-b (export "keepalive-b") (result i32)
  (struct.get $A 0
   (global.get $b)
  )
 )
)
;; CHECK:      (func $test_3 (type $3)
;; CHECK-NEXT:  (nop)
;; CHECK-NEXT: )
