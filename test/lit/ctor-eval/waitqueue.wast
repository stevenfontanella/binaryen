;; NOTE: Assertions have been generated by update_lit_checks.py --all-items and should not be edited.
;; RUN: foreach %s %t wasm-ctor-eval --ctors=test --kept-exports=test --quiet -all -S -o - | filecheck %s

(module
  ;; CHECK:      (type $0 (func (result (ref (shared waitqueue)) (ref (shared waitqueue)) (ref (shared waitqueue)))))

  ;; CHECK:      (global $g1 (ref (shared waitqueue)) (waitqueue.new))
  (global $g1 (ref (shared waitqueue)) (waitqueue.new))
  (func $test (export "test") (result (ref (shared waitqueue))) (result (ref (shared waitqueue))) (result (ref (shared waitqueue)))
    ;; waitqueue identity is preserved, including for existing waitqueue locals.
    (waitqueue.new)
    (waitqueue.new)
    (global.get $g1)
  )
)

;; CHECK:      (global $ctor-eval$global (ref (shared waitqueue)) (waitqueue.new))

;; CHECK:      (global $ctor-eval$global_2 (ref (shared waitqueue)) (waitqueue.new))

;; CHECK:      (export "test" (func $test_1))

;; CHECK:      (func $test_1 (type $0) (result (ref (shared waitqueue)) (ref (shared waitqueue)) (ref (shared waitqueue)))
;; CHECK-NEXT:  (tuple.make 3
;; CHECK-NEXT:   (global.get $ctor-eval$global)
;; CHECK-NEXT:   (global.get $ctor-eval$global_2)
;; CHECK-NEXT:   (global.get $g1)
;; CHECK-NEXT:  )
;; CHECK-NEXT: )
(module
  ;; CHECK:      (type $0 (func (result (ref (shared waitqueue)))))

  ;; CHECK:      (type $t (struct (field (ref (shared waitqueue)))))
  (type $t (struct (field (ref (shared waitqueue)))))
  (func $test (export "test") (result (ref (shared waitqueue)))
    ;; We can remove a redundant struct allocation, and lift the waitqueue
    ;; allocation to the top-level.
    (local $struct (ref $t))
    (local.set $struct
      (struct.new $t
        (waitqueue.new)
      )
    )

    (struct.get $t 0
      (local.get $struct)
    )
  )
)
;; CHECK:      (global $ctor-eval$global_3 (ref (shared waitqueue)) (waitqueue.new))

;; CHECK:      (export "test" (func $test_1))

;; CHECK:      (func $test_1 (type $0) (result (ref (shared waitqueue)))
;; CHECK-NEXT:  (local $struct (ref $t))
;; CHECK-NEXT:  (global.get $ctor-eval$global_3)
;; CHECK-NEXT: )
